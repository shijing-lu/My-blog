---
/*
 * SettingsLayout.astro —— 设置子页公共布局
 * Props.section: 当前激活分区；传递相同 form
 */
interface Props {
  section: 'site-name' | 'hero-quotes' | 'landing' | 'appearance' | 'image-bed' | 'md-css' | 'site-css' | 'ai' | 'netdisk' | 'sync' | 'shortcuts';
}
const { section } = Astro.props;
import AdminLayout from '@/layouts/AdminLayout.astro';
import SettingsForm from '@/components/admin/SettingsForm.astro';
import EditorShortcutsSettings from '@/components/admin/EditorShortcutsSettings';
import { getSettingsSections } from '@/lib/settings-sections';
import { serverEnv } from '@/lib/env';
const tabs = getSettingsSections(serverEnv('DESKTOP_MODE') === '1');
const titleSuffix = getSettingsSections(true).find(item => item.id === section)?.label ?? '设置';
---
<AdminLayout title={`设置 · ${titleSuffix}`}>
  <section data-settings-page class="mx-auto h-full w-full max-w-3xl overflow-y-auto px-4 py-8">
    <div>
      <p class="pixel-chip text-primary">SETTINGS</p>
      <h1 class="mt-1 font-display text-2xl font-semibold">站点设置</h1>
      <p class="mt-1 text-sm text-muted-foreground">集中管理站点可自定义项，保存后全站生效。</p>
    </div>
    <nav class="mt-5 flex flex-wrap gap-2" aria-label="设置分区">
      {tabs.map((t) => (
        <a href={t.href} data-m3-role="navigation-item" aria-current={t.id === section ? 'page' : undefined} class={`settings-tab${t.id === section ? ' active' : ''}`}>{t.label}</a>
      ))}
    </nav>
    {section === 'shortcuts' ? (
      <div class="mt-6">
        <EditorShortcutsSettings client:load />
      </div>
    ) : (
      <SettingsForm section={section} />
    )}
  </section>
</AdminLayout>
