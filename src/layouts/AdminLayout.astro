---
/* ===== Props ===== */
interface Props {
  /** 页面标题 */
  title?: string;
}

const { title = '后台管理' } = Astro.props;

/* ===== Imports ===== */
import '../styles/global.css';
import ThemeHead from '@/components/ThemeHead.astro';
import ThemeSettings from '@/components/ThemeSettings.astro';
import ThemeToggle from '@/components/ThemeToggle.astro';
import '@/styles/neobrutalism.css';
import { getSiteUiStyle } from '@/lib/ui-style-server';
import SiteTextStyles from '@/components/SiteTextStyles.astro';
import { isManagerSession } from '@/lib/admin-auth';
import { buildArticleFontCss, getFontsByIds, getSiteFontState } from '@/lib/fonts';
import { getSiteName } from '@/lib/site-name';

/* ===== Logic ===== */
const isAuthed = await isManagerSession(Astro.cookies);
/** 手动字体设置（优先于主题；未设置则跟随主题）——与 BaseLayout 保持一致 */
const { fonts: fontSettings, hasManualFonts } = await getSiteFontState();
const customFontIds = [fontSettings.article, fontSettings.ui]
  .filter((f) => f.type === 'custom')
  .map((f) => f.value);
const customFonts = await getFontsByIds(customFontIds);
const fontCss = hasManualFonts ? buildArticleFontCss(fontSettings, customFonts) : '';
/** 站点名称（管理员可在 /admin/settings 自定义，默认「白衣卿相」） */
const siteTitle = await getSiteName();
const siteUiStyle = await getSiteUiStyle();
---
<!-- ===== Template ===== -->
<!doctype html>
<html lang="zh-CN" data-site-ui-style={siteUiStyle} data-ui-style={siteUiStyle}>
  <head>
    <meta charset="utf-8" />
    <!-- Buffer 垫片：同 BaseLayout —— 客户端共享模块引用了 Node 的 Buffer，
         缺失会导致 astro-island 水合失败（编辑器空白、按钮失效） -->
    <script is:inline>
      if (typeof window !== 'undefined' && typeof window.Buffer === 'undefined') {
        window.Buffer = {
          isBuffer: function () { return false; },
          from: function (v) { return typeof v === 'string' ? new TextEncoder().encode(v) : new Uint8Array(0); },
          alloc: function (n) { return new Uint8Array(n || 0); },
        };
      }
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · {siteTitle}</title>
    {/* 后台页面一律不索引（P1-7）：防搜索引擎收录管理入口 */}
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <ThemeHead defaultStyle={siteUiStyle} />
    {/* 手动字体设置覆盖（仅设置过时注入；未设置则跟随主题） */}
    {fontCss !== '' && <style data-classic-style set:html={fontCss} />}
    {/* 全站文字样式（内置默认包 + 自定义）：后台与前台共用同一套文字观感 */}
    <SiteTextStyles />
    <script is:inline>window.__applyUiStyleHead?.();</script>
  </head>
  <body class="flex h-dvh flex-col overflow-hidden bg-background text-foreground" data-layout="admin">
    {/* 跳转到主内容（无障碍 P1-5）：与 BaseLayout 一致，键盘用户可直达后台内容区 */}
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-[60] focus:rounded-md focus:border focus:border-primary/40 focus:bg-background focus:px-4 focus:py-2 focus:text-sm focus:font-medium focus:text-primary focus:shadow-lg"
    >
      跳转到主内容
    </a>
    <header id="admin-header" class="neo-admin-header">
      <a href="/" data-site-name class="font-pixel text-sm tracking-wider text-primary">
        {siteTitle}
      </a>
      <nav class="flex items-center gap-2 text-xs sm:gap-3 sm:text-sm">
        <span class="neo-admin-appearance"><ThemeToggle /><ThemeSettings /></span>
        {/* 后台互跳用整页刷新（data-astro-reload）：后台页面内联脚本只在首次加载执行，
            直接元素绑定与页面状态会在 SPA 切换后失效（点击无反应）——整页刷新保证状态新鲜 */}
        <a href="/admin" aria-current={Astro.url.pathname === "/admin" ? "page" : undefined} data-astro-reload class="text-muted-foreground transition-colors duration-200 hover:text-foreground">
          文章
        </a>
        <a href="/admin/mindmaps" aria-current={Astro.url.pathname === "/admin/mindmaps" ? "page" : undefined} data-astro-reload class="text-muted-foreground transition-colors duration-200 hover:text-foreground">
          思维导图
        </a>
        <a href="/admin/nav" aria-current={Astro.url.pathname === "/admin/nav" ? "page" : undefined} data-astro-reload class="text-muted-foreground transition-colors duration-200 hover:text-foreground">
          导航
        </a>
        <a href="/admin/netdisk" aria-current={Astro.url.pathname === "/admin/netdisk" ? "page" : undefined} data-astro-reload class="text-muted-foreground transition-colors duration-200 hover:text-foreground">
          网盘
        </a>
        <a href="/admin/settings/site-name" aria-current={Astro.url.pathname.startsWith('/admin/settings') ? "page" : undefined} data-astro-reload class="text-muted-foreground transition-colors duration-200 hover:text-foreground">
          设置
        </a>
        <a href="/" data-astro-reload class="text-muted-foreground transition-colors duration-200 hover:text-foreground">
          查看文章
        </a>
        {
          isAuthed && (
            <button id="admin-logout" type="button" class="text-muted-foreground transition-colors duration-200 hover:text-destructive">
              退出登录
            </button>
          )
        }
      </nav>
    </header>
    <main id="main" tabindex="-1" class="min-h-0 flex-1 focus:outline-none">
      <slot />
    </main>
  </body>
</html>


<script>
  import { initMotion } from '@/lib/motion';
  initMotion();
  import { restoreTheme, initSystemThemeWatcher } from '@/lib/theme';
  restoreTheme();
  initSystemThemeWatcher();
  import { on } from '@/lib/dom';
  /** 退出登录：POST /api/logout 后回首页（委托绑定，防 SPA 后失效） */
  on('admin-logout', 'click', async () => {
    try {
      await fetch('/api/logout', { method: 'POST' });
    } catch {
      /* 忽略网络错误，仍跳转 */
    }
    window.location.href = '/';
  });
</script>
