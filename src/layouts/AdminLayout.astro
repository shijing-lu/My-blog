---
/* ===== Props ===== */
interface Props {
  /** 页面标题 */
  title?: string;
}

const { title = '后台管理' } = Astro.props;

/* ===== Imports ===== */
import '../styles/global.css';
import ThemeHead from '@/components/ThemeHead.astro';
import { verifyRequest } from '@/lib/auth';
import { buildFontCss, getFontsByIds, getSiteFonts, hasManualFontSettings } from '@/lib/fonts';

/* ===== Logic ===== */
const isAuthed = verifyRequest(Astro.cookies);
/** 手动字体设置（优先于主题；未设置则跟随主题）——与 BaseLayout 保持一致 */
const hasManualFonts = await hasManualFontSettings();
const fontSettings = await getSiteFonts();
const customFontIds = [fontSettings.article, fontSettings.ui]
  .filter((f) => f.type === 'custom')
  .map((f) => f.value);
const customFonts = await getFontsByIds(customFontIds);
const fontCss = hasManualFonts ? buildFontCss(fontSettings, customFonts) : '';
---
<!-- ===== Template ===== -->
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · My Blog</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <ThemeHead />
    {/* 手动字体设置覆盖（仅设置过时注入；未设置则跟随主题） */}
    {fontCss !== '' && <style set:html={fontCss} />}
  </head>
  <body class="flex h-dvh flex-col overflow-hidden bg-background text-foreground">
    <header class="flex h-12 shrink-0 items-center justify-between border-b px-4">
      <a href="/" class="font-pixel text-sm tracking-wider text-primary">
        My Blog
      </a>
      <nav class="flex items-center gap-2 text-xs sm:gap-3 sm:text-sm">
        {/* 后台互跳用整页刷新（data-astro-reload）：后台页面内联脚本只在首次加载执行，
            直接元素绑定与页面状态会在 SPA 切换后失效（点击无反应）——整页刷新保证状态新鲜 */}
        <a href="/admin" data-astro-reload class="text-muted-foreground transition-colors duration-200 hover:text-foreground">
          文章
        </a>
        <a href="/admin/mindmaps" data-astro-reload class="text-muted-foreground transition-colors duration-200 hover:text-foreground">
          思维导图
        </a>
        <a href="/admin/nav" data-astro-reload class="text-muted-foreground transition-colors duration-200 hover:text-foreground">
          导航
        </a>
        <a href="/admin/settings" data-astro-reload class="text-muted-foreground transition-colors duration-200 hover:text-foreground">
          设置
        </a>
        <a href="/" data-astro-reload class="text-muted-foreground transition-colors duration-200 hover:text-foreground">
          查看文章
        </a>
        {
          isAuthed && (
            <button id="admin-logout" type="button" class="text-muted-foreground transition-colors duration-200 hover:text-destructive">
              退出登录
            </button>
          )
        }
      </nav>
    </header>
    <main class="min-h-0 flex-1">
      <slot />
    </main>
  </body>
</html>

<script>
  import { on } from '@/lib/dom';
  /** 退出登录：POST /api/logout 后回首页（委托绑定，防 SPA 后失效） */
  on('admin-logout', 'click', async () => {
    try {
      await fetch('/api/logout', { method: 'POST' });
    } catch {
      /* 忽略网络错误，仍跳转 */
    }
    window.location.href = '/';
  });
</script>
