---
/* ===== Props ===== */
interface Props {
  /** 文章实体 */
  article: import('../../db/types').Article;
  /** 目录 */
  toc: import('@/lib/mdx-plugins').TocItem[];
  /** 上一篇（更旧） */
  prev?: import('../../db/types').ArticleMeta;
  /** 下一篇（更新） */
  next?: import('../../db/types').ArticleMeta;
}

const { article, toc, prev, next } = Astro.props;

/** 分享缩略图（OG/Twitter，P1-7）：手动封面优先，否则正文首图；无图则交回 BaseLayout 用站点默认图 */
const ogImage = cardCoverUrl(resolveCover(article), 1200) ?? undefined;

/* ===== Imports ===== */
import BaseLayout from '@/layouts/BaseLayout.astro';
import { resolveCover } from '@/lib/articles';
import { cardCoverUrl } from '@/lib/images';
import ArticleHeader from '@/components/article/ArticleHeader.astro';
import PublicArticleDirectory from '@/components/article/PublicArticleDirectory.astro';
import '@/styles/article-detail.css';
import '@/styles/article-workspace.css';
import ArticleAside from '@/components/article/ArticleAside.astro';
import ArticleFooter from '@/components/article/ArticleFooter.astro';
---
<!-- ===== Template ===== -->
<BaseLayout title={article.title} description={article.summary} image={ogImage}>
  <section class="neo-reader">
    <div class="reader-columns">
      <main class="article-paper min-w-0">
        {/* 整篇文章统一宽度：图片 object-cover（与分割线同宽，不铺满全屏） */}
        <div class="max-w-3xl">
          <ArticleHeader article={article} />
          <div class="pixel-divider mt-6" />
          <div class="layout-photo mt-6">
            <slot />
          </div>
          <ArticleFooter article={article} prev={prev} next={next} />
        </div>
      </main>
      {/* 右侧：目录 + 详细信息 */}
      <PublicArticleDirectory toc={toc}><ArticleAside article={article} /></PublicArticleDirectory>
    </div>
  </section>
</BaseLayout>
