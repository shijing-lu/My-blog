---
/* ===== Props ===== */
interface Props {
  title?: string;
  description?: string;
}

/* ===== Logic ===== */
const {
  title = 'My Blog',
  description = '技术教程 · 学习笔记 · 随笔与摄影',
} = Astro.props;

/* ===== Imports ===== */
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import ThemeToggle from '@/components/ThemeToggle.astro';
import ThemeSettings from '@/components/ThemeSettings';
import RightToolbar from '@/components/RightToolbar.astro';
import { buildThemeCss } from '@/themes';

const siteTitle = 'My Blog';
const pageTitle = title === 'My Blog' ? title : `${title} · ${siteTitle}`;

/* ===== Logic ===== */
/** 主题系统生成的全局 CSS（覆盖 :root 默认令牌） */
const themeCss = buildThemeCss();
---
<!-- ===== Template ===== -->
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <ClientRouter />
    <!-- 主题系统：注入各主题的 data-theme CSS，并用内联脚本首帧防闪烁 -->
    <Fragment set:html={`<style id="theme-styles">${themeCss}</style>`} />
    <script is:inline>
      (function () {
        try {
          const s = JSON.parse(localStorage.getItem('my-blog-theme') || '{}');
          const r = document.documentElement;
          if (s.themeId) r.setAttribute('data-theme', s.themeId);
          const m = s.mode || 'system';
          const d = m === 'dark' || (m === 'system' && matchMedia('(prefers-color-scheme: dark)').matches);
          r.classList.toggle('dark', d);
          r.setAttribute('data-mode', m);
        } catch (e) {
          document.documentElement.classList.toggle('dark', matchMedia('(prefers-color-scheme: dark)').matches);
        }
      })();
    </script>
  </head>
  <body class="flex min-h-dvh flex-col">
    <header class="sticky top-0 z-40 w-full border-b bg-background/85 backdrop-blur-sm">
      <div class="mx-auto flex h-14 w-full max-w-6xl items-center justify-between gap-4 px-4">
        <a
          href="/"
          class="font-pixel text-sm tracking-wider text-primary glow-text transition-opacity duration-200 hover:opacity-80"
        >
          My Blog
        </a>
        <nav class="flex items-center gap-1 text-sm" aria-label="主导航">
          <a href="/" class="rounded-md px-3 py-1.5 text-muted-foreground transition-colors duration-200 hover:bg-accent hover:text-foreground">
            首页
          </a>
          <span class="hidden text-xs text-muted-foreground/70 sm:inline">技术教程 · 学习笔记 · 随笔与摄影</span>
          <ThemeSettings client:load />
          <ThemeToggle />
        </nav>
      </div>
    </header>

    <main class="flex-1">
      <slot />
    </main>

    <footer class="border-t">
      <div class="mx-auto w-full max-w-6xl px-4 py-6">
        <div class="pixel-divider mb-4" />
        <p class="text-center text-sm text-muted-foreground">
          技术教程 · 学习笔记 · 随笔与摄影
        </p>
        <p class="mt-2 text-center text-xs text-muted-foreground/70">
          © {new Date().getFullYear()} My Blog · Powered by Astro
        </p>
      </div>
    </footer>

    <RightToolbar />
  </body>
</html>
