---
/* ===== Props ===== */
interface Props {
  title?: string;
  description?: string;
  /** 页面封面图（OG/Twitter 分享缩略图；相对路径会自动补成绝对 URL，留空则不输出 og:image） */
  image?: string;
  /** 是否允许搜索引擎索引该页（默认 true；后台/编辑等私密页传 false → 输出 noindex） */
  indexable?: boolean;
}

import { serverEnv } from '@/lib/env';

/* ===== Logic ===== */
const {
  title = '',
  description = '技术教程 · 学习笔记 · 随笔与摄影',
  image = '',
  indexable = true,
} = Astro.props;

/* ===== Imports ===== */
import '../styles/global.css';
import '../styles/print.css'; // 「导出 PDF」打印样式表（@media print，零屏显开销）
import 'katex/dist/katex.min.css'; // LaTeX 公式渲染样式（配合 mdx-plugins 的 rehype-katex）
import '@/styles/mobile-reading.css';
import '@/styles/body-heading-folding.css';
// KaTeX 关键字体预热：?url 取打包后哈希 URL，head 里 preload（见模板）。
// 国内网络下 KaTeX 字体加载失败会导致公式 vlist 行盒塌缩、糊成一团（诊断结论），
// preload 提前并行拉取 + 页面脚本检测失败后切 MathML 兜底（.katex-font-fallback）。
import katexMainRegular from 'katex/dist/fonts/KaTeX_Main-Regular.woff2?url';
import katexMainBold from 'katex/dist/fonts/KaTeX_Main-Bold.woff2?url';
import katexMathItalic from 'katex/dist/fonts/KaTeX_Math-Italic.woff2?url';
import katexMathBoldItalic from 'katex/dist/fonts/KaTeX_Math-BoldItalic.woff2?url';
import katexSize1 from 'katex/dist/fonts/KaTeX_Size1-Regular.woff2?url';
import katexSize2 from 'katex/dist/fonts/KaTeX_Size2-Regular.woff2?url';
import { ClientRouter } from 'astro:transitions';
import ThemeHead from '@/components/ThemeHead.astro';
import ThemeToggle from '@/components/ThemeToggle.astro';
import ThemeSettings from '@/components/ThemeSettings.astro';
import RightToolbar from '@/components/RightToolbar.astro';
import ProfileDialog from '@/components/ProfileDialog.astro';
import ManageDialog from '@/components/ManageDialog.astro';
import SettingsModal from '@/components/admin/SettingsModal.astro';
import { canManage, isTopAdmin } from '@/lib/admin-auth';
import { isUserGitHubConfigured } from '@/lib/auth';
import AiChatFloat from '@/components/ai/AiChatFloat';
import QuickNoteFloat from '@/components/quick-notes/QuickNoteFloat';
import { getAiConfig, isAiReady } from '@/lib/ai-config';
import { getSiteBackground, resolveBackgroundForPath } from '@/lib/background';
import { buildFontCss, getFontsByIds, getSiteFontState } from '@/lib/fonts';
import { getSiteName } from '@/lib/site-name';
import { getHeroQuoteSettings } from '@/lib/quote-settings';
import { getCustomMdCss, scopeMdCss } from '@/lib/md-css';
import SiteTextStyles from '@/components/SiteTextStyles.astro';

/** 站点名称（管理员可在 /admin/settings 自定义，默认「白衣卿相」） */
const siteTitle = await getSiteName();
const isDesktop = serverEnv('DESKTOP_MODE') === '1';
/** 文档标题：无页面标题或与站名相同时只显示站名，否则「页面标题 · 站名」 */
const pageTitle = title === '' || title === siteTitle ? siteTitle : `${title} · ${siteTitle}`;

/* ---- SEO / 社交分享元信息（P1-7）----
 * 站点根地址：优先环境变量（部署时配 SITE_URL，如 https://blog.example.com），
 * 缺失时回落到当前请求 origin——保证 canonical / og:url / og:image 始终是绝对 URL
 * （Open Graph 规范要求绝对地址，相对路径会被多数抓取方忽略）。 */
const rawOrigin =
  import.meta.env.SITE ?? import.meta.env.PUBLIC_SITE_URL ?? Astro.url.origin;
const origin = String(rawOrigin).replace(/\/+$/, '');
/** 当前页面规范化绝对地址（去掉查询串与 hash，避免 ?page=2 之类被判重） */
const canonicalUrl = new URL(Astro.url.pathname, `${origin}/`).href;
/** 分享缩略图绝对地址（传入相对路径时补全；未传入则回落到站点默认图 public/og-default.svg） */
const ogImagePath = image || '/og-default.svg';
const ogImage = /^https?:\/\//.test(ogImagePath)
  ? ogImagePath
  : new URL(ogImagePath, `${origin}/`).href;
/** 页脚标语：每次刷新从诗词轮播配置的名言池随机一条（配置保证至少一条） */
const heroQuotes = (await getHeroQuoteSettings()).quotes;
const footerQuote =
  heroQuotes[Math.floor(Math.random() * heroQuotes.length)]?.text ?? '技术教程 · 学习笔记 · 随笔与摄影';

/* ===== Logic ===== */
/** 是否具备文章管理权限（站主或 GitHub 授权管理员，ProfileDialog 按此切换管理视角） */
const isAuthed = await canManage(Astro.cookies, 'articles');
/** 是否具备站点设置权限（设置弹窗仅对管理端渲染，游客零输出） */
const canSettings = await canManage(Astro.cookies, 'settings');
const canQuickNotes = await isTopAdmin(Astro.cookies);
/** AI 助手是否就绪（SSR 判定；未配置时岛不渲染交互 UI） */
const aiReady = isAiReady(await getAiConfig());
/** 全站背景配置（统一背景 / 按页面独立，设置页可配） */
const bg = await getSiteBackground();
/** 当前页面应渲染的背景（null = 不渲染） */
const resolvedBg = resolveBackgroundForPath(bg, Astro.url.pathname);
/** 全局字体设置：手动设置过 → 注入覆盖（优先于主题）；从未设置 → 不注入，跟随主题字体 */
const { fonts: fontSettings, hasManualFonts } = await getSiteFontState();
const customFontIds = [fontSettings.article, fontSettings.ui]
  .filter((f) => f.type === 'custom')
  .map((f) => f.value);
const customFonts = await getFontsByIds(customFontIds);
const fontCss = hasManualFonts ? buildFontCss(fontSettings, customFonts) : '';
/** 自定义 Markdown 样式（设置页上传）：作用域化后全站注入，覆盖所有 .prose 渲染处 */
const mdCustomCss = await getCustomMdCss();
const mdCssScoped = mdCustomCss.css.trim() !== '' ? scopeMdCss(mdCustomCss.css) : '';

/* ---- 是否需要 KaTeX 字体预热（P2-21）----
 * 6 个 KaTeX 字体每个约 10–30KB，原先**无条件** preload：像 /nav、/calendar、/gallery
 * 这类零公式页面也白白拉 6 个请求，挤占首屏带宽、抬高 LCP。
 * 只有「会渲染 MDX 正文」的路由才可能出现公式，故按前缀白名单判定：
 *   - /blog/*     文章详情（技术笔记大量公式）
 *   - /doc/*      文档库
 *   - /demo       MDX 渲染演示页
 * 公式字体失败时有 MathML 兜底（见下方脚本），因此漏判的代价是可接受的降级，
 * 而误判（该 preload 却没 preload）只影响首帧公式字体，不影响正确性。 */
const pathname = Astro.url.pathname;
const needsKatexFonts =
  pathname.startsWith('/blog/') ||
  pathname.startsWith('/doc/') ||
  // 动态列表/详情：2026-09-20 起动态与文章/文档共用 renderMdx 管线，同样可能出现公式
  pathname.startsWith('/moments') ||
  pathname.startsWith('/quick-notes') ||
  pathname === '/demo';
---
<!-- ===== Template ===== -->
<!doctype html>
<!-- data-desktop：桌面端（Electron）标记 —— 用于启用"启动入场"等桌面专属动效 -->
<html lang="zh-CN" data-desktop={isDesktop ? '' : undefined}>
  <head>
    <meta charset="utf-8" />
    <!--
      Buffer 垫片（必须在任何岛脚本之前）：
      个别被客户端引用的共享模块（如 drizzle 的列类型映射）引用了 Node 的 Buffer，
      其自身有 `typeof Buffer<"u"` 守卫，但浏览器里 Buffer 未定义时守卫之外的取值路径仍会抛
      "Buffer is not defined"，导致 astro-island 水合失败（症状：编辑器空白、按钮全部无响应，实测踩过）。
      这里提供一个最小占位实现：浏览器路径不会真正走二进制编解码，只需要"存在"。
    -->
    <script is:inline>
      if (typeof window !== 'undefined' && typeof window.Buffer === 'undefined') {
        window.Buffer = {
          isBuffer: function () { return false; },
          from: function (v) { return typeof v === 'string' ? new TextEncoder().encode(v) : new Uint8Array(0); },
          alloc: function (n) { return new Uint8Array(n || 0); },
        };
      }
    </script>
    <!--
      Buffer 垫片（必须在任何岛脚本之前）：
      个别被客户端引用的共享模块（如 drizzle 的列类型映射）引用了 Node 的 Buffer，
      其自身有 `typeof Buffer<"u"` 守卫，但浏览器里 Buffer 未定义时守卫之外的取值路径仍会抛
      "Buffer is not defined"，导致 astro-island 水合失败（症状：编辑器空白、按钮全部无响应，实测踩过）。
      这里提供一个最小占位实现：浏览器路径不会真正走二进制编解码，只需要"存在"。
    -->
    <script is:inline>
      if (typeof window !== 'undefined' && typeof window.Buffer === 'undefined') {
        window.Buffer = {
          isBuffer: function () { return false; },
          from: function (v) { return typeof v === 'string' ? new TextEncoder().encode(v) : new Uint8Array(0); },
          alloc: function (n) { return new Uint8Array(n || 0); },
        };
      }
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    {/* 规范化链接：同内容多入口（?page=、尾斜杠、大小写）统一指向本页标准地址 */}
    <link rel="canonical" href={canonicalUrl} />
    {!indexable && <meta name="robots" content="noindex, nofollow" />}
    {/* Open Graph / Twitter Card：分享到微信、X、Telegram 等处不再只有裸链接（P1-7） */}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteTitle} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="zh_CN" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <ClientRouter fallback="swap" />
    <ThemeHead />
    {/* KaTeX 关键字体预热（并行提前拉取，缓解弱网下公式字体加载失败）。
        P2-21：仅公式页面 preload（见 needsKatexFonts 判定），其余路由零额外请求。 */}
    {
      needsKatexFonts && (
        <>
          <link rel="preload" as="font" type="font/woff2" href={katexMainRegular} crossorigin="anonymous" />
          <link rel="preload" as="font" type="font/woff2" href={katexMainBold} crossorigin="anonymous" />
          <link rel="preload" as="font" type="font/woff2" href={katexMathItalic} crossorigin="anonymous" />
          <link rel="preload" as="font" type="font/woff2" href={katexMathBoldItalic} crossorigin="anonymous" />
          <link rel="preload" as="font" type="font/woff2" href={katexSize1} crossorigin="anonymous" />
          <link rel="preload" as="font" type="font/woff2" href={katexSize2} crossorigin="anonymous" />
        </>
      )
    }
    {/* KaTeX 字体韧性检测：字体加载失败 → html.katex-font-fallback → 全站公式切原生 MathML 展示
        （KaTeX 每个公式同时输出 .katex-html 视觉层 + .katex-mathml 原生层，兜底零渲染成本）。
        根因背景：KaTeX 字体加载失败时 Times 回退度量使 vlist 行盒塌缩 → 公式糊成一团；
        MathML 由浏览器排版引擎直接渲染，不依赖任何 web 字体，是最可靠的兜底。 */}
    <script is:inline>
      (function () {
        var marker = 'katex-font-fallback';
        var done = false;
        function applyFallback() {
          if (done) return;
          done = true;
          document.documentElement.classList.add(marker);
        }
        function verify() {
          try {
            if (!document.fonts || typeof document.fonts.check !== 'function') return;
            Promise.all([
              document.fonts.load('1em KaTeX_Main'),
              document.fonts.load('1em KaTeX_Math'),
            ])
              .then(function () {
                // load() 正常 resolve 后再 check：仍缺 KaTeX_Main 说明字体面加载失败（网络/被拦截）
                if (!document.fonts.check('1em KaTeX_Main')) applyFallback();
              })
              .catch(applyFallback);
          } catch (e) {
            /* fonts API 异常：保持 HTML 层不动（比误切换更安全） */
          }
        }
        function start() {
          // 页面没有公式时字体不会被请求，check 为 false 属正常，跳过检测
          if (!document.querySelector('.katex')) return;
          verify();
          // 时序兜底：fonts.ready 过早 resolve 的边缘情况，3s 后再验一次
          setTimeout(function () {
            if (!done) verify();
          }, 3000);
        }
        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', start);
        } else {
          start();
        }
        // SPA（ClientRouter）切页后新正文可能才出现公式：页面加载完成后补检一次
        document.addEventListener('astro:page-load', function () {
          if (!done) start();
        });
      })();
    </script>
    {/* 手动字体设置覆盖（仅设置过时注入；未设置则跟随主题字体） */}
    {fontCss !== '' && <style set:html={fontCss} />}
    {/* 自定义 Markdown 样式（管理员上传，作用域限定 .prose；SSR 每页注入，ClientRouter 转场随新 head 存活） */}
    {mdCssScoped !== '' && <style id="md-custom-css" set:html={mdCssScoped} />}
    {/* 全站文字样式：① 内置默认风格包（site-text 层，始终生效）② 管理员自定义（unlayered，覆盖 ①）。
        两块都在 head 内、无「</style」风险（保存前已净化），ClientRouter 转场随新 head 存活 */}
    <SiteTextStyles />
  </head>
  <body class="flex min-h-dvh flex-col">
    {/* 跳转到主内容（无障碍 P1-5）：默认视觉隐藏，键盘 Tab 聚焦时才显形。
        全站导航有 6 个链接 + 若干图标按钮，键盘/读屏用户无需逐个跳过即可直达正文。 */}
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-[60] focus:rounded-md focus:border focus:border-primary/40 focus:bg-background focus:px-4 focus:py-2 focus:text-sm focus:font-medium focus:text-primary focus:shadow-lg"
    >
      跳转到主内容
    </a>
    {
      resolvedBg && (
        // 注意：不要加 transition:persist —— 持久化会把旧背景元素（含旧 --bg-url）复用到新页面，
        // 导致「保存并应用」后 SPA 跳转仍显示旧背景。去掉后每次导航按当前 DB 值重新渲染。
        <div
          class="site-bg"
          style={`--bg-url: url('${resolvedBg.imageUrl.replace(/['\\]/g, '')}'); --bg-opacity: ${resolvedBg.opacity / 100}; --bg-blur: ${resolvedBg.blur}px`}
          aria-hidden="true"
        />
      )
    }
    <!-- 顶部阅读进度条（转场时保留，避免重建闪烁） -->
    <div id="scroll-progress" transition:persist="scroll-progress" class="scroll-progress" aria-hidden="true" />
    <!-- 全局页面切换加载指示：顶部进度条 + 居中转圈（导航开始→转场完成期间覆盖，避免卡顿画面裸露） -->
    <div id="nav-progress" class="nav-progress" aria-hidden="true"></div>
    <div id="nav-loader" class="nav-loader" aria-hidden="true"></div>
    <!-- 暗色主题星尘粒子背景（转场时保留；设置页可开关） -->
    {
      bg.stardust && <div class="stardust" transition:persist="stardust" aria-hidden="true" />
    }
    <header id="site-header" transition:persist="site-header" class="sticky top-0 z-40 w-full border-b bg-background/85 backdrop-blur-sm">
      <div class="mx-auto flex h-14 w-full max-w-6xl items-center justify-between gap-4 px-4">
        <div class="flex shrink-0 items-center gap-1">
          {isDesktop && (
            <button type="button" data-desktop-back aria-label="后退" title="后退" disabled class="flex h-8 w-8 items-center justify-center rounded-md text-muted-foreground transition-colors hover:bg-accent hover:text-foreground focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary disabled:cursor-not-allowed disabled:opacity-35 disabled:hover:bg-transparent disabled:hover:text-muted-foreground">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6" /></svg>
            </button>
          )}
          <a
            href="/"
            data-site-name
            class="shrink-0 font-pixel text-sm tracking-wider text-primary glow-text transition-opacity duration-200 hover:opacity-80"
          >
            {siteTitle}
          </a>
          {isDesktop && (
            <button type="button" data-desktop-forward aria-label="前进" title="前进" disabled class="flex h-8 w-8 items-center justify-center rounded-md text-muted-foreground transition-colors hover:bg-accent hover:text-foreground focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary disabled:cursor-not-allowed disabled:opacity-35 disabled:hover:bg-transparent disabled:hover:text-muted-foreground">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6" /></svg>
            </button>
          )}
        </div>
        <nav class="flex min-w-0 items-center gap-1 overflow-x-auto whitespace-nowrap text-sm" aria-label="主导航">
          <a href="/" class="rounded-md px-3 py-1.5 text-muted-foreground transition-colors duration-200 hover:bg-accent hover:text-foreground">
            首页
          </a>
          <a href="/doc" class="rounded-md px-3 py-1.5 text-muted-foreground transition-colors duration-200 hover:bg-accent hover:text-foreground">
            文档
          </a>
          <a href="/nav" class="rounded-md px-3 py-1.5 text-muted-foreground transition-colors duration-200 hover:bg-accent hover:text-foreground">
            导航
          </a>
          <a href="/gallery" class="rounded-md px-3 py-1.5 text-muted-foreground transition-colors duration-200 hover:bg-accent hover:text-foreground">
            影集
          </a>
          <a href="/calendar" class="rounded-md px-3 py-1.5 text-muted-foreground transition-colors duration-200 hover:bg-accent hover:text-foreground">
            日历
          </a>
          <a href="/schedule" aria-current={Astro.url.pathname.startsWith('/schedule') ? 'page' : undefined} class:list={['rounded-md px-3 py-1.5 transition-colors duration-200 hover:bg-accent hover:text-foreground', Astro.url.pathname.startsWith('/schedule') ? 'bg-accent text-foreground' : 'text-muted-foreground']}>
            日程
          </a>
          <a href="/moments" class="rounded-md px-3 py-1.5 text-muted-foreground transition-colors duration-200 hover:bg-accent hover:text-foreground">
            动态
          </a>
          <a href="/archive" class="rounded-md px-3 py-1.5 text-muted-foreground transition-colors duration-200 hover:bg-accent hover:text-foreground">
            归档
          </a>
          {canQuickNotes && <a href="/quick-notes" class="rounded-md px-3 py-1.5 text-muted-foreground transition-colors duration-200 hover:bg-accent hover:text-foreground">随心录</a>}
          <span class="mx-1 hidden h-5 w-px bg-border sm:block" aria-hidden="true" />
          <ThemeToggle />
          <ThemeSettings />
          <ProfileDialog isAuthed={isAuthed} />
          <!-- 管理入口：模态弹窗（打开时按身份分支渲染，不再跳转独立页） -->
          <ManageDialog githubEnabled={isUserGitHubConfigured()} />
          <!-- 站点设置弹窗（Obsidian 式左右分栏；仅 settings 权限渲染） -->
          {canSettings && <SettingsModal />}
        </nav>
      </div>
    </header>

    {/* id + tabindex="-1"：让 skip link 的 #main 锚点可聚焦，
        焦点转移后读屏会播报主内容区起点（否则浏览器只滚动不移动焦点） */}
    <main id="main" tabindex="-1" class="flex-1 focus:outline-none">
      <slot />
    </main>

    <footer id="site-footer" transition:persist="site-footer" class="border-t">
      <div class="mx-auto w-full max-w-6xl px-4 py-6">
        <div class="pixel-divider mb-4" />
        <p class="text-center text-sm text-muted-foreground">
          {footerQuote}
        </p>
        <p class="mt-2 text-center text-xs text-muted-foreground">
          © {new Date().getFullYear()} <span data-site-name>{siteTitle}</span> · Powered by Astro
        </p>
      </div>
    </footer>

    <RightToolbar aiEnabled={aiReady} />

    <!-- 图标 sprite：代码块/行内代码的复制与折叠图标按 `<use href="#id">` 引用。
         ⚠️ 不能用内联 SVG 逐个复制：行内代码可高频出现（实测 31KB 文章 331 处），
         每处内联两枚 SVG 会让 HTML 原始体积 +228KB（桌面端本地服务无 gzip，直接承受），
         改 sprite 后每处约 70B，整体增量降到 ~1/5。 -->
    <svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false">
      <symbol id="i-code-copy" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <rect x="9" y="9" width="13" height="13" rx="2" />
        <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" />
      </symbol>
      <symbol id="i-code-check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M20 6 9 17l-5-5" />
      </symbol>
      <symbol id="i-code-chevron-up" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="18 15 12 9 6 15" />
      </symbol>
      <symbol id="i-code-chevron-down" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="6 9 12 15 18 9" />
      </symbol>
    </svg>

    <!-- AI 助手「小卿」：选中文本右键 → 悬浮对话（全站，client:idle 惰性水合） -->
    {aiReady && !Astro.url.pathname.startsWith('/schedule') && <AiChatFloat client:idle enabled={true} />}
    {canQuickNotes && <QuickNoteFloat client:load />}

    <!-- 公开页交互：代码块折叠 + 代码复制（块级/行内） + Callout 复制按钮 + 图片灯箱 + 选项卡组 + 黑幕开关（document 委托，View Transitions 下依然有效） -->
    <script>
      import '@/scripts/copy-button';
      import '@/scripts/code-block-collapse';
      import '@/scripts/callout-copy';
      import '@/scripts/lightbox';
      import '@/scripts/tabs';
      import '@/scripts/spoiler';
      import '@/scripts/body-heading-folding';
    </script>
    <script>
      import '@/scripts/desktop-navigation';
    </script>

    <!-- 全局动效：滚动进度条 + 卡片入场动画 + GSAP 分割线展开 -->
    <script>
      import { initMotion } from '@/lib/motion';
      initMotion();
      import { restoreTheme, readState, isDark, initSystemThemeWatcher } from '@/lib/theme';
      import { getCustomThemes, injectCustomThemeCss } from '@/lib/custom-theme';

      // 幂等守卫：View Transition 重执行本脚本时监听只绑定一次
      if (!(window as unknown as { __blogGlobalsBound?: boolean }).__blogGlobalsBound) {
        (window as unknown as { __blogGlobalsBound?: boolean }).__blogGlobalsBound = true;
      /** 顶部阅读进度条（P2-4：写 CSS 变量驱动 transform，不再改 width 触发布局） */
      const progressEl = document.getElementById('scroll-progress');
      const updateProgress = (): void => {
        if (!progressEl) return;
        const h = document.documentElement.scrollHeight - window.innerHeight;
        const p = h > 0 ? window.scrollY / h : 0;
        progressEl.style.setProperty('--progress', String(p));
      };
      window.addEventListener('scroll', updateProgress, { passive: true });
      window.addEventListener('resize', updateProgress);
      updateProgress();

      /** 进度由真实导航事件驱动；短导航不闪遮罩，也不强制等待最短动画时长。 */
      let loaderTimer = 0;
      let progressTimer = 0;
      let navigationVersion = 0;
      const hideLoader = (): void => {
        window.clearTimeout(loaderTimer);
        document.getElementById('nav-loader')?.classList.remove('show');
        const progress = document.getElementById('nav-progress');
        if (!progress?.classList.contains('active')) return;
        progress.classList.add('done');
        window.clearTimeout(progressTimer);
        progressTimer = window.setTimeout(() => progress.classList.remove('active', 'done'), 240);
      };
      document.addEventListener('astro:before-preparation', (event) => {
        const version = ++navigationVersion;
        window.clearTimeout(loaderTimer);
        window.clearTimeout(progressTimer);
        const progress = document.getElementById('nav-progress');
        progress?.classList.remove('done');
        progress?.classList.add('active');
        loaderTimer = window.setTimeout(() => document.getElementById('nav-loader')?.classList.add('show'), 180);
        const signal = (event as Event & { signal?: AbortSignal }).signal;
        signal?.addEventListener('abort', () => { if (version === navigationVersion) hideLoader(); }, { once: true });
      });
      document.addEventListener('astro:after-swap', hideLoader);
      document.addEventListener('astro:page-load', hideLoader);

      /**
       * 主题无闪烁恢复（关键修复）：
       * Astro View Transitions 的 swap 会用新文档（SSR 输出，无主题属性的
       * `<html lang="zh-CN">`）替换根元素的 class/attributes，导致暗黑模式
       * 下 SPA 跳转瞬间回落到 :root 默认亮色（闪白）。
       * 在 swap 前把当前主题状态（data-theme/.dark/data-mode + 自定义主题 CSS）
       * 预写入 newDocument 的 <html>，让新页面根元素天生带正确主题，从根上消除闪烁。
       */
      document.addEventListener('astro:before-swap', (ev) => {
        try {
          const doc = (ev as unknown as { newDocument?: Document }).newDocument;
          if (!doc) return;
          const root = doc.documentElement;
          const state = readState();
          if (state.themeId) root.setAttribute('data-theme', state.themeId);
          else root.removeAttribute('data-theme');
          root.classList.toggle('dark', isDark(state));
          root.setAttribute('data-mode', state.mode);
          // 自定义主题：把当前注入的 #custom-theme-css 原样复制进新文档 head，
          // 否则 swap 替换 head 后自定义主题 CSS 丢失（内置主题 CSS 在 #theme-styles 里会随 head 一并替换，无需处理）
          const existing = document.getElementById('custom-theme-css') as HTMLStyleElement | null;
          if (existing && !doc.getElementById('custom-theme-css')) {
            const st = doc.createElement('style');
            st.id = 'custom-theme-css';
            st.textContent = existing.textContent;
            doc.head.appendChild(st);
          }
        } catch (e) { /* 失败则回落 after-swap/page-load 兜底，不影响导航 */ }
      });

      document.addEventListener('astro:page-load', () => {
        // View Transition 后恢复主题（data-theme / 暗色 / 自定义主题 CSS 会被新 head 替换丢失）
        // 注意：主题的「无闪烁恢复」已由 astro:before-swap 提前到 swap 前处理；
        // 这里仅作幂等兜底（before-swap 覆盖不到的极端场景），重复应用无害。
        try {
          restoreTheme();
          const state = readState();
          if (state.themeId) {
            const custom = getCustomThemes().find(function (t) { return t.id === state.themeId; });
            if (custom && !document.getElementById('custom-theme-css')) injectCustomThemeCss(custom);
          }
          // 跟随系统明暗偏好（幂等，仅首次生效）
          initSystemThemeWatcher();
        } catch (e) { /* 主题恢复失败不影响页面 */ }
        updateProgress();
      });

      }
    </script>
  </body>
</html>
