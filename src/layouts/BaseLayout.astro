---
/* ===== Props ===== */
interface Props {
  title?: string;
  description?: string;
}

/* ===== Logic ===== */
const {
  title = 'My Blog',
  description = '技术教程 · 学习笔记 · 随笔与摄影',
} = Astro.props;

/* ===== Imports ===== */
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import ThemeToggle from '@/components/ThemeToggle.astro';

const siteTitle = 'My Blog';
const pageTitle = title === 'My Blog' ? title : `${title} · ${siteTitle}`;
---
<!-- ===== Template ===== -->
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <ClientRouter />
  </head>
  <body class="flex min-h-dvh flex-col">
    <header class="sticky top-0 z-40 w-full border-b bg-background/80 backdrop-blur-sm">
      <div class="mx-auto flex h-14 w-full max-w-5xl items-center justify-between px-4">
        <a href="/" class="text-base font-semibold tracking-tight transition-opacity duration-200 hover:opacity-75">
          {siteTitle}
        </a>
        <nav class="flex items-center gap-1">
          <ThemeToggle />
        </nav>
      </div>
    </header>

    <main class="flex-1">
      <slot />
    </main>

    <footer class="border-t">
      <div class="mx-auto w-full max-w-5xl px-4 py-6 text-center text-sm text-muted-foreground">
        技术教程 · 学习笔记 · 随笔与摄影
      </div>
    </footer>
  </body>
</html>
