---
/* ===== Imports ===== */
import BaseLayout from '@/layouts/BaseLayout.astro';
import { verifyRequest } from '@/lib/auth';
import {
  getDailyGoal,
  getStudyStats,
  listStudyDistractions,
  listStudyTasks,
} from '@/lib/study-data';
import { listCheckinTasks } from '@/lib/checkin-data';

/* ===== Logic ===== */
const isAuthed = verifyRequest(Astro.cookies);
const stats = await getStudyStats();
const dailyGoal = await getDailyGoal();
/** 私密数据（登录后注入，经隐藏 div 传前端） */
const tasksJson = isAuthed ? JSON.stringify(await listStudyTasks()) : '[]';
const distractionsJson = isAuthed ? JSON.stringify(await listStudyDistractions()) : '[]';
/** 任务数组（模板下拉用，登录时才有） */
const tasks = isAuthed ? (await listStudyTasks()) : [];
/** 打卡任务（登录时才有；含聚合统计 + 记录日期） */
const checkins = isAuthed ? (await listCheckinTasks()) : [];
const checkinsJson = isAuthed ? JSON.stringify(checkins) : '[]';

/** HTML 转义 */
function esc(s: string): string {
  return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;').replace(/'/g, '&#39;');
}

/* ---- 热力图渲染数据 ---- */
/** 分钟数 → 档位 0-4 */
function level(minutes: number): number {
  if (minutes === 0) return 0;
  if (minutes < 15) return 1;
  if (minutes < 30) return 2;
  if (minutes < 60) return 3;
  return 4;
}
const monthLabels = stats.heatmap.weeks.map((week) => {
  const first = week.find((d) => d.date.endsWith('-01'));
  if (!first) return '';
  const m = new Date(`${first.date}T12:00:00`);
  return m.toLocaleString('en-US', { month: 'short' }).toUpperCase();
});

/* ---- 月度折线图数据 ---- */
const CHART_W = 260;
const CHART_H = 120;
const PAD = 10;
const maxMonthly = Math.max(1, ...stats.heatmap.monthly.map((m) => m.total));
const points = stats.heatmap.monthly.map((m, i) => {
  const denom = Math.max(1, stats.heatmap.monthly.length - 1);
  const x = PAD + (i * (CHART_W - PAD * 2)) / denom;
  const y = CHART_H - PAD - (m.total / maxMonthly) * (CHART_H - PAD * 2);
  return { x: Number(x.toFixed(1)), y: Number(y.toFixed(1)), total: m.total };
});
const linePath = points.map((p, i) => `${i === 0 ? 'M' : 'L'}${p.x},${p.y}`).join(' ');
const areaPath =
  points.length > 1
    ? `M${points[0]!.x},${points[0]!.y} ` +
      points.slice(1).map((p) => `L${p.x},${p.y}`).join(' ') +
      ` L${points[points.length - 1]!.x},${CHART_H - PAD} L${points[0]!.x},${CHART_H - PAD} Z`
    : '';
const monthShort = (month: string): string => {
  const [y, m] = month.split('-');
  return new Date(Number(y), Number(m) - 1, 1).toLocaleString('en-US', { month: 'short' }).toUpperCase();
};
const firstMonth = stats.heatmap.monthly[0] ? monthShort(stats.heatmap.monthly[0]!.month) : '';
const lastMonth = stats.heatmap.monthly[stats.heatmap.monthly.length - 1]
  ? monthShort(stats.heatmap.monthly[stats.heatmap.monthly.length - 1]!.month)
  : '';

/* ---- 近 7 天柱状图 ---- */
const maxWeek = Math.max(1, ...stats.weeklyMinutes.map((d) => d.minutes));
const barDays = stats.weeklyMinutes.map((d) => {
  const m = new Date(`${d.date}T12:00:00`);
  return {
    ...d,
    label: m.toLocaleString('zh-CN', { weekday: 'short' }),
    /** 柱高（px）：有值至少 4px，无值 1px */
    h: Math.max(d.minutes > 0 ? 4 : 1, (d.minutes / maxWeek) * 64),
  };
});

/** 番茄进度点：本轮已完成的番茄数（取整到 4） */
const roundPomodoros = stats.todayPomodoros % 4;
const dots = Array.from({ length: 4 }, (_, i) => (i < roundPomodoros ? '●' : '○')).join('');
/** 每日目标进度百分比 */
const goalPct = dailyGoal > 0 ? Math.min(100, Math.round((stats.todayPomodoros / dailyGoal) * 100)) : 0;
---

<BaseLayout title="沉浸学习" description="番茄工作法 · 沉浸学习模式 —— My Blog Study">
  <section data-authed={isAuthed ? '1' : '0'}>
    <main class="mx-auto w-full max-w-6xl px-4 py-10">
      {/* Hero：居中，标题 + 今日概览 */}
      <div data-hero class="text-center">
        <p class="font-pixel text-[0.6rem] uppercase tracking-[0.2em] text-primary">STUDY · 番茄工作法</p>
        <h1 class="mt-1 font-display text-3xl font-semibold tracking-tight">沉浸学习</h1>
        <p class="mt-1 text-sm text-muted-foreground">
          今日已专注 <span class="font-medium text-primary">{stats.todayMinutes}</span> 分钟 ·
          <span class="font-medium text-primary">{stats.todayPomodoros}</span> 个番茄 ·
          连续 <span class="font-medium text-primary">{stats.streakDays}</span> 天
        </p>
      </div>
      <div class="pixel-divider mt-5" />

      <div class="mt-6 grid gap-6 lg:grid-cols-[340px_1fr]">
        {/* 左侧：番茄钟 + 打断 */}
        <div class="flex flex-col gap-6">
          {/* 番茄钟主卡 */}
          <div class="hairline p-5">
            <div class="flex items-center justify-between">
              <p class="pixel-chip text-muted-foreground">番茄钟 / POMODORO</p>
              <button
                id="study-settings-btn"
                type="button"
                title="设置时长"
                aria-label="设置时长"
                class="rounded-md border border-border px-2 py-1 text-xs text-muted-foreground transition-colors hover:border-primary/50 hover:text-primary"
              >
                ⚙ 设置
              </button>
            </div>

            {/* 模式切换 */}
            <div class="mt-3 flex gap-1 rounded-lg border border-border p-1 text-xs" role="tablist" aria-label="计时模式">
              <button type="button" data-mode-tab="focus" class="flex-1 rounded-md px-2 py-1.5 transition-colors">🍅 专注</button>
              <button type="button" data-mode-tab="short" class="flex-1 rounded-md px-2 py-1.5 text-muted-foreground transition-colors">☕ 短休</button>
              <button type="button" data-mode-tab="long" class="flex-1 rounded-md px-2 py-1.5 text-muted-foreground transition-colors">🌙 长休</button>
            </div>

            {/* 圆环倒计时 */}
            <div class="relative mx-auto mt-5 size-52">
              <svg viewBox="0 0 120 120" class="size-full -rotate-90" aria-hidden="true">
                <circle cx="60" cy="60" r="52" fill="none" stroke="var(--color-muted)" stroke-width="7" opacity="0.35" />
                <circle
                  id="study-ring"
                  cx="60"
                  cy="60"
                  r="52"
                  fill="none"
                  stroke="var(--color-primary)"
                  stroke-width="7"
                  stroke-linecap="round"
                  stroke-dasharray="326.7"
                  stroke-dashoffset="0"
                />
              </svg>
              <div class="absolute inset-0 flex flex-col items-center justify-center">
                <p id="study-time" class="font-display text-5xl font-semibold tabular-nums tracking-tight">25:00</p>
                <p id="study-mode-label" class="mt-1 text-xs text-muted-foreground">专注中</p>
              </div>
            </div>

            {/* 番茄进度点 */}
            <p id="study-dots" class="mt-4 text-center text-lg tracking-[0.4em] text-primary" title="本轮番茄进度">
              {dots}
            </p>

            {/* 控制按钮 */}
            <div class="mt-4 flex items-center justify-center gap-2">
              <button
                id="study-start"
                type="button"
                class="rounded-md bg-primary px-6 py-2 text-sm text-primary-foreground transition-opacity hover:opacity-90"
              >
                开始
              </button>
              <button
                id="study-pause"
                type="button"
                disabled
                class="rounded-md border border-border px-4 py-2 text-sm text-muted-foreground transition-colors hover:border-primary/50 hover:text-primary disabled:cursor-not-allowed disabled:opacity-40"
              >
                暂停
              </button>
              <button
                id="study-reset"
                type="button"
                class="rounded-md border border-border px-4 py-2 text-sm text-muted-foreground transition-colors hover:border-primary/50 hover:text-primary"
              >
                重置
              </button>
              <button
                id="study-abandon"
                type="button"
                class="rounded-md border border-border px-4 py-2 text-sm text-muted-foreground transition-colors hover:border-destructive/50 hover:text-destructive"
                title="放弃当前番茄（作废，不计入统计）"
              >
                放弃
              </button>
            </div>

            {/* 当前任务（登录） */}
            <div class="mt-4">
              <label class="block text-xs font-medium text-muted-foreground">
                当前任务
                <select
                  id="study-task"
                  class="mt-1 w-full rounded-md border border-input bg-background px-2 py-1.5 text-sm outline-none focus-visible:border-ring"
                >
                  <option value="">无任务</option>
                  {tasks.map((t) => (
                    <option value={t.id}>{esc(t.title)}</option>
                  ))}
                </select>
              </label>
              {!isAuthed && (
                <p class="mt-1 text-[0.6rem] text-muted-foreground">登录后记录番茄、选择任务并保存学习数据。</p>
              )}
            </div>
          </div>

          {/* 打断记录（登录） */}
          {isAuthed && (
            <div class="hairline p-5">
              <p class="pixel-chip mb-3 text-muted-foreground">打断记录 / DISTRACTIONS</p>
              <div class="flex gap-2">
                <input
                  id="distraction-note"
                  type="text"
                  maxlength="300"
                  placeholder="刚才分心去做了什么？"
                  class="min-w-0 flex-1 rounded-md border border-input bg-background px-3 py-1.5 text-sm outline-none transition-colors focus-visible:border-ring"
                />
                <button
                  id="distraction-internal"
                  type="button"
                  class="shrink-0 rounded-md border border-border px-3 py-1.5 text-xs text-muted-foreground transition-colors hover:border-primary/50 hover:text-primary"
                  title="内部打断：走神、突然想起的事"
                >
                  内部
                </button>
                <button
                  id="distraction-external"
                  type="button"
                  class="shrink-0 rounded-md border border-border px-3 py-1.5 text-xs text-muted-foreground transition-colors hover:border-primary/50 hover:text-primary"
                  title="外部打断：他人、环境干扰"
                >
                  外部
                </button>
              </div>
              <ul id="distraction-list" class="mt-3 space-y-1.5 text-xs"></ul>
            </div>
          )}
        </div>

        {/* 右侧：打卡 + 任务计划 + 统计 */}
        <div class="flex flex-col gap-6">
          {/* 打卡系统（登录） */}
          {isAuthed && (
            <div class="hairline p-5">
              <div class="flex items-center justify-between">
                <p class="pixel-chip text-muted-foreground">打卡 / CHECK-IN</p>
                <button
                  id="checkin-add"
                  type="button"
                  class="rounded-full border border-dashed border-border px-3 py-1 text-xs text-muted-foreground transition-colors hover:border-primary/50 hover:text-primary"
                >
                  ＋ 添加打卡任务
                </button>
              </div>
              {checkins.length === 0 ? (
                <p class="mt-3 text-xs text-muted-foreground">还没有打卡任务 —— 添加一个开始坚持吧。</p>
              ) : (
                <ul id="checkin-list" class="mt-3 space-y-1.5 text-sm"></ul>
              )}
            </div>
          )}

          {/* 任务计划（登录） */}
          {isAuthed && (
            <div class="hairline p-5">
              <div class="flex items-center justify-between">
                <p class="pixel-chip text-muted-foreground">学习计划 / PLAN</p>
                <div class="flex items-center gap-2 text-xs text-muted-foreground">
                  <span>每日目标</span>
                  <input
                    id="goal-input"
                    type="number"
                    min="0"
                    max="99"
                    value={dailyGoal}
                    class="w-14 rounded-md border border-input bg-background px-1.5 py-0.5 text-center text-sm outline-none focus-visible:border-ring"
                  />
                  <span>个番茄</span>
                </div>
              </div>

              {/* 每日目标进度条 */}
              <div class="mt-3">
                <div class="h-2 w-full overflow-hidden rounded-full bg-muted">
                  <div
                    id="goal-bar"
                    class="h-full rounded-full bg-primary transition-all duration-500"
                    style={`width: ${goalPct}%`}
                  />
                </div>
                <p class="mt-1 text-[0.6rem] text-muted-foreground">
                  今日 {stats.todayPomodoros} / {dailyGoal || '∞'} 个番茄
                </p>
              </div>

              <div class="mt-3 flex gap-2">
                <input
                  id="task-title"
                  type="text"
                  maxlength="200"
                  placeholder="添加学习任务…"
                  class="min-w-0 flex-1 rounded-md border border-input bg-background px-3 py-1.5 text-sm outline-none transition-colors focus-visible:border-ring"
                />
                <input
                  id="task-est"
                  type="number"
                  min="1"
                  max="99"
                  value="1"
                  title="预估番茄数"
                  class="w-14 rounded-md border border-input bg-background px-1.5 py-1.5 text-center text-sm outline-none focus-visible:border-ring"
                />
                <button
                  id="task-add"
                  type="button"
                  class="shrink-0 rounded-md bg-primary px-3 py-1.5 text-xs text-primary-foreground transition-opacity hover:opacity-90"
                >
                  ＋ 添加
                </button>
              </div>
              <ul id="task-list" class="mt-3 space-y-1.5 text-xs"></ul>
            </div>
          )}

          {/* 统计区（公开） */}
          <div class="hairline p-5">
            <p class="pixel-chip text-muted-foreground">学习统计 / STATS</p>
            <div class="mt-3 flex flex-wrap items-baseline gap-x-8 gap-y-2">
              <div class="flex items-baseline gap-2">
                <span class="font-pixel text-[0.6rem] uppercase tracking-[0.15em] text-muted-foreground">Today</span>
                <span class="font-display text-3xl font-semibold leading-none text-primary">{stats.todayMinutes}</span>
                <span class="text-xs text-muted-foreground">分钟</span>
              </div>
              <div class="flex items-baseline gap-2">
                <span class="font-pixel text-[0.6rem] uppercase tracking-[0.15em] text-muted-foreground">Pomodoros</span>
                <span class="font-display text-3xl font-semibold leading-none text-primary">{stats.totalPomodoros}</span>
                <span class="text-xs text-muted-foreground">累计</span>
              </div>
              <div class="flex items-baseline gap-2">
                <span class="font-pixel text-[0.6rem] uppercase tracking-[0.15em] text-muted-foreground">Hours</span>
                <span class="font-display text-3xl font-semibold leading-none text-primary">{stats.totalHours}</span>
                <span class="text-xs text-muted-foreground">小时</span>
              </div>
              <div class="flex items-baseline gap-2">
                <span class="font-pixel text-[0.6rem] uppercase tracking-[0.15em] text-muted-foreground">Streak</span>
                <span class="font-display text-3xl font-semibold leading-none text-primary">{stats.streakDays}</span>
                <span class="text-xs text-muted-foreground">天</span>
              </div>
            </div>

            {/* 近 7 天柱状图 */}
            <div class="mt-5">
              <p class="pixel-chip mb-2 text-[0.55rem] text-muted-foreground">近 7 天 / WEEKLY</p>
              <div class="flex h-20 items-end gap-2">
                {barDays.map((d) => (
                  <div class="flex flex-1 flex-col items-center gap-1">
                    <span class="text-[0.55rem] text-muted-foreground">{d.minutes > 0 ? d.minutes : ''}</span>
                    <div
                      class="w-full rounded-sm bg-primary/80"
                      style={`height: ${d.h.toFixed(1)}px`}
                      title={`${d.date}：${d.minutes} 分钟`}
                    />
                    <span class="text-[0.55rem] text-muted-foreground">{d.label}</span>
                  </div>
                ))}
              </div>
            </div>

            {/* 热力图 */}
            <div class="mt-5">
              <div class="mb-1 flex h-3">
                {monthLabels.map((label) => (
                  <span class="w-[11px] shrink-0 text-[0.5rem] leading-none text-muted-foreground">{label}</span>
                ))}
              </div>
              <div class="overflow-x-auto">
                <div class="flex w-max gap-[2px]">
                  {stats.heatmap.weeks.map((week) => (
                    <div class="flex flex-col gap-[2px]">
                      {week.map((day) => (
                        <div
                          class={`heat-cell heat-${level(day.count)}`}
                          title={day.count > 0 ? `${day.date}：专注 ${day.count} 分钟` : day.date}
                        />
                      ))}
                    </div>
                  ))}
                </div>
              </div>
              <div class="mt-3 flex items-center gap-1.5 text-[0.6rem] text-muted-foreground">
                <span class="mr-1">图例</span>
                <span class="heat-cell heat-0" /><span>0</span>
                <span class="heat-cell heat-1" /><span>1-14m</span>
                <span class="heat-cell heat-2" /><span>15-29m</span>
                <span class="heat-cell heat-3" /><span>30-59m</span>
                <span class="heat-cell heat-4" /><span>60m+</span>
              </div>
            </div>

            {/* 月度折线 */}
            <div class="mt-5">
              <p class="pixel-chip mb-2 text-[0.55rem] text-muted-foreground">月度专注 / MONTHLY</p>
              <svg viewBox={`0 0 ${CHART_W} ${CHART_H}`} class="w-full" role="img" aria-label="月度专注分钟数折线图">
                <path class="line-area" d={areaPath} fill="var(--color-primary)" opacity="0.14" />
                <path
                  class="line-stroke"
                  d={linePath}
                  fill="none"
                  stroke="var(--color-primary)"
                  stroke-width="2"
                  stroke-linejoin="round"
                  stroke-linecap="round"
                />
                {points.map((p) => (
                  <circle cx={p.x} cy={p.y} r="3" fill="var(--color-primary)" />
                ))}
              </svg>
              <div class="mt-1 flex justify-between text-[0.55rem] text-muted-foreground">
                <span>{firstMonth}</span>
                <span>{lastMonth}</span>
              </div>
            </div>
          </div>
        </div>
      </div>

      {/* 番茄法原理 */}
      <div class="mt-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
        <div class="hairline p-4">
          <p class="text-lg">🍅</p>
          <p class="mt-1 text-sm font-medium">25 / 5 循环</p>
          <p class="mt-1 text-xs text-muted-foreground">专注 25 分钟 + 休息 5 分钟为一个番茄；每完成 4 个进入 15 分钟长休息。</p>
        </div>
        <div class="hairline p-4">
          <p class="text-lg">🎯</p>
          <p class="mt-1 text-sm font-medium">一次一事</p>
          <p class="mt-1 text-xs text-muted-foreground">每个番茄只专注一个任务，开始前选定当前任务，避免多任务切换损耗。</p>
        </div>
        <div class="hairline p-4">
          <p class="text-lg">📝</p>
          <p class="mt-1 text-sm font-medium">打断先记下</p>
          <p class="mt-1 text-xs text-muted-foreground">走神或被打扰时先记录原因，稍后处理，番茄不可分割——被打断则作废重来。</p>
        </div>
        <div class="hairline p-4">
          <p class="text-lg">📈</p>
          <p class="mt-1 text-sm font-medium">预估与复盘</p>
          <p class="mt-1 text-xs text-muted-foreground">任务前预估番茄数，完成后对比实际，逐步提升对时间的掌控力。</p>
        </div>
      </div>
    </main>
  </section>

  {/* 数据注入（脚本读取） */}
  <div
    id="study-data"
    data-authed={isAuthed ? '1' : '0'}
    data-tasks={tasksJson}
    data-distractions={distractionsJson}
    data-checkins={checkinsJson}
    class="hidden"
    aria-hidden="true"
  />

  {/* 设置弹框 */}
  <dialog id="study-settings-dialog" class="m-auto w-80 rounded-lg border border-border bg-card p-4 shadow-xl backdrop:bg-black/40">
    <h3 class="font-medium">番茄钟设置</h3>
    <div class="mt-3 space-y-2">
      <label class="block text-xs font-medium text-muted-foreground">
        专注时长（分钟）
        <input id="cfg-focus" type="number" min="1" max="120" class="mt-1 w-full rounded-md border border-input bg-background px-3 py-1.5 text-sm outline-none focus-visible:border-ring" />
      </label>
      <label class="block text-xs font-medium text-muted-foreground">
        短休息（分钟）
        <input id="cfg-short" type="number" min="1" max="60" class="mt-1 w-full rounded-md border border-input bg-background px-3 py-1.5 text-sm outline-none focus-visible:border-ring" />
      </label>
      <label class="block text-xs font-medium text-muted-foreground">
        长休息（分钟）
        <input id="cfg-long" type="number" min="1" max="120" class="mt-1 w-full rounded-md border border-input bg-background px-3 py-1.5 text-sm outline-none focus-visible:border-ring" />
      </label>
      <label class="block text-xs font-medium text-muted-foreground">
        长休息间隔（每几个番茄）
        <input id="cfg-every" type="number" min="2" max="12" class="mt-1 w-full rounded-md border border-input bg-background px-3 py-1.5 text-sm outline-none focus-visible:border-ring" />
      </label>
    </div>
    <div class="mt-3 flex items-center justify-end gap-2">
      <button id="cfg-cancel" type="button" class="rounded-md px-2 py-1 text-xs text-muted-foreground hover:text-foreground">取消</button>
      <button id="cfg-save" type="button" class="rounded-md bg-primary px-3 py-1 text-xs text-primary-foreground transition-opacity hover:opacity-90">保存</button>
    </div>
  </dialog>

  <!-- 添加/编辑打卡任务弹框（登录） -->
  <dialog id="checkin-task-dialog" class="m-auto w-80 rounded-lg border border-border bg-card p-4 shadow-xl backdrop:bg-black/40">
    <h3 id="checkin-task-dialog-title" class="font-medium">添加打卡任务</h3>
    <label class="mt-3 block text-xs font-medium text-muted-foreground">
      任务名
      <input id="checkin-name" type="text" maxlength="50" placeholder="如 背单词、跑步、早起" class="mt-1 w-full rounded-md border border-input bg-background px-3 py-1.5 text-sm outline-none focus-visible:border-ring" />
    </label>
    <label class="mt-2 block text-xs font-medium text-muted-foreground">
      图标（可选，填一个 emoji）
      <input id="checkin-icon" type="text" maxlength="20" placeholder="如 📖" class="mt-1 w-full rounded-md border border-input bg-background px-3 py-1.5 text-sm outline-none focus-visible:border-ring" />
    </label>
    <label class="mt-2 block text-xs font-medium text-muted-foreground">
      最大可补签天数（0 = 不可补签）
      <input id="checkin-makeup" type="number" min="0" max="30" value="1" class="mt-1 w-full rounded-md border border-input bg-background px-3 py-1.5 text-sm outline-none focus-visible:border-ring" />
    </label>
    <p id="checkin-task-status" class="mt-2 hidden text-xs text-destructive" role="alert"></p>
    <div class="mt-3 flex items-center justify-end gap-2">
      <button id="checkin-task-cancel" type="button" class="rounded-md px-2 py-1 text-xs text-muted-foreground hover:text-foreground">取消</button>
      <button id="checkin-task-confirm" type="button" class="rounded-md bg-primary px-3 py-1 text-xs text-primary-foreground transition-opacity hover:opacity-90">保存</button>
    </div>
  </dialog>

  <!-- 补签弹框（登录） -->
  <dialog id="checkin-makeup-dialog" class="m-auto w-80 rounded-lg border border-border bg-card p-4 shadow-xl backdrop:bg-black/40">
    <h3 id="checkin-makeup-task" class="font-medium">补签</h3>
    <div id="checkin-makeup-days" class="mt-3 flex flex-wrap gap-1.5"></div>
    <div class="mt-3 flex items-center justify-end gap-2">
      <button id="checkin-makeup-cancel" type="button" class="rounded-md px-2 py-1 text-xs text-muted-foreground hover:text-foreground">取消</button>
    </div>
  </dialog>

  {/* 专注遮罩（可选开启） */}
  <div id="study-focus-mask" class="pointer-events-none fixed inset-0 z-50 hidden items-center justify-center bg-background/85 backdrop-blur-sm">
    <div class="text-center">
      <p class="font-pixel text-[0.6rem] uppercase tracking-[0.2em] text-primary">FOCUS</p>
      <p id="mask-time" class="mt-2 font-display text-7xl font-semibold tabular-nums tracking-tight">25:00</p>
      <p id="mask-label" class="mt-2 text-sm text-muted-foreground"></p>
    </div>
  </div>
</BaseLayout>

<script>
  /** 沉浸学习页：番茄钟（全局状态，跨页面后台运行）+ 任务/打断 CRUD + 目标 + 遮罩
   *  注意：View Transition 会替换 DOM 但模块脚本可能不重新执行，
   *  因此所有交互一律用 document 委托 + 实时查询 DOM（不缓存元素引用）。 */
  import {
    durationSecFor,
    freshTimerState,
    readTimerState,
    remainingSec,
    writeTimerState,
  } from '@/lib/study-timer-global';
  import { confirmDialog, confirmDanger } from '@/lib/confirm';

  type Mode = 'focus' | 'short' | 'long';
  let state = readTimerState() ?? freshTimerState();
  let remaining = remainingSec(state);
  let maskOn = false;

  const MODE_TEXT: Record<Mode, string> = { focus: '专注中', short: '短休息', long: '长休息' };
  const RING_C = 2 * Math.PI * 52; // ≈326.7

  function persist(): void {
    writeTimerState(state);
  }

  /** 实时查询当前 DOM 元素（View Transition 后元素被替换，必须每次重新取） */
  function el<T extends Element = HTMLElement>(id: string): T | null {
    return document.getElementById(id) as T | null;
  }

  function render(): void {
    const total = durationSecFor(state.mode, state.cfg);
    const mm = String(Math.floor(remaining / 60)).padStart(2, '0');
    const ss = String(remaining % 60).padStart(2, '0');
    const timeEl = el('study-time');
    const maskTime = el('mask-time');
    const ringEl = el<SVGCircleElement>('study-ring');
    const modeLabel = el('study-mode-label');
    const maskLabel = el('mask-label');
    const dotsEl = el('study-dots');
    const startBtn = el<HTMLButtonElement>('study-start');
    const pauseBtn = el<HTMLButtonElement>('study-pause');
    if (timeEl) timeEl.textContent = `${mm}:${ss}`;
    if (maskTime) maskTime.textContent = `${mm}:${ss}`;
    if (ringEl) ringEl.style.strokeDashoffset = String(RING_C * (1 - remaining / total));
    if (modeLabel) modeLabel.textContent = MODE_TEXT[state.mode];
    if (maskLabel) maskLabel.textContent = MODE_TEXT[state.mode];
    // 番茄进度点
    const filled = state.roundCount % state.cfg.every;
    if (dotsEl) {
      dotsEl.textContent = Array.from({ length: state.cfg.every }, (_, i) => (i < filled ? '●' : '○')).join('');
    }
    document.title = `${mm}:${ss} · ${MODE_TEXT[state.mode]} — My Blog`;
    // 模式 tab 高亮（实时查询）
    document.querySelectorAll<HTMLButtonElement>('[data-mode-tab]').forEach((t) => {
      const active = t.dataset.modeTab === state.mode;
      t.classList.toggle('bg-primary/10', active);
      t.classList.toggle('text-primary', active);
      t.classList.toggle('text-muted-foreground', !active);
    });
    // 按钮态
    if (startBtn) {
      startBtn.textContent = state.running ? '进行中' : remaining > 0 && remaining < durationSecFor(state.mode, state.cfg) ? '继续' : '开始';
    }
    if (pauseBtn) { pauseBtn.disabled = !state.running; pauseBtn.textContent = '暂停'; }
    // 遮罩
    const mask = el('study-focus-mask');
    if (mask) mask.classList.toggle('flex', maskOn);
  }

  /** 本地 UI 刷新：基于全局状态重算剩余（完成由全局 tick 统一处理） */
  function uiTick(): void {
    if (!state.running) return;
    const s = readTimerState();
    if (s) {
      state = s;
      remaining = remainingSec(state);
    } else {
      remaining = remainingSec(state);
    }
    if (remaining <= 0) return; // 全局 tick 会推进并广播
    render();
  }

  /** 从 localStorage 重新同步并渲染（开始/暂停/全局变更后） */
  function sync(): void {
    const s = readTimerState();
    if (s) state = s;
    remaining = remainingSec(state);
    render();
  }

  function start(): void {
    if (state.running) return;
    state.pausedRemaining = remaining;
    state.running = true;
    state.endTime = Date.now() + remaining * 1000;
    persist();
    remaining = remainingSec(state);
    render();
  }

  function pause(): void {
    if (!state.running) return;
    state.running = false;
    state.pausedRemaining = Math.max(0, Math.ceil((state.endTime - Date.now()) / 1000));
    state.endTime = 0;
    remaining = state.pausedRemaining;
    persist();
    render();
  }

  function reset(): void {
    state = freshTimerState(state.cfg);
    remaining = durationSecFor('focus', state.cfg);
    persist();
    render();
  }

  /* ================= 事件（全部 document 委托，View Transition 后依然有效） ================= */

  // 番茄钟控制
  document.addEventListener('click', async (e) => {
    const target = e.target as HTMLElement;

    if (target.closest('[data-mode-tab]')) {
      const tab = target.closest<HTMLElement>('[data-mode-tab]')!;
      if (state.running && !(await confirmDialog('切换模式将重置计时，确定？'))) return;
      state = freshTimerState(state.cfg);
      state.mode = (tab.dataset.modeTab ?? 'focus') as Mode;
      state.pausedRemaining = durationSecFor(state.mode, state.cfg);
      remaining = state.pausedRemaining;
      persist();
      render();
      return;
    }
    if (target.closest('#study-start')) {
      if (!state.running) start();
      if ('Notification' in window && Notification.permission === 'default') {
        void Notification.requestPermission();
      }
      return;
    }
    if (target.closest('#study-pause')) {
      if (state.running) pause();
      return;
    }
    if (target.closest('#study-reset')) {
      reset();
      return;
    }
    if (target.closest('#study-abandon')) {
      if (!(await confirmDialog('放弃当前番茄？该番茄作废，不计入统计。'))) return;
      reset();
      return;
    }
    if (target.closest('#study-settings-btn')) {
      const dlg = el<HTMLDialogElement>('study-settings-dialog');
      if (!dlg) return;
      const f = el<HTMLInputElement>('cfg-focus');
      const s = el<HTMLInputElement>('cfg-short');
      const l = el<HTMLInputElement>('cfg-long');
      const ev = el<HTMLInputElement>('cfg-every');
      if (f) f.value = String(state.cfg.focus);
      if (s) s.value = String(state.cfg.short);
      if (l) l.value = String(state.cfg.long);
      if (ev) ev.value = String(state.cfg.every);
      dlg.showModal();
      return;
    }
    if (target.closest('#cfg-cancel')) {
      el<HTMLDialogElement>('study-settings-dialog')?.close();
      return;
    }
    if (target.closest('#cfg-save')) {
      const f = Number(el<HTMLInputElement>('cfg-focus')?.value);
      const s = Number(el<HTMLInputElement>('cfg-short')?.value);
      const l = Number(el<HTMLInputElement>('cfg-long')?.value);
      const ev = Number(el<HTMLInputElement>('cfg-every')?.value);
      if (![f, s, l, ev].every((n) => Number.isFinite(n) && n > 0)) return;
      state.cfg = { focus: f, short: s, long: l, every: ev };
      if (!state.running) {
        remaining = durationSecFor(state.mode, state.cfg);
        state.pausedRemaining = remaining;
      }
      persist();
      el<HTMLDialogElement>('study-settings-dialog')?.close();
      render();
      return;
    }
    // 专注遮罩开关按钮（F6 快捷键 + 浮标不做，仅键盘）
    if (target.closest('#study-mask-toggle')) {
      maskOn = !maskOn;
      render();
    }
  });

  // 当前任务选择变化 → 记录到状态（change 委托）
  document.addEventListener('change', (e) => {
    const sel = (e.target as HTMLElement).closest<HTMLSelectElement>('#study-task');
    if (sel) {
      state.taskId = sel.value || null;
      persist();
    }
  });

  // F6 专注遮罩
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'F6') return;
    maskOn = !maskOn;
    render();
  });

  // 全局状态变化（其他页面发起/完成）→ 同步 UI
  window.addEventListener('study-timer-change', () => sync());
  // 番茄完成（全局 tick 推进模式后）→ 重载页面刷新统计
  window.addEventListener('study-timer-done', () => {
    window.setTimeout(() => window.location.reload(), 800);
  });

  /* ================= 任务 CRUD（登录，document 委托） ================= */
  if (document.querySelector('[data-authed]')?.getAttribute('data-authed') === '1') {
    function escHtml(s: string): string {
      return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
    }

    interface TaskView { id: string; title: string; estPomodoros: number; done: boolean; pomodoroCount: number }

    function renderTasks(tasks: TaskView[]): void {
      const taskList = el('task-list');
      if (!taskList) return;
      if (tasks.length === 0) {
        taskList.innerHTML = '<li class="text-muted-foreground">还没有任务，添加一个开始吧。</li>';
        return;
      }
      taskList.innerHTML = tasks
        .map(
          (t) =>
            `<li class="flex items-center gap-2 rounded-md border border-border px-2.5 py-1.5 ${t.done ? 'opacity-50' : ''}">` +
            `<button type="button" data-task-toggle="${t.id}" title="标记完成" aria-label="标记完成" ` +
            `class="shrink-0 text-sm ${t.done ? 'text-primary' : 'text-muted-foreground'}">${t.done ? '☑' : '☐'}</button>` +
            `<span class="min-w-0 flex-1 truncate ${t.done ? 'line-through' : ''}">${escHtml(t.title)}</span>` +
            `<span class="shrink-0 font-pixel text-[0.55rem] text-muted-foreground">${t.pomodoroCount}/${t.estPomodoros}🍅</span>` +
            `<button type="button" data-task-del="${t.id}" title="删除" aria-label="删除" ` +
            `class="shrink-0 text-muted-foreground transition-colors hover:text-destructive">×</button>` +
            `</li>`,
        )
        .join('');
    }

    async function loadTasks(): Promise<void> {
      try {
        const res = await fetch('/api/study/tasks');
        const d = (await res.json()) as { tasks?: TaskView[] };
        renderTasks(d.tasks ?? []);
      } catch { /* 忽略 */ }
    }

    async function loadDistractions(): Promise<void> {
      try {
        const res = await fetch('/api/study/distractions');
        const d = (await res.json()) as { distractions?: Array<{ id: string; type: string; note: string }> };
        renderDistractions(d.distractions ?? []);
      } catch { /* 忽略 */ }
    }

    function renderDistractions(items: Array<{ id: string; type: string; note: string }>): void {
      const distList = el('distraction-list');
      if (!distList) return;
      const labels: Record<string, string> = { internal: '内部', external: '外部' };
      if (items.length === 0) {
        distList.innerHTML = '<li class="text-muted-foreground">今天还没有打断记录。</li>';
        return;
      }
      distList.innerHTML = items
        .map(
          (d) =>
            `<li class="flex items-center gap-2 rounded-md border border-border px-2.5 py-1.5">` +
            `<span class="shrink-0 rounded-full border border-border px-1.5 py-0.5 text-[0.55rem] ${d.type === 'internal' ? 'text-primary' : 'text-destructive'}">${labels[d.type] ?? d.type}</span>` +
            `<span class="min-w-0 flex-1 truncate">${escHtml(d.note || '（无备注）')}</span>` +
            `<button type="button" data-dist-del="${d.id}" title="删除" aria-label="删除" class="shrink-0 text-muted-foreground transition-colors hover:text-destructive">×</button>` +
            `</li>`,
        )
        .join('');
    }

    // 任务/打断交互（委托）
    document.addEventListener('click', async (e) => {
      const target = e.target as HTMLElement;

      const toggle = target.closest<HTMLElement>('[data-task-toggle]');
      if (toggle) {
        const id = toggle.dataset.taskToggle;
        try {
          await fetch(`/api/study/tasks/${id}`, {
            method: 'PATCH',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify({ done: toggle.textContent?.trim() === '☐' }),
          });
          void loadTasks();
        } catch { /* 忽略 */ }
        return;
      }
      const taskDel = target.closest<HTMLElement>('[data-task-del]');
      if (taskDel) {
        if (!(await confirmDanger('删除该任务？'))) return;
        try {
          await fetch(`/api/study/tasks/${taskDel.dataset.taskDel}`, { method: 'DELETE' });
          void loadTasks();
        } catch { /* 忽略 */ }
        return;
      }
      const distDel = target.closest<HTMLElement>('[data-dist-del]');
      if (distDel) {
        try {
          await fetch(`/api/study/distractions/${distDel.dataset.distDel}`, { method: 'DELETE' });
          void loadDistractions();
        } catch { /* 忽略 */ }
        return;
      }
      const taskAdd = target.closest('#task-add');
      if (taskAdd) {
        const title = (el<HTMLInputElement>('task-title')?.value ?? '').trim();
        if (!title) return;
        const est = Math.max(1, Number(el<HTMLInputElement>('task-est')?.value) || 1);
        try {
          const res = await fetch('/api/study/tasks', {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify({ title, estPomodoros: est }),
          });
          if (res.ok) {
            const inp = el<HTMLInputElement>('task-title');
            if (inp) inp.value = '';
            void loadTasks();
          }
        } catch { /* 忽略 */ }
        return;
      }
      const distInt = target.closest('#distraction-internal');
      if (distInt) {
        void addDistraction('internal');
        return;
      }
      const distExt = target.closest('#distraction-external');
      if (distExt) {
        void addDistraction('external');
      }
    });

    async function addDistraction(type: 'internal' | 'external'): Promise<void> {
      const note = (el<HTMLInputElement>('distraction-note')?.value ?? '').trim();
      try {
        const res = await fetch('/api/study/distractions', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ type, note }),
        });
        if (res.ok) {
          const inp = el<HTMLInputElement>('distraction-note');
          if (inp) inp.value = '';
          void loadDistractions();
        }
      } catch { /* 忽略 */ }
    }

    // 任务标题回车添加
    document.addEventListener('keydown', (e) => {
      const t = e.target as HTMLElement;
      if (t.id === 'task-title' && e.key === 'Enter') {
        const btn = el<HTMLButtonElement>('task-add');
        btn?.click();
      }
    });

    // 每日目标
    document.addEventListener('change', async (e) => {
      const goal = (e.target as HTMLElement).closest<HTMLInputElement>('#goal-input');
      if (!goal) return;
      const v = Math.max(0, Math.min(99, Number(goal.value) || 0));
      goal.value = String(v);
      try {
        await fetch('/api/study/goal', {
          method: 'PUT',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ value: v }),
        });
      } catch { /* 忽略 */ }
      window.location.reload();
    });

    // 首次 + View Transition 后加载任务/打断（幂等：页面存在才加载）
    function loadPrivateData(): void {
      if (el('task-list')) void loadTasks();
      if (el('distraction-list')) void loadDistractions();
    }
    loadPrivateData();
    document.addEventListener('astro:page-load', loadPrivateData);
  }

  /* ================= 启动 ================= */
  // 每秒 UI 刷新（幂等；无论脚本是否重跑，interval 只建一次）
  if (!(window as unknown as { __studyUiBound?: boolean }).__studyUiBound) {
    (window as unknown as { __studyUiBound?: boolean }).__studyUiBound = true;
    window.setInterval(uiTick, 500);
  }

  function initPage(): void {
    sync();
  }
  initPage();
  // View Transition 后重新渲染（DOM 已替换）
  document.addEventListener('astro:page-load', () => initPage());

  /* ================= 打卡系统（登录，document 委托 + 实时查询 DOM） ================= */
  const IS_AUTHED = document.querySelector('[data-authed]')?.getAttribute('data-authed') === '1';
  if (IS_AUTHED) {
    // 打卡渲染（每次加载/刷新后重建列表）
    const CHECKINS = JSON.parse(
      document.getElementById('study-data')?.getAttribute('data-checkins') ?? '[]',
    ) as Array<{ id: string; name: string; icon: string | null; maxMakeupDays: number; todayChecked: boolean; streakDays: number; totalCount: number; recordDates: string[] }>;

    function escHtml(s: string): string {
      return String(s).replace(/[&<>"']/g, (c) => {
        const map: Record<string, string> = { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' };
        return map[c] ?? c;
      });
    }

    /** 本地时区 YYYY-MM-DD */
    function todayKey(): string {
      const d = new Date();
      const m = String(d.getMonth() + 1).padStart(2, '0');
      const day = String(d.getDate()).padStart(2, '0');
      return `${d.getFullYear()}-${m}-${day}`;
    }

    /** 热力图（近 12 周，复用 heat-cell 档位：0=无 1=已打） */
    function heatmapHtml(dates: string[]): string {
      const set = new Set(dates);
      const end = new Date();
      const start = new Date(end.getFullYear(), end.getMonth() - 2, 1);
      const gridStart = new Date(start);
      gridStart.setDate(gridStart.getDate() - gridStart.getDay());
      const mk = (d: Date): string => {
        const m = String(d.getMonth() + 1).padStart(2, '0');
        const day = String(d.getDate()).padStart(2, '0');
        return `${d.getFullYear()}-${m}-${day}`;
      };
      let weeks = '';
      const cursor = new Date(gridStart);
      while (cursor.getTime() <= end.getTime()) {
        let week = '';
        for (let i = 0; i < 7; i += 1) {
          const d = new Date(cursor);
          d.setDate(d.getDate() + i);
          const k = mk(d);
          week += `<span class="heat-cell ${set.has(k) ? 'heat-4' : 'heat-0'}" title="${k}${set.has(k) ? '：已打卡' : ''}"></span>`;
        }
        weeks += `<div class="flex flex-col gap-[2px]">${week}</div>`;
        cursor.setDate(cursor.getDate() + 7);
      }
      return `<div class="mt-2 flex gap-[2px] overflow-x-auto">${weeks}</div>`;
    }

    function renderCheckins(): void {
      const list = document.getElementById('checkin-list');
      if (!list) return;
      if (CHECKINS.length === 0) return; // 模板已显示空态提示
      list.innerHTML = CHECKINS.map((t) => {
        const checked = t.todayChecked;
        return (
          `<li class="rounded-md border border-border px-3 py-2">` +
          `<div class="flex items-center gap-2">` +
          `<span class="text-base">${t.icon ?? '✅'}</span>` +
          `<span class="min-w-0 flex-1 truncate">${escHtml(t.name)}</span>` +
          `<span class="shrink-0 text-[0.6rem] text-muted-foreground">🔥${t.streakDays}天 · 共${t.totalCount}次</span>` +
          `<button type="button" data-checkin-toggle="${t.id}" title="${checked ? '取消今天打卡' : '今天打卡'}" aria-label="打卡" ` +
          `class="inline-flex size-6 shrink-0 items-center justify-center rounded-full border text-xs transition-colors ${checked ? 'border-primary bg-primary text-primary-foreground' : 'border-border text-muted-foreground hover:border-primary/50 hover:text-primary'}">${checked ? '✓' : '○'}</button>` +
          `<button type="button" data-checkin-makeup="${t.id}" data-checkin-makeup-max="${t.maxMakeupDays}" title="补签" aria-label="补签" ` +
          `class="shrink-0 text-[0.7rem] text-muted-foreground transition-colors hover:text-primary">↩</button>` +
          `<span class="flex shrink-0 items-center gap-0.5">` +
          `<button type="button" data-checkin-edit="${t.id}" title="编辑" aria-label="编辑" class="text-[0.7rem] text-muted-foreground hover:text-primary">✎</button>` +
          `<button type="button" data-checkin-del="${t.id}" data-checkin-name="${escHtml(t.name)}" title="删除" aria-label="删除" class="text-[0.7rem] text-muted-foreground hover:text-destructive">×</button>` +
          `</span>` +
          `</div>` +
          `<button type="button" data-checkin-heat="${t.id}" title="展开/收起热力图" class="mt-1 text-[0.6rem] text-muted-foreground hover:text-primary">▸ 热力图</button>` +
          `<div data-checkin-heat-panel="${t.id}" class="hidden">${heatmapHtml(t.recordDates)}</div>` +
          `</li>`
        );
      }).join('');
    }

    let editingCheckinId: string | null = null;

    // 打开添加/编辑任务弹框
    document.addEventListener('click', (e) => {
      const t = e.target as HTMLElement;
      const add = t.closest('#checkin-add');
      const edit = t.closest<HTMLElement>('[data-checkin-edit]');
      const dlg = el<HTMLDialogElement>('checkin-task-dialog');
      if (!dlg) return;
      if (add) {
        editingCheckinId = null;
        if (el<HTMLInputElement>('checkin-name')) el<HTMLInputElement>('checkin-name')!.value = '';
        if (el<HTMLInputElement>('checkin-icon')) el<HTMLInputElement>('checkin-icon')!.value = '';
        if (el<HTMLInputElement>('checkin-makeup')) el<HTMLInputElement>('checkin-makeup')!.value = '1';
        el('checkin-task-status')?.classList.add('hidden');
        el<HTMLHeadingElement>('checkin-task-dialog-title')!.textContent = '添加打卡任务';
        dlg.showModal();
        el<HTMLInputElement>('checkin-name')?.focus();
        return;
      }
      if (edit) {
        const id = edit.dataset.checkinEdit;
        const task = CHECKINS.find((x) => x.id === id);
        if (!task) return;
        editingCheckinId = id ?? null;
        if (el<HTMLInputElement>('checkin-name')) el<HTMLInputElement>('checkin-name')!.value = task.name;
        if (el<HTMLInputElement>('checkin-icon')) el<HTMLInputElement>('checkin-icon')!.value = task.icon ?? '';
        if (el<HTMLInputElement>('checkin-makeup')) el<HTMLInputElement>('checkin-makeup')!.value = String(task.maxMakeupDays);
        el('checkin-task-status')?.classList.add('hidden');
        el<HTMLHeadingElement>('checkin-task-dialog-title')!.textContent = '编辑打卡任务';
        dlg.showModal();
        el<HTMLInputElement>('checkin-name')?.focus();
      }
    });
    document.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('#checkin-task-cancel')) el<HTMLDialogElement>('checkin-task-dialog')?.close();
    });
    document.addEventListener('click', async (e) => {
      const t = e.target as HTMLElement;
      if (!t.closest('#checkin-task-confirm')) return;
      const name = (el<HTMLInputElement>('checkin-name')?.value ?? '').trim();
      const icon = (el<HTMLInputElement>('checkin-icon')?.value ?? '').trim() || null;
      const makeup = Math.max(0, Math.floor(Number(el<HTMLInputElement>('checkin-makeup')?.value) || 1));
      if (!name) {
        const st = el('checkin-task-status');
        if (st) { st.textContent = '请填写任务名'; st.classList.remove('hidden'); }
        return;
      }
      const dlg = el<HTMLDialogElement>('checkin-task-dialog');
      try {
        const res = editingCheckinId
          ? await fetch(`/api/study/checkin/tasks/${editingCheckinId}`, {
              method: 'PATCH',
              headers: { 'content-type': 'application/json' },
              body: JSON.stringify({ name, icon, maxMakeupDays: makeup }),
            })
          : await fetch('/api/study/checkin/tasks', {
              method: 'POST',
              headers: { 'content-type': 'application/json' },
              body: JSON.stringify({ name, icon, maxMakeupDays: makeup }),
            });
        const d = (await res.json().catch(() => ({}))) as { error?: string };
        if (!res.ok) {
          const st = el('checkin-task-status');
          if (st) { st.textContent = d.error ?? '保存失败'; st.classList.remove('hidden'); }
          return;
        }
        dlg?.close();
        window.location.reload();
      } catch {
        const st = el('checkin-task-status');
        if (st) { st.textContent = '保存失败'; st.classList.remove('hidden'); }
      }
    });
    // 删除任务
    document.addEventListener('click', async (e) => {
      const del = (e.target as HTMLElement).closest<HTMLElement>('[data-checkin-del]');
      if (!del) return;
      const name = del.dataset.checkinName ?? '';
      if (!(await confirmDanger(`删除打卡任务「${name}」？其打卡记录也会一并删除。`))) return;
      try {
        const res = await fetch(`/api/study/checkin/tasks/${del.dataset.checkinDel}`, { method: 'DELETE' });
        if (res.ok) window.location.reload();
      } catch { /* 忽略 */ }
    });
    // 打卡 toggle（成功本地即时更新，失败给出反馈；不依赖 reload 的 SSR 时区判断）
    document.addEventListener('click', async (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-checkin-toggle]');
      if (!btn) return;
      btn.disabled = true;
      try {
        const res = await fetch('/api/study/checkin/toggle', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ taskId: btn.dataset.checkinToggle, date: todayKey() }),
        });
        const d = (await res.json().catch(() => ({}))) as { checked?: boolean; error?: string };
        if (!res.ok) {
          showCheckinToast(d.error ?? '打卡失败，请重试');
          btn.disabled = false;
          return;
        }
        // 本地即时更新：✓ ↔ ○
        const checked = d.checked ?? btn.textContent !== '✓';
        btn.textContent = checked ? '✓' : '○';
        btn.classList.toggle('border-primary', checked);
        btn.classList.toggle('bg-primary', checked);
        btn.classList.toggle('text-primary-foreground', checked);
        btn.classList.toggle('text-muted-foreground', !checked);
        btn.title = checked ? '取消今天打卡' : '今天打卡';
      } catch {
        showCheckinToast('打卡失败，请重试');
      } finally {
        btn.disabled = false;
      }
    });

    /** 轻提示（底部 toast） */
    function showCheckinToast(msg: string): void {
      const toast = document.createElement('div');
      toast.className = 'fixed bottom-6 left-1/2 z-50 -translate-x-1/2 rounded-full border border-border bg-background px-4 py-2 text-xs shadow-lg';
      toast.textContent = msg;
      document.body.appendChild(toast);
      window.setTimeout(() => toast.remove(), 2200);
    }
    // 补签弹窗：动态创建简单日期选择（近 N 天，含今天）
    let checkinMakeupTaskId: string | null = null;
    document.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLElement>('[data-checkin-makeup]');
      if (!btn) return;
      const taskId = btn.dataset.checkinMakeup;
      const max = Math.max(0, Number(btn.dataset.checkinMakeupMax) || 0);
      checkinMakeupTaskId = taskId ?? null;
      if (!taskId) return;
      const dlg = el<HTMLDialogElement>('checkin-makeup-dialog');
      if (!dlg) return;
      // 渲染近 N 天按钮（含今天）
      const wrap = el('checkin-makeup-days');
      if (!wrap) return;
      const rows: string[] = [];
      for (let i = max; i >= 0; i -= 1) {
        const d = new Date();
        d.setDate(d.getDate() - i);
        const m = String(d.getMonth() + 1).padStart(2, '0');
        const day = String(d.getDate()).padStart(2, '0');
        const k = `${d.getFullYear()}-${m}-${day}`;
        rows.push(
          `<button type="button" data-checkin-makeup-day="${k}" class="rounded-md border border-border px-2 py-1 text-xs text-muted-foreground transition-colors hover:border-primary/50 hover:text-primary">${m}/${day}</button>`,
        );
      }
      wrap.innerHTML = rows.join('');
      el('checkin-makeup-task')!.textContent = '补签日期（可多选）';
      dlg.showModal();
    });
    document.addEventListener('click', (e) => {
      const t = e.target as HTMLElement;
      if (t.closest('#checkin-makeup-cancel')) el<HTMLDialogElement>('checkin-makeup-dialog')?.close();
    });
    document.addEventListener('click', async (e) => {
      const t = e.target as HTMLElement;
      const day = t.closest<HTMLElement>('[data-checkin-makeup-day]');
      if (!day) return;
      if (checkinMakeupTaskId) {
        try {
          const res = await fetch('/api/study/checkin/toggle', {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify({ taskId: checkinMakeupTaskId, date: day.dataset.checkinMakeupDay }),
          });
          if (res.ok) {
            el<HTMLDialogElement>('checkin-makeup-dialog')?.close();
            window.location.reload();
          }
        } catch { /* 忽略 */ }
      }
    });
    // 热力图展开/收起
    document.addEventListener('click', (e) => {
      const t = e.target as HTMLElement;
      const heat = t.closest<HTMLElement>('[data-checkin-heat]');
      if (!heat) return;
      const panel = document.querySelector<HTMLElement>(`[data-checkin-heat-panel="${heat.dataset.checkinHeat}"]`);
      if (panel) {
        panel.classList.toggle('hidden');
        heat.textContent = panel.classList.contains('hidden') ? '▸ 热力图' : '▾ 热力图';
      }
    });

    // 首次 + View Transition 后渲染
    function renderCheckinPage(): void {
      if (document.getElementById('checkin-list')) renderCheckins();
    }
    renderCheckinPage();
    document.addEventListener('astro:page-load', renderCheckinPage);
  }
</script>
