---
/* ===== Props ===== */
/* （首页无 Props） */

/* ===== Imports ===== */
import BaseLayout from '@/layouts/BaseLayout.astro';
import HeroQuote from '@/components/HeroQuote.astro';
import ActivityHeatmap from '@/components/ActivityHeatmap.astro';
import NeoIcon from '@/components/NeoIcon.astro';
import SearchBox from '@/components/SearchBox.astro';
import Pagination from '@/components/Pagination.astro';
import { listArticleMeta, listArticlePageMeta } from '@/lib/articles';
import { listArticleCategories } from '@/lib/article-categories';
import { getSiteName } from '@/lib/site-name';
import { cardCoverUrl } from '@/lib/images';
import { getLandingHero } from '@/lib/landing';
import { pageInfo } from '@/lib/pagination';
import { canManage } from '@/lib/admin-auth';

/* ===== Logic ===== */
/** 每页固定五篇，所有明暗模式共享分页 */
const PAGE_SIZE = 5;

/* ---- 并行取数（P1-1）----
 * 这三个请求彼此**完全独立**：全量元信息（列表/标签/统计 + 推导总数与分页）、
 * 当日文章页（需先知道页码才能查）、落地页 Hero 配置、权限判定、自定义分类。
 * 旧实现五连 `await` 串行，TTFB 是各段耗时之和；改 `Promise.all` 后取最大值。
 *
 * ⚠️ `listArticlePageMeta` 依赖 `info.page`，而 `info` 由 `allMeta.length` 推导，
 *    因此这两步有**真实依赖**，不能一起并行——先并行取 allMeta + 其余独立项，
 *    再单独取当页（下面第二段）。 */
const [allMeta, landing, isAuthed, categories] = await Promise.all([
  /** 全部文章元信息（不含正文，用于标签统计、最近更新；总数直接由此推导，省一次 COUNT 查询） */
  listArticleMeta(),
  /** 落地页 Hero：优先「已自定义头图列表」 */
  getLandingHero(),
  /** 是否管理者（articles 权限：站主或授权管理员，决定卡片编辑入口；勿用旧 verifyRequest——不认新会话通道） */
  canManage(Astro.cookies, 'articles'),
  /** 自定义分类（写作台维护；首页分类筛选项与它保持一致。表未迁移时为空 → 不渲染按钮行） */
  listArticleCategories(),
]);

/** 站点名（首页 h1 的屏幕阅读器文本用，与页头 logo 同源 —— P1-6） */
const siteTitle = await getSiteName();

const total = allMeta.length;
const rawPage = Number(Astro.url.searchParams.get('page') ?? '1');
const info = pageInfo(rawPage, total, PAGE_SIZE);

/* 当页文章（**不取正文**，只带 contentLength 聚合列 —— P1-2：
 * 一页 5 篇 × 30KB 正文 = 270KB 无谓传输，而页面只用字数） */
const articles = await listArticlePageMeta(info.page, PAGE_SIZE);

/** Hero 大图取值。
 *  注意：当页文章查询只带 contentLength，**不取正文**（P1-2），因此没有首图可提取——
 *  仅用手动封面一条路径（原 resolveCover 分支因缺 content 恒为 null，已删除）。 */
const heroSlides = landing.images.map((u) => cardCoverUrl(u, 1920)).filter((u): u is string => !!u);
/* 优先级：自定义头图 > 当页文章封面图 > null（模板回落主题渐变） */
const heroRaw =
  heroSlides[0] ||
  articles.map((a) => a.cover).find((c): c is string => !!c) ||
  null;
const heroCover = cardCoverUrl(heroRaw, 1920);
const heroSubtitle = landing.subtitle || '敢于斗争，善于斗争';
/**
 * 粗略字数展示（>1000 显示 x.xk）。
 *
 * 入参来自 SQL 的 `length(content)` 聚合（`listArticlePageMeta`），
 * **不再需要取回正文**做 `replace(/\s+/g,'')`（P1-2）。
 * 注：SQL `length()` 计的是含空白字符数，与旧实现略有差异，
 * 但此处仅作「约 x 字」展示，差异可忽略。
 */
function countChars(n: number): string {
  return n >= 1000 ? `${(n / 1000).toFixed(1)}k` : String(n);
}

/** 社交链接 */
const SOCIALS: ReadonlyArray<{
  key: 'github' | 'bilibili' | 'sinaweibo';
  href: string;
  label: string;
}> = [
  { key: 'github', href: 'https://github.com/shijing-lu', label: 'GitHub' },
  { key: 'bilibili', href: 'https://space.bilibili.com/3493293975406955?spm_id_from=333.1007.0.0', label: 'Bilibili' },
  { key: 'sinaweibo', href: 'https://www.weibo.com/u/7843516472', label: '微博' },
];

/** 格式化最近更新为「YYYY-MM-DD HH:mm」像素风格 */
function formatShort(date?: Date): string {
  if (!date) return '—';
  const y = date.getFullYear();
  const m = String(date.getMonth() + 1).padStart(2, '0');
  const d = String(date.getDate()).padStart(2, '0');
  const h = String(date.getHours()).padStart(2, '0');
  const min = String(date.getMinutes()).padStart(2, '0');
  return `${y}-${m}-${d} ${h}:${min}`;
}
---
<BaseLayout title="首页" description="技术教程 · 学习笔记 · 随笔与摄影" image={heroCover ?? undefined}>
  <div class="neo-home">
    <section class="neo-hero landing-hero" aria-label={siteTitle + ' · 个人知识库'}>
      {heroSlides.length > 1 ? <div class="landing-hero-slides" data-interval={landing.intervalSec}>{heroSlides.map((src, index) => <img class={'landing-hero-bg landing-hero-slide' + (index === 0 ? ' is-active' : '')} src={src} alt="" fetchpriority={index === 0 ? 'high' : undefined} loading={index === 0 ? 'eager' : 'lazy'} />)}</div> : <img class="landing-hero-bg" src={heroCover ?? '/images/neobrutalism/article-fallback.webp'} alt="" fetchpriority="high" />}
      <div class="neo-hero-paper">
        <span class="neo-hero-eyebrow">PERSONAL KNOWLEDGE BASE</span>
        <HeroQuote />
        <p class="neo-hero-subtitle">{heroSubtitle}</p>
        <div class="neo-socials">
          {SOCIALS.map(social => <a href={social.href} target="_blank" rel="noopener noreferrer" class="social-link" aria-label={social.label} title={social.label}><span class={'social-icon icon-' + social.key} aria-hidden="true" /></a>)}
          <button type="button" id="wechat-btn" class="social-link" title="微信" aria-label="微信"><span class="social-icon icon-wechat" aria-hidden="true" /></button>
        </div>
        <span class="neo-blog-script" aria-hidden="true">Blog</span>
        <span class="neo-paper-rays" aria-hidden="true"></span>
      </div>
      <aside class="neo-hero-note" aria-label="记录热爱，分享知识，遇见更好的自己"><NeoIcon name="star" size={22} /><p>记录热爱<br />分享知识<br />遇见更好的自己<br />……</p></aside>
    </section>
    <div class="neo-home-content">
      <ActivityHeatmap />
      <section id="latest" class="neo-latest neo-panel" aria-labelledby="latest-heading">
        <div class="neo-latest-header"><div class="neo-latest-tab"><NeoIcon name="file" size={30} /><h2 id="latest-heading">最新文章</h2><span>LATEST ARTICLES</span></div><span class="neo-articles-script" aria-hidden="true">Articles</span><p class="neo-page-summary">第 {info.page} / {info.totalPages} 页 · 共 {total} 篇</p></div>
        <div class="neo-latest-body">
          <SearchBox canEdit={isAuthed} total={total} categories={categories.map(category => ({ id: category.id, name: category.name }))} />
          <div id="tag-filter-bar" class="hidden neo-tag-filter"><span>筛选当前页</span><span id="tag-filter-name"></span><span id="tag-filter-count"></span><a id="tag-filter-all" href="#">在全站查看 →</a><button type="button" id="tag-filter-clear">清除筛选 ×</button></div>
          <div id="post-grid" class="post-list">
            {articles.map(article => <article class="post-row" data-tags={article.tags.join('|').toLowerCase()}>
              <a href={'/blog/' + article.slug} class="neo-post-link" aria-label={'阅读《' + (article.title || '未命名') + '》'}></a>
              <img class="neo-post-cover" src={cardCoverUrl(article.cover, 480) ?? '/images/neobrutalism/article-fallback.webp'} data-article-cover alt="" width="164" height="84" loading="lazy" />
              <div class="post-row-main"><h3>{article.title || '未命名'}{article.encrypted && <span class="neo-encrypted" title="加密文章" aria-label="加密文章"><NeoIcon name="lock" size={15} /></span>}</h3>
                <div class="neo-post-tags">{article.tags.slice(0, 4).map(tag => <button type="button" data-tag-filter={tag} class="post-tag" title={'只筛选当前页的「' + tag + '」'}>{tag}</button>)}{article.tags.length > 4 && <span>+{article.tags.length - 4}</span>}</div>
                <p class="neo-post-summary">{article.summary}</p>
              </div>
              <div class="post-row-meta"><time datetime={article.updatedAt.toISOString()}>{formatShort(article.updatedAt)}</time><span class="neo-word-count"><NeoIcon name="file" size={15} />{article.encrypted ? '已加密' : countChars(article.contentLength) + ' 字'}</span></div>
              {isAuthed && <a href={'/edit/' + article.id} class="post-row-edit" aria-label={'编辑《' + article.title + '》'} title="编辑文章"><NeoIcon name="more" size={20} /></a>}
            </article>)}
          </div>
          {total === 0 && <p class="neo-empty">还没有文章，新的故事即将开始。</p>}
          <div id="post-pagination">{info.totalPages > 1 && <Pagination page={info.page} totalPages={info.totalPages} />}</div>
        </div>
      </section>
    </div>
  </div>
  <dialog id="wechat-dialog" class="wechat-dialog" aria-labelledby="wechat-dialog-title"><div class="settings-header"><h2 id="wechat-dialog-title">微信好友</h2><button id="wechat-close" type="button" aria-label="关闭" class="settings-close">×</button></div><img id="wechat-qr" src="/qrcodes/wechat.png" alt="微信二维码" class="mx-auto mt-4 w-44 rounded-lg" width="176" height="176" /><p id="wechat-qr-fallback" class="mt-4 hidden">二维码暂时无法加载，请稍后重试。</p></dialog>
</BaseLayout>
<script>
  import { feedback, reducedMotion } from '@/lib/motion';
  /** ================= 首页标签筛选（点击文章下方标签即时过滤） =================
   *  - 只筛选**当前页**的服务端列表（无请求、无刷新）；全站检索走 /tags/[tag] 链接；
   *  - 与搜索框互斥：点击标签时先清空搜索词回到静态列表，再执行过滤；
   *  - 事件用 document 委托 + 每次重新查询 DOM，规避 View Transitions 后绑定失效。 */
  let activeTag = '';

  function applyTagFilter(tag: string): void {
    if (tag !== activeTag) void feedback(document.getElementById('post-grid'));
    activeTag = tag;
    const bar = document.getElementById('tag-filter-bar');
    const nameEl = document.getElementById('tag-filter-name');
    const countEl = document.getElementById('tag-filter-count');
    const allLink = document.getElementById('tag-filter-all') as HTMLAnchorElement | null;
    const pagination = document.getElementById('post-pagination');

    document.dispatchEvent(new CustomEvent('byqx:home-reset-search'));

    const needle = tag.toLowerCase();
    let shown = 0;
    document.querySelectorAll<HTMLElement>('#post-grid .post-row').forEach((row) => {
      const tags = (row.dataset.tags ?? '').split('|').filter(Boolean);
      const match = !needle || tags.includes(needle);
      row.classList.toggle('hidden', !match);
      if (match) shown += 1;
    });
    // 同页内高亮被选中的标签
    document.querySelectorAll<HTMLElement>('#post-grid [data-tag-filter]').forEach((btn) => {
      const on = !!needle && (btn.dataset.tagFilter ?? '').toLowerCase() === needle;
      btn.classList.toggle('bg-primary/15', on);
      btn.classList.toggle('text-primary', on);
      btn.setAttribute('aria-pressed', String(on));
    });

    if (!tag) {
      bar?.classList.add('hidden');
      pagination?.classList.remove('hidden');
      return;
    }
    if (bar) bar.classList.remove('hidden');
    if (nameEl) nameEl.textContent = `#${tag}`;
    if (countEl) countEl.textContent = `${shown} 篇（当前页）`;
    if (allLink) allLink.href = `/tags/${encodeURIComponent(tag)}`;
    // 过滤态下分页失效（分页针对全量列表），先隐藏避免误导
    pagination?.classList.add('hidden');
  }

  document.addEventListener('byqx:home-clear-tag', () => { activeTag = ''; document.getElementById('tag-filter-bar')?.classList.add('hidden'); document.querySelectorAll('#post-grid .post-row').forEach(row => row.classList.remove('hidden')); document.querySelectorAll('#post-grid [data-tag-filter]').forEach(button => { button.classList.remove('bg-primary/15','text-primary'); button.setAttribute('aria-pressed','false'); }); });
  document.addEventListener('click', (e) => {
    const tagBtn = (e.target as HTMLElement).closest<HTMLElement>('[data-tag-filter]');
    if (tagBtn) {
      const tag = tagBtn.dataset.tagFilter ?? '';
      // 再次点击同一标签 = 取消筛选
      applyTagFilter(tag && tag.toLowerCase() === activeTag.toLowerCase() ? '' : tag);
      return;
    }
    if ((e.target as HTMLElement).closest('#tag-filter-clear')) applyTagFilter('');
  });

  /** 微信二维码弹窗（document 委托） */
  const wechatDialog = (): HTMLDialogElement | null =>
    document.getElementById('wechat-dialog') as HTMLDialogElement | null;
  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    if (target.closest('#wechat-btn')) {
      wechatDialog()?.showModal();
      return;
    }
    if (target.closest('#wechat-close')) {
      wechatDialog()?.close();
    }
  });
  // 二维码图片不存在时显示占位提示
  document.addEventListener('astro:page-load', () => {
    const img = document.getElementById('wechat-qr') as HTMLImageElement | null;
    if (!img) return;
    img.onerror = () => {
      img.classList.add('hidden');
      document.getElementById('wechat-qr-fallback')?.classList.remove('hidden');
    };
    if (img.complete && img.naturalWidth === 0) img.onerror?.(new Event('error'));
  });


  let carouselTimer = 0;
  function stopCarousel(): void { window.clearInterval(carouselTimer); carouselTimer = 0; }
  function startCarousel(): void {
    stopCarousel();
    if (reducedMotion() || document.hidden) return;
    const wrap = document.querySelector<HTMLElement>('.landing-hero-slides');
    const slides = Array.from(wrap?.querySelectorAll<HTMLElement>('.landing-hero-slide') ?? []);
    if (slides.length < 2) return;
    let current = Math.max(0, slides.findIndex(slide => slide.classList.contains('is-active')));
    carouselTimer = window.setInterval(() => { slides[current]?.classList.remove('is-active'); current = (current + 1) % slides.length; slides[current]?.classList.add('is-active'); }, Math.max(2, Number(wrap?.dataset.interval ?? 6)) * 1000);
  }
  document.addEventListener('astro:before-swap', () => { stopCarousel(); activeTag = ''; });
  document.addEventListener('astro:page-load', startCarousel);
  document.addEventListener('visibilitychange', () => document.hidden ? stopCarousel() : startCarousel());
  matchMedia('(prefers-reduced-motion: reduce)').addEventListener('change', startCarousel);
  document.addEventListener('error', event => { const image = event.target; if (image instanceof HTMLImageElement && image.matches('[data-article-cover]') && !image.src.endsWith('/article-fallback.webp')) image.src = '/images/neobrutalism/article-fallback.webp'; }, true);
  startCarousel();
</script>
