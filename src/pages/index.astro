---
/* ===== Props ===== */
/* （首页无 Props） */

/* ===== Imports ===== */
import BaseLayout from '@/layouts/BaseLayout.astro';
import HeroQuote from '@/components/HeroQuote.astro';
import ActivityHeatmap from '@/components/ActivityHeatmap.astro';
import SearchBox from '@/components/SearchBox.astro';
import Pagination from '@/components/Pagination.astro';
import { countArticles, listArticleMeta, listArticlePage, resolveCover } from '@/lib/articles';
import { pageInfo } from '@/lib/pagination';
import { verifyRequest } from '@/lib/auth';
import type { ArticleType } from '../../db/types';

/* ===== Logic ===== */
/** 每页文章数（3×3 网格） */
const PAGE_SIZE = 9;

const total = await countArticles();
const rawPage = Number(Astro.url.searchParams.get('page') ?? '1');
const info = pageInfo(rawPage, total, PAGE_SIZE);
const articles = await listArticlePage(info.page, PAGE_SIZE);

/** 是否管理员（决定卡片编辑入口等） */
const isAuthed = verifyRequest(Astro.cookies);
/** 文章 → 封面图（手动指定优先，否则取正文第一张图，无则用主题渐变占位） */
const covers = new Map(articles.map((a) => [a.id, resolveCover(a)]));

/** 全部文章元信息（不含正文，用于标签统计与最近更新） */
const allMeta = await listArticleMeta();
/** 全部标签总数（去重） */
const uniqueTags = new Set(allMeta.flatMap((a) => a.tags)).size;
/** 最近更新时间 */
const lastUpdated = allMeta[0]?.updatedAt;

/** 文章类型 → 中文标签 */
const typeLabels: Record<ArticleType, string> = {
  tech: '技术',
  note: '笔记',
  photo: '摄影',
};

/** 文章类型 → 像素章样式类 */
const typeChipClass: Record<ArticleType, string> = {
  tech: 'chip-tech',
  note: 'chip-note',
  photo: 'chip-photo',
};

/** 文章类型 → 封面大字字形 */
const typeGlyph: Record<ArticleType, string> = {
  tech: '技',
  note: '记',
  photo: '影',
};

/** 粗略字数（去除空白后的字符数），>1000 显示 x.xk */
function countChars(markdown: string): string {
  const n = markdown.replace(/\s+/g, '').length;
  return n >= 1000 ? `${(n / 1000).toFixed(1)}k` : String(n);
}

/** 栏目入口（已替换为社交图标，见模板） */

/** 社交链接 */
const SOCIALS: ReadonlyArray<{
  key: 'github' | 'bilibili' | 'sinaweibo';
  href: string;
  label: string;
}> = [
  { key: 'github', href: 'https://github.com/shijing-lu', label: 'GitHub' },
  { key: 'bilibili', href: 'https://space.bilibili.com/3493293975406955?spm_id_from=333.1007.0.0', label: 'Bilibili' },
  { key: 'sinaweibo', href: 'https://www.weibo.com/u/7843516472', label: '微博' },
];

/** 格式化最近更新为「YYYY-MM-DD HH:mm」像素风格 */
function formatShort(date?: Date): string {
  if (!date) return '—';
  const y = date.getFullYear();
  const m = String(date.getMonth() + 1).padStart(2, '0');
  const d = String(date.getDate()).padStart(2, '0');
  const h = String(date.getHours()).padStart(2, '0');
  const min = String(date.getMinutes()).padStart(2, '0');
  return `${y}-${m}-${d} ${h}:${min}`;
}
---
<!-- ===== Template ===== -->
<BaseLayout title="首页" description="技术教程 · 学习笔记 · 随笔与摄影 —— My Blog">
  <section class="mx-auto w-full max-w-6xl px-4 py-10">
    <!-- Hero -->
    <p data-hero class="font-pixel text-[0.6rem] uppercase tracking-[0.2em] text-primary">Personal Knowledge Base</p>
    <HeroQuote />
    <p data-hero class="mt-3 max-w-2xl text-base text-muted-foreground">
      全面自由地发展吧，同志！让我们用知识武装自己，打败世间一切邪祟。
    </p>

    <!-- 社交入口（GitHub / Bilibili / 微信 / 微博） -->
    <div data-hero class="mt-8 flex flex-wrap gap-3">
      {
        SOCIALS.map((s) => (
          <a
            href={s.href}
            target="_blank"
            rel="noopener noreferrer"
            class="social-link"
            title={s.label}
            aria-label={s.label}
          >
            <span class={`social-icon icon-${s.key}`} aria-hidden="true" />
          </a>
        ))
      }
      <!-- 微信：点击弹出好友二维码 -->
      <button type="button" id="wechat-btn" class="social-link" title="微信" aria-label="微信">
        <span class="social-icon icon-wechat" aria-hidden="true" />
      </button>
    </div>

    <!-- 文章活跃热力图 + 月度写作量 -->
    <ActivityHeatmap />

    <!-- 像素统计条 -->
    <div class="pixel-divider mt-8" />
    <div class="mt-4 flex flex-wrap items-center gap-x-8 gap-y-2 font-pixel text-xs text-muted-foreground">
      <span>
        <span class="stat-count text-primary" data-num={total}>0</span> ARTICLES
      </span>
      <span>
        <span class="stat-count text-primary" data-num={uniqueTags}>0</span> TAGS
      </span>
      <span>
        UPDATED <span class="text-primary">{formatShort(lastUpdated)}</span>
      </span>
    </div>

    <!-- 最新文章 -->
    <div class="mt-10">
      <div class="flex items-center gap-2.5">
        <h2 class="font-display text-2xl font-semibold">最新文章</h2>
        <span class="pixel-chip rounded bg-muted px-2 py-1 text-muted-foreground">LATEST ARTICLES</span>
        {
          info.totalPages > 1 && (
            <span class="ml-auto font-pixel text-xs text-muted-foreground">
              第 {info.page} / {info.totalPages} 页
            </span>
          )
        }
      </div>

      <!-- 检索：服务端搜索 + 类型筛选 -->
      <div class="mt-4">
        <SearchBox total={total} />
      </div>

      <!-- 服务端分页卡片流（搜索激活时由 SearchBox 隐藏） -->
      <div id="post-grid" class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {
          articles.map((article, index) => (
            <article class="post-card group relative overflow-hidden">
              {/* 整卡链接：点击卡片任意处进入详情页（stretched-link） */}
              <a href={`/blog/${article.slug}`} class="absolute inset-0 z-0" aria-label={`阅读《${article.title || '未命名'}》`} />
              {/* 封面：手动封面 > 正文首图 > 主题渐变占位 + 大字字形 + 像素类型章 */}
              <div class="post-cover" data-type={article.type}>
                {
                  (() => {
                    const cover = covers.get(article.id);
                    return cover ? (
                      <img
                        src={cover}
                        alt=""
                        class="post-cover-img"
                        fetchpriority={index === 0 && info.page === 1 ? 'high' : 'auto'}
                        loading={index < 2 ? 'eager' : 'lazy'}
                      />
                    ) : (
                      <>
                        <span class="post-cover-dither" aria-hidden="true" />
                        <span class="post-cover-glyph" aria-hidden="true">{typeGlyph[article.type]}</span>
                      </>
                    );
                  })()
                }
                <span class={`post-cover-chip pixel-chip rounded px-1.5 py-0.5 ${typeChipClass[article.type]}`}>
                  {typeLabels[article.type]}
                </span>
                {
                  isAuthed && (
                    <a
                      href={`/edit/${article.id}`}
                      aria-label="编辑文章"
                      title="编辑"
                      class="absolute right-2 top-2 z-10 inline-flex size-7 items-center justify-center rounded-md bg-black/40 text-white opacity-0 backdrop-blur-sm transition-opacity duration-200 group-hover:opacity-100 hover:bg-black/60"
                    >
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-3.5" aria-hidden="true">
                        <path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z" />
                      </svg>
                    </a>
                  )
                }
              </div>
              <div class="p-4">
                <div class="flex items-start justify-between gap-2">
                  <h3 class="font-display text-lg font-semibold leading-snug transition-colors duration-200">
                    {article.title}
                  </h3>
                  <span class="shrink-0 font-pixel text-xs text-primary">{countChars(article.content)}字</span>
                </div>
                <div class="mt-2 flex items-center gap-3 text-xs text-muted-foreground">
                  <time class="inline-flex items-center gap-1" datetime={article.updatedAt.toISOString()}>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-3.5" aria-hidden="true">
                      <circle cx="12" cy="12" r="9" />
                      <path d="M12 7v5l3 2" />
                    </svg>
                    {formatShort(article.updatedAt)}
                  </time>
                  <span class="inline-flex items-center gap-1">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-3.5" aria-hidden="true">
                      <path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7Z" />
                      <circle cx="12" cy="12" r="3" />
                    </svg>
                    {String(article.tags.length).padStart(2, '0')} 标
                  </span>
                </div>
                <p class="font-readable mt-2 text-sm text-muted-foreground line-clamp-2">{article.summary}</p>
                {
                  article.tags.length > 0 && (
                    <div class="mt-3 flex flex-wrap gap-1.5 border-t border-border pt-2.5">
                      {
                        article.tags.slice(0, 3).map((tag) => (
                          <a
                            href={`/tags/${encodeURIComponent(tag)}`}
                            class="relative z-[1] rounded bg-muted px-1.5 py-0.5 text-xs text-muted-foreground transition-colors duration-200 hover:bg-accent hover:text-primary"
                          >
                            {tag}
                          </a>
                        ))
                      }
                    </div>
                  )
                }
              </div>
            </article>
          ))
        }
      </div>

      {
        total === 0 && (
          <p class="mt-6 text-sm text-muted-foreground">
            暂无文章 —— 请先运行 <code class="rounded bg-muted px-1.5 py-0.5">pnpm db:push:dev && pnpm db:seed</code>
          </p>
        )
      }

      <!-- 分页栏（搜索激活时由 SearchBox 隐藏） -->
      <div id="post-pagination">
        {
          info.totalPages > 1 && <Pagination page={info.page} totalPages={info.totalPages} />
        }
      </div>
    </div>
  </section>

  <!-- 微信好友二维码弹窗 -->
  <dialog id="wechat-dialog" class="wechat-dialog" aria-labelledby="wechat-dialog-title">
    <div class="settings-header">
      <div>
        <p class="pixel-chip text-primary">WECHAT</p>
        <h2 id="wechat-dialog-title" class="mt-1 font-display text-lg font-semibold">微信好友</h2>
      </div>
      <button id="wechat-close" type="button" aria-label="关闭" class="settings-close">×</button>
    </div>
    <img
      id="wechat-qr"
      src="/qrcodes/wechat.png"
      alt="微信二维码"
      class="mx-auto mt-4 w-44 rounded-lg border border-border"
    />
    <p id="wechat-qr-fallback" class="mt-4 hidden text-xs text-muted-foreground">
      二维码待上传 —— 请将图片放到 <code class="font-mono">public/qrcodes/wechat.png</code>。
    </p>
  </dialog>
</BaseLayout>

<script>
  /** 首页动效：Hero 进场序列 + 像素统计条数字滚动（GSAP，reduced-motion 时跳过） */
  import { heroIn, counterInView } from '@/lib/anim';

  const homeW = window as unknown as { __homeAnimsBound?: boolean };
  async function runHomeAnims(): Promise<void> {
    // 进场序列只在首次加载播放一次（刷新/SPA 转场后直接显示，避免重复动画卡隐藏）
    if (!homeW.__homeAnimsBound) {
      homeW.__homeAnimsBound = true;
      await heroIn();
    }
    void counterInView('.stat-count');
  }
  // 初始加载播放；View Transition 后新页面元素重新进场
  document.addEventListener('astro:page-load', () => void runHomeAnims());
  void runHomeAnims();

  /** 微信二维码弹窗（document 委托） */
  const wechatDialog = (): HTMLDialogElement | null =>
    document.getElementById('wechat-dialog') as HTMLDialogElement | null;
  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    if (target.closest('#wechat-btn')) {
      wechatDialog()?.showModal();
      return;
    }
    if (target.closest('#wechat-close')) {
      wechatDialog()?.close();
    }
  });
  // 二维码图片不存在时显示占位提示
  document.addEventListener('astro:page-load', () => {
    const img = document.getElementById('wechat-qr') as HTMLImageElement | null;
    if (!img) return;
    img.onerror = () => {
      img.classList.add('hidden');
      document.getElementById('wechat-qr-fallback')?.classList.remove('hidden');
    };
    if (img.complete && img.naturalWidth === 0) img.onerror?.(new Event('error'));
  });
</script>
