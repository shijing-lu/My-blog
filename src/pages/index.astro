---
/* ===== Props ===== */
/* （首页无 Props） */

/* ===== Imports ===== */
import BaseLayout from '@/layouts/BaseLayout.astro';
import HeroQuote from '@/components/HeroQuote.astro';
import ActivityHeatmap from '@/components/ActivityHeatmap.astro';
import DeerDots from '@/components/DeerDots.astro';
import SearchBox from '@/components/SearchBox.astro';
import Pagination from '@/components/Pagination.astro';
import { listArticleMeta, listArticlePageMeta } from '@/lib/articles';
import { listArticleCategories } from '@/lib/article-categories';
import { getSiteName } from '@/lib/site-name';
import { cardCoverUrl } from '@/lib/images';
import { getLandingHero } from '@/lib/landing';
import { pageInfo } from '@/lib/pagination';
import { canManage } from '@/lib/admin-auth';
import type { ArticleType } from '../../db/types';

/* ===== Logic ===== */
/** 每页文章数（故事流为单列交替，仍按 9 篇分页） */
const PAGE_SIZE = 9;

/* ---- 并行取数（P1-1）----
 * 这三个请求彼此**完全独立**：全量元信息（列表/标签/统计 + 推导总数与分页）、
 * 当日文章页（需先知道页码才能查）、落地页 Hero 配置、权限判定、自定义分类。
 * 旧实现五连 `await` 串行，TTFB 是各段耗时之和；改 `Promise.all` 后取最大值。
 *
 * ⚠️ `listArticlePageMeta` 依赖 `info.page`，而 `info` 由 `allMeta.length` 推导，
 *    因此这两步有**真实依赖**，不能一起并行——先并行取 allMeta + 其余独立项，
 *    再单独取当页（下面第二段）。 */
const [allMeta, landing, isAuthed, categories] = await Promise.all([
  /** 全部文章元信息（不含正文，用于标签统计、最近更新；总数直接由此推导，省一次 COUNT 查询） */
  listArticleMeta(),
  /** 落地页 Hero：优先「已自定义头图列表」 */
  getLandingHero(),
  /** 是否管理者（articles 权限：站主或授权管理员，决定卡片编辑入口；勿用旧 verifyRequest——不认新会话通道） */
  canManage(Astro.cookies, 'articles'),
  /** 自定义分类（写作台维护；首页分类筛选项与它保持一致。表未迁移时为空 → 不渲染按钮行） */
  listArticleCategories(),
]);

/** 站点名（首页 h1 的屏幕阅读器文本用，与页头 logo 同源 —— P1-6） */
const siteTitle = await getSiteName();

const total = allMeta.length;
const rawPage = Number(Astro.url.searchParams.get('page') ?? '1');
const info = pageInfo(rawPage, total, PAGE_SIZE);

/* 当页文章（**不取正文**，只带 contentLength 聚合列 —— P1-2：
 * 一页 9 篇 × 30KB 正文 = 270KB 无谓传输，而页面只用字数） */
const articles = await listArticlePageMeta(info.page, PAGE_SIZE);

/** Hero 大图取值。
 *  注意：当页文章查询只带 contentLength，**不取正文**（P1-2），因此没有首图可提取——
 *  仅用手动封面一条路径（原 resolveCover 分支因缺 content 恒为 null，已删除）。 */
const heroSlides = landing.images.map((u) => cardCoverUrl(u, 1920)).filter((u): u is string => !!u);
/* 优先级：自定义头图 > 当页文章封面图 > null（模板回落主题渐变） */
const heroRaw =
  heroSlides[0] ||
  articles.map((a) => a.cover).find((c): c is string => !!c) ||
  null;
const heroCover = cardCoverUrl(heroRaw, 1920);
const heroSubtitle = landing.subtitle || '全面自由地发展吧，同志！让我们用知识武装自己，打败世间一切邪祟。';
const heroType: ArticleType = articles[0]?.type ?? 'tech';

/** 全部标签总数（去重） */
const uniqueTags = new Set(allMeta.flatMap((a) => a.tags)).size;
/** 最近更新时间 */
const lastUpdated = allMeta[0]?.updatedAt;

/** 文章类型 → 封面大字字形（Hero 装饰；type 仅作内部元数据，分类体系用自定义分类） */
const typeGlyph: Record<ArticleType, string> = {
  tech: '技',
  note: '记',
  photo: '影',
};

/**
 * 粗略字数展示（>1000 显示 x.xk）。
 *
 * 入参来自 SQL 的 `length(content)` 聚合（`listArticlePageMeta`），
 * **不再需要取回正文**做 `replace(/\s+/g,'')`（P1-2）。
 * 注：SQL `length()` 计的是含空白字符数，与旧实现略有差异，
 * 但此处仅作「约 x 字」展示，差异可忽略。
 */
function countChars(n: number): string {
  return n >= 1000 ? `${(n / 1000).toFixed(1)}k` : String(n);
}

/** 社交链接 */
const SOCIALS: ReadonlyArray<{
  key: 'github' | 'bilibili' | 'sinaweibo';
  href: string;
  label: string;
}> = [
  { key: 'github', href: 'https://github.com/shijing-lu', label: 'GitHub' },
  { key: 'bilibili', href: 'https://space.bilibili.com/3493293975406955?spm_id_from=333.1007.0.0', label: 'Bilibili' },
  { key: 'sinaweibo', href: 'https://www.weibo.com/u/7843516472', label: '微博' },
];

/** 格式化最近更新为「YYYY-MM-DD HH:mm」像素风格 */
function formatShort(date?: Date): string {
  if (!date) return '—';
  const y = date.getFullYear();
  const m = String(date.getMonth() + 1).padStart(2, '0');
  const d = String(date.getDate()).padStart(2, '0');
  const h = String(date.getHours()).padStart(2, '0');
  const min = String(date.getMinutes()).padStart(2, '0');
  return `${y}-${m}-${d} ${h}:${min}`;
}
---
<!-- ===== Template ===== -->
<BaseLayout title="首页" description="技术教程 · 学习笔记 · 随笔与摄影 —— My Blog" image={heroCover ?? undefined}>
  <!-- ===== 落地页 Hero：全屏大图 + 文字叠层 ===== -->
  <section class="landing-hero">
    {
      heroSlides.length > 1 ? (
        <div class="landing-hero-slides" data-animation={landing.animation} data-interval={landing.intervalSec}>
          {
            heroSlides.map((src, i) => (
              <img
                class={`landing-hero-bg landing-hero-slide${i === 0 ? ' is-active' : ''}`}
                src={src}
                alt=""
                fetchpriority={i === 0 ? 'high' : undefined}
                loading={i === 0 ? undefined : 'lazy'}
              />
            ))
          }
        </div>
      ) : heroCover ? (
        <img class="landing-hero-bg" src={heroCover} alt="" fetchpriority="high" />
      ) : (
        <div class="landing-hero-bg landing-hero-bg--gradient" data-type={heroType} aria-hidden="true">
          <span class="post-cover-glyph" aria-hidden="true">{typeGlyph[heroType]}</span>
        </div>
      )
    }
    <div class="landing-hero-scrim" aria-hidden="true" />
    <div class="landing-hero-content relative z-[1] mx-auto w-full max-w-6xl px-4">
      {/* 页面唯一 h1（P1-6：此前首页全文无 h1，标题层级从 h2 起跳）。
          视觉上是 Hero 主标题，语义上是首页的顶层标题——两条信息线合并，
          对读屏与 SEO 都更正确；下方社交入口等保持原字号不变。 */}
      <h1 class="contents">
        <span class="sr-only">{siteTitle} —— 个人知识库</span>
        <span data-hero class="font-pixel text-[0.6rem] uppercase tracking-[0.2em] text-primary" aria-hidden="true">
          Personal Knowledge Base
        </span>
      </h1>
      <HeroQuote />
      <p data-hero class="mt-3 max-w-2xl text-base text-white/85">{heroSubtitle}</p>
      <!-- 社交入口（GitHub / Bilibili / 微博 / 微信） -->
      <div data-hero class="mt-8 flex flex-wrap gap-3">
        {
          SOCIALS.map((s) => (
            <a
              href={s.href}
              target="_blank"
              rel="noopener noreferrer"
              class="social-link"
              title={s.label}
              aria-label={s.label}
            >
              <span class={`social-icon icon-${s.key}`} aria-hidden="true" />
            </a>
          ))
        }
        <!-- 微信：点击弹出好友二维码 -->
        <button type="button" id="wechat-btn" class="social-link" title="微信" aria-label="微信">
          <span class="social-icon icon-wechat" aria-hidden="true" />
        </button>
      </div>
    </div>
    <!-- 滚动提示：点击平滑滚到文章区 -->
    <a href="#latest" class="scroll-cue" aria-label="向下浏览文章">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-6" aria-hidden="true">
        <path d="M12 5v14M19 12l-7 7-7-7" />
      </svg>
    </a>
  </section>

  <!-- ===== 落地页以下整体区域（小鹿点阵背景全宽贯穿，顶部渐隐衔接 Hero） ===== -->
  <div class="relative isolate">
    <DeerDots />
    <!-- ===== 数据条 + 文章故事流 ===== -->
    <section class="mx-auto w-full max-w-6xl px-4 py-12" aria-labelledby="latest-heading">
      <!-- 文章活跃热力图 + 月度写作量 -->
      <ActivityHeatmap />

    <!-- 像素统计条 -->
    <div class="pixel-divider mt-8" />
    <div
      class="mt-4 flex flex-wrap items-center gap-x-8 gap-y-2 font-pixel text-xs text-muted-foreground"
      role="group"
      aria-label="站点统计"
    >
      <span>
        <span class="stat-count text-primary" data-num={total}>0</span> ARTICLES
      </span>
      <span>
        <span class="stat-count text-primary" data-num={uniqueTags}>0</span> TAGS
      </span>
      <span>
        UPDATED <span class="text-primary">{formatShort(lastUpdated)}</span>
      </span>
    </div>

    <!-- 最新文章 -->
    <div id="latest" class="mt-10 scroll-mt-24">
      <div class="flex items-center gap-2.5">
        <h2 id="latest-heading" class="font-display text-2xl font-semibold">最新文章</h2>
        <span class="pixel-chip rounded bg-muted px-2 py-1 text-muted-foreground">LATEST ARTICLES</span>
        {
          info.totalPages > 1 && (
            <span class="ml-auto font-pixel text-xs text-muted-foreground">
              第 {info.page} / {info.totalPages} 页
            </span>
          )
        }
      </div>

      <!-- 检索：服务端搜索 + 自定义分类筛选（内置类型已从 UI 退役） -->
      <div class="mt-4">
        <SearchBox total={total} categories={categories.map((c) => ({ id: c.id, name: c.name }))} />
      </div>

      <!-- 标签筛选状态条（点击文章标签后显示；仅筛选当前页，全站请跳标签页） -->
      <div id="tag-filter-bar" class="mt-4 hidden flex-wrap items-center gap-2 rounded-md border border-primary/30 bg-primary/5 px-3 py-2 text-xs">
        <span class="text-muted-foreground">正在筛选</span>
        <span id="tag-filter-name" class="rounded bg-primary/10 px-1.5 py-0.5 font-medium text-primary">#</span>
        <span id="tag-filter-count" class="text-muted-foreground tabular-nums">0 篇</span>
        <a id="tag-filter-all" href="#" class="text-muted-foreground underline underline-offset-2 transition-colors hover:text-primary">在全站查看 →</a>
        <button type="button" id="tag-filter-clear" class="ml-auto rounded border border-border px-2 py-0.5 text-muted-foreground transition-colors hover:border-primary hover:text-primary">
          清除筛选 ✕
        </button>
      </div>

      <!-- 文章行式列表（Claude 简约表格风格：无图、细分割线、大留白） -->
      <div id="post-grid" class="post-list mt-8">
        {
          articles.map((article) => {
            return (
              <article class="post-row group relative" data-tags={article.tags.join('|').toLowerCase()}>
                {/* 整行可点：进入详情页（stretched-link） */}
                <a href={`/blog/${article.slug}`} class="absolute inset-0 z-0" aria-label={`阅读《${article.title || '未命名'}》`} />
                {/* 左：标题 + 一行摘要 + 标签 */}
                <div class="post-row-main">
                  <div class="flex items-center gap-2.5">
                    <h3 class="font-display text-lg font-medium leading-snug transition-colors duration-200 group-hover:text-primary">
                      {article.title}
                    </h3>
                    {
                      article.encrypted && (
                        /* 加密文章：锁标识（标题摘要仍可见，正文需解锁） */
                        <span
                          class="inline-flex size-4 shrink-0 items-center justify-center text-muted-foreground"
                          title="加密文章"
                          aria-label="加密文章"
                        >
                          <svg
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            class="size-3.5"
                            aria-hidden="true"
                          >
                            <rect x="4" y="11" width="16" height="10" rx="2" />
                            <path d="M8 11V7a4 4 0 0 1 8 0v4" />
                          </svg>
                        </span>
                      )
                    }
                  </div>
                  <p class="mt-1.5 text-sm text-muted-foreground line-clamp-1">{article.summary}</p>
                  {
                    article.tags.length > 0 && (
                      /* 标签行：点击即在当前列表内按该标签过滤（再点一次取消）；
                         relative z-[1] 抬到整行链接之上，否则点不到 */
                      <div class="mt-2 flex flex-wrap items-center gap-1.5">
                        {article.tags.slice(0, 4).map((tag) => (
                          <button
                            type="button"
                            data-tag-filter={tag}
                            class="post-tag relative z-[1] rounded bg-muted px-1.5 py-0.5 text-xs text-muted-foreground transition-colors duration-200 hover:bg-accent hover:text-primary"
                            title={`只看「${tag}」`}
                          >
                            {tag}
                          </button>
                        ))}
                        {article.tags.length > 4 && (
                          <span class="relative z-[1] text-xs text-muted-foreground/70">+{article.tags.length - 4}</span>
                        )}
                      </div>
                    )
                  }
                </div>
                {/* 右：时间 + 字数（右对齐，等宽对齐） */}
                <div class="post-row-meta">
                  <span class="text-xs text-muted-foreground tabular-nums">{formatShort(article.updatedAt)}</span>
                  <span class="font-pixel text-xs text-primary tabular-nums">
                    {article.encrypted ? '已加密' : `${countChars(article.contentLength)}字`}
                  </span>
                </div>
                {
                  isAuthed && (
                    <a
                      href={`/edit/${article.id}`}
                      aria-label="编辑文章"
                      title="编辑"
                      class="post-row-edit inline-flex size-7 items-center justify-center rounded-md text-muted-foreground hover:bg-accent hover:text-primary"
                    >
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-3.5" aria-hidden="true">
                        <path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z" />
                      </svg>
                    </a>
                  )
                }
              </article>
            );
          })
        }
      </div>

      {
        total === 0 && (
          <p class="mt-6 text-sm text-muted-foreground">
            暂无文章 —— 请先运行 <code class="rounded bg-muted px-1.5 py-0.5">pnpm db:push:dev && pnpm db:seed</code>
          </p>
        )
      }

      <!-- 分页栏（搜索激活时由 SearchBox 隐藏） -->
      <div id="post-pagination" class="mt-8">
        {
          info.totalPages > 1 && <Pagination page={info.page} totalPages={info.totalPages} />
        }
      </div>
    </div>
  </section>
  </div>

  <!-- 微信好友二维码弹窗 -->
  <dialog id="wechat-dialog" class="wechat-dialog" aria-labelledby="wechat-dialog-title">
    <div class="settings-header">
      <div>
        <p class="pixel-chip text-primary">WECHAT</p>
        <h2 id="wechat-dialog-title" class="mt-1 font-display text-lg font-semibold">微信好友</h2>
      </div>
      <button id="wechat-close" type="button" aria-label="关闭" class="settings-close">×</button>
    </div>
    <img
      id="wechat-qr"
      src="/qrcodes/wechat.png"
      alt="微信二维码"
      class="mx-auto mt-4 w-44 rounded-lg border border-border"
    />
    <p id="wechat-qr-fallback" class="mt-4 hidden text-xs text-muted-foreground">
      二维码待上传 —— 请将图片放到 <code class="font-mono">public/qrcodes/wechat.png</code>。
    </p>
  </dialog>
</BaseLayout>

<script>
  /** 首页动效：Hero 进场序列 + 像素统计条数字滚动（GSAP，reduced-motion 时跳过） */
  import { heroIn, counterInView } from '@/lib/anim';

  const homeW = window as unknown as { __homeAnimsBound?: boolean };
  async function runHomeAnims(): Promise<void> {
    // 进场序列只在首次加载播放一次（刷新/SPA 转场后直接显示，避免重复动画卡隐藏）
    if (!homeW.__homeAnimsBound) {
      homeW.__homeAnimsBound = true;
      await heroIn();
    }
    void counterInView('.stat-count');
  }
  // 初始加载播放；View Transition 后新页面元素重新进场
  document.addEventListener('astro:page-load', () => void runHomeAnims());
  void runHomeAnims();

  /** 落地页滚动提示：点击平滑滚到文章区 */
  document.addEventListener('click', (e) => {
    const cue = (e.target as HTMLElement).closest<HTMLAnchorElement>('.scroll-cue');
    if (!cue) return;
    e.preventDefault();
    document.getElementById('latest')?.scrollIntoView({ behavior: 'smooth' });
  });

  /** ================= 首页标签筛选（点击文章下方标签即时过滤） =================
   *  - 只筛选**当前页**的服务端列表（无请求、无刷新）；全站检索走 /tags/[tag] 链接；
   *  - 与搜索框互斥：点击标签时先清空搜索词回到静态列表，再执行过滤；
   *  - 事件用 document 委托 + 每次重新查询 DOM，规避 View Transitions 后绑定失效。 */
  let activeTag = '';

  function applyTagFilter(tag: string): void {
    activeTag = tag;
    const bar = document.getElementById('tag-filter-bar');
    const nameEl = document.getElementById('tag-filter-name');
    const countEl = document.getElementById('tag-filter-count');
    const allLink = document.getElementById('tag-filter-all') as HTMLAnchorElement | null;
    const pagination = document.getElementById('post-pagination');

    // 让标签过滤与搜索互斥：有搜索词时先清空（SearchBox 监听 input 事件回到静态列表）
    const input = document.getElementById('search-input') as HTMLInputElement | null;
    if (input && input.value.trim()) {
      input.value = '';
      input.dispatchEvent(new Event('input', { bubbles: true }));
    }

    const needle = tag.toLowerCase();
    let shown = 0;
    document.querySelectorAll<HTMLElement>('#post-grid .post-row').forEach((row) => {
      const tags = (row.dataset.tags ?? '').split('|').filter(Boolean);
      const match = !needle || tags.includes(needle);
      row.classList.toggle('hidden', !match);
      if (match) shown += 1;
    });
    // 同页内高亮被选中的标签
    document.querySelectorAll<HTMLElement>('#post-grid [data-tag-filter]').forEach((btn) => {
      const on = !!needle && (btn.dataset.tagFilter ?? '').toLowerCase() === needle;
      btn.classList.toggle('bg-primary/15', on);
      btn.classList.toggle('text-primary', on);
    });

    if (!tag) {
      bar?.classList.add('hidden');
      pagination?.classList.remove('hidden');
      return;
    }
    if (bar) bar.classList.remove('hidden');
    if (nameEl) nameEl.textContent = `#${tag}`;
    if (countEl) countEl.textContent = `${shown} 篇（当前页）`;
    if (allLink) allLink.href = `/tags/${encodeURIComponent(tag)}`;
    // 过滤态下分页失效（分页针对全量列表），先隐藏避免误导
    pagination?.classList.add('hidden');
  }

  document.addEventListener('click', (e) => {
    const tagBtn = (e.target as HTMLElement).closest<HTMLElement>('[data-tag-filter]');
    if (tagBtn) {
      const tag = tagBtn.dataset.tagFilter ?? '';
      // 再次点击同一标签 = 取消筛选
      applyTagFilter(tag && tag.toLowerCase() === activeTag.toLowerCase() ? '' : tag);
      return;
    }
    if ((e.target as HTMLElement).closest('#tag-filter-clear')) applyTagFilter('');
  });

  /** 微信二维码弹窗（document 委托） */
  const wechatDialog = (): HTMLDialogElement | null =>
    document.getElementById('wechat-dialog') as HTMLDialogElement | null;
  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    if (target.closest('#wechat-btn')) {
      wechatDialog()?.showModal();
      return;
    }
    if (target.closest('#wechat-close')) {
      wechatDialog()?.close();
    }
  });
  // 二维码图片不存在时显示占位提示
  document.addEventListener('astro:page-load', () => {
    const img = document.getElementById('wechat-qr') as HTMLImageElement | null;
    if (!img) return;
    img.onerror = () => {
      img.classList.add('hidden');
      document.getElementById('wechat-qr-fallback')?.classList.remove('hidden');
    };
    if (img.complete && img.naturalWidth === 0) img.onerror?.(new Event('error'));
  });

  /**
   * 落地页 Hero 轮播（多图；单图不轮播）
   *
   * P3-6：定时器改为脚本作用域变量 + `astro:before-swap` 钩子清理，
   * 不再挂 window 全局。同时把切图动画的收尾 setTimeout 也纳入清理——
   * 原先这些短定时器换页后仍会触发，操作已被替换掉的旧 DOM。
   */
  let carouselTimer = 0;
  const carouselCleanups = new Set<number>();

  /** 停止轮播：清掉周期定时器与全部收尾定时器 */
  function stopCarousel(): void {
    if (carouselTimer) {
      window.clearInterval(carouselTimer);
      carouselTimer = 0;
    }
    carouselCleanups.forEach((t) => window.clearTimeout(t));
    carouselCleanups.clear();
  }

  /** 登记一个收尾定时器（动画结束后移除过渡 class） */
  function scheduleCarouselCleanup(fn: () => void, ms: number): void {
    const id = window.setTimeout(() => {
      carouselCleanups.delete(id);
      fn();
    }, ms);
    carouselCleanups.add(id);
  }

  const heroCarousel = (): void => {
    stopCarousel(); // 重入（View Transition / 重复调用）先清旧定时器
    const wrap = document.querySelector<HTMLElement>('.landing-hero-slides');
    if (!wrap) return;
    const slides = Array.from(wrap.querySelectorAll<HTMLElement>('.landing-hero-slide'));
    const n = slides.length;
    if (n < 2) return;
    const intervalMs = Number(wrap.dataset.interval ?? 6) * 1000;
    const anim = wrap.dataset.animation ?? 'slide';
    let cur = 0;
    carouselTimer = window.setInterval(() => {
      const prev = slides[cur];
      const next = slides[(cur + 1) % n];
      if (!prev || !next) return;
      if (anim === 'break') {
        prev.classList.add('is-breaking');
        next.classList.add('is-active');
        scheduleCarouselCleanup(() => prev.classList.remove('is-breaking'), 800);
      } else {
        prev.classList.remove('is-active');
        prev.classList.add('is-leaving');
        next.classList.add('is-active');
        scheduleCarouselCleanup(() => prev.classList.remove('is-leaving'), 950);
      }
      cur = (cur + 1) % n;
    }, intervalMs);
  };
  document.addEventListener('astro:before-swap', stopCarousel);
  document.addEventListener('astro:page-load', heroCarousel);
  heroCarousel();
</script>
