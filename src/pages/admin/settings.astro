---
/* ===== Imports ===== */
import AdminLayout from '@/layouts/AdminLayout.astro';
import SettingsForm from '@/components/admin/SettingsForm.astro';
---
<!-- ===== Template ===== -->
<AdminLayout title="设置">
  <section class="mx-auto h-full w-full max-w-3xl overflow-y-auto px-4 py-8">
    <div>
      <p class="pixel-chip text-primary">SETTINGS</p>
      <h1 class="mt-1 font-display text-2xl font-semibold">站点设置</h1>
      <p class="mt-1 text-sm text-muted-foreground">集中管理站点可自定义项，保存后全站生效。</p>
    </div>

    <!-- 分区导航：每个设置项独立成页（点击切换到对应设置子页面） -->
    <nav class="mt-5 flex flex-wrap gap-2" aria-label="设置分区">
      <a href="/admin/settings/site-name" class="settings-tab active">站点名称</a>
      <a href="/admin/settings/hero-quotes" class="settings-tab">诗词轮播</a>
      <a href="/admin/settings/landing" class="settings-tab">落地页</a>
      <a href="/admin/settings/appearance" class="settings-tab">外观</a>
    </nav>

    <!-- 站点名称分区 -->
    <SettingsForm section="site-name" />
  </section>
</AdminLayout>