---
/* ===== Imports ===== */
import AdminLayout from '@/layouts/AdminLayout.astro';
import MindMapEditor from '@/components/mindmap/MindMapEditor';
import { getMindmap } from '@/lib/mindmaps';
import { getArticleById, listArticleMeta } from '@/lib/articles';
import { renderMdx } from '@/lib/mdx';

/* ===== Logic ===== */
const { id } = Astro.params;
const map = id ? await getMindmap(id) : null;
if (!map) return Astro.redirect('/admin/mindmaps');

/** 全部文章（绑定下拉） */
const articles = await listArticleMeta();

/** 绑定文章的块级锚点映射（失效引用检测用） */
let articleBlockMap: Record<string, { type: string; text: string }> = {};
if (map.articleId) {
  const article = await getArticleById(map.articleId);
  if (article) {
    try {
      articleBlockMap = (await renderMdx(article.content)).blockMap;
    } catch {
      articleBlockMap = {};
    }
  }
}
---
<AdminLayout title="导图编辑器">
  <div class="flex h-full min-h-0 flex-col">
    <!-- 工具栏 -->
    <div class="flex shrink-0 flex-wrap items-center gap-2 border-b bg-card px-4 py-2">
      <a href="/admin/mindmaps" class="text-xs text-muted-foreground transition-colors hover:text-primary">
        ← 列表
      </a>
      <input
        id="map-title"
        type="text"
        maxlength="100"
        value={map.title}
        placeholder="导图标题"
        class="min-w-0 flex-1 rounded-md border border-input bg-background px-2 py-1 text-sm outline-none focus-visible:border-ring"
      />
      <select
        id="map-article"
        class="max-w-44 rounded-md border border-input bg-background px-2 py-1 text-xs outline-none focus-visible:border-ring"
        title="绑定文章（绑定后文章页显示导图入口）"
      >
        <option value="">不绑定（独立导图）</option>
        {articles.map((a) => (
          <option value={a.id} selected={map.articleId === a.id}>
            {a.title || '未命名'}
          </option>
        ))}
      </select>
      <span id="map-save-state" class="text-xs text-muted-foreground"></span>
      <button
        id="map-export-png"
        type="button"
        class="rounded-md border border-border px-2.5 py-1 text-xs transition-colors hover:border-primary hover:text-primary"
      >
        导出 PNG
      </button>
      <button
        id="map-export-svg"
        type="button"
        class="rounded-md border border-border px-2.5 py-1 text-xs transition-colors hover:border-primary hover:text-primary"
      >
        导出 SVG
      </button>
      <button
        id="map-export-md"
        type="button"
        class="rounded-md border border-border px-2.5 py-1 text-xs transition-colors hover:border-primary hover:text-primary"
      >
        导出大纲
      </button>
      <button
        id="map-delete"
        type="button"
        class="rounded-md border border-destructive/40 px-2.5 py-1 text-xs text-destructive transition-colors hover:bg-destructive/10"
      >
        删除
      </button>
    </div>
    <!-- 画布 -->
    <div class="min-h-0 flex-1">
      <MindMapEditor
        client:load
        mapId={map.id}
        initialTitle={map.title}
        initialData={map.data}
        blockMap={articleBlockMap}
      />
    </div>
  </div>
</AdminLayout>

<script>
  /** 编辑器工具栏：标题保存、导出、删除（画布与自动保存由 MindMapEditor 岛负责） */
  const titleInput = document.getElementById('map-title') as HTMLInputElement | null;
  const saveState = document.getElementById('map-save-state');
  let titleTimer = 0;

  function showState(text: string): void {
    if (saveState) saveState.textContent = text;
  }

  /** 导出：通过自定义事件交给岛内实例处理（导出由 simple-mind-map 实例执行） */
  function emitExport(type: 'png' | 'svg' | 'md'): void {
    document.dispatchEvent(new CustomEvent('mindmap-export', { detail: { type } }));
  }

  titleInput?.addEventListener('input', () => {
    showState('标题未保存');
    window.clearTimeout(titleTimer);
    titleTimer = window.setTimeout(async () => {
      const title = titleInput.value.trim();
      if (!title) return;
      try {
        const res = await fetch(`/api/mindmaps/${location.pathname.split('/').pop()}`, {
          method: 'PUT',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ title }),
        });
        showState(res.ok ? '' : '标题保存失败');
      } catch {
        showState('标题保存失败');
      }
    }, 800);
  });

  /** 绑定文章（切换即保存；不绑定 = 独立导图） */
  document.getElementById('map-article')?.addEventListener('change', async (e) => {
    const val = (e.target as HTMLSelectElement).value;
    const res = await fetch(`/api/mindmaps/${location.pathname.split('/').pop()}`, {
      method: 'PUT',
      headers: { 'content-type': 'application/json' },
      body: JSON.stringify({ articleId: val || null }),
    });
    showState(res.ok ? '已保存' : '绑定失败，请重试');
  });

  document.getElementById('map-export-png')?.addEventListener('click', () => emitExport('png'));
  document.getElementById('map-export-svg')?.addEventListener('click', () => emitExport('svg'));
  document.getElementById('map-export-md')?.addEventListener('click', () => emitExport('md'));

  document.getElementById('map-delete')?.addEventListener('click', async () => {
    const id = location.pathname.split('/').pop();
    if (!window.confirm('删除这张思维导图？')) return;
    const res = await fetch(`/api/mindmaps/${id}`, { method: 'DELETE' });
    if (res.ok) window.location.href = '/admin/mindmaps';
  });
</script>
