---
/*
 * admin/netdisk.astro —— 网盘浏览页（只读文件树，经 AList 中转层）
 *
 * 能力：按需懒加载的目录树（根 = AList 根目录下的全部挂载点，动态获取）、
 *       逐级展开到文件；每个节点右侧可一键复制直链（目录 = 递归收集其下所有文件）。
 * 权限：middleware 已按 netdisk 权限保护本路径。
 * 只读：本页不含任何写操作，后端也只保留 list / download / links 三个读接口。
 * 数据：SSR 只注入「是否就绪」与初始路径，树的每一层都由前端按需拉取。
 */
import AdminLayout from '@/layouts/AdminLayout.astro';
import { getNetdiskConfig, isNetdiskReady } from '@/lib/netdisk-config';

const cfg = await getNetdiskConfig();
const ready = isNetdiskReady(cfg);

/** 注入前端的运行参数（不含任何密码） */
const boot = {
  ready,
  enabled: cfg.enabled,
  initialPath: cfg.managePath || '/',
};
---

<AdminLayout title="网盘">
  <section class="mx-auto w-full max-w-5xl px-4 py-8" id="netdisk-page" data-boot={JSON.stringify(boot)}>
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <p class="pixel-chip text-primary">CLOUD DRIVE</p>
        <h1 class="mt-1 font-display text-2xl font-semibold">网盘</h1>
        <p class="mt-1 text-sm text-muted-foreground">
          只读浏览 AList 中转层下的文件树。点节点右侧的复制图标可取分享直链（目录会递归收集其下全部文件的直链）。
        </p>
      </div>
      <div class="flex shrink-0 items-center gap-2">
        <a href="/admin/settings/netdisk" data-astro-reload class="rounded-md border border-border px-4 py-2 text-sm text-muted-foreground transition-colors hover:border-primary hover:text-primary">
          ⚙ 对接设置
        </a>
      </div>
    </div>

    {
      !ready && (
        <div class="mt-6 rounded-md border border-amber-500/40 bg-amber-500/5 px-4 py-3 text-sm">
          <p class="font-medium text-amber-600">网盘对接尚未就绪</p>
          <p class="mt-1 text-xs text-muted-foreground">
            请先到「⚙ 对接设置」填写 AList 中转服务地址与管理员账号，并点「测试连接」确认可用。
            {!cfg.enabled && ' 当前总开关为关闭状态。'}
          </p>
        </div>
      )
    }

    {/* 工具栏 */}
    <div class="mt-6 flex flex-wrap items-center gap-2">
      <button type="button" id="nd-refresh" class="rounded-md border border-border px-3 py-1.5 text-sm text-muted-foreground transition-colors hover:border-primary hover:text-primary">
        ⟳ 刷新
      </button>
      <button type="button" id="nd-collapse" class="rounded-md border border-border px-3 py-1.5 text-sm text-muted-foreground transition-colors hover:border-primary hover:text-primary">
        全部折叠
      </button>
      <p id="nd-status" class="ml-auto text-xs text-muted-foreground" role="status"></p>
    </div>

    <p id="nd-error" class="mt-2 hidden text-xs text-destructive" role="alert"></p>

    {/* 文件树 */}
    <div class="mt-3 overflow-hidden rounded-md border border-border">
      <div id="nd-tree" class="py-1"></div>
    </div>

    <details class="mt-6 rounded-md border border-border px-4 py-3 text-xs text-muted-foreground">
      <summary class="cursor-pointer font-medium text-foreground">使用说明与限制</summary>
      <ul class="mt-2 list-disc space-y-1 pl-4">
        <li><strong>本页为只读</strong>：不含上传、下载、新建、删除等任何写操作。</li>
        <li>根节点是 AList 根目录下的<strong>全部挂载点</strong>（有几个就显示几个），逐级展开时才按需请求，不会一次性拉全树。</li>
        <li>复制出的链接是<strong>网盘直链</strong>（由 AList 提供，部分驱动会指向厂商 CDN），<strong>有时效</strong>，过期请重新复制。</li>
        <li>目录的复制按钮会<strong>递归收集</strong>其下所有文件的直链；为控制耗时，单次最多 200 个文件、递归 6 层。</li>
        <li>单个目录一层最多显示 200 项，超出部分会提示「还有 N 项未显示」。</li>
        <li>本功能依赖你本机的 AList 常驻运行；中转服务离线时此处会给出提示，不影响博客其他功能。</li>
      </ul>
    </details>
  </section>
</AdminLayout>

<script>
  /** 网盘浏览页交互：懒加载文件树 + 复制直链
   *  - 事件用 document 委托 + 每次解析元素，规避 View Transitions 后绑定失效；
   *  - 状态存在 TreeNode 里，任何变化都整树重渲染（懒加载下已展开节点有限，代价可接受）；
   *  - 复制走 navigator.clipboard，失败时回落到 textarea + execCommand。 */
  interface Boot {
    ready: boolean;
    enabled: boolean;
    initialPath: string;
  }

  /** 树节点（children === null 表示尚未加载） */
  interface TreeNode {
    name: string;
    path: string;
    isDir: boolean;
    size: number;
    modified: string;
    children: TreeNode[] | null;
    expanded: boolean;
    loading: boolean;
    error: string;
    /** 单层超过一页时未显示的条数 */
    hidden: number;
  }

  interface ListItem {
    name: string;
    size: number;
    is_dir: boolean;
    modified: string;
  }

  const ICON_CHEVRON =
    '<svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 18l6-6-6-6"/></svg>';
  const ICON_FOLDER =
    '<svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/></svg>';
  const ICON_FILE =
    '<svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 3v5h5"/><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"/></svg>';
  const ICON_COPY =
    '<svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="11" height="11" rx="2"/><path d="M5 15V5a2 2 0 0 1 2-2h10"/></svg>';
  const ICON_CHECK =
    '<svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6L9 17l-5-5"/></svg>';

  const page = document.getElementById('netdisk-page');
  if (page) {
    let boot: Boot = { ready: false, enabled: false, initialPath: '/' };
    try {
      boot = { ...boot, ...(JSON.parse(page.dataset.boot ?? '{}') as Partial<Boot>) };
    } catch {
      /* 用默认 */
    }

    function el<T extends HTMLElement>(id: string): T | null {
      return document.getElementById(id) as T | null;
    }
    const treeEl = el<HTMLDivElement>('nd-tree');
    const statusEl = el('nd-status');
    const errorEl = el('nd-error');

    let nodes: TreeNode[] = [];
    let loadingRoot = false;
    /** AList 单层一页的上限 */
    const PER_PAGE = 200;

    const esc = (s: string): string =>
      s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c] ?? c);

    const baseName = (p: string): string => p.slice(p.lastIndexOf('/') + 1) || p;

    const fmtSize = (n: number): string => {
      if (!Number.isFinite(n) || n <= 0) return '—';
      const units = ['B', 'KB', 'MB', 'GB', 'TB'];
      let i = 0;
      let v = n;
      while (v >= 1024 && i < units.length - 1) {
        v /= 1024;
        i += 1;
      }
      return `${i === 0 ? v : v.toFixed(v >= 10 ? 0 : 1)} ${units[i]}`;
    };

    const setError = (msg: string): void => {
      if (!errorEl) return;
      errorEl.textContent = msg;
      errorEl.classList.toggle('hidden', !msg);
    };
    const setStatus = (msg: string): void => {
      if (statusEl) statusEl.textContent = msg;
    };

    /** 复制到剪贴板：优先 Clipboard API，被拒时回落 textarea + execCommand */
    async function copyText(text: string): Promise<boolean> {
      try {
        if (navigator.clipboard?.writeText) {
          await navigator.clipboard.writeText(text);
          return true;
        }
      } catch {
        /* 走回落 */
      }
      try {
        const ta = document.createElement('textarea');
        ta.value = text;
        ta.setAttribute('readonly', '');
        ta.style.position = 'fixed';
        ta.style.top = '-1000px';
        document.body.appendChild(ta);
        ta.select();
        const ok = document.execCommand('copy');
        document.body.removeChild(ta);
        return ok;
      } catch {
        return false;
      }
    }

    /** 拉取某一层目录 → 排好序的节点数组 */
    async function fetchLayer(path: string, refresh = false): Promise<{ items: TreeNode[]; total: number }> {
      const res = await fetch('/api/netdisk/list', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ path, page: 1, perPage: PER_PAGE, refresh }),
      });
      const d = (await res.json().catch(() => ({}))) as {
        ok?: boolean;
        error?: string;
        items?: ListItem[];
        total?: number;
      };
      if (!res.ok || !d.ok) throw new Error(d.error ?? '加载失败');
      const raw = d.items ?? [];
      // 目录在前，同类型按中文名排序
      const sorted = [...raw].sort((a, b) =>
        a.is_dir === b.is_dir ? a.name.localeCompare(b.name, 'zh') : a.is_dir ? -1 : 1,
      );
      const dir = path.replace(/\/+$/, '');
      return {
        items: sorted.map((it) => ({
          name: it.name,
          path: `${dir}/${it.name}`,
          isDir: it.is_dir,
          size: it.size ?? 0,
          modified: it.modified ?? '',
          children: null,
          expanded: false,
          loading: false,
          error: '',
          hidden: 0,
        })),
        total: d.total ?? raw.length,
      };
    }

    /** 展开/折叠一个目录节点 */
    async function toggle(node: TreeNode): Promise<void> {
      if (!node.isDir) return;
      if (node.expanded) {
        node.expanded = false;
        renderTree();
        return;
      }
      node.expanded = true;
      if (node.children === null && !node.loading) {
        node.loading = true;
        node.error = '';
        renderTree();
        try {
          const { items, total } = await fetchLayer(node.path);
          node.children = items;
          node.hidden = Math.max(0, total - items.length);
        } catch (err) {
          node.children = [];
          node.error = err instanceof Error ? err.message : '加载失败';
        } finally {
          node.loading = false;
        }
      }
      renderTree();
    }

    function findNode(path: string, list: TreeNode[] = nodes): TreeNode | null {
      for (const n of list) {
        if (n.path === path) return n;
        if (n.children) {
          const hit = findNode(path, n.children);
          if (hit) return hit;
        }
      }
      return null;
    }

    /** 递归渲染一个节点（行 + 其已展开的子层） */
    function renderNode(n: TreeNode, depth: number): string {
      const pad = 10 + depth * 15;
      const childPad = pad + 30;

      const chevron = n.isDir
        ? `<button type="button" data-nd-toggle="${esc(n.path)}" aria-expanded="${n.expanded}" aria-label="${n.expanded ? '折叠' : '展开'}" class="flex size-4 shrink-0 items-center justify-center rounded text-muted-foreground transition-transform duration-150 hover:text-primary ${n.expanded ? 'rotate-90' : ''}">${ICON_CHEVRON}</button>`
        : '<span class="size-4 shrink-0" aria-hidden="true"></span>';

      const nameCell = n.isDir
        ? `<button type="button" data-nd-toggle="${esc(n.path)}" title="${esc(n.name)}" class="min-w-0 flex-1 truncate text-left text-sm transition-colors hover:text-primary">${esc(n.name)}</button>`
        : `<span class="min-w-0 flex-1 truncate text-sm" title="${esc(n.name)}">${esc(n.name)}</span>`;

      const meta = n.isDir ? '' : `<span class="shrink-0 text-xs tabular-nums text-muted-foreground">${fmtSize(n.size)}</span>`;

      const copyLabel = n.isDir ? '复制该文件夹下所有文件的直链' : '复制下载直链';
      const copyBtn = `<button type="button" data-nd-copy="${esc(n.path)}" data-nd-dir="${n.isDir ? '1' : '0'}" title="${copyLabel}" aria-label="${copyLabel}" class="shrink-0 rounded p-1 text-muted-foreground opacity-40 transition-all hover:text-primary group-hover:opacity-100 focus-visible:opacity-100">${ICON_COPY}</button>`;

      const row = `<div class="group flex items-center gap-1.5 py-1.5 pr-3 transition-colors hover:bg-accent/60" style="padding-left:${pad}px">
        ${chevron}
        <span class="shrink-0 text-muted-foreground">${n.isDir ? ICON_FOLDER : ICON_FILE}</span>
        ${nameCell}
        ${meta}
        ${copyBtn}
      </div>`;

      if (!n.isDir || !n.expanded) return row;

      let body = '';
      if (n.loading) body = `<p class="py-1.5 text-xs text-muted-foreground" style="padding-left:${childPad}px">加载中…</p>`;
      else if (n.error) body = `<p class="py-1.5 text-xs text-destructive" style="padding-left:${childPad}px">${esc(n.error)}</p>`;
      else if (!n.children || n.children.length === 0)
        body = `<p class="py-1.5 text-xs text-muted-foreground" style="padding-left:${childPad}px">空文件夹</p>`;
      else {
        body = n.children.map((c) => renderNode(c, depth + 1)).join('');
        if (n.hidden > 0)
          body += `<p class="py-1.5 text-xs text-muted-foreground" style="padding-left:${childPad}px">还有 ${n.hidden} 项未显示（超出单层上限）</p>`;
      }
      return row + body;
    }

    function renderTree(): void {
      if (!treeEl) return;
      if (nodes.length === 0) {
        treeEl.innerHTML = `<p class="px-3 py-6 text-center text-xs text-muted-foreground">${loadingRoot ? '加载中…' : '没有可显示的挂载点'}</p>`;
        return;
      }
      treeEl.innerHTML = nodes.map((n) => renderNode(n, 0)).join('');
    }

    /** 加载/刷新根层（= AList 根目录下的全部挂载点） */
    async function loadRoot(refresh = false): Promise<void> {
      loadingRoot = true;
      setError('');
      setStatus('加载中…');
      renderTree();
      try {
        const { items } = await fetchLayer(boot.initialPath || '/', refresh);
        nodes = items;
        setStatus(`共 ${nodes.length} 个挂载点 · 点击展开`);
      } catch (err) {
        nodes = [];
        setStatus('');
        setError(err instanceof Error ? err.message : '加载失败');
      } finally {
        loadingRoot = false;
        renderTree();
      }
    }

    /** 复制流程：目录递归收集直链，文件直接取单链 */
    async function handleCopy(btn: HTMLElement): Promise<void> {
      const path = btn.dataset.ndCopy ?? '';
      const isDir = btn.dataset.ndDir === '1';
      if (!path) return;
      setError('');
      btn.classList.add('pointer-events-none', 'opacity-40');
      try {
        if (isDir) {
          setStatus(`正在收集「${baseName(path)}」下的文件直链…`);
          const res = await fetch('/api/netdisk/links', {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify({ path }),
          });
          const d = (await res.json().catch(() => ({}))) as {
            ok?: boolean;
            error?: string;
            count?: number;
            truncated?: boolean;
            text?: string;
          };
          if (!res.ok || !d.ok) throw new Error(d.error ?? '收集直链失败');
          if (!d.count) {
            setStatus('');
            setError(`「${baseName(path)}」下没有可取直链的文件`);
            return;
          }
          if (!(await copyText(d.text ?? ''))) throw new Error('浏览器拒绝了剪贴板访问，请手动复制');
          btn.innerHTML = ICON_CHECK;
          window.setTimeout(() => {
            btn.innerHTML = ICON_COPY;
          }, 2000);
          setStatus(
            `已复制 ${d.count} 个链接${d.truncated ? '（目录过大，仅含前 200 个）' : ''} · 直链有时效，过期请重新复制`,
          );
        } else {
          setStatus(`正在获取「${baseName(path)}」的直链…`);
          const res = await fetch('/api/netdisk/download', {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify({ path }),
          });
          const d = (await res.json().catch(() => ({}))) as { ok?: boolean; error?: string; url?: string };
          if (!res.ok || !d.ok || !d.url) throw new Error(d.error ?? '获取直链失败');
          if (!(await copyText(d.url))) throw new Error('浏览器拒绝了剪贴板访问，请手动复制');
          btn.innerHTML = ICON_CHECK;
          window.setTimeout(() => {
            btn.innerHTML = ICON_COPY;
          }, 2000);
          setStatus(`已复制「${baseName(path)}」的直链 · 有时效，过期请重新复制`);
        }
      } catch (err) {
        setStatus('');
        setError(err instanceof Error ? err.message : '复制失败');
      } finally {
        btn.classList.remove('pointer-events-none', 'opacity-40');
      }
    }

    /* ---------- 事件委托 ---------- */
    document.addEventListener('click', (e) => {
      const t = e.target as HTMLElement;
      if (!t.closest('#netdisk-page')) return;

      const copyBtn = t.closest<HTMLElement>('[data-nd-copy]');
      if (copyBtn) {
        void handleCopy(copyBtn);
        return;
      }

      const toggleEl = t.closest<HTMLElement>('[data-nd-toggle]');
      if (toggleEl) {
        const node = findNode(toggleEl.dataset.ndToggle ?? '');
        if (node) void toggle(node);
        return;
      }

      if (t.closest('#nd-refresh')) {
        nodes = [];
        void loadRoot(true);
        return;
      }

      if (t.closest('#nd-collapse')) {
        const walk = (list: TreeNode[]): void => {
          for (const n of list) {
            n.expanded = false;
            if (n.children) walk(n.children);
          }
        };
        walk(nodes);
        renderTree();
        return;
      }
    });

    /** 初始化 / View Transition 后重新加载 */
    function init(): void {
      if (!document.getElementById('netdisk-page')) return;
      void loadRoot();
    }
    document.addEventListener('astro:page-load', init);
    init();
  }
</script>
