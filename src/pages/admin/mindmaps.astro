---
/* ===== Imports ===== */
import AdminLayout from '@/layouts/AdminLayout.astro';
import { listMindmaps } from '@/lib/mindmaps';
import { listArticleMeta } from '@/lib/articles';

/* ===== Logic ===== */
const maps = await listMindmaps();
const articles = await listArticleMeta();
const articleTitle = new Map(articles.map((a) => [a.id, a.title]));

function formatShort(date: Date): string {
  const p = (n: number): string => String(n).padStart(2, '0');
  return `${date.getFullYear()}-${p(date.getMonth() + 1)}-${p(date.getDate())} ${p(date.getHours())}:${p(date.getMinutes())}`;
}
---
<AdminLayout title="思维导图">
  <section class="mx-auto w-full max-w-4xl px-4 py-8">
    <div class="flex items-end justify-between gap-4">
      <div>
        <p class="pixel-chip text-primary">MIND MAP</p>
        <h1 class="mt-1 font-display text-2xl font-semibold">思维导图</h1>
        <p class="mt-1 text-sm text-muted-foreground">共 {maps.length} 张 · 绑定文章后可在文章页联动阅读</p>
      </div>
    </div>

    <!-- 新建 -->
    <div class="mt-5 rounded-lg border bg-card p-4">
      <p class="text-xs font-medium text-muted-foreground">新建思维导图</p>
      <div class="mt-2 flex flex-wrap items-center gap-2">
        <input
          id="map-title"
          type="text"
          maxlength="100"
          placeholder="导图标题"
          class="min-w-0 flex-1 rounded-md border border-input bg-background px-3 py-1.5 text-sm outline-none transition-colors focus-visible:border-ring"
        />
        <select
          id="map-article"
          class="rounded-md border border-input bg-background px-2 py-1.5 text-sm outline-none focus-visible:border-ring"
        >
          <option value="">不绑定文章（独立导图）</option>
          {articles.map((a) => <option value={a.id}>{a.title || '未命名'}</option>)}
        </select>
        <label class="flex items-center gap-1.5 text-xs text-muted-foreground">
          <input id="map-auto" type="checkbox" class="size-3.5 accent-[var(--color-primary)]" />
          按文章标题结构生成骨架
        </label>
        <button
          id="map-create"
          type="button"
          class="rounded-md bg-primary px-4 py-1.5 text-sm text-primary-foreground transition-opacity hover:opacity-90"
        >
          创建
        </button>
      </div>
      <p id="map-status" class="mt-2 hidden text-xs text-destructive" role="alert"></p>
    </div>

    <!-- 列表 -->
    <ul class="mt-6 divide-y divide-border rounded-lg border bg-card">
      {
        maps.length === 0 ? (
          <li class="px-4 py-8 text-center text-sm text-muted-foreground">还没有思维导图 —— 在上方创建一张吧。</li>
        ) : (
          maps.map((m) => (
            <li class="flex items-center justify-between gap-3 px-4 py-3">
              <div class="min-w-0">
                <p class="truncate text-sm font-medium">{m.title || '未命名'}</p>
                <p class="font-pixel mt-0.5 text-[0.6rem] text-muted-foreground">
                  {m.articleId ? `绑定文章：${articleTitle.get(m.articleId) || '未知'}` : '独立导图'} · {formatShort(m.updatedAt)}
                </p>
              </div>
              <div class="flex shrink-0 gap-2 text-xs">
                <a
                  href={`/admin/mindmaps/${m.id}`}
                  class="rounded-md border border-border px-2.5 py-1 transition-colors duration-200 hover:border-primary hover:text-primary"
                >
                  编辑
                </a>
                <button
                  type="button"
                  data-map-del={m.id}
                  data-map-title={m.title || '未命名'}
                  class="rounded-md border border-destructive/40 px-2.5 py-1 text-destructive transition-colors duration-200 hover:bg-destructive/10"
                >
                  删除
                </button>
              </div>
            </li>
          ))
        )
      }
    </ul>
  </section>
</AdminLayout>

<script>
  const status = document.getElementById('map-status') as HTMLParagraphElement | null;
  function setStatus(msg: string): void {
    if (!status) return;
    status.textContent = msg;
    status.classList.remove('hidden');
  }

  document.getElementById('map-create')?.addEventListener('click', async () => {
    const title = (document.getElementById('map-title') as HTMLInputElement | null)?.value.trim() ?? '';
    if (!title) {
      setStatus('请填写导图标题');
      return;
    }
    const articleId = (document.getElementById('map-article') as HTMLSelectElement | null)?.value ?? '';
    const auto = (document.getElementById('map-auto') as HTMLInputElement | null)?.checked ?? false;
    try {
      let res: Response;
      if (auto && articleId) {
        res = await fetch('/api/mindmaps/generate', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ articleId, title }),
        });
      } else {
        res = await fetch('/api/mindmaps', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ title, articleId: articleId || undefined }),
        });
      }
      const d = (await res.json().catch(() => ({}))) as { error?: string; map?: { id: string } };
      if (!res.ok || !d.map) {
        setStatus(d.error ?? '创建失败');
        return;
      }
      window.location.href = `/admin/mindmaps/${d.map.id}`;
    } catch {
      setStatus('创建失败，请重试');
    }
  });

  document.addEventListener('click', async (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLElement>('[data-map-del]');
    if (!btn) return;
    if (!window.confirm(`删除思维导图「${btn.dataset.mapTitle}」？`)) return;
    const res = await fetch(`/api/mindmaps/${btn.dataset.mapDel}`, { method: 'DELETE' });
    if (res.ok) btn.closest('li')?.remove();
  });
</script>
