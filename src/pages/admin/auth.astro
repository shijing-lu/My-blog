---
/* ===== Props ===== */
/* （授权管理页无 Props） */

/* ===== Imports ===== */
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getProfile } from '@/lib/profile';
import {
  isTopAdmin,
  listAdminAccounts,
  listApplications,
  PERMISSION_KEYS,
} from '@/lib/admin-auth';
import { authAccList, authAppList } from '@/lib/admin-auth-render';

/* ===== Logic ===== */
/**
 * 授权管理页（仅顶级管理员：站主密码会话 / 站主通用会话 / role=top 的 GitHub 管理员）。
 *
 * - 申请审批：访客的 GitHub 权限申请（同意时逐项勾选授权；拒绝即驳回）；
 * - 管理员列表：逐项权限管理、设置其他顶级管理员、移除授权账号；
 * - GitHub 资料同步：把博客头像与个人中心设置为指定 GitHub 账号的资料（顶级管理员权限）。
 *   非顶级管理员访问：渲染「无权进入该页面」。
 */
const top = await isTopAdmin(Astro.cookies);
const applications = top ? await listApplications('pending') : [];
const accounts = top ? await listAdminAccounts() : [];
const profile = top ? await getProfile() : null;
const permEntries = Object.entries(PERMISSION_KEYS);
---
<!-- ===== Template ===== -->
<BaseLayout title="授权管理" description="授权管理（仅顶级管理员）" indexable={false}>
  <section class="mx-auto w-full max-w-3xl px-4 py-12" data-perm-entries={JSON.stringify(permEntries)}>
    {
      !top ? (
        <div class="p-6">
          <p class="pixel-chip text-primary">AUTH</p>
          <h1 class="mt-1 font-display text-2xl font-semibold">无权进入该页面</h1>
          <p class="mt-2 text-sm leading-relaxed text-muted-foreground">
            授权管理页仅顶级管理员（站主）可进入。请通过导航栏「管理」入口以站主身份登录。
          </p>
          <a
            href="/manage"
            class="mt-4 inline-flex rounded-md border border-border px-4 py-2 text-sm transition-colors duration-200 hover:bg-accent"
          >
            返回管理入口
          </a>
        </div>
      ) : (
        <div>
          <p class="pixel-chip text-primary">AUTH</p>
          <h1 class="mt-1 font-display text-2xl font-semibold">授权管理</h1>
          <p class="mt-1 text-sm text-muted-foreground">管理 GitHub 授权管理员、审批权限申请、同步个人资料。</p>

          <!-- ===== 权限申请审批 ===== -->
          <div class="mt-8">
            <h2 class="font-display text-lg font-semibold">权限申请</h2>
            <div id="app-list" class="mt-3 space-y-3" set:html={authAppList(applications, permEntries)} />
          </div>

          <!-- ===== 管理员列表 ===== -->
          <div class="mt-10">
            <h2 class="font-display text-lg font-semibold">授权管理员</h2>
            <div id="acc-list" class="mt-3 space-y-3" set:html={authAccList(accounts, permEntries)} />
          </div>

          <!-- ===== 添加管理员（按 GitHub 用户名直接建号） ===== -->
          <div class="mt-6">
            <h3 class="text-sm font-medium">添加管理员</h3>
            <p class="mt-1 text-xs leading-relaxed text-muted-foreground">
              直接输入 GitHub 用户名建号，无需对方先提交申请。角色选「顶级管理员」即自动拥有全部权限（无需逐项授权）；选「普通管理员」则需在列表中逐项勾选。站主可把自己的 GitHub 账号添加为顶级管理员，此后用 GitHub 登录即拥有全部权限。
            </p>
            <div class="mt-2 flex flex-wrap gap-2">
              <input
                id="acc-add-login"
                type="text"
                placeholder="GitHub 用户名（如 octocat）"
                class="min-w-0 flex-1 rounded-md border border-input bg-background px-3 py-2 text-sm outline-none transition-colors focus-visible:border-ring focus-visible:ring-[3px] focus-visible:ring-ring/40"
              />
              <select
                id="acc-add-role"
                class="rounded-md border border-input bg-background px-3 py-2 text-sm outline-none transition-colors focus-visible:border-ring"
              >
                <option value="admin">普通管理员</option>
                <option value="top">顶级管理员</option>
              </select>
              <button
                id="acc-add-btn"
                type="button"
                class="rounded-md bg-primary px-4 py-2 text-sm text-primary-foreground transition-opacity duration-200 hover:opacity-90"
              >
                添加
              </button>
            </div>
            <p id="acc-add-msg" class="mt-2 hidden text-xs" role="status" />
          </div>

          <!-- ===== GitHub 资料同步（个人信息设置） ===== -->
          <div class="mt-10">
            <h2 class="font-display text-lg font-semibold">个人资料同步（GitHub）</h2>
            <p class="mt-1 text-sm leading-relaxed text-muted-foreground">
              将博客头像与个人中心设置为指定 GitHub 账号的资料，头像与昵称自动从 GitHub 获取。当前：{profile?.nickname || '博主'}
            </p>
            <div class="mt-3 flex gap-2">
              <input
                id="gh-sync-login"
                type="text"
                placeholder="GitHub 用户名（如 octocat）"
                class="min-w-0 flex-1 rounded-md border border-input bg-background px-3 py-2 text-sm outline-none transition-colors focus-visible:border-ring focus-visible:ring-[3px] focus-visible:ring-ring/40"
              />
              <button
                id="gh-sync-btn"
                type="button"
                class="rounded-md bg-primary px-4 py-2 text-sm text-primary-foreground transition-opacity duration-200 hover:opacity-90"
              >
                同步资料
              </button>
            </div>
            <p id="gh-sync-msg" class="mt-2 hidden text-xs" role="status" />
          </div>
        </div>
      )
    }
  </section>
</BaseLayout>

<script>
  import { authAccList, authAppList } from '@/lib/admin-auth-render';
  import type { AuthAccountRenderable, AuthApplicationRenderable, PermEntries } from '@/lib/admin-auth-render';

  /** 实时查询元素（ClientRouter 转场后 DOM 会被替换，必须每次重新取） */
  function el(id: string): HTMLElement | null {
    return document.getElementById(id);
  }

  /** 权限项 [key, label]（由模板的 data-perm-entries 传入 —— 本脚本不能 import @/lib/admin-auth，会带进 db） */
  function permEntries(): PermEntries {
    const raw = document.querySelector<HTMLElement>('[data-perm-entries]')?.dataset.permEntries;
    if (!raw) return [];
    try {
      return JSON.parse(raw) as PermEntries;
    } catch {
      return [];
    }
  }

  /** 从容器内收集勾选的权限键 */
  function collectPerms(container: HTMLElement, attr: string): string[] {
    return Array.from(container.querySelectorAll<HTMLInputElement>(`input[${attr}]:checked`))
      .map((el) => el.getAttribute(attr) ?? '')
      .filter(Boolean);
  }

  /* ================= 勾选态快照 / 回贴 =================
   * 重绘列表会把 DOM 整个换掉，其它行里**尚未保存**的勾选会随之消失
   * （原实现整页 reload 丢得更彻底）。这里在重绘前快照、重绘后回贴，
   * 保住那些「已经勾好、但还没点保存」的项。
   */

  /** 快照当前所有行的勾选态（按行 id 分组） */
  function snapshotPerms(): { app: Map<string, string[]>; acc: Map<string, string[]> } {
    const grab = (rowSel: string, idAttr: string, permAttr: string): Map<string, string[]> => {
      const out = new Map<string, string[]>();
      document.querySelectorAll<HTMLElement>(rowSel).forEach((row) => {
        const id = row.getAttribute(idAttr);
        if (id) out.set(id, collectPerms(row, permAttr));
      });
      return out;
    };
    return {
      app: grab('[data-app-id]', 'data-app-id', 'data-app-perm'),
      acc: grab('[data-acc-id]', 'data-acc-id', 'data-acc-perm'),
    };
  }

  /** 把快照回贴到（可能刚被重绘过的）列表上 */
  function restorePerms(snap: { app: Map<string, string[]>; acc: Map<string, string[]> }): void {
    const apply = (rowSel: string, idAttr: string, permAttr: string, saved: Map<string, string[]>): void => {
      document.querySelectorAll<HTMLElement>(rowSel).forEach((row) => {
        const keys = saved.get(row.getAttribute(idAttr) ?? '');
        if (!keys) return; // 新出现的行（刚添加/刚提升）：沿用服务端渲染出的状态
        row.querySelectorAll<HTMLInputElement>(`input[${permAttr}]`).forEach((box) => {
          box.checked = keys.includes(box.getAttribute(permAttr) ?? '');
        });
      });
    };
    apply('[data-app-id]', 'data-app-id', 'data-app-perm', snap.app);
    apply('[data-acc-id]', 'data-acc-id', 'data-acc-perm', snap.acc);
  }

  /* ================= 列表就地重绘 ================= */

  /** 需要重绘哪一块列表 */
  type RefreshTarget = 'none' | 'applications' | 'accounts' | 'both';

  /**
   * 重新拉取列表并就地重绘（**不整页刷新**）。
   * 重绘前快照勾选态、重绘后回贴，保住其它行未保存的勾选。
   */
  async function refreshLists(target: RefreshTarget): Promise<void> {
    if (target === 'none') return;
    const snap = snapshotPerms();
    const entries = permEntries();
    const jobs: Promise<void>[] = [];

    if (target === 'applications' || target === 'both') {
      jobs.push(
        fetch('/api/admin-auth/applications?status=pending')
          .then((r) => (r.ok ? r.json() : null))
          .then((d: { applications?: AuthApplicationRenderable[] } | null) => {
            const list = el('app-list');
            if (list) list.innerHTML = authAppList(d?.applications ?? [], entries);
          })
          .catch(() => undefined),
      );
    }
    if (target === 'accounts' || target === 'both') {
      jobs.push(
        fetch('/api/admin-auth/accounts')
          .then((r) => (r.ok ? r.json() : null))
          .then((d: { accounts?: AuthAccountRenderable[] } | null) => {
            const list = el('acc-list');
            if (list) list.innerHTML = authAccList(d?.accounts ?? [], entries);
          })
          .catch(() => undefined),
      );
    }
    await Promise.all(jobs);
    restorePerms(snap);
  }

  /**
   * 统一请求。
   *
   * - 失败 → `onError`（调用方回滚按钮状态并提示）；
   * - 成功 → 先按 `refresh` 就地重绘受影响列表，再调 `onSuccess` 收尾。
   *
   * 关键：**不再 `window.location.reload()`**。本页的典型用法是「逐行勾好权限、再逐个点同意」，
   * 整页刷新会把其它行里刚勾好、还没提交的权限全部抹掉。
   */
  function request(
    url: string,
    init: RequestInit,
    handlers: {
      onError: (data: { error?: string }) => void;
      onSuccess?: () => void;
      refresh?: RefreshTarget;
    },
  ): void {
    fetch(url, init)
      .then(async (res) => {
        const data = (await res.json().catch(() => ({}))) as { error?: string };
        if (!res.ok) {
          handlers.onError(data);
          return;
        }
        await refreshLists(handlers.refresh ?? 'none');
        handlers.onSuccess?.();
      })
      .catch(() => handlers.onError({ error: '网络错误，请重试' }));
  }

  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;

    /* 申请审批：同意（带勾选权限）/ 拒绝 */
    const appBtn = target.closest<HTMLButtonElement>('[data-action="approve"], [data-action="reject"]');
    if (appBtn) {
      const row = appBtn.closest<HTMLElement>('[data-app-id]');
      const id = row?.dataset.appId;
      if (!row || !id) return;
      const approve = appBtn.dataset.action === 'approve';
      const perms = approve ? collectPerms(row, 'data-app-perm') : [];
      appBtn.disabled = true;
      request(
        '/api/admin-auth/applications',
        {
          method: 'PATCH',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ id, action: approve ? 'approve' : 'reject', permissions: perms }),
        },
        {
          // 申请行会消失；同意时还会新增一行授权账号
          refresh: 'both',
          onError: (data) => {
            appBtn.disabled = false;
            alert(data.error ?? '操作失败');
          },
        },
      );
      return;
    }

    /* 管理员列表：保存权限 / 升降级 / 移除 */
    const accBtn = target.closest<HTMLButtonElement>(
      '[data-action="save"], [data-action="promote"], [data-action="demote"], [data-action="remove"]',
    );
    if (accBtn) {
      const row = accBtn.closest<HTMLElement>('[data-acc-id]');
      const id = row?.dataset.accId;
      if (!row || !id) return;
      const action = accBtn.dataset.action ?? '';
      accBtn.disabled = true;
      if (action === 'save') {
        request(
          '/api/admin-auth/accounts',
          {
            method: 'PATCH',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify({ id, permissions: collectPerms(row, 'data-acc-perm') }),
          },
          {
            refresh: 'accounts',
            onSuccess: () => {
              accBtn.disabled = false;
            },
            onError: (data) => {
              accBtn.disabled = false;
              alert(data.error ?? '操作失败');
            },
          },
        );
      } else if (action === 'promote' || action === 'demote') {
        request(
          '/api/admin-auth/accounts',
          {
            method: 'PATCH',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify({ id, role: action === 'promote' ? 'top' : 'admin' }),
          },
          {
            refresh: 'accounts',
            onSuccess: () => {
              accBtn.disabled = false;
            },
            onError: (data) => {
              accBtn.disabled = false;
              alert(data.error ?? '操作失败');
            },
          },
        );
      } else {
        if (!window.confirm('确定移除该授权管理员？移除后其将失去全部管理权限。')) {
          accBtn.disabled = false;
          return;
        }
        request(
          `/api/admin-auth/accounts?id=${encodeURIComponent(id)}`,
          { method: 'DELETE' },
          {
            refresh: 'accounts',
            onError: (data) => {
              accBtn.disabled = false;
              alert(data.error ?? '操作失败');
            },
          },
        );
      }
      return;
    }

    /* 添加管理员：POST /api/admin-auth/accounts { login, role } */
    if (target.closest('#acc-add-btn')) {
      const input = el('acc-add-login') as HTMLInputElement | null;
      const roleSel = el('acc-add-role') as HTMLSelectElement | null;
      const btn = el('acc-add-btn') as HTMLButtonElement | null;
      const msg = el('acc-add-msg');
      if (!btn) return;
      const login = (input?.value ?? '').trim();
      const role = roleSel?.value === 'top' ? 'top' : 'admin';
      const fail = (text: string): void => {
        btn.disabled = false;
        btn.textContent = '添加';
        if (msg) {
          msg.textContent = text;
          msg.className = 'mt-2 text-xs text-destructive';
          msg.classList.remove('hidden');
        }
      };
      if (!login) {
        fail('请输入 GitHub 用户名');
        return;
      }
      btn.disabled = true;
      btn.textContent = '添加中…';
      request(
        '/api/admin-auth/accounts',
        {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ login, role }),
        },
        {
          refresh: 'accounts',
          onSuccess: () => {
            btn.disabled = false;
            btn.textContent = '添加';
            if (input) input.value = '';
            if (msg) {
              msg.textContent = '已添加，列表已更新。';
              msg.className = 'mt-2 text-xs text-primary';
              msg.classList.remove('hidden');
            }
          },
          onError: (data) => fail(data.error ?? '操作失败'),
        },
      );
      return;
    }

    /* GitHub 资料同步 */
    if (target.closest('#gh-sync-btn')) {
      const input = el('gh-sync-login') as HTMLInputElement | null;
      const msg = el('gh-sync-msg');
      const btn = el('gh-sync-btn') as HTMLButtonElement | null;
      if (!btn) return;
      const login = (input?.value ?? '').trim();
      const fail = (text: string): void => {
        btn.disabled = false;
        btn.textContent = '同步资料';
        if (msg) {
          msg.textContent = text;
          msg.className = 'mt-2 text-xs text-destructive';
          msg.classList.remove('hidden');
        }
      };
      if (!login) {
        fail('请输入 GitHub 用户名');
        return;
      }
      btn.disabled = true;
      btn.textContent = '同步中…';
      request(
        '/api/admin-auth/profile-sync',
        {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ login }),
        },
        {
          // 不刷新列表：同步只改资料。导航头像在下次页面加载时更新（提示里已说明）
          refresh: 'none',
          onSuccess: () => {
            btn.disabled = false;
            btn.textContent = '同步资料';
            if (msg) {
              msg.textContent =
                '已同步：博客头像与个人中心已更新为该 GitHub 账号的资料（导航头像将在下次页面加载时更新）。';
              msg.className = 'mt-2 text-xs text-primary';
              msg.classList.remove('hidden');
            }
          },
          onError: (data) => fail(data.error ?? '操作失败'),
        },
      );
    }
  });
</script>
