---
/* ===== Imports ===== */
import AdminLayout from '@/layouts/AdminLayout.astro';
import { listNav } from '@/lib/nav';

/* ===== Logic ===== */
const categories = await listNav();
const categoriesJson = JSON.stringify(
  categories.map((c) => ({ id: c.id, name: c.name, icon: c.icon, sort: c.sort, sites: c.sites })),
);
---
<AdminLayout title="导航管理">
  <section class="mx-auto w-full max-w-4xl px-4 py-8">
    <div>
      <p class="pixel-chip text-primary">NAV MANAGER</p>
      <h1 class="mt-1 font-display text-2xl font-semibold">导航管理</h1>
      <p class="mt-1 text-sm text-muted-foreground">管理分类与网站；改网站所属分类即可移动。数据存服务端。</p>
    </div>

    <!-- 分类管理 -->
    <div class="mt-6 rounded-lg border bg-card p-4">
      <div class="flex items-center justify-between">
        <h2 class="font-medium">分类</h2>
        <span class="text-xs text-muted-foreground">共 {categories.length} 个</span>
      </div>
      <!-- 新增/编辑表单 -->
      <div class="mt-3 flex flex-wrap items-center gap-2">
        <input id="cat-name" type="text" maxlength="50" placeholder="分类名（如 AI 工具）"
          class="min-w-0 flex-1 rounded-md border border-input bg-background px-3 py-1.5 text-sm outline-none focus-visible:border-ring" />
        <input id="cat-icon" type="text" maxlength="20" placeholder="图标（emoji，可选）"
          class="w-28 rounded-md border border-input bg-background px-3 py-1.5 text-sm outline-none focus-visible:border-ring" />
        <input id="cat-sort" type="number" min="0" value="0"
          class="w-20 rounded-md border border-input bg-background px-3 py-1.5 text-sm outline-none focus-visible:border-ring" />
        <button id="cat-save" type="button" data-mode="create"
          class="rounded-md bg-primary px-4 py-1.5 text-sm text-primary-foreground transition-opacity hover:opacity-90">
          添加分类
        </button>
      </div>
      <p id="cat-status" class="mt-2 hidden text-xs text-destructive" role="alert"></p>
      <!-- 分类列表 -->
      <ul id="cat-list" class="mt-3 divide-y divide-border rounded-md border border-border">
        {categories.map((c) => (
          <li class="flex items-center justify-between gap-3 px-3 py-2">
            <div class="flex min-w-0 items-center gap-2">
              {c.icon && <span class="shrink-0 text-sm">{c.icon}</span>}
              <span class="truncate text-sm font-medium">{c.name}</span>
              <span class="font-pixel text-[0.55rem] text-muted-foreground">{c.sites.length} 站</span>
            </div>
            <div class="flex shrink-0 gap-2 text-xs">
              <button type="button" data-cat-edit={c.id} class="rounded-md border border-border px-2 py-1 hover:border-primary hover:text-primary">编辑</button>
              <button type="button" data-cat-del={c.id} data-cat-name={c.name} class="rounded-md border border-destructive/40 px-2 py-1 text-destructive hover:bg-destructive/10">删除</button>
            </div>
          </li>
        ))}
      </ul>
    </div>

    <!-- 网站管理 -->
    <div class="mt-6 rounded-lg border bg-card p-4">
      <h2 class="font-medium">网站</h2>
      <p class="mt-0.5 text-xs text-muted-foreground">图标留空自动抓 favicon（域名 /favicon.ico → Google 兜底）。</p>
      <!-- 新增/编辑表单 -->
      <div class="mt-3 grid gap-2 sm:grid-cols-2">
        <input id="site-name" type="text" maxlength="80" placeholder="网站名"
          class="rounded-md border border-input bg-background px-3 py-1.5 text-sm outline-none focus-visible:border-ring" />
        <input id="site-url" type="url" maxlength="300" placeholder="网址 https://…"
          class="rounded-md border border-input bg-background px-3 py-1.5 text-sm outline-none focus-visible:border-ring" />
        <input id="site-desc" type="text" maxlength="200" placeholder="一句话简介（可选）"
          class="rounded-md border border-input bg-background px-3 py-1.5 text-sm outline-none focus-visible:border-ring" />
        <input id="site-icon" type="text" maxlength="500" placeholder="图标 URL（可选，留空自动）"
          class="rounded-md border border-input bg-background px-3 py-1.5 text-sm outline-none focus-visible:border-ring" />
        <div class="flex items-center gap-2">
          <select id="site-cat" class="min-w-0 flex-1 rounded-md border border-input bg-background px-2 py-1.5 text-sm outline-none focus-visible:border-ring">
            {categories.map((c) => <option value={c.id}>{c.name}</option>)}
          </select>
          <input id="site-sort" type="number" min="0" value="0" title="排序"
            class="w-16 rounded-md border border-input bg-background px-2 py-1.5 text-sm outline-none focus-visible:border-ring" />
        </div>
      </div>
      <div class="mt-2 flex items-center gap-2">
        <button id="site-scan" type="button"
          class="rounded-md border border-border px-3 py-1.5 text-xs text-muted-foreground transition-colors hover:border-primary/50 hover:text-primary">
          自动抓取简介
        </button>
        <span id="site-scan-status" class="text-xs text-muted-foreground"></span>
        <button id="site-save" type="button" data-mode="create"
          class="ml-auto rounded-md bg-primary px-4 py-1.5 text-sm text-primary-foreground transition-opacity hover:opacity-90">
          添加网站
        </button>
      </div>
      <p id="site-status" class="mt-2 hidden text-xs text-destructive" role="alert"></p>
      <!-- 网站列表（按分类分组） -->
      <div class="mt-4 space-y-5">
        {categories.map((c) => (
          <div>
            <h3 class="flex items-center gap-2 text-xs">
              {c.icon && <span>{c.icon}</span>}
              <span class="font-pixel uppercase tracking-wider text-primary">{c.name}</span>
              <span class="h-px flex-1 bg-border" />
            </h3>
            <ul class="mt-2 divide-y divide-border rounded-md border border-border">
              {
                c.sites.length === 0 ? (
                  <li class="px-3 py-2 text-xs text-muted-foreground">暂无网站</li>
                ) : (
                  c.sites.map((s) => (
                    <li class="flex items-center justify-between gap-3 px-3 py-2">
                      <div class="min-w-0">
                        <p class="truncate text-sm font-medium">{s.name}</p>
                        <p class="truncate text-xs text-muted-foreground">{s.url}</p>
                      </div>
                      <div class="flex shrink-0 items-center gap-2 text-xs">
                        <select data-site-move={s.id} class="rounded-md border border-input bg-background px-1.5 py-1 outline-none">
                          {categories.map((c2) => (
                            <option value={c2.id} selected={c2.id === c.id}>{c2.name}</option>
                          ))}
                        </select>
                        <button type="button" data-site-edit={s.id} class="rounded-md border border-border px-2 py-1 hover:border-primary hover:text-primary">编辑</button>
                        <button type="button" data-site-del={s.id} data-site-name={s.name} class="rounded-md border border-destructive/40 px-2 py-1 text-destructive hover:bg-destructive/10">删除</button>
                      </div>
                    </li>
                  ))
                )
              }
            </ul>
          </div>
        ))}
      </div>
    </div>
    <!-- 分类数据（供脚本读取，避免 script 插值问题） -->
    <div id="nav-data" data-categories={categoriesJson} class="hidden" aria-hidden="true" />
  </section>
</AdminLayout>

<script>
  /** 导航管理：分类/网站 增删改查 + 移动分类（操作后刷新） */
  interface CategoryJson { id: string; name: string; icon: string | null; sort: number; sites: { id: string; name: string; url: string; icon: string | null; desc: string | null }[] }
  const CATEGORIES = JSON.parse((document.getElementById('nav-data') as HTMLElement).dataset.categories ?? '[]') as CategoryJson[];
  const status = (id: string): HTMLElement | null => document.getElementById(id);
  const setStatus = (id: string, msg: string): void => {
    const el = status(id);
    if (!el) return;
    el.textContent = msg;
    el.classList.remove('hidden');
  };
  const clearStatus = (id: string): void => status(id)?.classList.add('hidden');
  const $ = (id: string): HTMLInputElement | HTMLSelectElement =>
    document.getElementById(id) as HTMLInputElement | HTMLSelectElement;
  const val = (id: string): string => ($(id) as HTMLInputElement).value?.trim() ?? '';

  // ---- 分类：新增 / 编辑 ----
  let editingCategoryId: string | null = null;
  document.getElementById('cat-save')?.addEventListener('click', async () => {
    const name = val('cat-name');
    const icon = val('cat-icon');
    const sort = Number(val('cat-sort') || 0);
    if (!name) { setStatus('cat-status', '请填写分类名'); return; }
    clearStatus('cat-status');
    const isEdit = editingCategoryId !== null;
    const body = isEdit
      ? { id: editingCategoryId, name, icon: icon || null, sort }
      : { name, icon: icon || null, sort };
    const res = await fetch('/api/nav/categories', {
      method: isEdit ? 'PUT' : 'POST',
      headers: { 'content-type': 'application/json' },
      body: JSON.stringify(body),
    });
    if (!res.ok) { setStatus('cat-status', '操作失败，请重试'); return; }
    window.location.reload();
  });

  document.getElementById('cat-list')?.addEventListener('click', async (e) => {
    const target = e.target as HTMLElement;
    const edit = target.closest<HTMLElement>('[data-cat-edit]');
    if (edit) {
      const cat = CATEGORIES.find((c) => c.id === edit.dataset.catEdit);
      if (!cat) return;
      editingCategoryId = cat.id;
      ($('cat-name') as HTMLInputElement).value = cat.name;
      ($('cat-icon') as HTMLInputElement).value = cat.icon ?? '';
      ($('cat-sort') as HTMLInputElement).value = String(cat.sort);
      const btn = document.getElementById('cat-save');
      if (btn) btn.textContent = '保存修改';
      return;
    }
    const del = target.closest<HTMLElement>('[data-cat-del]');
    if (del) {
      if (!window.confirm(`删除分类「${del.dataset.catName}」？其下所有网站将一并删除。`)) return;
      const res = await fetch('/api/nav/categories', {
        method: 'DELETE',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ id: del.dataset.catDel }),
      });
      if (res.ok) window.location.reload();
    }
  });

  // ---- 网站：新增 / 编辑 ----
  let editingSiteId: string | null = null;

  /** 自动抓取简介：填网址 → scan → 填充简介输入框 */
  document.getElementById('site-scan')?.addEventListener('click', async () => {
    const url = val('site-url');
    const scanStatus = document.getElementById('site-scan-status');
    if (!url) {
      if (scanStatus) { scanStatus.textContent = '先填写网址'; scanStatus.classList.add('text-destructive'); }
      return;
    }
    if (scanStatus) { scanStatus.textContent = '抓取中…'; scanStatus.classList.remove('text-destructive'); }
    try {
      const res = await fetch('/api/nav/sites/scan', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ url }),
      });
      const d = (await res.json().catch(() => ({}))) as { desc?: string; error?: string };
      if (res.ok && d.desc) {
        ($('site-desc') as HTMLInputElement).value = d.desc;
        if (scanStatus) { scanStatus.textContent = '已抓取简介 ✓'; scanStatus.classList.add('text-emerald-600'); }
      } else {
        if (scanStatus) { scanStatus.textContent = d.error ?? '未抓到简介'; scanStatus.classList.add('text-destructive'); }
      }
    } catch {
      if (scanStatus) { scanStatus.textContent = '抓取失败'; scanStatus.classList.add('text-destructive'); }
    }
  });

  document.getElementById('site-save')?.addEventListener('click', async () => {
    const name = val('site-name');
    const url = val('site-url');
    const desc = val('site-desc');
    const icon = val('site-icon');
    const categoryId = ($('site-cat') as HTMLSelectElement).value;
    const sort = Number(val('site-sort') || 0);
    if (!name || !url) { setStatus('site-status', '请填写网站名和网址'); return; }
    clearStatus('site-status');
    const isEdit = editingSiteId !== null;
    const body = isEdit
      ? { id: editingSiteId, name, url, icon: icon || null, desc: desc || null, categoryId, sort }
      : { name, url, icon: icon || null, desc: desc || null, categoryId, sort };
    const res = await fetch('/api/nav/sites', {
      method: isEdit ? 'PUT' : 'POST',
      headers: { 'content-type': 'application/json' },
      body: JSON.stringify(body),
    });
    if (!res.ok) { setStatus('site-status', '操作失败，请重试'); return; }
    window.location.reload();
  });

  // 网站列表：编辑 / 删除 / 移动分类
  document.querySelectorAll<HTMLElement>('[data-site-edit]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const siteId = btn.dataset.siteEdit;
      if (!siteId) return;
      const cat = CATEGORIES.find((c) => c.sites.some((s) => s.id === siteId));
      const site = cat?.sites.find((s) => s.id === siteId);
      if (!site || !cat) return;
      editingSiteId = siteId;
      ($('site-name') as HTMLInputElement).value = site.name;
      ($('site-url') as HTMLInputElement).value = site.url;
      ($('site-desc') as HTMLInputElement).value = site.desc ?? '';
      ($('site-icon') as HTMLInputElement).value = site.icon ?? '';
      ($('site-sort') as HTMLInputElement).value = '0';
      ($('site-cat') as HTMLSelectElement).value = cat.id;
      const btn2 = document.getElementById('site-save');
      if (btn2) btn2.textContent = '保存修改';
      document.getElementById('site-name')?.scrollIntoView({ behavior: 'smooth', block: 'center' });
    });
  });
  document.querySelectorAll<HTMLElement>('[data-site-del]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      if (!window.confirm(`删除网站「${btn.dataset.siteName}」？`)) return;
      const res = await fetch('/api/nav/sites', {
        method: 'DELETE',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ id: btn.dataset.siteDel }),
      });
      if (res.ok) window.location.reload();
    });
  });
  document.querySelectorAll<HTMLSelectElement>('[data-site-move]').forEach((sel) => {
    sel.addEventListener('change', async () => {
      const res = await fetch('/api/nav/sites', {
        method: 'PUT',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ id: sel.dataset.siteMove, categoryId: sel.value }),
      });
      if (res.ok) window.location.reload();
    });
  });
</script>
