---
/* ===== Imports ===== */
import AdminLayout from '@/layouts/AdminLayout.astro';
import { listNav } from '@/lib/nav';
import { adminCatList, adminCatOptions, adminSiteGroups } from '@/lib/admin-nav-render';

/* ===== Logic ===== */
const categories = await listNav();
/**
 * 注入给客户端的数据源。
 *
 * `sort` + `createdAt` 都要带上：客户端增删改后要**就地**把记录插到与服务端
 * `ORDER BY sort, createdAt` 一致的位置，否则原地重绘的顺序会和刷新后不一致。
 */
const categoriesJson = JSON.stringify(
  categories.map((c) => ({
    id: c.id,
    name: c.name,
    icon: c.icon,
    sort: c.sort,
    createdAt: c.createdAt,
    sites: c.sites,
  })),
);
---
<AdminLayout title="导航管理">
  <section class="mx-auto w-full max-w-4xl px-4 py-8">
    <div>
      <p class="pixel-chip text-primary">NAV MANAGER</p>
      <h1 class="mt-1 font-display text-2xl font-semibold">导航管理</h1>
      <p class="mt-1 text-sm text-muted-foreground">管理分类与网站；改网站所属分类即可移动。数据存服务端。</p>
    </div>

    <!-- 分类管理 -->
    <div class="mt-6">
      <div class="flex items-center justify-between">
        <h2 class="font-medium">分类</h2>
        <span id="cat-count" class="text-xs text-muted-foreground">共 {categories.length} 个</span>
      </div>
      <!-- 新增/编辑表单 -->
      <div class="mt-3 flex flex-wrap items-center gap-2">
        <input id="cat-name" type="text" maxlength="50" placeholder="分类名（如 AI 工具）"
          class="min-w-0 flex-1 rounded-md border border-input bg-background px-3 py-1.5 text-sm outline-none focus-visible:border-ring" />
        <input id="cat-icon" type="text" maxlength="20" placeholder="图标（emoji，可选）"
          class="w-28 rounded-md border border-input bg-background px-3 py-1.5 text-sm outline-none focus-visible:border-ring" />
        <input id="cat-sort" type="number" min="0" value="0"
          class="w-20 rounded-md border border-input bg-background px-3 py-1.5 text-sm outline-none focus-visible:border-ring" />
        <button id="cat-save" type="button" data-mode="create"
          class="rounded-md bg-primary px-4 py-1.5 text-sm text-primary-foreground transition-opacity hover:opacity-90">
          添加分类
        </button>
      </div>
      <p id="cat-status" class="mt-2 hidden text-xs text-destructive" role="alert"></p>
      <!-- 分类列表（客户端就地重建：见 renderAll） -->
      <ul id="cat-list" class="mt-3 list-blend" set:html={adminCatList(categories)} />
    </div>

    <!-- 网站管理 -->
    <div class="mt-6">
      <h2 class="font-medium">网站</h2>
      <p class="mt-0.5 text-xs text-muted-foreground">图标留空自动抓 favicon（域名 /favicon.ico → Google 兜底）。</p>
      <!-- 新增/编辑表单 -->
      <div class="mt-3 grid gap-2 sm:grid-cols-2">
        <input id="site-name" type="text" maxlength="80" placeholder="网站名"
          class="rounded-md border border-input bg-background px-3 py-1.5 text-sm outline-none focus-visible:border-ring" />
        <input id="site-url" type="url" maxlength="300" placeholder="网址 https://…"
          class="rounded-md border border-input bg-background px-3 py-1.5 text-sm outline-none focus-visible:border-ring" />
        <input id="site-desc" type="text" maxlength="200" placeholder="一句话简介（可选）"
          class="rounded-md border border-input bg-background px-3 py-1.5 text-sm outline-none focus-visible:border-ring" />
        <input id="site-icon" type="text" maxlength="500" placeholder="图标 URL（可选，留空自动）"
          class="rounded-md border border-input bg-background px-3 py-1.5 text-sm outline-none focus-visible:border-ring" />
        <div class="flex items-center gap-2">
          <select id="site-cat" class="min-w-0 flex-1 rounded-md border border-input bg-background px-2 py-1.5 text-sm outline-none focus-visible:border-ring" set:html={adminCatOptions(categories)} />
          <input id="site-sort" type="number" min="0" value="0" title="排序"
            class="w-16 rounded-md border border-input bg-background px-2 py-1.5 text-sm outline-none focus-visible:border-ring" />
        </div>
      </div>
      <div class="mt-2 flex items-center gap-2">
        <button id="site-scan" type="button"
          class="rounded-md border border-border px-3 py-1.5 text-xs text-muted-foreground transition-colors hover:border-primary/50 hover:text-primary">
          自动抓取简介
        </button>
        <span id="site-scan-status" class="text-xs text-muted-foreground"></span>
        <button id="site-save" type="button" data-mode="create"
          class="ml-auto rounded-md bg-primary px-4 py-1.5 text-sm text-primary-foreground transition-opacity hover:opacity-90">
          添加网站
        </button>
      </div>
      <p id="site-status" class="mt-2 hidden text-xs text-destructive" role="alert"></p>
      <!-- 网站列表（按分类分组；客户端就地重建：见 renderAll） -->
      <div id="site-groups" class="mt-4 space-y-5" set:html={adminSiteGroups(categories)} />
    </div>
    <!-- 分类数据（供脚本读取，避免 script 插值问题） -->
    <div id="nav-data" data-categories={categoriesJson} class="hidden" aria-hidden="true" />
  </section>
</AdminLayout>

<script>
  /**
   * 导航管理：分类/网站 增删改查 + 移动分类。
   *
   * 关键点：所有增删改**不再整页刷新**（原来 5 处 window.location.reload()）。
   * 成功回调里改内存中的 CATEGORIES，再用 admin-nav-render 的同一套渲染函数就地重建
   * 分类列表 / 网站分组 / 分类下拉 —— 因此滚动位置与表单状态都保留。
   *
   * 顺序一致性：插入位置由 `insertOrdered`（sort 升序，同 sort 按 createdAt 升序）决定，
   * 与服务端 `ORDER BY sort, createdAt` 等价，刷新前后顺序一致。
   *
   * 事件一律用 document 委托：列表节点会被 renderAll() 整块替换，直接绑在节点上的
   * 监听器会随之丢失。（AdminLayout 未启用 ClientRouter，导航即整页加载，不存在监听器累积。）
   */
  import { confirmDanger } from '@/lib/confirm';
  import { adminCatList, adminCatOptions, adminSiteGroups, insertOrdered, removeById } from '@/lib/admin-nav-render';

  interface SiteJson {
    id: string;
    name: string;
    url: string;
    icon: string | null;
    desc: string | null;
    sort: number;
    createdAt: string;
    categoryId: string;
    subCategoryId: string | null;
  }
  interface CategoryJson {
    id: string;
    name: string;
    icon: string | null;
    sort: number;
    createdAt: string;
    sites: SiteJson[];
  }

  const CATEGORIES = JSON.parse(
    (document.getElementById('nav-data') as HTMLElement).dataset.categories ?? '[]',
  ) as CategoryJson[];

  const $ = (id: string): HTMLInputElement | HTMLSelectElement =>
    document.getElementById(id) as HTMLInputElement | HTMLSelectElement;
  const val = (id: string): string => ($(id) as HTMLInputElement).value?.trim() ?? '';
  const setStatus = (id: string, msg: string): void => {
    const el = document.getElementById(id);
    if (!el) return;
    el.textContent = msg;
    el.classList.remove('hidden');
  };
  const clearStatus = (id: string): void => document.getElementById(id)?.classList.add('hidden');

  /** 跨分类按 id 找网站 */
  function findSite(siteId: string): { cat: CategoryJson; index: number } | null {
    for (const cat of CATEGORIES) {
      const index = cat.sites.findIndex((s) => s.id === siteId);
      if (index >= 0) return { cat, index };
    }
    return null;
  }

  /**
   * 就地重建三块由数据驱动的列表（**不刷新页面**）。
   *
   * `#site-cat` 会被重建，所以先记住用户当前的选择再恢复，避免改别的条目时选择被重置。
   */
  function renderAll(): void {
    const keepCat = ($('site-cat') as HTMLSelectElement | null)?.value ?? '';

    const countEl = document.getElementById('cat-count');
    if (countEl) countEl.textContent = `共 ${CATEGORIES.length} 个`;

    const catList = document.getElementById('cat-list');
    if (catList) catList.innerHTML = adminCatList(CATEGORIES);

    const siteGroups = document.getElementById('site-groups');
    if (siteGroups) siteGroups.innerHTML = adminSiteGroups(CATEGORIES);

    const siteCat = $('site-cat') as HTMLSelectElement | null;
    if (siteCat) {
      siteCat.innerHTML = adminCatOptions(CATEGORIES);
      if (keepCat && CATEGORIES.some((c) => c.id === keepCat)) siteCat.value = keepCat;
    }

    // 隐藏数据源同步，保持 DOM 与内存状态一致
    const dataEl = document.getElementById('nav-data');
    if (dataEl) dataEl.dataset.categories = JSON.stringify(CATEGORIES);
  }

  function resetCatForm(): void {
    editingCategoryId = null;
    ($('cat-name') as HTMLInputElement).value = '';
    ($('cat-icon') as HTMLInputElement).value = '';
    ($('cat-sort') as HTMLInputElement).value = '0';
    const btn = document.getElementById('cat-save');
    if (btn) btn.textContent = '添加分类';
  }

  function resetSiteForm(): void {
    editingSiteId = null;
    ($('site-name') as HTMLInputElement).value = '';
    ($('site-url') as HTMLInputElement).value = '';
    ($('site-desc') as HTMLInputElement).value = '';
    ($('site-icon') as HTMLInputElement).value = '';
    ($('site-sort') as HTMLInputElement).value = '0';
    const btn = document.getElementById('site-save');
    if (btn) btn.textContent = '添加网站';
    const scan = document.getElementById('site-scan-status');
    if (scan) scan.textContent = '';
  }

  /* ================= 分类：新增 / 编辑 ================= */

  let editingCategoryId: string | null = null;

  document.getElementById('cat-save')?.addEventListener('click', async () => {
    const name = val('cat-name');
    const icon = val('cat-icon');
    const sort = Number(val('cat-sort') || 0);
    if (!name) {
      setStatus('cat-status', '请填写分类名');
      return;
    }
    clearStatus('cat-status');
    const isEdit = editingCategoryId !== null;
    const body = isEdit
      ? { id: editingCategoryId, name, icon: icon || null, sort }
      : { name, icon: icon || null, sort };
    const res = await fetch('/api/nav/categories', {
      method: isEdit ? 'PUT' : 'POST',
      headers: { 'content-type': 'application/json' },
      body: JSON.stringify(body),
    });
    if (!res.ok) {
      setStatus('cat-status', '操作失败，请重试');
      return;
    }
    const d = (await res.json().catch(() => ({}))) as {
      category?: { id: string; name: string; icon: string | null; sort: number; createdAt: string };
    };
    const saved = d.category;
    if (saved) {
      const existing = CATEGORIES.find((c) => c.id === saved.id);
      if (existing) {
        // 编辑：先摘出来再按新 sort 插回，顺序与服务端一致
        removeById(CATEGORIES, saved.id);
        existing.name = saved.name;
        existing.icon = saved.icon;
        existing.sort = saved.sort;
        insertOrdered(CATEGORIES, existing);
      } else {
        insertOrdered(CATEGORIES, {
          id: saved.id,
          name: saved.name,
          icon: saved.icon,
          sort: saved.sort,
          createdAt: saved.createdAt,
          sites: [],
        });
      }
    }
    resetCatForm();
    renderAll();
  });

  document.addEventListener('click', async (e) => {
    const target = e.target as HTMLElement;

    const edit = target.closest<HTMLElement>('[data-cat-edit]');
    if (edit) {
      const cat = CATEGORIES.find((c) => c.id === edit.dataset.catEdit);
      if (!cat) return;
      editingCategoryId = cat.id;
      ($('cat-name') as HTMLInputElement).value = cat.name;
      ($('cat-icon') as HTMLInputElement).value = cat.icon ?? '';
      ($('cat-sort') as HTMLInputElement).value = String(cat.sort);
      const btn = document.getElementById('cat-save');
      if (btn) btn.textContent = '保存修改';
      return;
    }

    const del = target.closest<HTMLElement>('[data-cat-del]');
    if (del) {
      const catId = del.dataset.catDel;
      if (!catId) return;
      const cat = CATEGORIES.find((c) => c.id === catId);
      const catName = del.dataset.catName ?? cat?.name ?? '';
      const count = cat?.sites.length ?? 0;
      const msg =
        count > 0
          ? `删除分类「${catName}」？其下 ${count} 个网站也会一并删除。`
          : `删除分类「${catName}」？`;
      if (!(await confirmDanger(msg))) return;
      const res = await fetch('/api/nav/categories', {
        method: 'DELETE',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ id: catId }),
      });
      if (!res.ok) return;
      removeById(CATEGORIES, catId);
      // 正在编辑的对象被删掉了 → 清空表单，避免保存到不存在的记录
      if (editingCategoryId === catId) resetCatForm();
      if (editingSiteId && !findSite(editingSiteId)) resetSiteForm();
      renderAll();
    }
  });

  /* ================= 网站：新增 / 编辑 ================= */

  let editingSiteId: string | null = null;

  /** 自动抓取简介：填网址 → scan → 填充简介输入框 */
  document.getElementById('site-scan')?.addEventListener('click', async () => {
    const url = val('site-url');
    const scanStatus = document.getElementById('site-scan-status');
    if (!url) {
      if (scanStatus) {
        scanStatus.textContent = '先填写网址';
        scanStatus.classList.add('text-destructive');
      }
      return;
    }
    if (scanStatus) {
      scanStatus.textContent = '抓取中…';
      scanStatus.classList.remove('text-destructive');
    }
    try {
      const res = await fetch('/api/nav/sites/scan', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ url }),
      });
      const d = (await res.json().catch(() => ({}))) as { desc?: string; error?: string };
      if (res.ok && d.desc) {
        ($('site-desc') as HTMLInputElement).value = d.desc;
        if (scanStatus) {
          scanStatus.textContent = '已抓取简介 ✓';
          scanStatus.classList.add('text-emerald-600');
        }
      } else {
        if (scanStatus) {
          scanStatus.textContent = d.error ?? '未抓到简介';
          scanStatus.classList.add('text-destructive');
        }
      }
    } catch {
      if (scanStatus) {
        scanStatus.textContent = '抓取失败';
        scanStatus.classList.add('text-destructive');
      }
    }
  });

  document.getElementById('site-save')?.addEventListener('click', async () => {
    const name = val('site-name');
    const url = val('site-url');
    const desc = val('site-desc');
    const icon = val('site-icon');
    const categoryId = ($('site-cat') as HTMLSelectElement).value;
    const sort = Number(val('site-sort') || 0);
    if (!name || !url) {
      setStatus('site-status', '请填写网站名和网址');
      return;
    }
    if (!categoryId) {
      setStatus('site-status', '请先创建分类');
      return;
    }
    clearStatus('site-status');
    const isEdit = editingSiteId !== null;
    const body = isEdit
      ? { id: editingSiteId, name, url, icon: icon || null, desc: desc || null, categoryId, sort }
      : { name, url, icon: icon || null, desc: desc || null, categoryId, sort };
    const res = await fetch('/api/nav/sites', {
      method: isEdit ? 'PUT' : 'POST',
      headers: { 'content-type': 'application/json' },
      body: JSON.stringify(body),
    });
    if (!res.ok) {
      setStatus('site-status', '操作失败，请重试');
      return;
    }
    const d = (await res.json().catch(() => ({}))) as { website?: SiteJson };
    const saved = d.website;
    if (saved) {
      // 编辑 / 换分类都先把旧记录摘掉，再按 sort 插到目标分类的正确位置
      for (const c of CATEGORIES) removeById(c.sites, saved.id);
      const target = CATEGORIES.find((c) => c.id === saved.categoryId);
      if (target) {
        insertOrdered(target.sites, {
          id: saved.id,
          name: saved.name,
          url: saved.url,
          icon: saved.icon,
          desc: saved.desc,
          sort: saved.sort,
          createdAt: saved.createdAt,
          categoryId: saved.categoryId,
          subCategoryId: saved.subCategoryId,
        });
      }
    }
    resetSiteForm();
    renderAll();
  });

  /** 网站行：编辑（预填表单）/ 删除（就地移除） */
  document.addEventListener('click', async (e) => {
    const target = e.target as HTMLElement;

    const edit = target.closest<HTMLElement>('[data-site-edit]');
    if (edit) {
      const siteId = edit.dataset.siteEdit;
      if (!siteId) return;
      const hit = findSite(siteId);
      if (!hit) return;
      const site = hit.cat.sites[hit.index]!;
      editingSiteId = siteId;
      ($('site-name') as HTMLInputElement).value = site.name;
      ($('site-url') as HTMLInputElement).value = site.url;
      ($('site-desc') as HTMLInputElement).value = site.desc ?? '';
      ($('site-icon') as HTMLInputElement).value = site.icon ?? '';
      // 预填**真实** sort：以前写死 '0'，等于一编辑保存就把排序静默清零
      ($('site-sort') as HTMLInputElement).value = String(site.sort);
      ($('site-cat') as HTMLSelectElement).value = hit.cat.id;
      const btn = document.getElementById('site-save');
      if (btn) btn.textContent = '保存修改';
      document.getElementById('site-name')?.scrollIntoView({ behavior: 'smooth', block: 'center' });
      return;
    }

    const del = target.closest<HTMLElement>('[data-site-del]');
    if (del) {
      const siteId = del.dataset.siteDel;
      if (!siteId) return;
      if (!(await confirmDanger(`删除网站「${del.dataset.siteName}」？`))) return;
      const res = await fetch('/api/nav/sites', {
        method: 'DELETE',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ id: siteId }),
      });
      if (!res.ok) return;
      const hit = findSite(siteId);
      if (hit) removeById(hit.cat.sites, siteId);
      if (editingSiteId === siteId) resetSiteForm();
      renderAll();
    }
  });

  /** 移动分类：change 会冒泡，故用 document 委托（列表会被 renderAll 替换） */
  document.addEventListener('change', async (e) => {
    const sel = (e.target as HTMLElement).closest<HTMLSelectElement>('[data-site-move]');
    if (!sel) return;
    const siteId = sel.dataset.siteMove;
    if (!siteId) return;
    const res = await fetch('/api/nav/sites', {
      method: 'PUT',
      headers: { 'content-type': 'application/json' },
      body: JSON.stringify({ id: siteId, categoryId: sel.value }),
    });
    if (!res.ok) {
      // 失败：用内存状态重绘，把下拉恢复到真实归属
      setStatus('site-status', '移动失败，请重试');
      renderAll();
      return;
    }
    const d = (await res.json().catch(() => ({}))) as { website?: SiteJson };
    const saved = d.website;
    if (saved) {
      for (const c of CATEGORIES) removeById(c.sites, saved.id);
      const target = CATEGORIES.find((c) => c.id === saved.categoryId);
      if (target) {
        insertOrdered(target.sites, {
          id: saved.id,
          name: saved.name,
          url: saved.url,
          icon: saved.icon,
          desc: saved.desc,
          sort: saved.sort,
          createdAt: saved.createdAt,
          categoryId: saved.categoryId,
          subCategoryId: saved.subCategoryId,
        });
      }
    }
    renderAll();
  });
</script>
