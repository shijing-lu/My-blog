---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { isTopAdmin } from '@/lib/admin-auth';
import { getQuickNoteFacets, listQuickNotes, toQuickNoteView } from '@/lib/quick-notes';

export const prerender = false;

if (!(await isTopAdmin(Astro.cookies))) {
  return Astro.redirect('/login?next=%2Fquick-notes');
}
Astro.response.headers.set('cache-control', 'private, no-store');

const rawTag = Astro.url.searchParams.get('tag') ?? '';
const tag = rawTag.length <= 20 ? rawTag : '';
const rawMonth = Astro.url.searchParams.get('month') ?? '';
const month = /^\d{4}-(0[1-9]|1[0-2])$/.test(rawMonth) ? rawMonth : '';
const rawPage = Number(Astro.url.searchParams.get('page') ?? 1);
const page = Number.isFinite(rawPage) ? Math.max(1, Math.floor(rawPage)) : 1;
const pageSize = 20;
const [{ notes, total }, facets] = await Promise.all([
  listQuickNotes(pageSize, (page - 1) * pageSize, { tag: tag || undefined, month: month || undefined }),
  getQuickNoteFacets(),
]);
const cards = await Promise.all(notes.map(toQuickNoteView));
const maxPage = Math.max(1, Math.ceil(total / pageSize));
const dateFmt = new Intl.DateTimeFormat('zh-CN', { timeZone: 'Asia/Shanghai', year: 'numeric', month: 'long', day: 'numeric', hour: '2-digit', minute: '2-digit' });
const monthFmt = new Intl.DateTimeFormat('en-CA', { timeZone: 'Asia/Shanghai', year: 'numeric', month: '2-digit' });
const monthOf = (date: Date) => {
  const parts = monthFmt.formatToParts(date);
  return `${parts.find((p) => p.type === 'year')?.value}-${parts.find((p) => p.type === 'month')?.value}`;
};
const href = (next: { tag?: string; month?: string; page?: number }) => {
  const params = new URLSearchParams();
  if (next.tag) params.set('tag', next.tag);
  if (next.month) params.set('month', next.month);
  if (next.page && next.page > 1) params.set('page', String(next.page));
  return `/quick-notes${params.size ? `?${params}` : ''}`;
};
---
<BaseLayout title="随心录" description="私密记录，随时回看" indexable={false}>
  <section class="mx-auto w-full max-w-6xl px-4 py-10">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <p class="font-pixel text-[0.6rem] uppercase tracking-[0.2em] text-primary">QUICK NOTES</p>
        <h1 class="mt-1 font-display text-3xl font-semibold tracking-tight">随心录</h1>
        <p class="mt-2 text-sm text-muted-foreground">记下当时的想法，想起时再读。</p>
      </div>
      <button type="button" data-note-open="" class="rounded-md bg-primary px-4 py-2 text-sm text-primary-foreground transition-opacity hover:opacity-90">写一条</button>
    </div>
    <div class="pixel-divider mt-6" />
    <div class="mt-8 grid gap-8 lg:grid-cols-[minmax(0,1fr)_220px]">
      <div>
        {(tag || month) && <div class="mb-5 flex flex-wrap items-center gap-2 text-sm text-muted-foreground">
          <span>筛选：{tag && `#${tag}`}{tag && month && ' · '}{month && `${month.slice(0, 4)} 年 ${Number(month.slice(5))} 月`}</span>
          <a href="/quick-notes" class="text-primary hover:underline">清除筛选</a>
        </div>}
        {cards.length === 0 ? <div class="rounded-xl border border-dashed border-border px-6 py-16 text-center text-sm text-muted-foreground">
          <p>{tag || month ? '没有符合条件的记录' : '还没有记录，随手写下第一条吧。'}</p>
          {(tag || month) && <a href="/quick-notes" class="mt-3 inline-block text-primary hover:underline">查看全部记录</a>}
        </div> : <div class="space-y-5">
          {cards.map((note, i) => <Fragment>
            {(i === 0 || monthOf(cards[i - 1]!.createdAt) !== monthOf(note.createdAt)) && <div class="flex items-center gap-3 pt-2"><span class="font-display text-sm font-semibold text-primary">{monthOf(note.createdAt).replace('-', ' / ')}</span><span class="h-px flex-1 bg-border" /></div>}
            <article class="group rounded-xl border border-border bg-card/70 p-5 pr-16 transition-colors hover:border-primary/40 sm:pr-5" data-note-id={note.id}>
              <div class="flex items-start justify-between gap-3">
                <div class="min-w-0">
                  <p class="text-xs text-muted-foreground">{dateFmt.format(note.createdAt)}{note.updatedAt.getTime() - note.createdAt.getTime() > 1000 && ' · 已编辑'}</p>
                  <h2 class="mt-2 font-display text-lg font-semibold">{note.title || note.content.replace(/^\s*#{1,6}\s*/m, '').split('\n').find(Boolean)?.slice(0, 64) || '无标题记录'}</h2>
                </div>
                <button type="button" data-note-open={note.id} aria-label={`编辑${note.title || '记录'}`} class="shrink-0 rounded-md border border-border px-2.5 py-1 text-xs text-muted-foreground hover:border-primary hover:text-primary">编辑</button>
              </div>
              <div class="prose mt-3 max-h-48 max-w-none overflow-hidden text-sm" set:html={note.contentHtml} />
              {note.tags.length > 0 && <div class="mt-4 flex flex-wrap gap-2 border-t border-border pt-3">
                {note.tags.map((item) => <a href={href({ tag: item, month })} class="rounded-full bg-muted px-2.5 py-1 text-xs text-muted-foreground hover:bg-primary/10 hover:text-primary">#{item}</a>)}
              </div>}
            </article>
          </Fragment>)}
        </div>}
        {maxPage > 1 && <nav aria-label="随心录分页" class="mt-8 flex items-center justify-center gap-4 text-sm">
          {page > 1 && <a href={href({ tag, month, page: page - 1 })} class="rounded-md border border-border px-3 py-1.5 hover:border-primary">上一页</a>}
          <span class="text-muted-foreground">{Math.min(page, maxPage)} / {maxPage}</span>
          {page < maxPage && <a href={href({ tag, month, page: page + 1 })} class="rounded-md border border-border px-3 py-1.5 hover:border-primary">下一页</a>}
        </nav>}
      </div>
      <aside class="space-y-6 lg:sticky lg:top-24 lg:self-start" aria-label="随心录筛选">
        <div class="rounded-xl border border-border bg-card/70 p-4">
          <h2 class="font-display text-sm font-semibold">标签</h2>
          <div class="mt-3 flex flex-wrap gap-2">
            {facets.tags.length ? facets.tags.map((item) => <a href={href({ tag: tag === item.name ? '' : item.name, month })} aria-current={tag === item.name ? 'true' : undefined} class={`rounded-full px-2.5 py-1 text-xs transition-colors ${tag === item.name ? 'bg-primary text-primary-foreground' : 'bg-muted text-muted-foreground hover:text-primary'}`}>#{item.name} <span class="opacity-70">{item.count}</span></a>) : <p class="text-xs text-muted-foreground">暂无标签</p>}
          </div>
        </div>
        <div class="rounded-xl border border-border bg-card/70 p-4">
          <h2 class="font-display text-sm font-semibold">时间线</h2>
          <nav class="mt-3 max-h-72 space-y-1 overflow-y-auto" aria-label="按月份筛选">
            {facets.months.length ? facets.months.map((item) => <a href={href({ tag, month: month === item.name ? '' : item.name })} aria-current={month === item.name ? 'true' : undefined} class={`flex justify-between rounded-md px-2 py-1.5 text-xs ${month === item.name ? 'bg-primary text-primary-foreground' : 'text-muted-foreground hover:bg-accent hover:text-foreground'}`}><span>{item.name.slice(0, 4)} 年 {Number(item.name.slice(5))} 月</span><span>{item.count}</span></a>) : <p class="text-xs text-muted-foreground">暂无记录</p>}
          </nav>
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>

<script>
  if (!(window as unknown as { __quickNotePageBound?: boolean }).__quickNotePageBound) {
    (window as unknown as { __quickNotePageBound?: boolean }).__quickNotePageBound = true;
    document.addEventListener('click', (event) => {
      const button = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-note-open]');
      if (!button) return;
      const detail = { id: button.dataset.noteOpen || undefined };
      (window as unknown as { __quickNotePending?: { id?: string } }).__quickNotePending = detail;
      window.dispatchEvent(new CustomEvent('quick-notes:open', { detail }));
    });
    window.addEventListener('quick-notes:changed', () => {
      if (location.pathname === '/quick-notes') location.reload();
    });
  }
  const linkedNote = new URLSearchParams(location.search).get('note');
  if (linkedNote) {
    const detail = { id: linkedNote };
    (window as unknown as { __quickNotePending?: { id?: string } }).__quickNotePending = detail;
    window.dispatchEvent(new CustomEvent('quick-notes:open', { detail }));
  }
</script>
