---
/* ===== Props ===== */
/* （动态路由，无 Props） */

/* ===== Imports ===== */
import { getArticleBySlug, listArticleMeta } from '@/lib/articles';
import { renderMdx } from '@/lib/mdx';
import { getImageSizes, collectImageIdsFromHtml, injectImageSizeAttrs } from '@/lib/images';
import { parseEncryptMeta } from '@/lib/article-crypto';
import TechLayout from '@/layouts/TechLayout.astro';
import NoteLayout from '@/layouts/NoteLayout.astro';
import PhotoLayout from '@/layouts/PhotoLayout.astro';
import MindMapViewer from '@/components/mindmap/MindMapViewer';
import { listMindmaps, parseMindmapData } from '@/lib/mindmaps';

/* ===== Logic ===== */
const { slug } = Astro.params;
const article = slug ? await getArticleBySlug(slug) : null;
if (!article) return Astro.redirect('/404');

/* ---- 加密文章：服务端不下发正文，交由浏览器解密 ----
 * 密文与派生参数（salt/iv/iterations）可以安全内联进 HTML——
 * 没有密码就无法由它们还原出任何明文（AES-GCM 的机密性基于密钥，不是基于参数保密）。 */
const encryptMeta = article.encrypted ? parseEncryptMeta(article.encryptMeta) : null;
const locked = Boolean(article.encrypted && encryptMeta);

const { html: rawHtml, toc, blockMap } = await renderMdx(locked ? '' : article.content);
// 正文图片注入原始宽高（DB 图片；避免懒加载时宽度跳变、为 fit-content 预留空间）。
// photo 类型由 PhotoLayout 的 16/9 aspect-ratio + object-cover 主导排版，不注入。
let html = rawHtml;
if (article.type !== 'photo') {
  const ids = collectImageIdsFromHtml(rawHtml);
  if (ids.length > 0) {
    const sizes = await getImageSizes(ids);
    if (sizes.size > 0) html = injectImageSizeAttrs(rawHtml, sizes);
  }
}

// 上一篇 / 下一篇（按更新时间排序，仅取元信息）
const all = await listArticleMeta();
const idx = all.findIndex((a) => a.id === article.id);
const next = idx > 0 ? all[idx - 1] : undefined;
const prev = idx >= 0 && idx < all.length - 1 ? all[idx + 1] : undefined;

// ★ 智能布局切换：按 article.type 映射到对应布局
const layoutMap = {
  tech: TechLayout,
  note: NoteLayout,
  photo: PhotoLayout,
} as const;
const ContentLayout = layoutMap[article.type] ?? NoteLayout;
// 正文使用 max-w-none，交由布局的受限容器统一约束宽度（图片/文字/分割线等宽）
const articleClass = 'prose max-w-none';

// 关联思维导图（SSR 注入完整数据，抽屉免二次请求）
// 查询失败（如数据库连接抖动）时优雅降级：文章正常显示，仅不展示导图入口
let maps: Awaited<ReturnType<typeof listMindmaps>> = [];
try {
  maps = await listMindmaps(article.id, true);
} catch (err) {
  console.error('[blog] 加载文章思维导图失败', err);
}
const mapPanels = maps
  .map((m) => ({
    id: m.id,
    title: m.title,
    data: parseMindmapData(m.data ?? ''),
  }))
  .filter((m) => m.data !== null);
const blockMapJson = JSON.stringify(blockMap);

/* 解锁参数（仅在加密文章时下发）：salt/iv/ct 是密文材料，公开无妨——
 * AES-GCM 的机密性完全依赖密码派生出的密钥。 */
const gateParams = locked && encryptMeta
  ? {
      iterations: encryptMeta.iterations,
      salt: encryptMeta.salt,
      iv: encryptMeta.iv,
      ct: encryptMeta.ct,
      renderUrl: '/api/unlock-render',
      photo: article.type === 'photo',
    }
  : null;
---
<!-- ===== Template ===== -->
<ContentLayout article={article} toc={toc} prev={prev} next={next}>
  {
    mapPanels.length > 0 && (
      <div>
        {/* 入口按钮 */}
        <button
          id="mindmap-open"
          type="button"
          class="mb-4 inline-flex items-center gap-1.5 rounded-full border border-border px-3.5 py-1.5 text-xs text-muted-foreground transition-all duration-150 hover:border-primary/50 hover:text-primary"
        >
          <span aria-hidden="true">🧭</span>
          思维导图{mapPanels.length > 1 ? `（${mapPanels.length}）` : ''}
        </button>

        {/* 右侧抽屉（桌面）/ 全屏弹层（移动端） */}
        <div
          id="mindmap-drawer"
          aria-hidden="true"
          class="fixed inset-y-0 right-0 z-50 flex w-full max-w-xl translate-x-full flex-col border-l border-border bg-background shadow-xl transition-transform duration-300 ease-out"
        >
          <div class="flex h-12 shrink-0 items-center justify-between gap-2 border-b px-4">
            <span class="font-medium">思维导图</span>
            {
              mapPanels.length > 1 && (
                <div class="flex min-w-0 items-center gap-1 overflow-x-auto text-xs">
                  {mapPanels.map((m, i) => (
                    <button
                      type="button"
                      data-map-tab={m.id}
                      class={`shrink-0 rounded-full px-2.5 py-1 transition-colors ${i === 0 ? 'bg-primary/10 text-primary' : 'text-muted-foreground hover:text-primary'}`}
                    >
                      {m.title}
                    </button>
                  ))}
                </div>
              )
            }
            <button
              id="mindmap-close"
              type="button"
              aria-label="关闭思维导图"
              class="ml-auto inline-flex size-7 items-center justify-center rounded-full border border-border text-muted-foreground transition-colors hover:border-primary hover:text-primary"
            >
              ×
            </button>
          </div>
          <div class="min-h-0 flex-1">
            {mapPanels.map((m, i) => (
              <div data-map-panel={m.id} class={i === 0 ? 'h-full' : 'hidden h-full'}>
                <!-- 性能优化：抽屉初始是收起的（translate-x-full，在视口外），
                     但 client:load 会让岛在首屏立即挂载，进而触发组件内的
                     dynamic import，把 300KB+ 的 simple-mind-map 拉进首屏关键路径。
                     改用 client:idle：等浏览器空闲再水合，正文与样式优先。
                     （不可用 client:visible —— 抽屉在视口外，永远不会交叉触发） -->
                <MindMapViewer client:idle mapId={m.id} data={m.data} blockMap={JSON.parse(blockMapJson)} />
              </div>
            ))}
          </div>
        </div>
      </div>
    )
  }
  {
    locked ? (
      /* 解锁门禁：密文材料通过 data-* 下发给客户端解密脚本（见页面底部脚本）。
         这些值可以公开 —— 没有密码就无法从 salt/iv/ct 还原出任何明文。 */
      <div
        id="article-gate"
        class="mx-auto w-full max-w-md py-6"
        data-slug={article.slug}
        data-iterations={gateParams?.iterations}
        data-salt={gateParams?.salt}
        data-iv={gateParams?.iv}
        data-ct={gateParams?.ct}
        data-render-url={gateParams?.renderUrl}
        data-photo={gateParams?.photo ? '1' : '0'}
      >
        {/* 锁形图标 */}
        <div class="flex justify-center">
          <div class="flex size-14 items-center justify-center rounded-full border border-border bg-muted/50">
            <svg
              class="size-6 text-muted-foreground"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <rect x="4" y="11" width="16" height="10" rx="2" />
              <path d="M8 11V7a4 4 0 0 1 8 0v4" />
              <circle cx="12" cy="16" r="1.2" fill="currentColor" stroke="none" />
            </svg>
          </div>
        </div>

        <h2 class="mt-4 text-center text-lg font-semibold">受保护的文章</h2>
        <p class="mt-1.5 text-center text-sm text-muted-foreground">
          该文章已被加密保护，请输入访问密码以解锁内容。
        </p>

        {
          article.encryptHint ? (
            <p class="mt-4 flex items-start gap-2 rounded-md border border-border bg-muted/40 px-3 py-2 text-xs text-muted-foreground">
              <span aria-hidden="true" class="mt-px shrink-0">
                💡
              </span>
              <span>
                提示：{article.encryptHint}
              </span>
            </p>
          ) : null
        }

        <form id="article-gate-form" class="mt-4" novalidate>
          <label class="block">
            <span class="sr-only">访问密码</span>
            <div class="relative">
              <span
                class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3 text-muted-foreground"
                aria-hidden="true"
              >
                <svg
                  class="size-4"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <rect x="4" y="11" width="16" height="10" rx="2" />
                  <path d="M8 11V7a4 4 0 0 1 8 0v4" />
                </svg>
              </span>
              <input
                id="article-gate-password"
                type="password"
                autocomplete="current-password"
                placeholder="访问密码"
                class="w-full rounded-md border border-input bg-background py-2.5 pl-9 pr-10 text-sm outline-none transition-colors focus-visible:border-ring"
              />
              <button
                id="article-gate-toggle"
                type="button"
                aria-label="显示密码"
                class="absolute inset-y-0 right-0 flex items-center px-3 text-muted-foreground transition-colors hover:text-foreground"
              >
                <svg
                  id="gate-icon-eye"
                  class="size-4"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7-10-7-10-7Z" />
                  <circle cx="12" cy="12" r="3" />
                </svg>
                <svg
                  id="gate-icon-eye-off"
                  class="hidden size-4"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M10.7 5.1A10.9 10.9 0 0 1 12 5c6.4 0 10 7 10 7a17.6 17.6 0 0 1-3.2 4.1M6.6 6.6A17.3 17.3 0 0 0 2 12s3.6 7 10 7a10.7 10.7 0 0 0 5.4-1.4" />
                  <path d="M9.9 9.9a3 3 0 0 0 4.2 4.2" />
                  <path d="m2 2 20 20" />
                </svg>
              </button>
            </div>
          </label>

          <button
            id="article-gate-submit"
            type="submit"
            class="mt-3 inline-flex w-full items-center justify-center gap-2 rounded-md bg-primary px-4 py-2.5 text-sm font-medium text-primary-foreground transition-opacity hover:opacity-90 disabled:opacity-60"
          >
            <svg
              class="size-4"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <rect x="4" y="11" width="16" height="10" rx="2" />
              <path d="M8 11V7a4 4 0 0 1 8 0v4" />
            </svg>
            解锁文章
          </button>

          <p
            id="article-gate-status"
            class="mt-2.5 hidden text-center text-xs text-destructive"
            role="alert"
          >
          </p>
        </form>
      </div>
    ) : (
      <article class={articleClass} set:html={html} />
    )
  }

  {/* 解锁成功后正文注入于此（保持与普通文章相同的排版容器） */}
  {locked ? <article id="article-gate-content" class={articleClass} hidden /> : null}

  {
    mapPanels.length > 0 && (
      <>
        {/* 选中文本 → 加入导图（悬浮工具条） */}
        <div
          id="mindmap-snippet-bar"
          aria-hidden="true"
          class="fixed z-50 hidden -translate-x-1/2"
        >
          <button
            id="mindmap-snippet-add"
            type="button"
            class="inline-flex items-center gap-1 rounded-full border border-border bg-background px-3 py-1.5 text-xs shadow-md transition-colors hover:border-primary/50 hover:text-primary"
          >
            🧭 加入导图
          </button>
        </div>

        {/* 选择目标导图 + 引用命名 */}
        <dialog id="mindmap-pick-dialog" class="w-80 rounded-lg border border-border bg-card p-4 text-foreground shadow-xl backdrop:bg-black/40">
          <h3 class="font-medium">添加引用到思维导图</h3>
          <p id="mindmap-pick-snippet" class="mt-1 line-clamp-2 text-xs text-muted-foreground"></p>
          <label class="mt-3 block text-xs font-medium text-muted-foreground">
            引用名称（节点显示用，不是粘贴全文）
            <input
              id="mindmap-pick-name"
              type="text"
              maxlength="80"
              placeholder="给这个引用起个名字"
              class="mt-1 w-full rounded-md border border-input bg-background px-2 py-1.5 text-sm outline-none focus-visible:border-ring"
            />
          </label>
          <select
            id="mindmap-pick-select"
            class="mt-2 w-full rounded-md border border-input bg-background px-2 py-1.5 text-sm outline-none focus-visible:border-ring"
          >
            {mapPanels.map((m) => <option value={m.id}>{m.title}</option>)}
          </select>
          <div class="mt-3 flex items-center justify-end gap-2">
            <button
              id="mindmap-pick-cancel"
              type="button"
              class="rounded-md px-2 py-1 text-xs text-muted-foreground hover:text-foreground"
            >
              取消
            </button>
            <button
              id="mindmap-pick-confirm"
              type="button"
              class="rounded-md bg-primary px-3 py-1 text-xs text-primary-foreground transition-opacity hover:opacity-90"
            >
              添加
            </button>
          </div>
          <p id="mindmap-pick-status" class="mt-2 hidden text-xs text-destructive" role="alert"></p>
        </dialog>
      </>
    )
  }
</ContentLayout>

<script>
  /** 委托绑定（防 SPA 切换后直接绑定失效） */
  function on(id: string, event: string, handler: EventListener): void {
    document.addEventListener(event, (e) => {
      const t = e.target as HTMLElement | null;
      if (t && (t.id === id || t.closest('#' + id))) handler(e);
    });
  }
  /** 思维导图抽屉：打开/关闭/多图切换；导图节点跳转时收起（移动端） */
  let drawer: HTMLElement | null = document.getElementById('mindmap-drawer');
  const openBtn = document.getElementById('mindmap-open');
  const closeBtn = document.getElementById('mindmap-close');

  /** 打开/关闭抽屉（按钮 toggle，点一下开、再点一下关） */
  function toggleDrawer(): void {
    const isOpen = drawer ? !drawer.classList.contains('translate-x-full') : false;
    setDrawer(!isOpen);
  }

  function setDrawer(open: boolean): void {
    if (!drawer) return;
    drawer.classList.toggle('translate-x-full', !open);
    drawer.setAttribute('aria-hidden', String(!open));
    if (open) {
      // 打开抽屉时确保视口高度正确（画布 resize）
      window.dispatchEvent(new Event('resize'));
    }
  }

  on('mindmap-open', 'click', toggleDrawer);
  on('mindmap-close', 'click', () => setDrawer(false));

  // 点击抽屉外（右侧文章区域）关闭：仅在桌面宽度时绑定到遮罩层效果
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') setDrawer(false);
  });

  // 导图节点跳转文章段落（viewer 直接滚动，不收起抽屉）
  // ---------- 加密文章解锁 ----------
  /**
   * 解密参数从 DOM 读取（而非 `define:vars`）：脚本经 Astro 打包后是独立模块，
   * 用 data-* 属性传参可以避免把密文材料重复内联进两份 HTML，
   * 也让 ClientRouter 转场后重新绑定逻辑保持一致。
   */
  function readGateParams(): {
    iterations: number;
    salt: string;
    iv: string;
    ct: string;
    renderUrl: string;
    photo: boolean;
    slug: string;
  } | null {
    const gate = document.getElementById('article-gate');
    if (!gate) return null;
    const d = gate.dataset;
    if (!d.salt || !d.iv || !d.ct) return null;
    return {
      iterations: Number(d.iterations ?? 250000),
      salt: d.salt,
      iv: d.iv,
      ct: d.ct,
      renderUrl: d.renderUrl ?? '/api/unlock-render',
      photo: d.photo === '1',
      slug: d.slug ?? '',
    };
  }

  /** 显示门禁错误提示 */
  function gateError(msg: string): void {
    const el = document.getElementById('article-gate-status');
    if (!el) return;
    el.textContent = msg;
    el.classList.remove('hidden');
  }

  /** 清空门禁错误提示 */
  function gateClearError(): void {
    document.getElementById('article-gate-status')?.classList.add('hidden');
  }

  /** 密码显隐切换 */
  function bindGateToggle(): void {
    const btn = document.getElementById('article-gate-toggle');
    const input = document.getElementById('article-gate-password') as HTMLInputElement | null;
    const on = document.getElementById('gate-icon-eye');
    const off = document.getElementById('gate-icon-eye-off');
    if (!btn || !input || btn.dataset.bound === '1') return;
    btn.dataset.bound = '1';
    btn.addEventListener('click', () => {
      const show = input.type === 'password';
      input.type = show ? 'text' : 'password';
      btn.setAttribute('aria-label', show ? '隐藏密码' : '显示密码');
      on?.classList.toggle('hidden', show);
      off?.classList.toggle('hidden', !show);
    });
  }

  /** 解锁流程：解密 → 渲染 → 注入正文 */
  async function submitGate(): Promise<void> {
    const params = readGateParams();
    const input = document.getElementById('article-gate-password') as HTMLInputElement | null;
    const submit = document.getElementById('article-gate-submit') as HTMLButtonElement | null;
    const gate = document.getElementById('article-gate');
    const contentEl = document.getElementById('article-gate-content');
    if (!params || !input || !submit || !gate || !contentEl) return;

    gateClearError();
    submit.disabled = true;
    const original = submit.innerHTML;
    submit.textContent = '解锁中…';

    const { unlockArticle } = await import('/src/lib/unlock-client.ts');
    const result = await unlockArticle(input.value, params);

    submit.disabled = false;
    submit.innerHTML = original;

    if (!result.ok) {
      gateError(result.message);
      input.select();
      return;
    }

    // 成功：用正文替换门禁
    contentEl.innerHTML = result.html;
    contentEl.hidden = false;
    gate.remove();
    // 解锁后重新触发懒加载图片与外部脚本绑定
    window.dispatchEvent(new Event('astro:page-load'));
    window.dispatchEvent(new Event('resize'));
  }

  function bindGate(): void {
    const form = document.getElementById('article-gate-form');
    if (!form || form.dataset.bound === '1') return;
    form.dataset.bound = '1';
    bindGateToggle();
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      void submitGate();
    });
    // 输入时清掉上一次的错误提示
    document
      .getElementById('article-gate-password')
      ?.addEventListener('input', gateClearError);
  }

  bindGate();
  document.addEventListener('astro:page-load', bindGate);


  // 多图切换
  document.addEventListener('click', (e) => {
    const tab = (e.target as HTMLElement).closest<HTMLElement>('[data-map-tab]');
    if (!tab) return;
    const id = tab.dataset.mapTab;
    document.querySelectorAll<HTMLElement>('[data-map-panel]').forEach((panel) => {
      panel.classList.toggle('hidden', panel.dataset.mapPanel !== id);
    });
    document.querySelectorAll<HTMLElement>('[data-map-tab]').forEach((t) => {
      const active = t.dataset.mapTab === id;
      t.classList.toggle('bg-primary/10', active);
      t.classList.toggle('text-primary', active);
      t.classList.toggle('text-muted-foreground', !active);
    });
    window.dispatchEvent(new Event('resize'));
  });

  // ---------- 选中文本 → 加入导图 ----------
  let snippetBar = document.getElementById('mindmap-snippet-bar');
  let snippetAddBtn = document.getElementById('mindmap-snippet-add');
  let pickDialog = document.getElementById('mindmap-pick-dialog') as HTMLDialogElement | null;
  let pickSelect = document.getElementById('mindmap-pick-select') as HTMLSelectElement | null;
  let pickSnippet = document.getElementById('mindmap-pick-snippet');
  let pickStatus = document.getElementById('mindmap-pick-status');
  let pendingRef: { text: string; anchorId: string; snippet: string } | null = null;
  let hideBarTimer = 0;

  /** SPA 切换后 DOM 换新、脚本不重跑：按需重取元素引用（幂等） */
  function syncRefs(): void {
    drawer = document.getElementById('mindmap-drawer');
    snippetBar = document.getElementById('mindmap-snippet-bar');
    snippetAddBtn = document.getElementById('mindmap-snippet-add');
    pickDialog = document.getElementById('mindmap-pick-dialog') as HTMLDialogElement | null;
    pickSelect = document.getElementById('mindmap-pick-select') as HTMLSelectElement | null;
    pickSnippet = document.getElementById('mindmap-pick-snippet');
    pickStatus = document.getElementById('mindmap-pick-status');
    pendingRef = null;
  }
  document.addEventListener('astro:page-load', syncRefs);

  function hideSnippetBar(): void {
    snippetBar?.classList.add('hidden');
    snippetBar?.setAttribute('aria-hidden', 'true');
  }

  function hideSnippetBarSoon(): void {
    window.clearTimeout(hideBarTimer);
    hideBarTimer = window.setTimeout(hideSnippetBar, 200);
  }

  /** 收集选区：文本 + 所在块锚点（para-N） */
  function collectSelection(): { text: string; anchorId: string; snippet: string } | null {
    const sel = window.getSelection();
    if (!sel || sel.isCollapsed) return null;
    const text = sel.toString().trim();
    if (!text) return null;
    let anchor: Node | null = sel.anchorNode;
    if (anchor?.nodeType === Node.TEXT_NODE) anchor = anchor.parentElement;
    const block = (anchor as HTMLElement | null)?.closest?.('[id^="para-"]') as HTMLElement | null;
    if (!block || !block.id) return null;
    return { text: text.slice(0, 60), anchorId: block.id, snippet: text.slice(0, 500) };
  }

  document.addEventListener('mouseup', (e) => {
    if (!snippetBar || !snippetAddBtn) return;
    const target = e.target as HTMLElement;
    // 点击工具条/弹层内部不触发
    if (target.closest('#mindmap-snippet-bar') || target.closest('#mindmap-pick-dialog')) return;
    const ref = collectSelection();
    if (!ref) {
      hideSnippetBarSoon();
      return;
    }
    pendingRef = ref;
    const rect = window.getSelection()?.getRangeAt(0).getBoundingClientRect();
    snippetBar.style.left = `${rect ? rect.left + rect.width / 2 : window.innerWidth / 2}px`;
    snippetBar.style.top = `${rect ? rect.top - 38 : 120}px`;
    snippetBar.classList.remove('hidden');
    snippetBar.setAttribute('aria-hidden', 'false');
  });

  // 点击非选区区域 / 滚动 → 收起工具条
  document.addEventListener('mousedown', (e) => {
    const target = e.target as HTMLElement;
    if (target.closest('#mindmap-snippet-bar') || target.closest('#mindmap-pick-dialog')) return;
    window.clearTimeout(hideBarTimer);
    if (!window.getSelection()?.isCollapsed) return;
    hideSnippetBar();
  });
  window.addEventListener('scroll', hideSnippetBar, { passive: true });

  // 「加入导图」→ 打开选择弹层（默认引用名称 = 选中文本摘要）
  const pickNameInput = document.getElementById('mindmap-pick-name') as HTMLInputElement | null;
  on('mindmap-snippet-add', 'click', () => {
    if (!pickDialog || !pendingRef || !pickSnippet) return;
    pickSnippet.textContent = `「${pendingRef.text}…」`;
    if (pickNameInput) pickNameInput.value = pendingRef.text.slice(0, 30);
    pickStatus?.classList.add('hidden');
    pickDialog.showModal();
  });

  on('mindmap-pick-cancel', 'click', () => pickDialog?.close());
  on('mindmap-pick-confirm', 'click', async () => {
    if (!pendingRef || !pickSelect) return;
    const mapId = pickSelect.value;
    if (!mapId) return;
    const name = (pickNameInput?.value ?? '').trim();
    if (!name) {
      if (pickStatus) {
        pickStatus.textContent = '请填写引用名称';
        pickStatus.classList.remove('hidden');
      }
      return;
    }
    try {
      const res = await fetch(`/api/mindmaps/${mapId}/refs`, {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ ...pendingRef, text: name }),
      });
      const d = (await res.json().catch(() => ({}))) as { error?: string };
      if (!res.ok) {
        if (pickStatus) {
          pickStatus.textContent = d.error ?? '添加失败';
          pickStatus.classList.remove('hidden');
        }
        return;
      }
      pickDialog?.close();
      hideSnippetBar();
      window.getSelection()?.removeAllRanges();
      // 轻提示
      const toast = document.createElement('div');
      toast.className = 'fixed bottom-6 left-1/2 z-50 -translate-x-1/2 rounded-full border border-border bg-background px-4 py-2 text-xs shadow-lg';
      toast.textContent = '已加入导图，可在「思维导图」中查看';
      document.body.appendChild(toast);
      window.setTimeout(() => toast.remove(), 2200);
      window.dispatchEvent(new CustomEvent('mindmap-refresh', { detail: { mapId } }));
    } catch {
      if (pickStatus) {
        pickStatus.textContent = '添加失败，请重试';
        pickStatus.classList.remove('hidden');
      }
    }
  });

  // ---------- 拖拽选中片段 → 导图引用节点 ----------
  // dragstart 时把选区信息（锚点+片段）写入全局，由抽屉内 MindMapViewer 的
  // drop 处理（感应目标节点 → 弹命名框 → 插入该节点下；空白处追加根节点）
  document.addEventListener('dragstart', (e) => {
    const t = e.target as HTMLElement;
    if (!t.closest('.prose')) return;
    const ref = collectSelection();
    if (ref) {
      (window as unknown as { __mindmapDragRef?: { anchorId: string; snippet: string } }).__mindmapDragRef = {
        anchorId: ref.anchorId,
        snippet: ref.snippet,
      };
    }
  });
</script>
