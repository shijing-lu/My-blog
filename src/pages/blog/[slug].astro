---
/* ===== Props ===== */
/* （动态路由，无 Props） */

/* ===== Imports ===== */
import { getArticleBySlug, getAdjacentArticles } from '@/lib/articles';
import { renderMdx } from '@/lib/mdx';
import { getImageSizes, collectImageIdsFromHtml, injectImageSizeAttrs } from '@/lib/images';
import TechLayout from '@/layouts/TechLayout.astro';
import NoteLayout from '@/layouts/NoteLayout.astro';
import PhotoLayout from '@/layouts/PhotoLayout.astro';

import ExportMenu from '@/components/ExportMenu.astro';


/* ===== Logic ===== */
const { slug } = Astro.params;
const article = slug ? await getArticleBySlug(slug) : null;
if (!article) return Astro.redirect('/404');

/* ---- 访问密码拦截（服务端判定）----
 * 正文明文存库；未解锁时**服务端不渲染正文**，HTML 里不存在任何明文，
 * F12 / 禁用 JS 都无法绕过。解锁后靠签名 Cookie 重新渲染本页。 */
const { signPayload: _signPayload, verifySignedPayload } = await import('@/lib/auth');
const { isArticleUnlocked, decodeTokenPayload, parsePasswordHash, decideArticleGate } = await import('@/lib/article-password');
const passwordMeta = article.encrypted ? parsePasswordHash(article.encryptMeta) : null;
// ★ 判定细节见 decideArticleGate：gated 只看 encrypted，哈希解析失败也要保留门禁
const { metaUsable, unlocked, locked } = decideArticleGate(
  Boolean(article.encrypted),
  passwordMeta,
  () => isArticleUnlocked(Astro.cookies, article.id, verifySignedPayload, decodeTokenPayload),
);

let rawHtml = '';
let toc: import('@/lib/mdx-plugins').TocItem[] = [];

try {
  const rendered = await renderMdx(locked ? '' : article.content);
  rawHtml = rendered.html;
  toc = rendered.toc;
} catch (err) {
  console.error(`[blog] SSR renderMdx failed for article ${article.id}:`, err);
  const errMsg = err instanceof Error ? err.message : String(err);
  rawHtml = `<div class="p-6 my-6 rounded-2xl border border-destructive/30 bg-destructive/5 text-destructive">
    <div class="flex items-center gap-2 font-medium mb-2">
      <svg class="size-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
      </svg>
      <span>文章内容渲染遇到异常</span>
    </div>
    <p class="text-sm opacity-90 mb-3">该文章包含无法解析的 Markdown/JSX 语法标记，已降级展示纯文本提示。</p>
    <pre class="p-3 text-xs bg-destructive/10 rounded-lg overflow-x-auto whitespace-pre-wrap font-mono">${errMsg.replace(/[<>&]/g, (c) => ({ '<': '&lt;', '>': '&gt;', '&': '&amp;' })[c] || c)}</pre>
  </div>`;
}

// 正文图片注入原始宽高（DB 图片；避免懒加载时宽度跳变、为 fit-content 预留空间）。
// photo 类型由 PhotoLayout 的 16/9 aspect-ratio + object-cover 主导排版，不注入。
let html = rawHtml;
if (article.type !== 'photo') {
  const ids = collectImageIdsFromHtml(rawHtml);
  if (ids.length > 0) {
    const sizes = await getImageSizes(ids);
    if (sizes.size > 0) html = injectImageSizeAttrs(rawHtml, sizes);
  }
}

// 上一篇 / 下一篇：两条定向查询（走 updatedAt 索引，limit 1），不再拉全表再 findIndex。
// 旧实现 `listArticleMeta()` + `findIndex` 是 O(N)，文章变多后每次阅读都白扫全表。
const { prev, next } = await getAdjacentArticles(article);

// ★ 智能布局切换：按 article.type 映射到对应布局
const layoutMap = {
  tech: TechLayout,
  note: NoteLayout,
  photo: PhotoLayout,
} as const;
const ContentLayout = layoutMap[article.type] ?? NoteLayout;
// 正文使用 max-w-none，交由布局的受限容器统一约束宽度（图片/文字/分割线等宽）
const articleClass = 'prose max-w-none';

---
<!-- ===== Template ===== -->
<ContentLayout article={article} toc={toc} prev={prev ?? undefined} next={next ?? undefined}>
  {/* 阅读上报锚点：无论文章是否加密解锁，只要访问了详情页就算一次阅读，
      故把它放在锁定/解锁分支**之外**（单一来源，避免两处维护）。 */}
  <span data-article-id={article.id} hidden aria-hidden="true" />
  {/* 导出入口（MD/PDF）：加密文章未解锁时不渲染——端点同样会拦，这里避免展示必败按钮 */}
  {!locked && <ExportMenu mdUrl={`/api/export/article/${article.slug}`} class="mb-4" />}
  {
    locked ? (
      /* 解锁门禁：服务端拦截模式 —— 正文根本不在 HTML 里，
         表单提交到 /api/unlock-article 校验密码，成功后 reload 由服务端渲染正文。 */
      <div
        id="article-gate"
        class="mx-auto w-full max-w-md py-6"
        data-slug={article.slug}
        data-article-id={article.id}
      >
        {/* 锁形图标 */}
        <div class="flex justify-center">
          <div class="flex size-14 items-center justify-center rounded-full border border-border bg-muted/50">
            <svg
              class="size-6 text-muted-foreground"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <rect x="4" y="11" width="16" height="10" rx="2" />
              <path d="M8 11V7a4 4 0 0 1 8 0v4" />
              <circle cx="12" cy="16" r="1.2" fill="currentColor" stroke="none" />
            </svg>
          </div>
        </div>

        <h2 class="mt-4 text-center text-lg font-semibold">受保护的文章</h2>
        <p class="mt-1.5 text-center text-sm text-muted-foreground">
          该文章已被加密保护，请输入访问密码以解锁内容。
        </p>

        {
          /* 旧格式哈希（AES-GCM 时代产物）无法校验，须由站主在写作台重设密码 */
          !metaUsable ? (
            <p class="mt-4 rounded-md border border-amber-500/30 bg-amber-500/10 px-3 py-2 text-xs leading-relaxed text-amber-700 dark:text-amber-400">
              该文章的密码为旧版格式，无法校验。请站主进入写作台重新设置访问密码后即可正常解锁。
            </p>
          ) : null
        }

        {
          article.encryptHint ? (
            <p class="mt-4 flex items-start gap-2 rounded-md border border-border bg-muted/40 px-3 py-2 text-xs text-muted-foreground">
              <span aria-hidden="true" class="mt-px shrink-0">
                💡
              </span>
              <span>
                提示：{article.encryptHint}
              </span>
            </p>
          ) : null
        }

        <form id="article-gate-form" class="mt-4" novalidate>
          <label class="block">
            <span class="sr-only">访问密码</span>
            <div class="relative">
              <span
                class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3 text-muted-foreground"
                aria-hidden="true"
              >
                <svg
                  class="size-4"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <rect x="4" y="11" width="16" height="10" rx="2" />
                  <path d="M8 11V7a4 4 0 0 1 8 0v4" />
                </svg>
              </span>
              <input
                id="article-gate-password"
                type="password"
                autocomplete="current-password"
                placeholder="访问密码"
                class="w-full rounded-md border border-input bg-background py-2.5 pl-9 pr-10 text-sm outline-none transition-colors focus-visible:border-ring"
              />
              <button
                id="article-gate-toggle"
                type="button"
                aria-label="显示密码"
                class="absolute inset-y-0 right-0 flex items-center px-3 text-muted-foreground transition-colors hover:text-foreground"
              >
                <svg
                  id="gate-icon-eye"
                  class="size-4"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7-10-7-10-7Z" />
                  <circle cx="12" cy="12" r="3" />
                </svg>
                <svg
                  id="gate-icon-eye-off"
                  class="hidden size-4"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M10.7 5.1A10.9 10.9 0 0 1 12 5c6.4 0 10 7 10 7a17.6 17.6 0 0 1-3.2 4.1M6.6 6.6A17.3 17.3 0 0 0 2 12s3.6 7 10 7a10.7 10.7 0 0 0 5.4-1.4" />
                  <path d="M9.9 9.9a3 3 0 0 0 4.2 4.2" />
                  <path d="m2 2 20 20" />
                </svg>
              </button>
            </div>
          </label>

          <button
            id="article-gate-submit"
            type="submit"
            class="mt-3 inline-flex w-full items-center justify-center gap-2 rounded-md bg-primary px-4 py-2.5 text-sm font-medium text-primary-foreground transition-opacity hover:opacity-90 disabled:opacity-60"
          >
            <svg
              class="size-4"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <rect x="4" y="11" width="16" height="10" rx="2" />
              <path d="M8 11V7a4 4 0 0 1 8 0v4" />
            </svg>
            解锁文章
          </button>

          <p
            id="article-gate-status"
            class="mt-2.5 hidden text-center text-xs text-destructive"
            role="alert"
          >
          </p>
        </form>
      </div>
    ) : (
      <article class={articleClass} data-heading-folding data-heading-fold-key={`home:${article.id}`} set:html={html} />
    )
  }

</ContentLayout>

<script>
  /* ===== 阅读量上报（归档页「x 阅读」的数据源）=====
   * 口径「每次访问 +1」（见 src/lib/article-views.ts），故此处只需打点一次。
   *
   * 三条设计约束：
   * 1. **客户端而非 SSR 上报**：SSR 会把预取、爬虫、构建期访问一并计入；
   * 2. **在 astro:page-load 时打点**：模块顶层直接执行会在 ClientRouter 转场
   *    尚未替换 DOM 时跑，拿到的可能是上一篇的 id（且 SPA 下本脚本只初始化一次）；
   * 3. **SPA 会话内按 id 去重**：View Transitions 下同一会话可能多次触发
   *    page-load，去重保证「一次访问」语义，不被转场放大。
   */
  const VIEWED = new Set<string>();
  function reportView(): void {
    const el = document.querySelector<HTMLElement>('[data-article-id]');
    const id = el?.dataset.articleId ?? '';
    if (!id || VIEWED.has(id)) return;
    VIEWED.add(id);
    // keepalive：允许在用户快速离开/跳转时仍完成这次埋点
    void fetch('/api/views', {
      method: 'POST',
      headers: { 'content-type': 'application/json' },
      body: JSON.stringify({ articleId: id }),
      keepalive: true,
      // 埋点失败一律静默：绝不能让统计影响阅读体验
    }).catch(() => {});
  }
  document.addEventListener('astro:page-load', reportView);
  reportView();

  // ---------- 访问密码解锁（服务端拦截） ----------
  /**
   * 门禁参数从 DOM 读取（而非 `define:vars`）：脚本经 Astro 打包后是独立模块，
   * 用 data-* 传参可避免重复内联，也让 ClientRouter 转场后重新绑定保持一致。
   *
   * 服务端拦截模式下**没有密文材料**下发，只需文章 id（用于按文章隔离解锁 Cookie）。
   */
  function readGateParams(): { articleId: string; slug: string } | null {
    const gate = document.getElementById('article-gate');
    if (!gate) return null;
    const d = gate.dataset;
    if (!d.articleId) return null;
    return { articleId: d.articleId, slug: d.slug ?? '' };
  }

  /** 显示门禁错误提示 */
  function gateError(msg: string): void {
    const el = document.getElementById('article-gate-status');
    if (!el) return;
    el.textContent = msg;
    el.classList.remove('hidden');
  }

  /** 清空门禁错误提示 */
  function gateClearError(): void {
    document.getElementById('article-gate-status')?.classList.add('hidden');
  }

  /** 密码显隐切换 */
  function bindGateToggle(): void {
    const btn = document.getElementById('article-gate-toggle');
    const input = document.getElementById('article-gate-password') as HTMLInputElement | null;
    const on = document.getElementById('gate-icon-eye');
    const off = document.getElementById('gate-icon-eye-off');
    if (!btn || !input || btn.dataset.bound === '1') return;
    btn.dataset.bound = '1';
    btn.addEventListener('click', () => {
      const show = input.type === 'password';
      input.type = show ? 'text' : 'password';
      btn.setAttribute('aria-label', show ? '隐藏密码' : '显示密码');
      on?.classList.toggle('hidden', show);
      off?.classList.toggle('hidden', !show);
    });
  }

  /** 解锁流程：解密 → 渲染 → 注入正文 */
  async function submitGate(): Promise<void> {
    const params = readGateParams();
    const input = document.getElementById('article-gate-password') as HTMLInputElement | null;
    const submit = document.getElementById('article-gate-submit') as HTMLButtonElement | null;
    const gate = document.getElementById('article-gate');
    if (!params || !input || !submit || !gate) return;

    if (!input.value) {
      gateError('请输入访问密码');
      input.focus();
      return;
    }

    gateClearError();
    submit.disabled = true;
    const original = submit.innerHTML;
    submit.textContent = '验证中…';

    try {
      const res = await fetch('/api/unlock-article', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ id: params.articleId, password: input.value }),
      });
      if (!res.ok) {
        const d = (await res.json().catch(() => ({}))) as { error?: string };
        submit.disabled = false;
        submit.innerHTML = original;
        gateError(d.error ?? '密码错误，请重试');
        input.select();
        return;
      }
      // 校验通过：解锁 Cookie 已写入 → 重新加载由服务端渲染正文
      location.reload();
    } catch {
      submit.disabled = false;
      submit.innerHTML = original;
      gateError('网络异常，请稍后重试');
    }
  }

  function bindGate(): void {
    const form = document.getElementById('article-gate-form');
    if (!form || form.dataset.bound === '1') return;
    form.dataset.bound = '1';
    bindGateToggle();
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      void submitGate();
    });
    // 输入时清掉上一次的错误提示
    document
      .getElementById('article-gate-password')
      ?.addEventListener('input', gateClearError);
  }

  bindGate();
  document.addEventListener('astro:page-load', bindGate);


</script>
