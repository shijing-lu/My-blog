---
/* ===== Props ===== */
/* （管理入口页无 Props） */

/* ===== Imports ===== */
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getAdminIdentity, isTopAdmin } from '@/lib/admin-auth';
import { isUserGitHubConfigured, getCurrentUserId } from '@/lib/auth';
import { getGithubUserById } from '@/lib/github-users';

/* ===== Logic ===== */
/**
 * 「管理」入口页：点击导航栏「管理」后先校验身份，按四种身份分支：
 * - 顶级管理员（站主 / role=top）→ 直接跳转授权管理页 /admin/auth；
 * - 普通管理员（GitHub 已授权，role=admin）→ 提示「无权进入该页面」；
 * - 未登录 GitHub → 提示可申请但需先登录，展示 GitHub 登录与站主登录两种方式；
 * - 已登录 GitHub 访客 → 展示「申请管理员权限」按钮（提交申请给顶级管理员）。
 */
const identity = await getAdminIdentity(Astro.cookies);
if (await isTopAdmin(Astro.cookies)) return Astro.redirect('/admin/auth');
const githubEnabled = isUserGitHubConfigured();
/** 普通管理员：展示已有权限 */
const isAdmin = identity.kind === 'github';
const account = isAdmin ? identity.account : null;
/** 已登录 GitHub 访客 */
const isVisitor = identity.kind === 'visitor';
const visitorUser = isVisitor ? await getGithubUserById(getCurrentUserId(Astro.cookies) ?? '') : null;
const ghLoginUrl = '/api/auth/user/github?next=/manage';
---
<!-- ===== Template ===== -->
<BaseLayout title="管理" description="博客管理入口" indexable={false}>
  <section class="mx-auto w-full max-w-md px-4 py-16">
    <!-- 普通管理员：无权进入授权管理页 -->
    {
      isAdmin && account && (
        <div class="p-6">
          <p class="pixel-chip text-primary">MANAGE</p>
          <h1 class="mt-1 font-display text-2xl font-semibold">无权进入该页面</h1>
          <p class="mt-2 text-sm leading-relaxed text-muted-foreground">
            授权管理页仅顶级管理员可进入。你当前是普通管理员，可通过下方入口管理已授权的内容。
          </p>
          <div class="mt-4 rounded-md border border-border p-4">
            <div class="flex items-center gap-3">
              {account.avatarUrl && <img src={account.avatarUrl} alt="" class="size-9 rounded-full" loading="lazy" />}
              <div>
                <p class="text-sm font-medium">{account.name || account.login}</p>
                <p class="text-xs text-muted-foreground">@{account.login} · 普通管理员</p>
              </div>
            </div>
            <p class="mt-3 text-xs text-muted-foreground">已授予权限：</p>
            <div class="mt-1 flex flex-wrap gap-1.5">
              {account.role === 'top' ? (
                <span class="text-xs text-primary">顶级管理员 · 自动拥有全部权限，无需逐项授权</span>
              ) : account.permissions.length === 0 ? (
                <span class="text-xs text-muted-foreground">暂无（等待顶级管理员授权）</span>
              ) : (
                account.permissions.map((p) => <span class="rounded bg-muted px-2 py-0.5 text-xs">{p}</span>)
              )}
            </div>
          </div>
        </div>
      )
    }

    <!-- 未登录：提示 + 两种登录方式 -->
    {
      identity.kind === 'anonymous' && (
        <div class="p-6">
          <p class="pixel-chip text-primary">MANAGE</p>
          <h1 class="mt-1 font-display text-2xl font-semibold">管理入口</h1>
          <p class="mt-2 text-sm leading-relaxed text-muted-foreground">
            您可以申请管理员权限，但您未登录 GitHub，请登录后再试。
          </p>
          <div class="mt-6 space-y-5">
            <div>
              <p class="text-sm font-medium">GitHub 登录</p>
              <p class="mt-0.5 text-xs leading-relaxed text-muted-foreground">
                与评论区登录一致：登录后可用 GitHub 身份评论、点赞，并可申请管理员权限。
              </p>
              {
                githubEnabled && (
                  <a
                    href={ghLoginUrl}
                    class="mt-2 flex items-center justify-center gap-2 rounded-md border border-border px-4 py-2 text-sm transition-colors duration-200 hover:bg-accent"
                  >
                    <svg viewBox="0 0 24 24" class="size-4" fill="currentColor" aria-hidden="true">
                      <path d="M12 2C6.48 2 2 6.58 2 12.25c0 4.53 2.87 8.37 6.84 9.73.5.09.68-.22.68-.49v-1.7c-2.78.62-3.37-1.37-3.37-1.37-.45-1.18-1.11-1.5-1.11-1.5-.91-.63.07-.62.07-.62 1 .07 1.53 1.06 1.53 1.06.9 1.57 2.35 1.12 2.92.85.09-.66.35-1.11.63-1.37-2.22-.26-4.56-1.14-4.56-5.07 0-1.12.39-2.03 1.03-2.75-.1-.26-.45-1.3.1-2.7 0 0 .84-.28 2.75 1.05a9.36 9.36 0 0 1 5 0c1.91-1.33 2.75-1.05 2.75-1.05.55 1.4.2 2.44.1 2.7.64.72 1.03 1.63 1.03 2.75 0 3.94-2.34 4.8-4.57 5.06.36.32.68.94.68 1.9v2.81c0 .27.18.59.69.49A10.26 10.26 0 0 0 22 12.25C22 6.58 17.52 2 12 2Z" />
                    </svg>
                    使用 GitHub 登录
                  </a>
                )
              }
              {!githubEnabled && <p class="mt-2 text-xs text-destructive">GitHub 登录未配置（需要 GITHUB_CLIENT_ID 等环境变量）。</p>}
            </div>
            <div class="border-t border-border pt-5">
              <p class="text-sm font-medium">站主登录</p>
              <p class="mt-0.5 text-xs leading-relaxed text-muted-foreground">站主即顶级管理员，登录后进入授权管理页。</p>
              <form id="top-login-form" class="mt-2 space-y-2">
                <input
                  id="top-login-password"
                  type="password"
                  required
                  autocomplete="current-password"
                  placeholder="站主密码"
                  class="w-full rounded-md border border-input bg-background px-3 py-2 text-sm outline-none transition-colors focus-visible:border-ring focus-visible:ring-[3px] focus-visible:ring-ring/40"
                />
                <button
                  type="submit"
                  class="w-full rounded-md bg-primary px-4 py-2 text-sm text-primary-foreground transition-opacity duration-200 hover:opacity-90"
                >
                  站主登录
                </button>
                <p id="top-login-error" class="hidden text-xs text-destructive" role="alert" />
              </form>
            </div>
          </div>
        </div>
      )
    }

    <!-- 已登录 GitHub 访客：申请按钮 + 登录方式 -->
    {
      isVisitor && (
        <div class="p-6">
          <p class="pixel-chip text-primary">MANAGE</p>
          <h1 class="mt-1 font-display text-2xl font-semibold">申请管理员权限</h1>
          <div class="mt-4 rounded-md border border-border p-4">
            <p class="text-sm font-medium">{visitorUser?.name ?? 'GitHub 用户'}</p>
            <p class="text-xs text-muted-foreground">@{visitorUser?.login ?? ''}</p>
          </div>
          <p class="mt-3 text-sm leading-relaxed text-muted-foreground">
            提交申请后将进入授权管理页的待审列表，由顶级管理员同意并逐项授权后，你即可按所授予权限管理博客。
          </p>
          <button
            id="apply-admin-btn"
            type="button"
            class="mt-4 w-full rounded-md bg-primary px-4 py-2 text-sm text-primary-foreground transition-opacity duration-200 hover:opacity-90"
          >
            申请管理员权限
          </button>
          <p id="apply-admin-msg" class="mt-2 hidden text-xs" role="status" />
          <div class="mt-6 border-t border-border pt-5">
            <p class="text-sm font-medium">其他登录方式</p>
            <div class="mt-2 space-y-2">
              {
                githubEnabled && (
                  <a
                    href={ghLoginUrl}
                    class="flex items-center justify-center gap-2 rounded-md border border-border px-4 py-2 text-sm transition-colors duration-200 hover:bg-accent"
                  >
                    <svg viewBox="0 0 24 24" class="size-4" fill="currentColor" aria-hidden="true">
                      <path d="M12 2C6.48 2 2 6.58 2 12.25c0 4.53 2.87 8.37 6.84 9.73.5.09.68-.22.68-.49v-1.7c-2.78.62-3.37-1.37-3.37-1.37-.45-1.18-1.11-1.5-1.11-1.5-.91-.63.07-.62.07-.62 1 .07 1.53 1.06 1.53 1.06.9 1.57 2.35 1.12 2.92.85.09-.66.35-1.11.63-1.37-2.22-.26-4.56-1.14-4.56-5.07 0-1.12.39-2.03 1.03-2.75-.1-.26-.45-1.3.1-2.7 0 0 .84-.28 2.75 1.05a9.36 9.36 0 0 1 5 0c1.91-1.33 2.75-1.05 2.75-1.05.55 1.4.2 2.44.1 2.7.64.72 1.03 1.63 1.03 2.75 0 3.94-2.34 4.8-4.57 5.06.36.32.68.94.68 1.9v2.81c0 .27.18.59.69.49A10.26 10.26 0 0 0 22 12.25C22 6.58 17.52 2 12 2Z" />
                    </svg>
                    使用 GitHub 登录（切换账号）
                  </a>
                )
              }
              <details>
                <summary class="cursor-pointer text-sm text-muted-foreground transition-colors hover:text-foreground">站主登录</summary>
                <form id="top-login-form" class="mt-2 space-y-2">
                  <input
                    id="top-login-password"
                    type="password"
                    required
                    autocomplete="current-password"
                    placeholder="站主密码"
                    class="w-full rounded-md border border-input bg-background px-3 py-2 text-sm outline-none transition-colors focus-visible:border-ring focus-visible:ring-[3px] focus-visible:ring-ring/40"
                  />
                  <button
                    type="submit"
                    class="w-full rounded-md bg-primary px-4 py-2 text-sm text-primary-foreground transition-opacity duration-200 hover:opacity-90"
                  >
                    站主登录
                  </button>
                  <p id="top-login-error" class="hidden text-xs text-destructive" role="alert" />
                </form>
              </details>
            </div>
          </div>
        </div>
      )
    }
  </section>
</BaseLayout>

<script>
  /* 站主登录：POST /api/admin-auth/login → 成功跳授权管理页（document 委托，View Transitions 下有效） */
  document.addEventListener('submit', (e) => {
    const form = e.target as HTMLFormElement;
    if (form.id !== 'top-login-form') return;
    e.preventDefault();
    const errorEl = form.querySelector<HTMLParagraphElement>('#top-login-error');
    const input = form.querySelector<HTMLInputElement>('#top-login-password');
    errorEl?.classList.add('hidden');
    fetch('/api/admin-auth/login', {
      method: 'POST',
      headers: { 'content-type': 'application/json' },
      body: JSON.stringify({ password: input?.value ?? '' }),
    })
      .then(async (res) => {
        const data = (await res.json()) as { error?: string };
        if (res.ok) {
          window.location.href = '/admin/auth';
          return;
        }
        if (errorEl) {
          errorEl.textContent = data.error ?? '登录失败';
          errorEl.classList.remove('hidden');
        }
      })
      .catch(() => {
        if (errorEl) {
          errorEl.textContent = '网络错误，请重试';
          errorEl.classList.remove('hidden');
        }
      });
  });

  /* 访客提交管理员权限申请 */
  document.addEventListener('click', (e) => {
    if (!(e.target as HTMLElement).closest('#apply-admin-btn')) return;
    const btn = document.getElementById('apply-admin-btn') as HTMLButtonElement | null;
    const msg = document.getElementById('apply-admin-msg');
    if (!btn) return;
    btn.disabled = true;
    btn.textContent = '提交中…';
    fetch('/api/admin-auth/applications', {
      method: 'POST',
      headers: { 'content-type': 'application/json' },
      body: JSON.stringify({}),
    })
      .then(async (res) => {
        const data = (await res.json()) as { error?: string };
        if (res.ok && msg) {
          msg.textContent = '申请已提交，请等待顶级管理员审批。';
          msg.classList.remove('hidden');
          msg.classList.add('text-primary');
          btn.textContent = '已提交';
          return;
        }
        if (msg) {
          msg.textContent = data.error ?? '提交失败';
          msg.classList.remove('hidden');
          msg.classList.add('text-destructive');
        }
        btn.disabled = false;
        btn.textContent = '申请管理员权限';
      })
      .catch(() => {
        if (msg) {
          msg.textContent = '网络错误，请重试';
          msg.classList.remove('hidden');
          msg.classList.add('text-destructive');
        }
        btn.disabled = false;
        btn.textContent = '申请管理员权限';
      });
  });
</script>
