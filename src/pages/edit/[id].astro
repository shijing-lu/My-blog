---
/* ===== Props ===== */
/* （动态路由，无 Props） */

/* ===== Imports ===== */
import AdminLayout from '@/layouts/AdminLayout.astro';
import LiveEditor from '@/components/admin/LiveEditor';
import { getArticleById, listArticleMeta } from '@/lib/articles';
import { listArticleCategories, articleCategoryMap } from '@/lib/article-categories';
import type { ArticleType } from '../../../db/types';

/* ===== Logic ===== */
const { id } = Astro.params;
const article = id ? await getArticleById(id) : null;

/** 初始草稿：已存在 → 载入；不存在（新文章）→ 空草稿 */
const initial = article
  ? {
      id: article.id,
      title: article.title,
      type: article.type as ArticleType,
      summary: article.summary,
      cover: article.cover ?? '',
      tags: article.tags,
      content: article.content,
      encrypted: article.encrypted,
      encryptHint: article.encryptHint,
    }
  : id
    ? {
        id,
        title: '',
        type: 'tech' as ArticleType,
        summary: '',
        cover: '',
        tags: [],
        content: '',
        encrypted: false,
        encryptHint: '',
      }
    : null;

if (!initial) return Astro.redirect('/edit/new');

/** 全部文章元信息（左栏资源管理器，不含正文） */
const articles = (await listArticleMeta()).map((a) => ({
  id: a.id,
  title: a.title,
  type: a.type as ArticleType,
  updatedAt: a.updatedAt.toISOString(),
}));

/** 自定义分类（表未迁移时返回空数组 → 写作台回落到「按类型分组」，不会 500） */
const categories = await listArticleCategories();
/** 文章 → 分类 归属映射 */
const categoryMap = Object.fromEntries(await articleCategoryMap());
---
<!-- ===== Template ===== -->
<AdminLayout title="写作">
  <LiveEditor client:load initial={initial} articles={articles} categories={categories} categoryMap={categoryMap} />
</AdminLayout>
