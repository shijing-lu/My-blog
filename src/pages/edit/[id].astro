---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ArticleDetailShell from '@/components/article/ArticleDetailShell.astro';
import DocInlineEditor from '@/components/doc/DocInlineEditor';
import HomeArticleSettings from '@/components/article/HomeArticleSettings';
import HomeArticleFolderDialog from '@/components/article/HomeArticleFolderDialog.astro';
import ExportMenu from '@/components/ExportMenu.astro';
import ArticleCoverGenerator from '@/components/article/ArticleCoverGenerator';
import ArticleCoverUpload from '@/components/article/ArticleCoverUpload';
import { isTopAdmin } from '@/lib/admin-auth';
import { getArticleById, listAdminArticleMeta } from '@/lib/articles';
import { articleCategoryMap, listArticleCategories } from '@/lib/article-categories';
import { buildDocTree, renderDocTree, type DocTreeItem } from '@/lib/doc-tree-render';
import { renderMdx } from '@/lib/mdx';
import { renderTocTreeHtml } from '@/lib/toc-tree';
import { getImageSizes, collectImageIdsFromHtml, injectImageSizeAttrs } from '@/lib/images';

const id = Astro.params.id ?? '';
const article = await getArticleById(id);
const isOwner = await isTopAdmin(Astro.cookies);
if (!article) return Astro.redirect('/admin');
const [articles, categories, categoryMap] = await Promise.all([
  listAdminArticleMeta(), listArticleCategories(), articleCategoryMap(),
]);
const uncategorizedId = '__home_uncategorized__';
const categoryIds = new Set(categories.map((category) => category.id));
const articleFolder = (articleId: string): string | null => {
  const folderId = categoryMap.get(articleId);
  return folderId && categoryIds.has(folderId) ? folderId : null;
};
const nodes: DocTreeItem[] = [
  ...categories.map((category) => ({ id: category.id, parentId: category.parentId, kind: 'folder' as const, title: category.name, sort: category.sort })),
  { id: uncategorizedId, parentId: null, kind: 'folder', title: '未分类', sort: Number.MAX_SAFE_INTEGER },
  ...articles.map((item, index) => ({ id: item.id, parentId: articleFolder(item.id) ?? uncategorizedId, kind: 'article' as const, title: item.title || '未命名文章', sort: index, updatedAt: item.updatedAt })),
];
const treeHtml = renderDocTree(buildDocTree(nodes), { authed: true, bundleId: '', activeId: article.id, articlePath: 'home', virtualRootId: uncategorizedId });
const folderPath: string[] = [];
const byId = new Map(categories.map((category) => [category.id, category]));
let parentId = articleFolder(article.id);
const seen = new Set<string>();
while (parentId && !seen.has(parentId)) {
  const folder = byId.get(parentId);
  if (!folder) break;
  folderPath.unshift(folder.name);
  seen.add(parentId);
  parentId = folder.parentId;
}
if (folderPath.length === 0) folderPath.push('未分类');
const deferRender = article.content.length > 96 * 1024;
let rendered: Awaited<ReturnType<typeof renderMdx>> | null = null;
if (!deferRender) {
  try {
    rendered = await renderMdx(article.content);
  } catch (err) {
    console.error(`[edit] SSR renderMdx failed for article ${article.id}:`, err);
  }
}
let html = rendered?.html ?? (deferRender ? '<p class="text-sm text-muted-foreground">正在加载长文章…</p>' : '');
if (rendered && html) {
  const imageIds = collectImageIdsFromHtml(html);
  if (imageIds.length) html = injectImageSizeAttrs(html, await getImageSizes(imageIds));
}
const tocHtml = renderTocTreeHtml(rendered?.toc ?? []);
const settingsArticle = {
  id: article.id, title: article.title, type: article.type,
  summary: article.summary, cover: article.cover ?? '', tags: article.tags,
  encrypted: article.encrypted, encryptHint: article.encryptHint,
};
---

<BaseLayout title={`${article.title || '未命名文章'} · 文章编辑`} description={article.summary || '编辑文章'}>
  <ArticleDetailShell
    domain="home" authed={true} treeLabel="全部文章" treeHtml={treeHtml}
    title={article.title || '未命名文章'} articleHtml={html} tocHtml={tocHtml} cover={article.cover} articleId={article.id}
    tocState={deferRender ? 'loading' : rendered?.toc.length ? 'ready' : 'empty'}
    deferArticleId={deferRender ? article.id : undefined} emptyText="暂无文章。"
  >
    <Fragment slot="breadcrumb">
      <a href="/" class="transition-colors hover:text-primary">首页文章</a>
      <span id="home-folder-breadcrumb">{folderPath.map((part) => <><span class="mx-1">/</span><span>{part}</span></>)}</span>
    </Fragment>
    <Fragment slot="title-actions">
      <button id="home-create-article" type="button" class="mt-2 rounded-md border border-border px-3 py-1 text-xs text-muted-foreground hover:text-primary">＋ 新建文章</button>
      <button id="home-article-settings" type="button" class="mt-2 rounded-md border border-border px-2 py-1 text-xs text-muted-foreground hover:text-primary">文章设置</button>
      <button id="doc-inline-edit" type="button" class="mt-2 shrink-0 rounded-md border border-border px-2.5 py-1 text-xs text-muted-foreground transition-colors hover:border-primary/50 hover:text-primary">编辑</button>
      <button data-map-open type="button" class="mt-2">思维导图</button>
      <button id="doc-inline-preview" type="button" aria-pressed="true" class="mt-2 rounded-md border border-border px-2.5 py-1 text-xs text-primary">预览</button>
      <button id="doc-inline-source" type="button" aria-pressed="false" class="mt-2 rounded-md border border-border px-2.5 py-1 text-xs text-muted-foreground">源码模式</button>
      <ExportMenu mdUrl={`/api/export/article/${encodeURIComponent(article.slug)}`} class="mt-1.5" />
      {isOwner && <ArticleCoverGenerator client:load articleId={article.id} />}
      {isOwner && <ArticleCoverUpload client:load articleId={article.id} />}
    </Fragment>
    <Fragment slot="editor"><DocInlineEditor client:load /></Fragment>
  </ArticleDetailShell>
  <HomeArticleSettings client:load article={settingsArticle} categories={categories} categoryId={articleFolder(article.id)} />
  <div id="doc-detail-data" data-authed="1" data-active-node={article.id} data-raw-title={article.title} data-nodes={JSON.stringify(nodes)} class="hidden" aria-hidden="true" />
  <HomeArticleFolderDialog />
</BaseLayout>

<script>import '@/scripts/home-article-detail';</script>
