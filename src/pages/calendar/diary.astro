---
import { isTopAdmin } from '@/lib/admin-auth';
import { isValidDiaryDate } from '@/lib/diary-log';

export const prerender = false;
if (!(await isTopAdmin(Astro.cookies))) return Astro.redirect('/login?next=%2Fcalendar');
Astro.response.headers.set('cache-control', 'private, no-store');
const date = Astro.url.searchParams.get('date') ?? '';
return Astro.redirect(isValidDiaryDate(date) ? `/calendar?month=${date.slice(0, 7)}&date=${date}&open=diary` : '/calendar');
---
