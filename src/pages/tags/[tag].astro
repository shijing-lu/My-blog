---
/* ===== Props ===== */
/* （动态路由，无 Props） */

/* ===== Imports ===== */
import BaseLayout from '@/layouts/BaseLayout.astro';
import WorkspaceHeading from '@/components/WorkspaceHeading.astro';
import NeoIcon from '@/components/NeoIcon.astro';
import '@/styles/completion-workspace.css';
import { listArticles } from '@/lib/articles';
import { countChars } from '@/lib/reading';

/* ===== Logic ===== */
const { tag } = Astro.params;
const tagName = (tag ?? '').trim();

const articles = (await listArticles()).filter((a) =>
  a.tags.some((t) => t.toLowerCase() === tagName.toLowerCase()),
);

if (!tagName || articles.length === 0) {
  Astro.response.status = 404;
}

/** 格式化时间为「YYYY-MM-DD HH:mm」 */
function formatShort(date: Date): string {
  const y = date.getFullYear();
  const m = String(date.getMonth() + 1).padStart(2, '0');
  const d = String(date.getDate()).padStart(2, '0');
  const h = String(date.getHours()).padStart(2, '0');
  const min = String(date.getMinutes()).padStart(2, '0');
  return `${y}-${m}-${d} ${h}:${min}`;
}
---
<!-- ===== Template ===== -->
<BaseLayout title={`标签：${tagName}`} description={`标签 ${tagName} 下的全部文章`}>
  <section class="neo-workspace neo-tags">
    <WorkspaceHeading title={`标签：${tagName}`} eyebrow="TAG ARCHIVE / 阅读与发现" description={`共 ${articles.length} 篇文章，沿着一个关键词继续阅读。`}><a href="/archive" class="neo-workspace-button">全部归档</a></WorkspaceHeading>

    <div class="neo-tags-grid">
      {
        articles.map((article) => (
          <a href={`/blog/${article.slug}`} class="neo-tag-card">
            <img src={article.cover || '/images/neobrutalism/article-fallback.webp'} alt="" width="480" height="270" loading="lazy" decoding="async" onerror="this.onerror=null;this.src='/images/neobrutalism/article-fallback.webp'" />
            <div class="p-4">
              <div class="flex items-center gap-2">
                <time class="font-pixel text-xs text-muted-foreground" datetime={article.updatedAt.toISOString()}>
                  {formatShort(article.updatedAt)}
                </time>
              </div>
              <h2 class="mt-2.5 font-display text-lg font-semibold leading-snug">{article.title}</h2>
              <p class="font-readable mt-1.5 text-sm text-muted-foreground line-clamp-2">{article.summary}</p>
              <p class="mt-3 font-pixel text-xs text-primary">{countChars(article.content)} 字</p>
              {article.encrypted && <span class="mt-2 inline-flex items-center gap-1 text-xs text-muted-foreground"><NeoIcon name="lock" size={14} />已加密</span>}
            </div>
          </a>
        ))
      }
    </div>

    {
      articles.length === 0 && (
        <div class="neo-workspace-empty"><img src="/images/neobrutalism/cat-peek.webp" width="90" height="72" alt="" aria-hidden="true" /><p>该标签下暂无文章。</p><a href="/archive" class="neo-workspace-button">浏览全部文章</a></div>
      )
    }
  </section>
</BaseLayout>
