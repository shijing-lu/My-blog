---
/* ===== Imports ===== */
import BaseLayout from '@/layouts/BaseLayout.astro';
import { autoIconUrl, googleFaviconUrl, listNav } from '@/lib/nav';

/* ===== Logic ===== */
const categories = await listNav();
const totalSites = categories.reduce((n, c) => n + c.sites.length, 0);

interface SiteLike {
  id: string;
  name: string;
  url: string;
  icon: string | null;
  desc: string | null;
}

/** 统一卡片模板（紧凑长方形，约原尺寸 2/3）：图标 + 名称 + 简介 */
function SiteCard({ site }: { site: SiteLike }) {
  return (
    <a
      href={site.url}
      target="_blank"
      rel="noopener noreferrer"
      class="group flex items-center gap-2.5 rounded-lg border border-border bg-card p-2.5 transition-all duration-200 hover:-translate-y-0.5 hover:border-primary/50 hover:shadow-md"
    >
      <span class="relative inline-flex size-8 shrink-0 items-center justify-center overflow-hidden rounded-md border border-border bg-muted">
        <img
          class="nav-icon size-5 object-contain"
          src={autoIconUrl(site.url, site.icon)}
          alt=""
          loading="lazy"
          data-google={googleFaviconUrl(site.url)}
          data-name={site.name}
        />
        <span class="nav-icon-fallback hidden font-display text-sm font-semibold text-primary">
          {(site.name || '?').slice(0, 1)}
        </span>
      </span>
      <span class="min-w-0">
        <span class="block truncate text-xs font-medium">{site.name}</span>
        {site.desc && <span class="mt-0.5 block truncate text-[0.7rem] text-muted-foreground">{site.desc}</span>}
      </span>
    </a>
  );
}
---
<BaseLayout title="导航" description="精选网站导航 —— My Blog Navigation">
  <section class="mx-auto w-full max-w-6xl px-4 py-10">
    <!-- 头部 -->
    <div data-hero>
      <p class="font-pixel text-[0.6rem] uppercase tracking-[0.2em] text-primary">NAVIGATION</p>
      <h1 class="mt-1 font-display text-3xl font-semibold tracking-tight">导航</h1>
      <p class="mt-1 text-sm text-muted-foreground">
        {categories.length > 0 ? `共 ${categories.length} 个分类 · ${totalSites} 个网站` : '精选网站，方便查找。'}
      </p>
    </div>
    <div class="pixel-divider mt-5" />

    {
      categories.length === 0 ? (
        <p class="mt-10 text-center text-sm text-muted-foreground">暂无分类 —— 管理员可到后台添加。</p>
      ) : (
        <div class="mt-6 flex gap-6">
          {/* 左侧分类栏 */}
          <aside class="hidden w-52 shrink-0 md:block">
            <div class="sticky top-20 rounded-lg border border-border bg-card p-2">
              <p class="pixel-chip mb-2 px-1 text-muted-foreground">分类 / CATEGORIES</p>
              <nav class="space-y-0.5 text-sm" aria-label="导航分类">
                <button
                  type="button"
                  data-cat-tab="all"
                  class="flex w-full items-center gap-2 rounded-md px-2.5 py-1.5 text-left text-muted-foreground transition-colors duration-150 hover:bg-accent hover:text-foreground"
                >
                  <span aria-hidden="true">🧭</span>
                  <span>全部网站</span>
                </button>
                {categories.map((c) => (
                  <button
                    type="button"
                    data-cat-tab={c.id}
                    class="flex w-full items-center gap-2 rounded-md px-2.5 py-1.5 text-left text-muted-foreground transition-colors duration-150 hover:bg-accent hover:text-foreground"
                  >
                    {c.icon ? <span class="shrink-0" aria-hidden="true">{c.icon}</span> : null}
                    <span class="truncate">{c.name}</span>
                    <span class="ml-auto font-pixel text-[0.55rem] text-muted-foreground">{c.sites.length}</span>
                  </button>
                ))}
              </nav>
            </div>
          </aside>

          {/* 右侧内容：全部 + 各分类面板（点击分类切换） */}
          <main class="min-w-0 flex-1">
            <div data-cat-panel="all">
              <div class="grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-4">
                {categories.flatMap((c) => c.sites).map((site) => (
                  <SiteCard site={site} />
                ))}
              </div>
            </div>
            {categories.map((c) => (
              <div data-cat-panel={c.id} class="hidden">
                {
                  c.sites.length === 0 ? (
                    <p class="text-sm text-muted-foreground">该分类暂无网站。</p>
                  ) : (
                    <div class="grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-4">
                      {c.sites.map((site) => (
                        <SiteCard site={site} />
                      ))}
                    </div>
                  )
                }
              </div>
            ))}
          </main>
        </div>
      )
    }
  </section>
</BaseLayout>

<script>
  /** 分类切换：点击左侧分类 → 右侧显示对应面板 */
  const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-cat-tab]'));
  const panels = Array.from(document.querySelectorAll<HTMLElement>('[data-cat-panel]'));
  function activate(id: string): void {
    panels.forEach((p) => p.classList.toggle('hidden', p.dataset.catPanel !== id));
    tabs.forEach((t) => {
      const active = t.dataset.catTab === id;
      t.classList.toggle('bg-primary/10', active);
      t.classList.toggle('text-primary', active);
      t.classList.toggle('text-muted-foreground', !active);
    });
  }
  activate('all');
  tabs.forEach((t) => t.addEventListener('click', () => activate(t.dataset.catTab ?? 'all')));
  document.addEventListener('astro:page-load', () => activate('all'));

  /** 图标三级兜底：favicon.ico → Google favicon → 首字占位 */
  function bindIconFallback(): void {
    document.querySelectorAll<HTMLImageElement>('.nav-icon').forEach((img) => {
      if (img.dataset.bound) return;
      img.dataset.bound = '1';
      img.addEventListener('error', () => {
        if (!img.dataset.stage) {
          img.dataset.stage = '1';
          img.src = img.dataset.google ?? '';
          return;
        }
        img.classList.add('hidden');
        (img.nextElementSibling as HTMLElement | null)?.classList.remove('hidden');
      });
    });
  }
  bindIconFallback();
  document.addEventListener('astro:page-load', bindIconFallback);
</script>
