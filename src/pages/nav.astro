---
/* ===== Imports ===== */
import BaseLayout from '@/layouts/BaseLayout.astro';
import { autoIconUrl, googleFaviconUrl, listNav } from '@/lib/nav';
import { verifyRequest } from '@/lib/auth';

/* ===== Logic ===== */
const categories = await listNav();
const totalSites = categories.reduce((n, c) => n + c.sites.length, 0);
/** 管理员：显示删除叉 / 添加加号 / 支持拖拽移动 */
const isAuthed = verifyRequest(Astro.cookies);
/** 全量分类数据（编辑弹窗用，经隐藏 div 注入） */
const categoriesJson = JSON.stringify(categories.map((c) => ({ id: c.id, name: c.name, icon: c.icon, sites: c.sites })));

interface SiteLike {
  id: string;
  name: string;
  url: string;
  icon: string | null;
  desc: string | null;
  categoryId: string;
}

/** HTML 转义 */
function esc(s: string): string {
  return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;').replace(/'/g, '&#39;');
}

/**
 * 统一卡片模板（紧凑长方形）：图标 + 名称 + 简介
 * 管理员模式下：卡片可拖拽（移动到分类）+ 右上角删除叉
 */
function renderSite(site: SiteLike, authed: boolean): string {
  const iconSrc = autoIconUrl(site.url, site.icon);
  const google = googleFaviconUrl(site.url);
  const name = site.name || '?';
  const desc = site.desc
    ? `<span class="mt-0.5 block truncate text-[0.7rem] text-muted-foreground">${esc(site.desc)}</span>`
    : '';
  const dragAttr = authed ? ` draggable="true" data-site-id="${site.id}" data-site-name="${esc(name)}"` : '';
  // 管理员：右上角操作组（编辑 ✎ + 删除 ×，hover 显示）
  const actions = authed
    ? `<span class="absolute -right-1.5 -top-2 z-10 flex items-center gap-1 opacity-0 transition-opacity group-hover:opacity-100">` +
      `<button type="button" data-site-edit="${site.id}" title="编辑" aria-label="编辑" ` +
      `class="inline-flex size-4 items-center justify-center rounded-full border border-border bg-card text-[0.6rem] leading-none text-muted-foreground transition-colors hover:border-primary/50 hover:text-primary">✎</button>` +
      `<button type="button" data-site-del="${site.id}" data-site-name="${esc(name)}" title="删除" aria-label="删除" ` +
      `class="inline-flex size-4 items-center justify-center rounded-full border border-border bg-card text-[0.6rem] leading-none text-muted-foreground transition-colors hover:border-destructive/50 hover:text-destructive">×</button>` +
      `</span>`
    : '';
  return (
    `<div class="group relative">` +
    `<a href="${esc(site.url)}"${dragAttr} target="_blank" rel="noopener noreferrer" ` +
    `class="flex items-center gap-2.5 rounded-lg border border-border bg-card p-2.5 transition-all duration-200 hover:-translate-y-0.5 hover:border-primary/50 hover:shadow-md">` +
    `<span class="relative inline-flex size-8 shrink-0 items-center justify-center overflow-hidden rounded-md border border-border bg-muted">` +
    `<img class="nav-icon size-5 object-contain" src="${esc(iconSrc)}" alt="" loading="lazy" data-google="${esc(google)}" data-name="${esc(name)}" />` +
    `<span class="nav-icon-fallback hidden font-display text-sm font-semibold text-primary">${esc(name.slice(0, 1))}</span>` +
    `</span>` +
    `<span class="min-w-0"><span class="block truncate text-xs font-medium">${esc(name)}</span>${desc}</span>` +
    `</a>${actions}</div>`
  );
}

/** 分类下的网站网格（含底部「+ 添加网址」） */
function siteGrid(sites: SiteLike[], categoryId: string, authed: boolean): string {
  const cards = sites.map((s) => renderSite(s, authed)).join('');
  const addBtn = authed
    ? `<div class="mt-3 flex justify-center">` +
      `<button type="button" data-site-add="${categoryId}" ` +
      `class="rounded-full border border-dashed border-border px-6 py-1.5 text-xs text-muted-foreground transition-colors hover:border-primary/50 hover:text-primary">＋ 添加网址</button></div>`
    : '';
  return `<div class="grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-4">${cards}</div>${addBtn}`;
}
---
<BaseLayout title="导航" description="精选网站导航 —— My Blog Navigation">
  <section data-authed={isAuthed ? '1' : '0'}>
    {
      categories.length > 0 && (
        /* 窄屏分类横排（吸顶）：超宽屏（1720px+）才改用左侧悬浮栏，其余一律走顶部横条 */
        <div class="sticky top-14 z-20 flex gap-1.5 overflow-x-auto border-b border-border bg-background/85 px-4 py-2 text-xs backdrop-blur-md min-[1720px]:hidden">
          <button
            type="button"
            data-cat-tab="all"
            data-cat-name="全部网站"
            class="shrink-0 rounded-full border border-border px-3 py-1 text-muted-foreground transition-colors hover:border-primary/50 hover:text-primary"
          >
            🧭 全部
          </button>
          {categories.map((c) => (
            <button
              type="button"
              data-cat-tab={c.id}
              data-cat-name={c.name}
              class="shrink-0 rounded-full border border-border px-3 py-1 text-muted-foreground transition-colors hover:border-primary/50 hover:text-primary"
            >
              {c.icon ? `${c.icon} ` : ''}{c.name}
            </button>
          ))}
          {isAuthed && (
            <button
              type="button"
              data-cat-add
              class="shrink-0 rounded-full border border-dashed border-border px-3 py-1 text-muted-foreground transition-colors hover:border-primary/50 hover:text-primary"
            >
              ＋ 分类
            </button>
          )}
        </div>
      )
    }

    {/* 主体内容：与页脚同宽（max-w-6xl）居中，两条虚线左右对齐；分类栏锚定在内容区左侧 */}
    <main class="relative mx-auto w-full max-w-6xl px-4 py-10">
      {
        categories.length === 0 ? (
          <div class="mt-10 text-center">
            <p class="text-sm text-muted-foreground">暂无分类 —— 管理员可到后台添加。</p>
            {isAuthed && (
              <button
                type="button"
                data-cat-add
                class="mt-4 rounded-full border border-dashed border-border px-6 py-1.5 text-xs text-muted-foreground transition-colors hover:border-primary/50 hover:text-primary"
              >
                ＋ 添加分类
              </button>
            )}
          </div>
        ) : (
          <>
            <div data-hero class="text-center">
              <p class="font-pixel text-[0.6rem] uppercase tracking-[0.2em] text-primary">NAVIGATION</p>
              <h1 id="nav-title" class="mt-1 font-display text-3xl font-semibold tracking-tight">全部网站</h1>
              <p class="mt-1 text-sm text-muted-foreground">
                共 {categories.length} 个分类 · {totalSites} 个网站
              </p>
            </div>
            <div class="relative mt-5">
              <div class="pixel-divider" />
              {
                categories.length > 0 && (
                  <aside class="absolute right-[calc(100%+1.5rem)] top-0 z-30 hidden w-52 min-[1720px]:block">
                  <div class="rounded-xl border border-border bg-card/85 p-3 shadow-md backdrop-blur-md">
                    <p class="pixel-chip mb-2 px-1 text-muted-foreground">分类 / CATEGORIES</p>
                    <nav class="space-y-0.5 text-sm" aria-label="导航分类">
                      <button
                        type="button"
                        data-cat-tab="all"
                        data-cat-name="全部网站"
                        class="flex w-full items-center gap-2 rounded-md px-2.5 py-1.5 text-left text-muted-foreground transition-colors duration-150 hover:bg-accent hover:text-foreground"
                      >
                        <span aria-hidden="true">🧭</span>
                        <span>全部网站</span>
                      </button>
                      {categories.map((c) => (
                        <div class="group relative">
                          <button
                            type="button"
                            data-cat-tab={c.id}
                            data-cat-name={c.name}
                            data-cat-id={c.id}
                            data-drop-cat={isAuthed ? c.id : undefined}
                            draggable={isAuthed ? 'true' : undefined}
                            class="flex w-full items-center gap-2 rounded-md px-2.5 py-1.5 pr-6 text-left text-muted-foreground transition-colors duration-150 hover:bg-accent hover:text-foreground"
                            title={isAuthed ? '拖拽可排序；拖拽网站卡片到此处可移动' : undefined}
                          >
                            {c.icon ? <span class="shrink-0" aria-hidden="true">{c.icon}</span> : null}
                            <span class="truncate">{c.name}</span>
                            <span class="ml-auto font-pixel text-[0.55rem] text-muted-foreground">{c.sites.length}</span>
                          </button>
                          {isAuthed && (
                            <span
                              class="absolute -top-1.5 right-0 z-10 flex items-center gap-1 opacity-0 transition-opacity group-hover:opacity-100"
                            >
                              <button
                                type="button"
                                data-cat-edit={c.id}
                                title="编辑分类"
                                aria-label="编辑分类"
                                class="inline-flex size-4 items-center justify-center rounded-full border border-border bg-card text-[0.6rem] leading-none text-muted-foreground transition-colors hover:border-primary/50 hover:text-primary"
                              >✎</button>
                              <button
                                type="button"
                                data-cat-del={c.id}
                                data-cat-name={esc(c.name)}
                                title="删除分类"
                                aria-label="删除分类"
                                class="inline-flex size-4 items-center justify-center rounded-full border border-border bg-card text-[0.6rem] leading-none text-muted-foreground transition-colors hover:border-destructive/50 hover:text-destructive"
                              >×</button>
                            </span>
                          )}
                        </div>
                      ))}
                    </nav>
                    {isAuthed && (
                      <>
                        <button
                          type="button"
                          data-cat-add
                          class="mt-2 flex w-full items-center justify-center gap-1 rounded-md border border-dashed border-border px-2.5 py-1.5 text-xs text-muted-foreground transition-colors hover:border-primary/50 hover:text-primary"
                        >
                          ＋ 添加分类
                        </button>
                        <p class="mt-2 border-t border-border px-1 pt-2 text-[0.6rem] text-muted-foreground">
                          提示：拖拽网站卡片到分类移动；拖拽分类可排序
                        </p>
                      </>
                    )}
                  </div>
                </aside>
              )
            }
            </div>
            <div class="mt-6">
              <div data-cat-panel="all">
                <Fragment set:html={siteGrid(categories.flatMap((c) => c.sites), '', false)} />
              </div>
              {categories.map((c) => (
                <div data-cat-panel={c.id} class="hidden">
                  {
                    c.sites.length === 0 && !isAuthed ? (
                      <p class="text-sm text-muted-foreground">该分类暂无网站。</p>
                    ) : (
                      <Fragment set:html={siteGrid(c.sites, c.id, isAuthed)} />
                    )
                  }
                </div>
              ))}
            </div>
          </>
        )
      }
    </main>
  </section>

  <!-- 添加网址弹框（管理员，居中） -->
  <dialog id="nav-add-dialog" class="m-auto w-96 rounded-lg border border-border bg-card p-4 shadow-xl backdrop:bg-black/40">
    <h3 class="font-medium">添加网址</h3>
    <p id="nav-add-target" class="mt-0.5 text-xs text-muted-foreground"></p>
    <label class="mt-3 block text-xs font-medium text-muted-foreground">
      网址
      <input
        id="nav-add-url"
        type="url"
        placeholder="https://…"
        class="mt-1 w-full rounded-md border border-input bg-background px-3 py-1.5 text-sm outline-none transition-colors focus-visible:border-ring"
      />
    </label>
    <label class="mt-2 block text-xs font-medium text-muted-foreground">
      名称（可选，默认取域名）
      <input
        id="nav-add-name"
        type="text"
        maxlength="80"
        class="mt-1 w-full rounded-md border border-input bg-background px-3 py-1.5 text-sm outline-none transition-colors focus-visible:border-ring"
      />
    </label>
    <p id="nav-add-status" class="mt-2 hidden text-xs text-destructive" role="alert"></p>
    <div class="mt-3 flex items-center justify-end gap-2">
      <button id="nav-add-cancel" type="button" class="rounded-md px-2 py-1 text-xs text-muted-foreground hover:text-foreground">
        取消
      </button>
      <button
        id="nav-add-confirm"
        type="button"
        class="rounded-md bg-primary px-3 py-1 text-xs text-primary-foreground transition-opacity hover:opacity-90"
      >
        添加（自动扒图标简介）
      </button>
    </div>
  </dialog>

  <!-- 编辑网址弹框（管理员，居中） -->
  <dialog id="nav-edit-dialog" class="m-auto w-96 rounded-lg border border-border bg-card p-4 shadow-xl backdrop:bg-black/40">
    <h3 class="font-medium">编辑网址</h3>
    <p id="nav-edit-target" class="mt-0.5 text-xs text-muted-foreground"></p>
    <label class="mt-3 block text-xs font-medium text-muted-foreground">
      名称
      <input
        id="nav-edit-name"
        type="text"
        maxlength="80"
        class="mt-1 w-full rounded-md border border-input bg-background px-3 py-1.5 text-sm outline-none transition-colors focus-visible:border-ring"
      />
    </label>
    <label class="mt-2 block text-xs font-medium text-muted-foreground">
      网址
      <input
        id="nav-edit-url"
        type="url"
        maxlength="300"
        class="mt-1 w-full rounded-md border border-input bg-background px-3 py-1.5 text-sm outline-none transition-colors focus-visible:border-ring"
      />
    </label>
    <label class="mt-2 block text-xs font-medium text-muted-foreground">
      简介（可选）
      <input
        id="nav-edit-desc"
        type="text"
        maxlength="200"
        class="mt-1 w-full rounded-md border border-input bg-background px-3 py-1.5 text-sm outline-none transition-colors focus-visible:border-ring"
      />
    </label>
    <label class="mt-2 block text-xs font-medium text-muted-foreground">
      所属分类
      <select
        id="nav-edit-cat"
        class="mt-1 w-full rounded-md border border-input bg-background px-2 py-1.5 text-sm outline-none focus-visible:border-ring"
      ></select>
    </label>
    <p id="nav-edit-status" class="mt-2 hidden text-xs text-destructive" role="alert"></p>
    <div class="mt-3 flex items-center justify-end gap-2">
      <button id="nav-edit-cancel" type="button" class="rounded-md px-2 py-1 text-xs text-muted-foreground hover:text-foreground">
        取消
      </button>
      <button
        id="nav-edit-confirm"
        type="button"
        class="rounded-md bg-primary px-3 py-1 text-xs text-primary-foreground transition-opacity hover:opacity-90"
      >
        保存
      </button>
    </div>
  </dialog>

  <!-- 添加分类弹框（管理员，居中） -->
  <dialog id="nav-cat-add-dialog" class="m-auto w-80 rounded-lg border border-border bg-card p-4 shadow-xl backdrop:bg-black/40">
    <h3 class="font-medium">添加分类</h3>
    <label class="mt-3 block text-xs font-medium text-muted-foreground">
      分类名
      <input
        id="nav-cat-add-name"
        type="text"
        maxlength="50"
        class="mt-1 w-full rounded-md border border-input bg-background px-3 py-1.5 text-sm outline-none transition-colors focus-visible:border-ring"
      />
    </label>
    <label class="mt-2 block text-xs font-medium text-muted-foreground">
      图标（可选，填一个 emoji）
      <input
        id="nav-cat-add-icon"
        type="text"
        maxlength="20"
        placeholder="如 🧭"
        class="mt-1 w-full rounded-md border border-input bg-background px-3 py-1.5 text-sm outline-none transition-colors focus-visible:border-ring"
      />
    </label>
    <p id="nav-cat-add-status" class="mt-2 hidden text-xs text-destructive" role="alert"></p>
    <div class="mt-3 flex items-center justify-end gap-2">
      <button id="nav-cat-add-cancel" type="button" class="rounded-md px-2 py-1 text-xs text-muted-foreground hover:text-foreground">
        取消
      </button>
      <button
        id="nav-cat-add-confirm"
        type="button"
        class="rounded-md bg-primary px-3 py-1 text-xs text-primary-foreground transition-opacity hover:opacity-90"
      >
        添加
      </button>
    </div>
  </dialog>

  <!-- 编辑分类弹框（管理员，居中） -->
  <dialog id="nav-cat-edit-dialog" class="m-auto w-80 rounded-lg border border-border bg-card p-4 shadow-xl backdrop:bg-black/40">
    <h3 class="font-medium">编辑分类</h3>
    <p id="nav-cat-edit-target" class="mt-0.5 text-xs text-muted-foreground"></p>
    <label class="mt-3 block text-xs font-medium text-muted-foreground">
      分类名
      <input
        id="nav-cat-edit-name"
        type="text"
        maxlength="50"
        class="mt-1 w-full rounded-md border border-input bg-background px-3 py-1.5 text-sm outline-none transition-colors focus-visible:border-ring"
      />
    </label>
    <label class="mt-2 block text-xs font-medium text-muted-foreground">
      图标（可选，填一个 emoji）
      <input
        id="nav-cat-edit-icon"
        type="text"
        maxlength="20"
        placeholder="如 🧭"
        class="mt-1 w-full rounded-md border border-input bg-background px-3 py-1.5 text-sm outline-none transition-colors focus-visible:border-ring"
      />
    </label>
    <p id="nav-cat-edit-status" class="mt-2 hidden text-xs text-destructive" role="alert"></p>
    <div class="mt-3 flex items-center justify-end gap-2">
      <button id="nav-cat-edit-cancel" type="button" class="rounded-md px-2 py-1 text-xs text-muted-foreground hover:text-foreground">
        取消
      </button>
      <button
        id="nav-cat-edit-confirm"
        type="button"
        class="rounded-md bg-primary px-3 py-1 text-xs text-primary-foreground transition-opacity hover:opacity-90"
      >
        保存
      </button>
    </div>
  </dialog>

  <!-- 分类/网站数据（脚本读取） -->
  <div id="nav-data" data-categories={categoriesJson} class="hidden" aria-hidden="true" />
</BaseLayout>

<script>
  /** 导航页：分类切换 + 图标兜底 + 管理员增删移（× 删除 / ＋ 添加 / 拖拽移动） */
  import { confirmDanger } from '@/lib/confirm';
  const IS_AUTHED = document.querySelector<HTMLElement>('[data-authed]')?.dataset.authed === '1';

  // ---- 分类切换（document 委托 + 实时查询 DOM，View Transition 后依然有效）----
  function activate(id: string): void {
    // 实时查询（View Transition 后 DOM 被替换）
    const panels = Array.from(document.querySelectorAll<HTMLElement>('[data-cat-panel]'));
    const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-cat-tab]'));
    panels.forEach((p) => p.classList.toggle('hidden', p.dataset.catPanel !== id));
    tabs.forEach((t) => {
      const active = t.dataset.catTab === id;
      t.classList.toggle('bg-primary/10', active);
      t.classList.toggle('text-primary', active);
      t.classList.toggle('text-muted-foreground', !active);
    });
    // 标题跟随当前分类
    const navTitle = document.getElementById('nav-title');
    const activeTab = tabs.find((t) => t.dataset.catTab === id);
    if (navTitle && activeTab?.dataset.catName) navTitle.textContent = activeTab.dataset.catName;
  }
  activate('all');
  document.addEventListener('click', (e) => {
    const tab = (e.target as HTMLElement).closest<HTMLElement>('[data-cat-tab]');
    if (!tab) return;
    activate(tab.dataset.catTab ?? 'all');
  });
  document.addEventListener('astro:page-load', () => activate('all'));

  // ---- 图标三级兜底：favicon.ico → Google favicon → 首字占位 ----
  // Google 可能被墙/慢：切换后 4s 未加载直接显示首字占位，避免空白/broken
  function bindIconFallback(): void {
    document.querySelectorAll<HTMLImageElement>('.nav-icon').forEach((img) => {
      if (img.dataset.bound) return;
      img.dataset.bound = '1';
      const showFallback = (): void => {
        img.classList.add('hidden');
        (img.nextElementSibling as HTMLElement | null)?.classList.remove('hidden');
      };
      let googleTimer = 0;
      img.addEventListener('error', () => {
        if (!img.dataset.stage) {
          img.dataset.stage = '1';
          img.src = img.dataset.google ?? '';
          googleTimer = window.setTimeout(showFallback, 2500);
          return;
        }
        window.clearTimeout(googleTimer);
        showFallback();
      });
      img.addEventListener('load', () => window.clearTimeout(googleTimer));
    });
  }
  bindIconFallback();
  document.addEventListener('astro:page-load', bindIconFallback);

  // ---- 管理员操作：删除 / 添加 / 拖拽移动 ----
  if (IS_AUTHED) {
    // 删除（卡片右上角 ×）
    document.addEventListener('click', async (e) => {
      const del = (e.target as HTMLElement).closest<HTMLElement>('[data-site-del]');
      if (!del) return;
      if (!(await confirmDanger(`删除网站「${del.dataset.siteName}」？`))) return;
      const res = await fetch('/api/nav/sites', {
        method: 'DELETE',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ id: del.dataset.siteDel }),
      });
      if (res.ok) del.closest<HTMLElement>('.group')?.remove();
    });

    // 编辑（卡片右上角 ✎）——居中弹窗
    interface NavSiteJson { id: string; name: string; url: string; icon: string | null; desc: string | null; categoryId: string }
    interface NavCatJson { id: string; name: string; icon: string | null; sites: NavSiteJson[] }
    const NAV_DATA = JSON.parse(
      (document.getElementById('nav-data') as HTMLElement).dataset.categories ?? '[]',
    ) as NavCatJson[];
    let editingSiteId: string | null = null;
    /** 实时查询元素（View Transition 后 DOM 被替换，必须每次重新取） */
    function $(id: string): HTMLElement | null {
      return document.getElementById(id);
    }
    function fillEditCats(selected: string): void {
      const editCat = $('nav-edit-cat') as HTMLSelectElement | null;
      if (!editCat) return;
      editCat.innerHTML = NAV_DATA.map(
        (c) => `<option value="${c.id}" ${c.id === selected ? 'selected' : ''}>${escHtml(c.name)}</option>`,
      ).join('');
    }
    function escHtml(s: string): string {
      return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
    }
    document.addEventListener('click', (e) => {
      const edit = (e.target as HTMLElement).closest<HTMLElement>('[data-site-edit]');
      if (!edit) return;
      const siteId = edit.dataset.siteEdit;
      if (!siteId) return;
      const cat = NAV_DATA.find((c) => c.sites.some((s) => s.id === siteId));
      const site = cat?.sites.find((s) => s.id === siteId);
      const editDialog = $('nav-edit-dialog') as HTMLDialogElement | null;
      if (!site || !cat || !editDialog) return;
      editingSiteId = siteId;
      const editName = $('nav-edit-name') as HTMLInputElement | null;
      const editUrl = $('nav-edit-url') as HTMLInputElement | null;
      const editDesc = $('nav-edit-desc') as HTMLInputElement | null;
      const editStatus = $('nav-edit-status');
      if (editName) editName.value = site.name;
      if (editUrl) editUrl.value = site.url;
      if (editDesc) editDesc.value = site.desc ?? '';
      fillEditCats(cat.id);
      if (editStatus) editStatus.classList.add('hidden');
      editDialog.showModal();
      editName?.focus();
    });
    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      if (!target.closest('#nav-edit-cancel')) return;
      ($('nav-edit-dialog') as HTMLDialogElement | null)?.close();
    });
    document.addEventListener('click', async (e) => {
      const target = e.target as HTMLElement;
      if (!target.closest('#nav-edit-confirm')) return;
      const editDialog = $('nav-edit-dialog') as HTMLDialogElement | null;
      const editName = $('nav-edit-name') as HTMLInputElement | null;
      const editUrl = $('nav-edit-url') as HTMLInputElement | null;
      const editDesc = $('nav-edit-desc') as HTMLInputElement | null;
      const editCat = $('nav-edit-cat') as HTMLSelectElement | null;
      const editStatus = $('nav-edit-status');
      if (!editingSiteId || !editDialog) return;
      const name = (editName?.value ?? '').trim();
      const url = (editUrl?.value ?? '').trim();
      if (!name || !url) {
        if (editStatus) { editStatus.textContent = '名称和网址不能为空'; editStatus.classList.remove('hidden'); }
        return;
      }
      try {
        const res = await fetch('/api/nav/sites', {
          method: 'PUT',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({
            id: editingSiteId,
            name,
            url,
            desc: (editDesc?.value ?? '').trim() || null,
            categoryId: editCat?.value ?? undefined,
          }),
        });
        const d = (await res.json().catch(() => ({}))) as { error?: string };
        if (!res.ok) {
          if (editStatus) { editStatus.textContent = d.error ?? '保存失败'; editStatus.classList.remove('hidden'); }
          return;
        }
        editDialog.close();
        window.location.reload();
      } catch {
        if (editStatus) { editStatus.textContent = '保存失败'; editStatus.classList.remove('hidden'); }
      }
    });

  // ---- 添加（分类面板底部 ＋）----
  let addCategoryId = '';
  function domainFromUrl(url: string): string {
    try {
      return new URL(url.startsWith('http') ? url : `https://${url}`).hostname.replace(/^www\./, '');
    } catch {
      return url;
    }
  }
  document.addEventListener('click', (e) => {
    const add = (e.target as HTMLElement).closest<HTMLElement>('[data-site-add]');
    if (!add) return;
    const addDialog = $('nav-add-dialog') as HTMLDialogElement | null;
    const addUrl = $('nav-add-url') as HTMLInputElement | null;
    const addName = $('nav-add-name') as HTMLInputElement | null;
    const addTarget = $('nav-add-target');
    const addStatus = $('nav-add-status');
    if (!addDialog) return;
    addCategoryId = add.dataset.siteAdd ?? '';
    const catName = add.closest('[data-cat-panel]')?.querySelector('[data-cat-tab]')?.textContent?.trim() ?? '';
    if (addTarget) addTarget.textContent = catName ? `添加到「${catName}」` : '';
    if (addUrl) addUrl.value = '';
    if (addName) addName.value = '';
    addStatus?.classList.add('hidden');
    addDialog.showModal();
    addUrl?.focus();
  });
  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    if (target.closest('#nav-add-cancel')) ($('nav-add-dialog') as HTMLDialogElement | null)?.close();
  });
  let addingSite = false;
  document.addEventListener('click', async (e) => {
    const target = e.target as HTMLElement;
    if (!target.closest('#nav-add-confirm')) return;
    if (addingSite) return;
    const addDialog = $('nav-add-dialog') as HTMLDialogElement | null;
    const addUrl = $('nav-add-url') as HTMLInputElement | null;
    const addName = $('nav-add-name') as HTMLInputElement | null;
    const addStatus = $('nav-add-status');
    const addConfirmBtn = $('nav-add-confirm') as HTMLButtonElement | null;
    const url = (addUrl?.value ?? '').trim();
    if (!url) {
      if (addStatus) { addStatus.textContent = '请填写网址'; addStatus.classList.remove('hidden'); }
      return;
    }
    const name = (addName?.value ?? '').trim() || domainFromUrl(url);
    addingSite = true;
    if (addConfirmBtn) { addConfirmBtn.disabled = true; addConfirmBtn.textContent = '添加中…'; }
    addStatus?.classList.add('hidden');
    try {
      const res = await fetch('/api/nav/sites', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ categoryId: addCategoryId, name, url }),
      });
      const d = (await res.json().catch(() => ({}))) as { error?: string };
      if (!res.ok) {
        if (addStatus) { addStatus.textContent = d.error ?? '添加失败'; addStatus.classList.remove('hidden'); }
        return;
      }
      addDialog?.close();
      window.location.reload();
    } catch {
      if (addStatus) { addStatus.textContent = '添加失败'; addStatus.classList.remove('hidden'); }
    } finally {
      addingSite = false;
      if (addConfirmBtn) { addConfirmBtn.disabled = false; addConfirmBtn.textContent = '添加（自动扒图标简介）'; }
    }
  });

  // ---- 拖拽移动（卡片 → 分类）----
  let draggingSiteId: string | null = null;
  document.addEventListener('dragstart', (e) => {
    const card = (e.target as HTMLElement).closest<HTMLElement>('[data-site-id]');
    if (!card) return;
    draggingSiteId = card.dataset.siteId ?? null;
    e.dataTransfer?.setData('text/plain', draggingSiteId ?? '');
    e.dataTransfer!.effectAllowed = 'move';
  });
  document.addEventListener('dragover', (e) => {
    const dropCat = (e.target as HTMLElement).closest<HTMLElement>('[data-drop-cat]');
    if (!dropCat) return;
    e.preventDefault();
    dropCat.classList.add('bg-primary/10');
    dropCat.classList.add('text-primary');
  });
  document.addEventListener('dragleave', (e) => {
    const dropCat = (e.target as HTMLElement).closest<HTMLElement>('[data-drop-cat]');
    if (dropCat) {
      dropCat.classList.remove('bg-primary/10');
      dropCat.classList.remove('text-primary');
    }
  });
  document.addEventListener('drop', async (e) => {
    const dropCat = (e.target as HTMLElement).closest<HTMLElement>('[data-drop-cat]');
    dropCat?.classList.remove('bg-primary/10', 'text-primary');
    if (!dropCat || !draggingSiteId) return;
    e.preventDefault();
    const categoryId = dropCat.dataset.dropCat;
    if (!categoryId) return;
    const siteId = draggingSiteId;
    draggingSiteId = null;
    if (dropCat.dataset.catTab === siteId) return; // 拖到自身分类忽略
    const res = await fetch('/api/nav/sites', {
      method: 'PUT',
      headers: { 'content-type': 'application/json' },
      body: JSON.stringify({ id: siteId, categoryId }),
    });
    if (res.ok) window.location.reload();
  });

  // ---- 分类：添加 / 编辑 / 删除 / 拖拽排序 ----
  let editingCatId: string | null = null;

  function catStatus(el: HTMLElement | null, msg: string): void {
    if (el) { el.textContent = msg; el.classList.remove('hidden'); }
  }

  // 打开添加分类弹框
  document.addEventListener('click', (e) => {
    const add = (e.target as HTMLElement).closest<HTMLElement>('[data-cat-add]');
    if (!add) return;
    const catAddDialog = $('nav-cat-add-dialog') as HTMLDialogElement | null;
    const catAddName = $('nav-cat-add-name') as HTMLInputElement | null;
    const catAddIcon = $('nav-cat-add-icon') as HTMLInputElement | null;
    const catAddStatus = $('nav-cat-add-status');
    if (!catAddDialog) return;
    if (catAddName) catAddName.value = '';
    if (catAddIcon) catAddIcon.value = '';
    catAddStatus?.classList.add('hidden');
    catAddDialog.showModal();
    catAddName?.focus();
  });
  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    if (target.closest('#nav-cat-add-cancel')) ($('nav-cat-add-dialog') as HTMLDialogElement | null)?.close();
  });
  let addingCat = false;
  document.addEventListener('click', async (e) => {
    const target = e.target as HTMLElement;
    if (!target.closest('#nav-cat-add-confirm')) return;
    if (addingCat) return;
    const catAddDialog = $('nav-cat-add-dialog') as HTMLDialogElement | null;
    const catAddName = $('nav-cat-add-name') as HTMLInputElement | null;
    const catAddIcon = $('nav-cat-add-icon') as HTMLInputElement | null;
    const catAddStatus = $('nav-cat-add-status');
    const catAddConfirmBtn = $('nav-cat-add-confirm') as HTMLButtonElement | null;
    const name = (catAddName?.value ?? '').trim();
    if (!name) { catStatus(catAddStatus, '请填写分类名'); return; }
    const icon = (catAddIcon?.value ?? '').trim() || null;
    addingCat = true;
    if (catAddConfirmBtn) { catAddConfirmBtn.disabled = true; catAddConfirmBtn.textContent = '添加中…'; }
    catAddStatus?.classList.add('hidden');
    try {
      const res = await fetch('/api/nav/categories', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ name, icon }),
      });
      const d = (await res.json().catch(() => ({}))) as { error?: string };
      if (!res.ok) { catStatus(catAddStatus, d.error ?? '添加失败'); return; }
      catAddDialog?.close();
      window.location.reload();
    } catch {
      catStatus(catAddStatus, '添加失败');
    } finally {
      addingCat = false;
      if (catAddConfirmBtn) { catAddConfirmBtn.disabled = false; catAddConfirmBtn.textContent = '添加'; }
    }
  });

  // 打开编辑分类弹框
  document.addEventListener('click', (e) => {
    const edit = (e.target as HTMLElement).closest<HTMLElement>('[data-cat-edit]');
    if (!edit) return;
    const catId = edit.dataset.catEdit;
    const cat = NAV_DATA.find((c) => c.id === catId);
    const catEditDialog = $('nav-cat-edit-dialog') as HTMLDialogElement | null;
    const catEditName = $('nav-cat-edit-name') as HTMLInputElement | null;
    const catEditIcon = $('nav-cat-edit-icon') as HTMLInputElement | null;
    const catEditTarget = $('nav-cat-edit-target');
    const catEditStatus = $('nav-cat-edit-status');
    if (!cat || !catEditDialog) return;
    editingCatId = catId ?? null;
    if (catEditName) catEditName.value = cat.name;
    if (catEditIcon) catEditIcon.value = cat.icon ?? '';
    if (catEditTarget) catEditTarget.textContent = `分类「${cat.name}」 · ${cat.sites.length} 个网站`;
    catEditStatus?.classList.add('hidden');
    catEditDialog.showModal();
    catEditName?.focus();
  });
  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    if (target.closest('#nav-cat-edit-cancel')) ($('nav-cat-edit-dialog') as HTMLDialogElement | null)?.close();
  });
  document.addEventListener('click', async (e) => {
    const target = e.target as HTMLElement;
    if (!target.closest('#nav-cat-edit-confirm')) return;
    const catEditDialog = $('nav-cat-edit-dialog') as HTMLDialogElement | null;
    const catEditName = $('nav-cat-edit-name') as HTMLInputElement | null;
    const catEditIcon = $('nav-cat-edit-icon') as HTMLInputElement | null;
    const catEditStatus = $('nav-cat-edit-status');
    if (!editingCatId || !catEditDialog) return;
    const name = (catEditName?.value ?? '').trim();
    if (!name) { catStatus(catEditStatus, '分类名不能为空'); return; }
    const icon = (catEditIcon?.value ?? '').trim() || null;
    try {
      const res = await fetch('/api/nav/categories', {
        method: 'PUT',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ id: editingCatId, name, icon }),
      });
      const d = (await res.json().catch(() => ({}))) as { error?: string };
      if (!res.ok) { catStatus(catEditStatus, d.error ?? '保存失败'); return; }
      catEditDialog.close();
      window.location.reload();
    } catch {
      catStatus(catEditStatus, '保存失败');
    }
  });

  // 删除分类（级联删除其下网站）
  document.addEventListener('click', async (e) => {
    const del = (e.target as HTMLElement).closest<HTMLElement>('[data-cat-del]');
    if (!del) return;
    const catId = del.dataset.catDel;
    const cat = NAV_DATA.find((c) => c.id === catId);
    const catName = del.dataset.catName ?? cat?.name ?? '';
    const count = cat?.sites.length ?? 0;
    const msg = count > 0
      ? `删除分类「${catName}」？其下 ${count} 个网站也会一并删除。`
      : `删除分类「${catName}」？`;
    if (!(await confirmDanger(msg))) return;
    const res = await fetch('/api/nav/categories', {
      method: 'DELETE',
      headers: { 'content-type': 'application/json' },
      body: JSON.stringify({ id: catId }),
    });
    if (res.ok) window.location.reload();
  });

  // 拖拽排序（分类上下拖动）
  let draggingCatId: string | null = null;
  let catDropBefore = false;
  function clearCatDragUi(): void {
    document.querySelectorAll('.cat-drag-top, .cat-drag-bottom').forEach((el) => {
      el.classList.remove('cat-drag-top', 'cat-drag-bottom');
    });
  }
  document.addEventListener('dragstart', (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLElement>('[data-cat-id]');
    if (!btn) return;
    draggingCatId = btn.dataset.catId ?? null;
    e.dataTransfer?.setData('text/plain', draggingCatId ?? '');
    e.dataTransfer!.effectAllowed = 'move';
  });
  document.addEventListener('dragover', (e) => {
    if (!draggingCatId) return;
    const btn = (e.target as HTMLElement).closest<HTMLElement>('[data-cat-id]');
    if (!btn || btn.dataset.catId === draggingCatId) return;
    e.preventDefault();
    clearCatDragUi();
    const rect = btn.getBoundingClientRect();
    catDropBefore = e.clientY < rect.top + rect.height / 2;
    btn.classList.add(catDropBefore ? 'cat-drag-top' : 'cat-drag-bottom');
  });
  document.addEventListener('drop', async (e) => {
    if (!draggingCatId) return;
    e.preventDefault();
    const btn = (e.target as HTMLElement).closest<HTMLElement>('[data-cat-id]');
    clearCatDragUi();
    const catId = draggingCatId;
    draggingCatId = null;
    if (!btn) return;
    const targetId = btn.dataset.catId;
    if (!targetId || targetId === catId) return;
    const ids = Array.from(document.querySelectorAll<HTMLElement>('[data-cat-id]')).map((el) => el.dataset.catId ?? '');
    const from = ids.indexOf(catId);
    if (from < 0) return;
    ids.splice(from, 1);
    let to = ids.indexOf(targetId);
    if (to < 0) return;
    if (!catDropBefore) to += 1;
    ids.splice(to, 0, catId);
    const results = await Promise.all(
      ids.map((id, i) =>
        fetch('/api/nav/categories', {
          method: 'PUT',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ id, sort: i }),
        }),
      ),
    );
    if (results.every((r) => r.ok)) window.location.reload();
  });
  document.addEventListener('dragend', () => {
    draggingCatId = null;
    clearCatDragUi();
  });
  } // end if (IS_AUTHED)

  // 转场后重置：分类高亮 + 拖拽高亮状态
  document.addEventListener('astro:page-load', () => {
    activate('all');
    document.querySelectorAll('[data-drop-cat]').forEach((el) => el.classList.remove('bg-primary/10', 'text-primary'));
    document.querySelectorAll('.cat-drag-top, .cat-drag-bottom').forEach((el) => el.classList.remove('cat-drag-top', 'cat-drag-bottom'));
  });
</script>

<style>
  /* 分类拖拽排序：指示插入位置的上/下线条 */
  .cat-drag-top {
    box-shadow: inset 0 2px 0 0 var(--color-primary);
  }
  .cat-drag-bottom {
    box-shadow: inset 0 -2px 0 0 var(--color-primary);
  }
</style>
