---
/* ===== Imports ===== */
import BaseLayout from '@/layouts/BaseLayout.astro';
import { verifyRequest } from '@/lib/auth';
import { buildNodeTree, getBundle, listBundleNodes, listDocTree } from '@/lib/docs';
import { renderMdx } from '@/lib/mdx';
import { renderTocTreeHtml } from '@/lib/toc-tree';
import type { TocItem } from '@/lib/mdx-plugins';
import type { DocNodeView } from '../../../db/types';
import DocInlineEditor from '@/components/doc/DocInlineEditor';

/* ===== Logic ===== */
const { id } = Astro.params;
const isAuthed = verifyRequest(Astro.cookies);
const bundle = id ? await getBundle(id) : null;
if (!bundle) return Astro.redirect('/doc');

/** 全部节点（含正文，注入前端供即时切换） */
const nodes = await listBundleNodes(bundle.id);
const tree = buildNodeTree(nodes);
/** 文章节点（扁平，用于默认选中与前端切换） */
const articleNodes = nodes.filter((n) => n.kind === 'article');

/** 当前选中的文章（默认第一篇；URL hash 定位） */
const hashId = Astro.url.hash ? Astro.url.hash.slice(1) : '';
const activeNode =
  articleNodes.find((n) => n.id === hashId) ?? articleNodes[0] ?? null;

let html = '';
let toc: TocItem[] = [];
if (activeNode) {
  const r = await renderMdx(activeNode.content);
  html = r.html;
  toc = r.toc;
}
/** 树形目录 HTML（SSR 初始渲染；客户端切换文章时由同一模块重建） */
const tocTreeHtml = renderTocTreeHtml(toc);

// 面包屑：分类名（通过列表匹配，可选）
const allCategories = await listDocTree();
const catName = allCategories.find((c) => c.bundles.some((b) => b.id === bundle.id))?.name ?? '';

// 节点元数据注入：去掉 content(MDX 源码)——大文档首页 HTML 体积断崖下降。
// 节点编辑/移动时按需走 /api/doc/nodes/${id} 取单节点详情（已有 PATCH/GET 接口）。
// updatedAt 作为 /render 的版本号 v：编辑后它变化 → URL 变化 → CDN 旧缓存自动失效
const nodesJson = JSON.stringify(
  nodes.map((n) => ({ id: n.id, parentId: n.parentId, kind: n.kind, title: n.title, updatedAt: n.updatedAt })),
);
const bundleJson = JSON.stringify({ id: bundle.id, name: bundle.name, icon: bundle.icon, summary: bundle.summary });
const activeNodeId = activeNode?.id ?? '';
/** 目录节点（供"移动到"下拉选择） */
const folderOptions = nodes
  .filter((n) => n.kind === 'folder')
  .map((n) => ({ id: n.id, title: n.title }));

/** HTML 转义 */
function esc(s: string): string {
  return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;').replace(/'/g, '&#39;');
}

/** 管理员行内操作按钮组 */
function adminActions(n: DocNodeView, isAuthed: boolean): string {
  if (!isAuthed) return '';
  const add =
    n.kind === 'folder'
      ? `<button type="button" data-node-add-article="${n.id}" title="新增文章" aria-label="新增文章" class="text-[0.65rem] text-muted-foreground hover:text-primary">＋文</button>` +
        `<button type="button" data-node-add-folder="${n.id}" title="新增子目录" aria-label="新增子目录" class="text-[0.65rem] text-muted-foreground hover:text-primary">＋目</button>`
      : '';
  return (
    `<span class="ml-auto hidden shrink-0 items-center gap-1 group-hover:flex">` +
    add +
    `<button type="button" data-node-move="${n.id}" title="移动" aria-label="移动" class="text-[0.65rem] text-muted-foreground hover:text-primary">⇄</button>` +
    `<button type="button" data-node-edit="${n.id}" title="编辑" aria-label="编辑" class="text-[0.65rem] text-muted-foreground hover:text-primary">✎</button>` +
    `<button type="button" data-node-del="${n.id}" data-node-name="${esc(n.title)}" title="删除" aria-label="删除" class="text-[0.65rem] text-muted-foreground hover:text-destructive">×</button>` +
    `</span>`
  );
}

/** 递归渲染目录树（folder → details；article → 可切换链接） */
function renderTreeHtml(items: DocNodeView[], isAuthed: boolean): string {
  let out = '';
  for (const n of items) {
    if (n.kind === 'folder') {
      const children = renderTreeHtml(n.children, isAuthed);
      out +=
        `<details class="group doc-folder" open data-folder="${n.id}">` +
        `<summary class="flex cursor-pointer items-center gap-1.5 rounded-md px-2 py-1.5 text-sm text-muted-foreground transition-colors hover:bg-accent hover:text-foreground">` +
        `<span class="text-[0.7rem]">▸</span>` +
        `<span class="min-w-0 flex-1 truncate">${esc(n.title)}</span>` +
        adminActions(n, isAuthed) +
        `</summary>` +
        (children ? `<div class="ml-3 border-l border-border pl-2">${children}</div>` : '') +
        `</details>`;
    } else {
      out +=
        `<a href="#${n.id}" data-article-switch="${n.id}" class="group flex items-center gap-2 rounded-md px-2 py-1.5 text-sm transition-colors ` +
        (n.id === activeNode?.id ? 'bg-primary/10 text-primary' : 'text-muted-foreground hover:bg-accent hover:text-foreground') +
        `">` +
        `<span class="min-w-0 flex-1 truncate">${esc(n.title)}</span>` +
        adminActions(n, isAuthed) +
        `</a>`;
    }
  }
  return out;
}

const treeHtml = renderTreeHtml(tree, isAuthed);
const folderOptionsJson = JSON.stringify(folderOptions);
---

<BaseLayout title={`${bundle.name} · 文档`} description={bundle.summary ?? `${bundle.name} 文档`}>
  <section data-authed={isAuthed ? '1' : '0'}>
    {/* 面包屑 */}
    <div class="mx-auto w-full max-w-[1320px] px-4 pt-6 text-sm text-muted-foreground">
      <a href="/doc" class="transition-colors hover:text-primary">文档</a>
      {catName && <span class="mx-1">/</span>}
      {catName && <span>{esc(catName)}</span>}
      <span class="mx-1">/</span>
      <span class="text-foreground">{esc(bundle.name)}</span>
      {isAuthed && (
        <button id="doc-edit-bundle" type="button" title="编辑文档" aria-label="编辑文档" class="ml-2 text-xs text-muted-foreground transition-colors hover:text-primary">✎</button>
      )}
    </div>

    <div class="mx-auto w-full max-w-[1320px] px-4 py-6">
      {/* 两栏布局：左=目录树（可折叠 44px）/ 中=正文（锁 680px 阅读宽）。
          右侧「文章内目录」已脱离文档流：fixed 悬浮贴视口右缘 340px（见 #doc-toc-panel），
          宽屏（≥1320px）悬浮不遮正文；窄窗自动收起为贴右浮钮，点开为带遮罩的浮层。
          正文列可用宽度因此完整释放（572px → 680px），与目录互不挤占。 */}
      <div id="doc-3col" data-ltoc-collapsed="false" data-toc-collapsed="false" data-toc-auto="false" class="grid gap-6 lg:grid-cols-[var(--toc-lw,220px)_minmax(0,1fr)]">
        {/* 左栏：册内目录树（可折叠，与右栏对称交互） */}
        <aside id="doc-ltoc-aside" class="lg:sticky lg:top-20 lg:self-start">
          <div id="doc-ltoc-inner" class="lg:border-r lg:border-border lg:pr-4">
            <div class="flex items-center justify-between gap-2 pl-1 pr-10">
              <p data-ltoc-label class="font-pixel text-[0.7rem] uppercase tracking-[0.15em] text-muted-foreground">本册目录</p>
              {
                isAuthed && (
                  <span data-ltoc-label class="flex items-center gap-1">
                    <button id="doc-add-root-folder" type="button" title="新建目录" aria-label="新建目录" class="rounded-full border border-dashed border-border px-2 py-0.5 text-[0.65rem] text-muted-foreground transition-colors hover:border-primary/50 hover:text-primary">＋目录</button>
                    <button id="doc-add-root-article" type="button" title="新建文章" aria-label="新建文章" class="rounded-full border border-dashed border-border px-2 py-0.5 text-[0.65rem] text-muted-foreground transition-colors hover:border-primary/50 hover:text-primary">＋文章</button>
                  </span>
                )
              }
            </div>
            <div id="doc-ltoc-body" class="mt-3 lg:max-h-[calc(100vh-6rem)] lg:overflow-y-auto">
              <nav class="space-y-0.5 text-base" aria-label="本册目录">
                {treeHtml !== '' ? (
                  <div class="space-y-0.5" set:html={treeHtml} />
                ) : (
                  <p class="px-1 py-2 text-xs text-muted-foreground">暂无内容 —— 管理员可新建目录或文章。</p>
                )}
              </nav>
            </div>
          </div>
          <button
            id="doc-ltoc-toggle"
            type="button"
            title="收起 / 展开目录"
            aria-label="收起或展开目录"
            aria-controls="doc-ltoc-body"
            aria-expanded="true"
            class="hidden h-7 w-7 shrink-0 items-center justify-center rounded-md border border-border bg-background/80 text-muted-foreground backdrop-blur transition-colors hover:border-primary/50 hover:text-primary lg:inline-flex"
          >
            <svg data-ltoc-icon-collapse class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="15 18 9 12 15 6" /></svg>
            <svg data-ltoc-icon-expand class="hidden h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6" /></svg>
          </button>
        </aside>

        {/* 中栏：正文（占满 grid 第二列 ≈ 1044px；右侧目录为悬浮面板不占布局列，
            可用宽度完整给正文，行长宽松更舒展。过长行内/块级公式仍按 katex-display
            overflow-x:auto 横向滚动。⚠️ 勿加 justify-self-start：grid item 在非 stretch
            对齐下 auto 宽度退化为 shrink-to-fit（跟随内容最窄处），正文中段会缩到
            ~414px。默认 stretch + 无 max-width 即占满 1fr 列、贴列左缘。 */}
        <main class="min-w-0">
          {activeNode ? (
            <>
              <header>
                <div class="flex items-start gap-3">
                  <h1 class="font-display text-3xl font-semibold tracking-tight">{esc(activeNode.title)}</h1>
                  {
                    isAuthed && (
                      <button
                        id="doc-inline-edit"
                        type="button"
                        title="原地编辑本文"
                        aria-label="原地编辑本文"
                        class="mt-2 shrink-0 rounded-md border border-border px-2.5 py-1 text-xs text-muted-foreground transition-colors hover:border-primary/50 hover:text-primary"
                      >
                        编辑
                      </button>
                    )
                  }
                </div>
                <div class="pixel-divider mt-4" />
              </header>
              <article class="prose mt-6 max-w-none break-words" set:html={html} />
              {/* 正文原编辑岛：仅登录用户加载（client:idle 延后到空闲，不拖阅读首屏） */}
              {isAuthed && <DocInlineEditor client:idle />}
            </>
          ) : (
            <p class="mt-10 text-center text-sm text-muted-foreground">该文档暂无文章。</p>
          )}
        </main>

        {/* 右栏：文章内目录 —— 悬浮面板（fixed 贴视口右缘 340px），状态机见 <script> setupTocRail：
            ① ≥1320px：悬浮展开，不遮正文（正文右缘与面板间留白 ≥40px）
            ② <1320px：自动收起为贴右浮钮（#doc-toc-fab）；点开 → 浮层 + 遮罩（#doc-toc-overlay）
            ③ 用户手动收起（任意宽度）：同 ② 的浮钮形态 */}
      </div>

      {/* TOC 悬浮面板（置于 grid 外：fixed 定位不参与两栏布局） */}
      <aside id="doc-toc-aside" class="hidden lg:block">
        <div id="doc-toc-panel" class="fixed top-20 right-0 z-30 flex max-h-[calc(100vh-6rem)] w-[340px] flex-col border-l border-y border-border bg-card/95 shadow-lg backdrop-blur">
          {/* 标题行 */}
          <div class="flex shrink-0 items-center justify-between gap-2 border-b border-border/60 px-4 py-2.5">
            <p data-toc-label class="font-pixel text-[0.7rem] uppercase tracking-[0.15em] text-muted-foreground">目录 / TOC</p>
            <button
              id="doc-toc-toggle"
              type="button"
              title="收起目录"
              aria-label="收起目录"
              aria-controls="doc-toc-list"
              aria-expanded="true"
              class="inline-flex h-7 w-7 shrink-0 items-center justify-center rounded-md border border-border bg-background/80 text-muted-foreground backdrop-blur transition-colors hover:border-primary/50 hover:text-primary"
            >
              <svg data-toc-icon-collapse class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="15 18 9 12 15 6" /></svg>
              <svg data-toc-icon-expand class="hidden h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6" /></svg>
            </button>
          </div>
          {/* 目录滚动区：悬停滚动时仅滚自身（overscroll-behavior:contain 阻断联动正文） */}
          <div id="doc-toc-rail" class="min-h-0 flex-1 overflow-y-auto overscroll-contain px-4 py-3 [scrollbar-width:thin]">
            {toc.length > 0 ? (
              <div id="doc-toc-list" data-toc-label class="flex flex-col gap-1.5" set:html={tocTreeHtml} />
            ) : (
              <p data-toc-label class="mt-2 text-xs text-muted-foreground">无目录</p>
            )}
          </div>
        </div>

        {/* 收起后的贴右浮钮（替代旧「44px 窄列」形态） */}
        <button
          id="doc-toc-fab"
          type="button"
          title="展开目录"
          aria-label="展开目录"
          aria-controls="doc-toc-list"
          aria-expanded="false"
          class="fixed top-20 right-3 z-30 hidden h-9 w-9 items-center justify-center rounded-full border border-border bg-card/95 text-muted-foreground shadow-lg backdrop-blur transition-colors hover:border-primary/50 hover:text-primary"
        >
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6" /></svg>
        </button>
      </aside>

      {/* overlay 遮罩：窄窗浮层模式下点击空白处收起目录 */}
      <div id="doc-toc-overlay" class="fixed inset-0 z-20 hidden bg-black/30 backdrop-blur-[1px]" aria-hidden="true" />
    </div>
  </section>

  {/* 数据注入 */}
  <div id="doc-detail-data" data-authed={isAuthed ? '1' : '0'} data-nodes={nodesJson} data-bundle={bundleJson} data-active-node={activeNodeId} data-folders={folderOptionsJson} class="hidden" aria-hidden="true" />

  <!-- 节点编辑弹窗（目录 / 文章通用） -->
  <dialog id="doc-node-dialog" class="m-auto w-[min(92vw,52rem)] rounded-lg border border-border bg-card p-4 shadow-xl backdrop:bg-black/40">
    <h3 id="doc-node-dialog-title" class="font-medium">编辑节点</h3>
    <div class="mt-3 grid gap-2 sm:grid-cols-2">
      <label class="text-xs font-medium text-muted-foreground">
        标题
        <input id="doc-node-title" type="text" maxlength="200" class="mt-1 w-full rounded-md border border-input bg-background px-3 py-1.5 text-sm outline-none focus-visible:border-ring" />
      </label>
      <label class="text-xs font-medium text-muted-foreground">
        类型（创建时可选）
        <select id="doc-node-kind" class="mt-1 w-full rounded-md border border-input bg-background px-2 py-1.5 text-sm outline-none focus-visible:border-ring">
          <option value="article">文章</option>
          <option value="folder">目录（可嵌套子目录/文章）</option>
        </select>
      </label>
    </div>
    <label class="mt-2 block text-xs font-medium text-muted-foreground">
      所在目录
      <select id="doc-node-parent" class="mt-1 w-full rounded-md border border-input bg-background px-2 py-1.5 text-sm outline-none focus-visible:border-ring"></select>
    </label>
    <div id="doc-node-content-wrap" class="mt-2">
      <div class="flex items-center justify-between">
        <span class="text-xs font-medium text-muted-foreground">正文（Markdown / MDX）</span>
        <button id="doc-node-preview-btn" type="button" class="rounded-md border border-border px-3 py-1.5 text-xs text-muted-foreground transition-colors hover:border-primary/50 hover:text-primary">预览</button>
      </div>
      <div class="mt-1 grid gap-2 md:grid-cols-2">
        <textarea id="doc-node-content" spellcheck="false" placeholder="文章正文…" class="h-80 w-full resize-y rounded-md border border-input bg-background px-3 py-2 font-mono text-sm leading-relaxed outline-none focus-visible:border-ring"></textarea>
        <div id="doc-node-preview" class="prose h-80 overflow-y-auto rounded-md border border-border bg-background/50 px-3 py-2 text-sm"></div>
      </div>
    </div>
    <p id="doc-node-status" class="mt-2 hidden text-xs text-destructive" role="alert"></p>
    <div class="mt-3 flex items-center justify-end gap-2">
      <button id="doc-node-cancel" type="button" class="rounded-md px-2 py-1 text-xs text-muted-foreground hover:text-foreground">取消</button>
      <button id="doc-node-confirm" type="button" class="rounded-md bg-primary px-3 py-1 text-xs text-primary-foreground transition-opacity hover:opacity-90">保存</button>
    </div>
  </dialog>

  <!-- 文档编辑弹窗 -->
  <dialog id="doc-edit-bundle-dialog" class="m-auto w-80 rounded-lg border border-border bg-card p-4 shadow-xl backdrop:bg-black/40">
    <h3 class="font-medium">编辑文档</h3>
    <label class="mt-3 block text-xs font-medium text-muted-foreground">
      文档名
      <input id="doc-bundle-edit-name" type="text" maxlength="80" class="mt-1 w-full rounded-md border border-input bg-background px-3 py-1.5 text-sm outline-none focus-visible:border-ring" />
    </label>
    <label class="mt-2 block text-xs font-medium text-muted-foreground">
      图标（可选）
      <input id="doc-bundle-edit-icon" type="text" maxlength="20" class="mt-1 w-full rounded-md border border-input bg-background px-3 py-1.5 text-sm outline-none focus-visible:border-ring" />
    </label>
    <label class="mt-2 block text-xs font-medium text-muted-foreground">
      简介（可选）
      <input id="doc-bundle-edit-summary" type="text" maxlength="200" class="mt-1 w-full rounded-md border border-input bg-background px-3 py-1.5 text-sm outline-none focus-visible:border-ring" />
    </label>
    <p id="doc-bundle-edit-status" class="mt-2 hidden text-xs text-destructive" role="alert"></p>
    <div class="mt-3 flex items-center justify-end gap-2">
      <button id="doc-bundle-edit-cancel" type="button" class="rounded-md px-2 py-1 text-xs text-muted-foreground hover:text-foreground">取消</button>
      <button id="doc-bundle-edit-confirm" type="button" class="rounded-md bg-primary px-3 py-1 text-xs text-primary-foreground transition-opacity hover:opacity-90">保存</button>
    </div>
  </dialog>
</BaseLayout>

<style is:global>
  /* ===== /doc/[id] 布局：左目录树两栏 grid + 右 TOC 悬浮面板 ===== */
  /* 左栏宽度（可折叠为 44px 只留按钮条）；右 TOC 为 fixed 悬浮面板，不占布局列 */
  #doc-3col { --toc-lw: 220px; }
  /* 左栏折叠态：只留按钮条 */
  #doc-3col[data-ltoc-collapsed='true'] { --toc-lw: 44px; }

  /* —— TOC 悬浮面板三态（状态属性挂在 #doc-toc-aside 上，由 setupTocRail 维护） ——
     ① data-collapsed='false' + data-auto='false'（≥1320px）：悬浮展开，贴视口右缘不遮正文
     ② data-collapsed='true'：收起为贴右浮钮（fab）
     ③ data-collapsed='false' + data-auto='true'（<1320px 手动点开）：浮层 + 遮罩 */
  #doc-toc-aside[data-collapsed='true'] #doc-toc-panel { display: none; }
  #doc-toc-aside[data-collapsed='true'] #doc-toc-fab { display: inline-flex; }
  #doc-toc-aside[data-collapsed='false'][data-auto='true'] ~ #doc-toc-overlay { display: block; }
  /* 浮层模式下面板抬升层级（高于遮罩 z-20） */
  #doc-toc-aside[data-auto='true'][data-collapsed='false'] #doc-toc-panel { z-index: 40; }

  /* 左栏折叠动画：inner 向左滑出（纯合成器动画），列宽由 data-* 瞬切（单次 reflow）。
     旧实现把 opacity 过渡挂在 #doc-3col 上导致正文整段淡出 + 巨型合成层卡顿，已废弃。 */
  @media (min-width: 1024px) {
    #doc-ltoc-aside { overflow: hidden; }
    #doc-ltoc-inner { width: 220px; }
    #doc-ltoc-inner { transition: transform 0.2s ease; }
    #doc-3col[data-ltoc-collapsed='true'] #doc-ltoc-inner { transform: translateX(-100%); }
    #doc-ltoc-toggle { position: absolute; top: 0; right: 0.5rem; z-index: 10; }
  }
  /* 左栏折叠态按钮图标切换（折叠图隐藏，展开图显示） */
  #doc-3col[data-ltoc-collapsed='true'] [data-ltoc-icon-collapse] { display: none; }
  #doc-3col[data-ltoc-collapsed='true'] [data-ltoc-icon-expand] { display: inline-block; }
  #doc-3col[data-ltoc-collapsed='false'] [data-ltoc-icon-collapse] { display: inline-block; }
  #doc-3col[data-ltoc-collapsed='false'] [data-ltoc-icon-expand] { display: none; }

  /* ===== 树形目录：层级递归折叠 ===== */
  .toc-row { display: flex; align-items: flex-start; gap: 0.125rem; }
  .toc-fold {
    flex-shrink: 0;
    width: 1rem;
    height: 1.4rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--color-muted-foreground);
    cursor: pointer;
    border-radius: 0.25rem;
    transition: color 0.15s;
  }
  .toc-fold:hover { color: var(--color-primary); }
  .toc-fold .toc-chevron { width: 0.7rem; height: 0.7rem; transition: transform 0.15s ease; }
  .toc-node.folded > .toc-row .toc-chevron { transform: rotate(-90deg); }
  .toc-node.folded > .toc-children { display: none; }
  .toc-fold-spacer { flex-shrink: 0; width: 1rem; height: 1.4rem; }
  .toc-children {
    margin-left: 1.05rem;
    margin-top: 0.375rem;
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }
  .toc-item {
    display: block;
    font-size: 0.95rem;
    line-height: 1.35;
    color: var(--color-muted-foreground);
    transition: color 0.2s;
    min-width: 0;
  }
  .toc-item:hover { color: var(--color-primary); }
  .toc-l3 { font-size: 0.9rem; }
  .toc-l4 { font-size: 0.85rem; }

  /* ===== 目录内 KaTeX：缩小字号防撑行；display 公式收敛为块内展示 ===== */
  #doc-toc-list .katex { font-size: 0.85em; }
  #doc-toc-list .katex-display { margin: 0.2em 0; }
  #doc-toc-list .katex-display > .katex { display: inline-block; white-space: nowrap; }

  /* ===== 正文 KaTeX：解拥挤 =====
     vlist 防御（诊断实验）：.katex 内部行盒必须用 KaTeX 官方行高 1.2 ——
     覆盖成 1.6 会给每个绝对定位行盒叠加额外前导，分式/上下标嵌套时 bbox 相交
     数倍增（实测 lh1.6 → 1.2 使 mfrac 重叠显著下降）。段落级行距由
     p:has(.katex) 的 line-height: 2 独立兜底，两者互不影响。
     字体失败场景由 html.katex-font-fallback 的 MathML 兜底处理（global.css）。 */
  .prose .katex { font-size: 1.05em; line-height: 1.2; }
  /* 行内公式左右留白：0.05em → 0.18em，避免与相邻文字粘连 */
  .prose p .katex,
  .prose li .katex { padding: 0 0.18em; }
  /* 含公式的段落/列表项放宽行距：\frac / \int 等"高"公式不再顶到相邻行 */
  .prose p:has(.katex),
  .prose li:has(.katex) { line-height: 2; }
  /* 行间公式：上下留白更舒展，横向溢出时独立滚动而不是撑破栏宽 */
  .prose .katex-display {
    margin: 1.3em 0;
    overflow-x: auto;
    overflow-y: hidden;
    padding: 0.35em 0;
  }
  .prose .katex-display > .katex { display: inline-block; white-space: nowrap; }
  /* 窄屏下宽公式轻微降字号，换取横向空间（宁可小一点，也不要挤成滚动条） */
  @media (max-width: 767px) {
    .prose .katex-display > .katex { font-size: 0.94em; }
  }

  /* ===== 长文渲染优化：跳过首屏外区块的布局与绘制 =====
     实测：243KB 文章渲染出约 1.9 万个 DOM 标签，浏览器一次性 layout 是
     「切到大文章卡一下」的主因（服务端有 LRU 后仅 0.1ms，网络 gzip 后也很小）。
     content-visibility:auto 让视口外区块跳过 layout/paint，只算可见部分；
     contain-intrinsic-size 的 `auto` 前缀会记住真实高度，避免滚动条反复抖动。
     权衡：未渲染过的区块用估算高度，首次锚点/TOC 跳转可能有轻微偏移；
     打印时必须还原 visible，否则视口外内容不会进打印结果。 */
  main article.prose > * {
    content-visibility: auto;
    contain-intrinsic-size: auto 120px;
  }
  @media print {
    main article.prose > * { content-visibility: visible; }
  }

  /* ===== 就地编辑（Obsidian 式原位编辑） =====
     编辑器=ghost 变体：透明融入正文、无卡片无工具条；高度按正文高计算不跳变。
     host 承接原 <article> 的 mt-6，使编辑内容与阅读正文起点一致。 */
  .doc-ie-host { margin-top: 1.5rem; }
  .doc-ie-view {
    overflow: hidden;
    border-radius: var(--radius-md);
    /* 就地编辑态下编辑器处于可点选状态，滚动条细而低调 */
    scrollbar-width: thin;
  }
  .doc-ie-view .cm-editor { border-radius: var(--radius-md); }
  .doc-ie-view .cm-scroller { scrollbar-width: thin; }
  /* 正文原位替换时去除 CM 的焦点外框（阅读正文无框，编辑态亦应无框） */
  .doc-ie-view .cm-editor.cm-focused { outline: none; }
  /* ghost 编辑器首行/末尾对齐阅读正文间距 */
  .doc-ie-view .cm-content { padding-top: 0.375rem; }

  /* 标题旁入口按钮：编辑态 →「完成」高亮（primary 色） */
  #doc-inline-edit.doc-entry-active {
    border-color: var(--color-primary);
    color: var(--color-primary);
    background: color-mix(in srgb, var(--color-primary) 8%, transparent);
  }
</style>

<script>
  /** 文档详情页：目录树文章切换 + 节点 CRUD（目录/文章 增删改移动）+ 预览 */
  import { confirmDanger } from '@/lib/confirm';
  import { renderTocTreeHtml } from '@/lib/toc-tree';
  import type { TocItem } from '@/lib/mdx-plugins';

  const DATA = document.getElementById('doc-detail-data');
  const IS_AUTHED = DATA?.dataset.authed === '1';
  /** View Transitions（SPA 切换）下页面数据会随 DOM 更换，禁止模块级缓存 —— 每次按需读取最新 bundle/nodes/folders */
  function readBundle(): { id: string; name: string; icon: string | null; summary: string | null } {
    const d = document.getElementById('doc-detail-data');
    return JSON.parse(d?.dataset.bundle ?? '{}') as { id: string; name: string; icon: string | null; summary: string | null };
  }
  /** 注入的节点元信息（updatedAt 用作 /render 的缓存版本号 v） */
  interface NodeMeta {
    id: string;
    parentId: string | null;
    kind: 'folder' | 'article';
    title: string;
    updatedAt?: string;
  }
  function readNodes(): NodeMeta[] {
    const d = document.getElementById('doc-detail-data');
    return JSON.parse(d?.dataset.nodes ?? '[]') as NodeMeta[];
  }
  function readFolders(): Array<{ id: string; title: string }> {
    const d = document.getElementById('doc-detail-data');
    return JSON.parse(d?.dataset.folders ?? '[]') as Array<{ id: string; title: string }>;
  }

  function el<T extends Element = HTMLElement>(id: string): T | null {
    return document.getElementById(id) as T | null;
  }
  function escHtml(s: string): string {
    return String(s).replace(/[&<>"']/g, (c) => {
      const map: Record<string, string> = { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' };
      return map[c] ?? c;
    });
  }

  /* ================= 左栏文章即时切换 ================= */
  document.addEventListener('click', async (e) => {
    const t = e.target as HTMLElement;
    // 左栏管理按钮（编辑/删除/移动/新建）嵌在文章链接内：点击时不要顺带切换文章
    if (t.closest('[data-node-edit], [data-node-del], [data-node-move], [data-node-add-article], [data-node-add-folder]')) return;
    const link = t.closest<HTMLElement>('[data-article-switch]');
    if (!link) return;
    // 编辑中禁止切换文章：否则编辑器里的旧正文会被保存/渲染到新文章上（数据覆盖）
    if (document.getElementById('doc-3col')?.getAttribute('data-editing') === 'true') return;
    e.preventDefault();
    const id = link.dataset.articleSwitch;
    if (!id) return;
    setActiveArticle(id);
    if (id === currentActiveId()) {
      window.scrollTo({ top: 0, behavior: 'smooth' });
      return;
    }
    try {
      // 带版本号 v（= updatedAt）：命中 CDN 长缓存，大文章二次切换近乎瞬时；
      // 无 updatedAt（数据缺失）时退化为不带 v，仍可用，只是每次回源重渲。
      const meta = readNodes().find((n) => n.id === id);
      const v = meta?.updatedAt ? `?v=${encodeURIComponent(meta.updatedAt)}` : '';
      const res = await fetch(`/api/doc/nodes/${id}/render${v}`);
      const d = (await res.json().catch(() => ({}))) as { title?: string; html?: string; toc?: TocItem[]; error?: string };
      if (!res.ok || typeof d.html !== 'string') throw new Error(d.error ?? '加载失败');
      const h1 = document.querySelector('main h1');
      if (h1 && d.title) h1.textContent = d.title;
      const article = document.querySelector<HTMLElement>('main article.prose');
      if (article) article.innerHTML = d.html;
      // 重建树形目录（与 SSR 同一实现：层级折叠 + KaTeX 富文本）
      const tocWrap = document.getElementById('doc-toc-list');
      if (tocWrap && Array.isArray(d.toc)) {
        tocWrap.innerHTML = d.toc.length ? renderTocTreeHtml(d.toc) : '<p class="text-xs text-muted-foreground">无目录</p>';
      }
      document.getElementById('doc-detail-data')?.setAttribute('data-active-node', id);
      history.replaceState(null, '', `#${id}`);
      window.scrollTo({ top: 0, behavior: 'smooth' });
    } catch {
      window.location.href = `/doc/${readBundle().id}#${id}`;
    }
  });

  function setActiveArticle(id: string): void {
    document.querySelectorAll<HTMLElement>('[data-article-switch]').forEach((a) => {
      const active = a.dataset.articleSwitch === id;
      a.classList.toggle('bg-primary/10', active);
      a.classList.toggle('text-primary', active);
      a.classList.toggle('text-muted-foreground', !active);
    });
  }
  function currentActiveId(): string {
    return document.getElementById('doc-detail-data')?.getAttribute('data-active-node') ?? '';
  }
  document.addEventListener('astro:page-load', () => setActiveArticle(currentActiveId()));
  setActiveArticle(currentActiveId());

  /* ================= 正文就地编辑（无跳转；滚动保持由岛内部完成） =================
     标题旁「编辑/完成」按钮：未编辑 → 打开就地编辑；编辑态再点 = 保存并退出。
     岛用 client:idle，首屏可能尚未水合：轮询等待最多 ~2s，避免点击无响应。 */
  document.addEventListener('click', (e) => {
    if (!(e.target as HTMLElement).closest('#doc-inline-edit')) return;
    const grid = document.getElementById('doc-3col');
    const editing = grid?.dataset.editing === 'true';
    let tries = 0;
    const tryBridge = (): void => {
      const bridge = (window as unknown as { __docInlineEditor?: { open: () => void; saveAndClose?: () => void } }).__docInlineEditor;
      if (!bridge) {
        if (tries++ < 20) window.setTimeout(tryBridge, 100);
        return;
      }
      if (editing && bridge.saveAndClose) bridge.saveAndClose();
      else bridge.open();
    };
    tryBridge();
  });

  /* ================= 树形目录：层级折叠/展开（事件委托，动态重建安全） ================= */
  // 点击折叠箭头 → 折叠/展开该节点全部子孙；点击目录链接仍正常锚点跳转
  document.addEventListener('click', (e) => {
    const fold = (e.target as HTMLElement).closest<HTMLElement>('.toc-fold');
    if (!fold) return;
    const node = fold.closest<HTMLElement>('.toc-node');
    if (!node) return;
    const folded = node.classList.toggle('folded');
    fold.setAttribute('aria-expanded', String(!folded));
    fold.setAttribute('aria-label', folded ? '展开子目录' : '折叠子目录');
  });

  /* ================= 左栏目录树：整栏可折叠/展开（transform 滑入滑出，纯合成器动画） ================= */
  // 状态：默认展开；收起后该栏仅留按钮，正文自动变宽。
  // 关键性能点：不动画 grid-template-columns（布局属性，每帧触发全文档重排卡顿），
  // 列宽由 data-* 属性一次性切换（单次 reflow）；目录内容用 transform 滑入滑出（合成器，零重排零重绘），
  // 正文永不参与动画（不再淡出消失、不再产生巨型合成层）。
  const grd = el<HTMLDivElement>('doc-3col');
  const lTocToggle = el<HTMLButtonElement>('doc-ltoc-toggle');
  if (grd && lTocToggle) {
    const attr = 'ltocCollapsed' as const;
    const key = 'doc-ltoc-collapsed';
    const apply = (collapsed: boolean): void => {
      grd.dataset[attr] = collapsed ? 'true' : 'false';
      lTocToggle.setAttribute('aria-expanded', String(!collapsed));
      lTocToggle.setAttribute('aria-label', collapsed ? '展开目录' : '收起目录');
      lTocToggle.title = collapsed ? '展开目录' : '收起目录';
    };
    let initial = false;
    try {
      initial = window.localStorage.getItem(key) === '1';
    } catch { /* 忽略隐私模式等异常 */ }
    apply(initial);
    lTocToggle.addEventListener('click', () => {
      const next = grd.dataset[attr] !== 'true';
      apply(next); // 列宽瞬切 + inner transform 过渡自动滑入/滑出
      try {
        window.localStorage.setItem(key, next ? '1' : '0');
      } catch { /* 忽略 */ }
    });
  }

  /* ================= 右栏文章内目录：悬浮面板三态 =================
     ① ≥1320px：悬浮展开（fixed 贴视口右缘，正文右缘与面板留白 ≥40px，互不遮盖）
     ② <1320px：自动收起为贴右浮钮（fab）；点开 → 浮层 + 遮罩，点遮罩收起
     ③ 用户手动收起（任意宽度）：同 ② 浮钮形态
     正文列与面板永不相交：面板不占布局列，正文可用宽度完整释放。 */
  const tocAside = el<HTMLElement>('doc-toc-aside');
  const tocPanel = el<HTMLElement>('doc-toc-panel');
  const tocToggle = el<HTMLButtonElement>('doc-toc-toggle');
  const tocFab = el<HTMLButtonElement>('doc-toc-fab');
  const tocOverlay = el<HTMLElement>('doc-toc-overlay');
  if (tocAside && tocToggle && tocFab) {
    const TOC_KEY = 'doc-toc-collapsed';
    /** 宽屏阈值：≥ 该宽度悬浮展开不遮正文（正文右缘 940px + 面板 340px + 40px 间隙） */
    const TOC_AUTO_THRESHOLD = 1320;

    const applyToc = (collapsed: boolean, persist: boolean): void => {
      tocAside.dataset.collapsed = collapsed ? 'true' : 'false';
      tocToggle.setAttribute('aria-expanded', String(!collapsed));
      tocToggle.title = collapsed ? '展开目录' : '收起目录';
      tocFab.setAttribute('aria-expanded', String(!collapsed));
      if (persist) {
        try {
          window.localStorage.setItem(TOC_KEY, collapsed ? '1' : '0');
        } catch { /* 忽略 */ }
      }
    };

    const readStoredCollapsed = (): boolean => {
      try {
        return window.localStorage.getItem(TOC_KEY) === '1';
      } catch {
        return false;
      }
    };

    /** 视口跨阈值时重算 auto 态；窄窗强制收起（不覆盖用户宽屏偏好） */
    const applyTocAuto = (): void => {
      const auto = window.innerWidth < TOC_AUTO_THRESHOLD;
      tocAside.dataset.auto = auto ? 'true' : 'false';
      if (auto) applyToc(true, false);
      else applyToc(readStoredCollapsed(), false);
    };
    applyTocAuto();

    // 面板头部「收起」按钮：宽屏写入用户偏好，窄窗仅临时收起
    tocToggle.addEventListener('click', () => {
      applyToc(true, tocAside.dataset.auto !== 'true');
    });
    // 浮钮「展开」：窄窗进入浮层模式，宽屏恢复悬浮展开
    tocFab.addEventListener('click', () => applyToc(false, tocAside.dataset.auto !== 'true'));
    // 遮罩点击：收起浮层
    tocOverlay?.addEventListener('click', () => applyToc(true, false));
    // 视口尺寸变化：跨阈值重算（防抖 120ms）
    let tocResizeTimer = 0;
    window.addEventListener('resize', () => {
      window.clearTimeout(tocResizeTimer);
      tocResizeTimer = window.setTimeout(applyTocAuto, 120);
    });
  }

  /* ================= 节点 CRUD（登录） ================= */
  if (IS_AUTHED) {
    /** 打开节点弹窗：mode=create|edit；parentId 为创建时的所在目录 */
    function openNodeDialog(opts: {
      mode: 'create' | 'edit';
      kind?: 'folder' | 'article';
      parentId?: string | null;
      nodeId?: string | null;
    }): void {
      const dlg = el<HTMLDialogElement>('doc-node-dialog');
      if (!dlg) return;
      const titleInput = el<HTMLInputElement>('doc-node-title');
      const kindSelect = el<HTMLSelectElement>('doc-node-kind');
      const parentSelect = el<HTMLSelectElement>('doc-node-parent');
      const contentArea = el<HTMLTextAreaElement>('doc-node-content');
      const previewBox = el('doc-node-preview');
      const status = el('doc-node-status');
      const contentWrap = el('doc-node-content-wrap');
      if (!titleInput || !kindSelect || !parentSelect) return;

      // 所在目录选项：根目录 + 所有目录
      parentSelect.innerHTML = '<option value="">册根级</option>' + readFolders().map((f) => `<option value="${f.id}">${escHtml(f.title)}</option>`).join('');

      status?.classList.add('hidden');
      if (previewBox) previewBox.innerHTML = '';
      if (opts.mode === 'edit' && opts.nodeId) {
        const meta = readNodes().find((n) => n.id === opts.nodeId);
        if (!meta) return;
        el<HTMLHeadingElement>('doc-node-dialog-title')!.textContent = meta.kind === 'folder' ? '编辑目录' : '编辑文章';
        titleInput.value = meta.title;
        kindSelect.value = meta.kind;
        kindSelect.disabled = true; // 类型不可改
        parentSelect.value = meta.parentId ?? '';
        // content 字段单独 fetch：首屏已不再注入 MDX 源码（B1），编辑时按需取单节点
        if (contentArea) contentArea.value = '';
        if (contentWrap) contentWrap.classList.toggle('hidden', meta.kind === 'folder');
        dlg.dataset.editing = meta.id;
      } else {
        el<HTMLHeadingElement>('doc-node-dialog-title')!.textContent = opts.kind === 'folder' ? '新建目录' : '新建文章';
        titleInput.value = '';
        kindSelect.value = opts.kind ?? 'article';
        kindSelect.disabled = false;
        parentSelect.value = opts.parentId ?? '';
        if (contentArea) contentArea.value = '';
        if (contentWrap) contentWrap.classList.toggle('hidden', (opts.kind ?? 'article') === 'folder');
        delete dlg.dataset.editing;
      }
      dlg.showModal();
      titleInput.focus();
      // 编辑文章时异步拉取 content 填充 textarea（弹窗立刻显示，content 字段 ~200ms 后到位）
      if (opts.mode === 'edit' && opts.nodeId && contentArea && contentWrap && !contentWrap.classList.contains('hidden')) {
        const nodeId = opts.nodeId;
        fetch(`/api/doc/nodes/${nodeId}`)
          .then((r) => (r.ok ? r.json() : null))
          .then((d) => {
            const c = d?.node?.content;
            if (typeof c === 'string') contentArea.value = c;
          })
          .catch(() => { /* 网络失败时 textarea 保持空，用户感知 */ });
      }
    }

    // 打开弹窗：根级新建 / 目录内新建 / 编辑 / 移动
    document.addEventListener('click', (e) => {
      const t = e.target as HTMLElement;
      if (t.closest('#doc-add-root-folder')) return void openNodeDialog({ mode: 'create', kind: 'folder', parentId: null });
      if (t.closest('#doc-add-root-article')) return void openNodeDialog({ mode: 'create', kind: 'article', parentId: null });
      const addArt = t.closest<HTMLElement>('[data-node-add-article]');
      if (addArt) return void openNodeDialog({ mode: 'create', kind: 'article', parentId: addArt.dataset.nodeAddArticle ?? null });
      const addFolder = t.closest<HTMLElement>('[data-node-add-folder]');
      if (addFolder) return void openNodeDialog({ mode: 'create', kind: 'folder', parentId: addFolder.dataset.nodeAddFolder ?? null });
      const edit = t.closest<HTMLElement>('[data-node-edit]');
      if (edit) return void openNodeDialog({ mode: 'edit', nodeId: edit.dataset.nodeEdit ?? null });
      const move = t.closest<HTMLElement>('[data-node-move]');
      if (move) return void openNodeDialog({ mode: 'edit', nodeId: move.dataset.nodeMove ?? null });
      if (t.closest('#doc-node-cancel')) el<HTMLDialogElement>('doc-node-dialog')?.close();
    });

    // 类型切换：目录无正文
    el<HTMLSelectElement>('doc-node-kind')?.addEventListener('change', () => {
      const wrap = el('doc-node-content-wrap');
      if (wrap) wrap.classList.toggle('hidden', el<HTMLSelectElement>('doc-node-kind')?.value === 'folder');
    });

    // 预览：防并发/重复触发（AbortController + 序号守卫），按钮禁用避免双击
    let previewSeq = 0;
    let previewCtrl: AbortController | null = null;
    document.addEventListener('click', async (e) => {
      if (!(e.target as HTMLElement).closest('#doc-node-preview-btn')) return;
      const source = el<HTMLTextAreaElement>('doc-node-content')?.value ?? '';
      const preview = el('doc-node-preview');
      const btn = el<HTMLButtonElement>('doc-node-preview-btn');
      if (!preview) return;
      // 取消上一次未完成请求
      previewCtrl?.abort();
      const ctrl = new AbortController();
      previewCtrl = ctrl;
      const seq = ++previewSeq;
      if (btn) btn.disabled = true;
      preview.innerHTML = '<p class="text-xs text-muted-foreground">渲染中…</p>';
      try {
        const res = await fetch('/api/doc/preview', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ source }),
          signal: ctrl.signal,
        });
        const d = (await res.json().catch(() => ({}))) as { html?: string; error?: string };
        if (seq !== previewSeq) return; // 已被新请求覆盖
        preview.innerHTML = d.html ?? `<p class="text-destructive">${d.error ?? '渲染失败'}</p>`;
      } catch (err) {
        if (ctrl.signal.aborted) return; // 主动取消
        preview.innerHTML = '<p class="text-destructive">渲染失败</p>';
      } finally {
        if (btn && seq === previewSeq) btn.disabled = false;
      }
    });

    // 保存（创建 / 编辑 / 移动）
    document.addEventListener('click', async (e) => {
      if (!(e.target as HTMLElement).closest('#doc-node-confirm')) return;
      const dlg = el<HTMLDialogElement>('doc-node-dialog');
      const title = (el<HTMLInputElement>('doc-node-title')?.value ?? '').trim();
      const kind = el<HTMLSelectElement>('doc-node-kind')?.value === 'folder' ? 'folder' : 'article';
      const parentId = el<HTMLSelectElement>('doc-node-parent')?.value ?? '';
      const content = el<HTMLTextAreaElement>('doc-node-content')?.value ?? '';
      const status = el('doc-node-status');
      const editingId = dlg?.dataset.editing ?? null;
      if (!title) {
        if (status) { status.textContent = '请填写标题'; status.classList.remove('hidden'); }
        return;
      }
      if (kind === 'article' && !content.trim()) {
        if (status) { status.textContent = '文章正文不能为空'; status.classList.remove('hidden'); }
        return;
      }
      try {
        if (editingId) {
          const res = await fetch(`/api/doc/nodes/${editingId}`, {
            method: 'PATCH',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify({ title, content, parentId: parentId || null }),
          });
          if (!res.ok) throw new Error('保存失败');
        } else {
          const res = await fetch('/api/doc/nodes', {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify({ bundleId: readBundle().id, parentId: parentId || null, kind, title, content }),
          });
          if (!res.ok) throw new Error('创建失败');
        }
        window.location.reload();
      } catch (err) {
        if (status) { status.textContent = err instanceof Error ? err.message : '操作失败'; status.classList.remove('hidden'); }
      }
    });

    // 删除
    document.addEventListener('click', async (e) => {
      const del = (e.target as HTMLElement).closest<HTMLElement>('[data-node-del]');
      if (!del) return;
      const name = del.dataset.nodeName ?? '';
      if (!(await confirmDanger(`确定删除「${name}」？其下所有子目录与文章将一并删除。`))) return;
      await fetch(`/api/doc/nodes/${del.dataset.nodeDel}`, { method: 'DELETE' });
      window.location.reload();
    });

    // 文档编辑（沿用旧接口）
    document.addEventListener('click', (e) => {
      // 关键守卫：只有点击 ✎（#doc-edit-bundle）才打开，避免盖住节点弹窗
      if (!(e.target as HTMLElement).closest('#doc-edit-bundle')) return;
      const dlg = el<HTMLDialogElement>('doc-edit-bundle-dialog');
      if (!dlg) return;
      if (el<HTMLInputElement>('doc-bundle-edit-name')) el<HTMLInputElement>('doc-bundle-edit-name')!.value = readBundle().name;
      if (el<HTMLInputElement>('doc-bundle-edit-icon')) el<HTMLInputElement>('doc-bundle-edit-icon')!.value = readBundle().icon ?? '';
      if (el<HTMLInputElement>('doc-bundle-edit-summary')) el<HTMLInputElement>('doc-bundle-edit-summary')!.value = readBundle().summary ?? '';
      el('doc-bundle-edit-status')?.classList.add('hidden');
      dlg.showModal();
    });
    // 取消
    document.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('#doc-bundle-edit-cancel')) {
        el<HTMLDialogElement>('doc-edit-bundle-dialog')?.close();
      }
    });
    // 保存
    document.addEventListener('click', async (e) => {
      if (!(e.target as HTMLElement).closest('#doc-bundle-edit-confirm')) return;
      const name = (el<HTMLInputElement>('doc-bundle-edit-name')?.value ?? '').trim();
      const icon = el<HTMLInputElement>('doc-bundle-edit-icon')?.value ?? '';
      const summary = el<HTMLInputElement>('doc-bundle-edit-summary')?.value ?? '';
      const status = el('doc-bundle-edit-status');
      if (!name) {
        if (status) { status.textContent = '请填写文档名'; status.classList.remove('hidden'); }
        return;
      }
      try {
        const res = await fetch(`/api/doc/bundles`, {
          method: 'PATCH',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ id: readBundle().id, name, icon, summary }),
        });
        if (!res.ok) throw new Error('保存失败');
        window.location.reload();
      } catch (err) {
        if (status) { status.textContent = err instanceof Error ? err.message : '保存失败'; status.classList.remove('hidden'); }
      }
    });
  }
</script>
