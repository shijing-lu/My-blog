---
/* ===== Imports ===== */
import BaseLayout from '@/layouts/BaseLayout.astro';
import { canManage } from '@/lib/admin-auth';
import { getBundle, getCategoryName, listBundleNodes } from '@/lib/docs';
import { esc } from '@/lib/html-escape';
import { buildDocTree, docFolderOptions, renderDocTree, type DocTreeItem } from '@/lib/doc-tree-render';
import { renderMdx } from '@/lib/mdx';
import { getImageSizes, collectImageIdsFromHtml, injectImageSizeAttrs } from '@/lib/images';
import { renderTocTreeHtml } from '@/lib/toc-tree';
import type { TocItem } from '@/lib/mdx-plugins';
import DocInlineEditor from '@/components/doc/DocInlineEditor';
import ExportMenu from '@/components/ExportMenu.astro';

/* ===== Logic ===== */
const { id } = Astro.params;
const isAuthed = await canManage(Astro.cookies, 'docs');
const bundle = id ? await getBundle(id) : null;
if (!bundle) return Astro.redirect('/doc');

/** 全部节点（含正文，注入前端供即时切换） */
const nodes = await listBundleNodes(bundle.id);
/** 扁平节点（同构形状）：目录树与「移动到」下拉共用同一份数据 */
const nodeItems: DocTreeItem[] = nodes.map((n) => ({
  id: n.id,
  parentId: n.parentId,
  kind: n.kind as 'folder' | 'article',
  title: n.title,
  sort: n.sort,
  createdAt: n.createdAt,
  updatedAt: n.updatedAt,
}));
/** 嵌套树：与客户端共用 buildDocTree（同构模块，见 lib/doc-tree-render.ts） */
const tree = buildDocTree(nodeItems);
/** 文章节点（扁平，用于默认选中与前端切换） */
const articleNodes = nodes.filter((n) => n.kind === 'article');

/** 当前选中的文章：?article=<nodeId>（URL 直达/刷新/前进后退均可保持）；缺省第一篇。
 *  ⚠️ 不能用 URL hash 定位当前文章——fragment 不会随 HTTP 请求发送，服务端
 *  Astro.url.hash 恒为空串，刷新会被 SSR 重置为第一篇。旧 hash 链接由前端
 *  migrateLegacyHash 一次性迁移为 ?article= 形态。 */
const requestedArticle = Astro.url.searchParams.get('article')?.trim() ?? '';
const activeNode =
  articleNodes.find((n) => n.id === requestedArticle) ?? articleNodes[0] ?? null;

/**
 * 大文档 SSR 延迟渲染阈值（正文 Markdown 字符数）。
 *
 * ## 为什么需要（2026-09-16 实测定位「进入文档界面多次无响应」）
 * 用户库中数学类长文（182KB markdown）经 KaTeX 渲染后膨胀到 **9.5MB HTML / 26.2 万 DOM 节点**，
 * `renderMdx` 单次耗时 **24.6 秒**（node 单线程全程占满）。若 SSR 同步渲染它：
 * ① 页面白屏等 20+ 秒；② 服务端被占满期间，同一页面的目录/图片/接口请求全部排队
 * → 用户感知为"一连串无响应"。
 * 超过阈值时 SSR 只输出界面骨架（标题/左栏/布局秒开），正文改由客户端拉取——
 * 复用页内切换的统一加载流程（顶部进度条 + 客户端缓存 + 请求取消 + 失败提示）。
 * 阈值取 96KB：实测 43KB 文档冷渲染 ~2s 可接受，182KB 级必须延迟。
 */
const DEFER_RENDER_THRESHOLD = 96 * 1024;
const deferRender = Boolean(activeNode && (activeNode.content?.length ?? 0) > DEFER_RENDER_THRESHOLD);

let html = '';
let toc: TocItem[] = [];
if (activeNode && !deferRender) {
  const r = await renderMdx(activeNode.content);
  let out = r.html;
  // 正文图片注入原始宽高（DB 图片），消除懒加载宽度跳变
  const ids = collectImageIdsFromHtml(out);
  if (ids.length > 0) {
    const sizes = await getImageSizes(ids);
    if (sizes.size > 0) out = injectImageSizeAttrs(out, sizes);
  }
  html = out;
  toc = r.toc;
} else if (activeNode) {
  // 延迟渲染：占位文案会被客户端拉取到的正文整体替换（见页内切换 handler 的延迟加载分支）
  html = '<p class="text-sm text-muted-foreground">正在加载长文档…</p>';
}
/** 树形目录 HTML（SSR 初始渲染；客户端切换文章时由同一模块重建） */
const tocTreeHtml = renderTocTreeHtml(toc);

// 面包屑：分类名。bundle 已带回 categoryId，直接单条查询即可（O(1)）。
// 旧实现调 listDocTree() 无 where 全表扫 4 张表，只为拿一个名字——属 P0-1 浪费点。
const catName = await getCategoryName(bundle.categoryId);

// 节点元数据注入：去掉 content(MDX 源码)——大文档首页 HTML 体积断崖下降。
// 节点编辑/移动时按需走 /api/doc/nodes/${id} 取单节点详情（已有 PATCH/GET 接口）。
// updatedAt 作为 /render 的版本号 v：编辑后它变化 → URL 变化 → CDN 旧缓存自动失效
// 客户端就地增删改后要重建目录树，故需下发完整节点表（含 createdAt：同级排序依据）
const nodesJson = JSON.stringify(nodeItems);
const bundleJson = JSON.stringify({ id: bundle.id, name: bundle.name, icon: bundle.icon, summary: bundle.summary });
const activeNodeId = activeNode?.id ?? '';
/** 目录节点（供"移动到"下拉选择）—— 与客户端共用 docFolderOptions */
const folderOptions = docFolderOptions(nodeItems);

/** 目录树 HTML（SSR 初始渲染；客户端增删改后就地重绘同一容器，走同一函数） */
const treeHtml = renderDocTree(tree, { authed: isAuthed, bundleId: bundle.id, activeId: activeNodeId });
const folderOptionsJson = JSON.stringify(folderOptions);
---

<BaseLayout title={`${bundle.name} · 文档`} description={bundle.summary ?? `${bundle.name} 文档`}>
  <section data-authed={isAuthed ? '1' : '0'}>
    {/* 面包屑 */}
    <div class="mx-auto w-full max-w-[1320px] px-4 pt-6 text-sm text-muted-foreground">
      <a href="/doc" class="transition-colors hover:text-primary">文档</a>
      {catName && <span class="mx-1">/</span>}
      {catName && <span>{esc(catName)}</span>}
      <span class="mx-1">/</span>
      <span id="doc-bundle-name" class="text-foreground">{esc(bundle.name)}</span>
      {isAuthed && (
        <button id="doc-edit-bundle" type="button" title="编辑文档" aria-label="编辑文档" class="icon-btn-tap ml-2 text-xs text-muted-foreground transition-colors hover:text-primary">✎</button>
      )}
    </div>

    <div class="mx-auto w-full max-w-[1320px] px-4 py-6">
      {/* 两栏布局：左=目录树（可折叠 44px）/ 中=正文（锁 680px 阅读宽）。
          右侧「文章内目录」已脱离文档流：fixed 悬浮贴视口右缘 340px（见 #doc-toc-panel），
          宽屏（≥1320px）悬浮不遮正文；窄窗自动收起为贴右浮钮，点开为带遮罩的浮层。
          正文列可用宽度因此完整释放（572px → 680px），与目录互不挤占。 */}
      <div id="doc-3col" data-ltoc-collapsed="false" data-toc-collapsed="false" data-toc-auto="false" class="grid gap-6 lg:grid-cols-[var(--toc-lw,220px)_minmax(0,1fr)]">
        {/* 左栏：册内目录树（可折叠，与右栏对称交互） */}
        <aside id="doc-ltoc-aside" class="lg:sticky lg:top-20 lg:self-start">
          <div id="doc-ltoc-inner" class="lg:border-r lg:border-border lg:pr-4">
            <div class="flex items-center justify-between gap-2 pl-1 pr-10">
              <p data-ltoc-label class="font-pixel text-[0.7rem] uppercase tracking-[0.15em] text-muted-foreground">本册目录</p>
              {
                isAuthed && (
                  <span data-ltoc-label class="flex items-center gap-1">
                    <button id="doc-add-root-folder" type="button" title="新建目录" aria-label="新建目录" class="rounded-full border border-dashed border-border px-2 py-0.5 text-[0.65rem] text-muted-foreground transition-colors hover:border-primary/50 hover:text-primary">＋目录</button>
                    <button id="doc-add-root-article" type="button" title="新建文章" aria-label="新建文章" class="rounded-full border border-dashed border-border px-2 py-0.5 text-[0.65rem] text-muted-foreground transition-colors hover:border-primary/50 hover:text-primary">＋文章</button>
                  </span>
                )
              }
            </div>
            <div id="doc-ltoc-body" class="mt-3 lg:max-h-[calc(100vh-6rem)] lg:overflow-y-auto">
              <nav class="space-y-0.5 text-base" aria-label="本册目录">
                {/* 容器恒存在（空态由 renderDocTree 输出）：客户端就地增删改后整体重绘此处 */}
                <div class="space-y-0.5" data-doc-tree-root set:html={treeHtml} />
              </nav>
            </div>
          </div>
          <button
            id="doc-ltoc-toggle"
            type="button"
            title="收起 / 展开目录"
            aria-label="收起或展开目录"
            aria-controls="doc-ltoc-body"
            aria-expanded="true"
            class="hidden h-7 w-7 shrink-0 items-center justify-center rounded-md border border-border bg-background/80 text-muted-foreground backdrop-blur transition-colors hover:border-primary/50 hover:text-primary lg:inline-flex"
          >
            <svg data-ltoc-icon-collapse class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="15 18 9 12 15 6" /></svg>
            <svg data-ltoc-icon-expand class="hidden h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6" /></svg>
          </button>
        </aside>

        {/* 中栏：正文（占满 grid 第二列 ≈ 1044px；右侧目录为悬浮面板不占布局列，
            可用宽度完整给正文，行长宽松更舒展。过长行内/块级公式仍按 katex-display
            overflow-x:auto 横向滚动。⚠️ 勿加 justify-self-start：grid item 在非 stretch
            对齐下 auto 宽度退化为 shrink-to-fit（跟随内容最窄处），正文中段会缩到
            ~414px。默认 stretch + 无 max-width 即占满 1fr 列、贴列左缘。 */}
        <main class="min-w-0">
          {activeNode ? (
            <>
              <header>
                <div class="flex items-start gap-3">
                  <h1 class="font-display text-3xl font-semibold tracking-tight">{esc(activeNode.title)}</h1>
                  {
                    isAuthed && (
                      <button
                        id="doc-inline-edit"
                        type="button"
                        title="原地编辑本文"
                        aria-label="原地编辑本文"
                        class="mt-2 shrink-0 rounded-md border border-border px-2.5 py-1 text-xs text-muted-foreground transition-colors hover:border-primary/50 hover:text-primary"
                      >
                        编辑
                      </button>
                    )
                  }
                  {/* 导出入口：MD 端点在点击时按当前 ?article= 节点 id 拼接（页内切换后仍正确） */}
                  <ExportMenu mdBase="/api/export/doc/" mdParam="article" class="mt-1.5" />
                </div>
                <div class="pixel-divider mt-4" />
              </header>
              <article
                class="prose mt-6 max-w-none break-words"
                data-defer-article={deferRender && activeNode ? activeNode.id : undefined}
                set:html={html}
              />
              {/* 正文原编辑岛：仅登录用户加载（client:idle 延后到空闲，不拖阅读首屏） */}
              {isAuthed && <DocInlineEditor client:idle />}
            </>
          ) : (
            <p class="mt-10 text-center text-sm text-muted-foreground">该文档暂无文章。</p>
          )}
        </main>

        {/* 右栏：文章内目录 —— 悬浮面板（fixed 贴视口右缘 340px），状态机见 <script> setupTocRail：
            ① ≥1320px：悬浮展开，不遮正文（正文右缘与面板间留白 ≥40px）
            ② <1320px：自动收起为贴右浮钮（#doc-toc-fab）；点开 → 浮层 + 遮罩（#doc-toc-overlay）
            ③ 用户手动收起（任意宽度）：同 ② 的浮钮形态 */}
      </div>

      {/* TOC 悬浮面板（置于 grid 外：fixed 定位不参与两栏布局） */}
      <aside id="doc-toc-aside" class="hidden lg:block">
        <div id="doc-toc-panel" class="fixed top-20 right-0 z-30 flex max-h-[calc(100vh-6rem)] w-[340px] flex-col border-l border-y border-border bg-card/95 shadow-lg backdrop-blur">
          {/* 标题行 */}
          <div class="flex shrink-0 items-center justify-between gap-2 border-b border-border/60 px-4 py-2.5">
            <p data-toc-label class="font-pixel text-[0.7rem] uppercase tracking-[0.15em] text-muted-foreground">目录 / TOC</p>
            <button
              id="doc-toc-toggle"
              type="button"
              title="收起目录"
              aria-label="收起目录"
              aria-controls="doc-toc-list"
              aria-expanded="true"
              class="inline-flex h-7 w-7 shrink-0 items-center justify-center rounded-md border border-border bg-background/80 text-muted-foreground backdrop-blur transition-colors hover:border-primary/50 hover:text-primary"
            >
              <svg data-toc-icon-collapse class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="15 18 9 12 15 6" /></svg>
              <svg data-toc-icon-expand class="hidden h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6" /></svg>
            </button>
          </div>
          {/* 目录滚动区：悬停滚动时仅滚自身（overscroll-behavior:contain 阻断联动正文） */}
          <div id="doc-toc-rail" class="min-h-0 flex-1 overflow-y-auto overscroll-contain px-4 py-3 [scrollbar-width:thin]">
            {toc.length > 0 ? (
              <div id="doc-toc-list" data-toc-label class="flex flex-col gap-1.5" set:html={tocTreeHtml} />
            ) : (
              <p data-toc-label class="mt-2 text-xs text-muted-foreground">{deferRender ? '正在加载目录…' : '无目录'}</p>
            )}
          </div>
        </div>

        {/* 收起后的贴右浮钮（替代旧「44px 窄列」形态） */}
        <button
          id="doc-toc-fab"
          type="button"
          title="展开目录"
          aria-label="展开目录"
          aria-controls="doc-toc-list"
          aria-expanded="false"
          class="fixed top-20 right-3 z-30 hidden h-9 w-9 items-center justify-center rounded-full border border-border bg-card/95 text-muted-foreground shadow-lg backdrop-blur transition-colors hover:border-primary/50 hover:text-primary"
        >
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6" /></svg>
        </button>
      </aside>

      {/* overlay 遮罩：窄窗浮层模式下点击空白处收起目录 */}
      <div id="doc-toc-overlay" class="fixed inset-0 z-20 hidden bg-black/30 backdrop-blur-[1px]" aria-hidden="true" />
    </div>
  </section>

  {/* 数据注入 */}
  <div id="doc-detail-data" data-authed={isAuthed ? '1' : '0'} data-nodes={nodesJson} data-bundle={bundleJson} data-active-node={activeNodeId} data-folders={folderOptionsJson} class="hidden" aria-hidden="true" />
  {/* 切换文章加载条：首渲染 1~3s 期间的即时反馈（否则页面静止会被当成卡死），见页内切换 handler */}
  <div id="doc-switch-progress" class="hidden" role="progressbar" aria-label="正在加载文章">
    <span></span>
  </div>

  <!-- 节点编辑弹窗（目录 / 文章通用） -->
  <dialog id="doc-node-dialog" class="m-auto w-[min(92vw,52rem)] rounded-lg border border-border bg-card p-4 text-foreground shadow-xl backdrop:bg-black/40">
    <h3 id="doc-node-dialog-title" class="font-medium">编辑节点</h3>
    <div class="mt-3 grid gap-2 sm:grid-cols-2">
      <label class="text-xs font-medium text-muted-foreground">
        标题
        <input id="doc-node-title" type="text" maxlength="200" class="mt-1 w-full rounded-md border border-input bg-background px-3 py-1.5 text-sm outline-none focus-visible:border-ring" />
      </label>
      <label class="text-xs font-medium text-muted-foreground">
        类型（创建时可选）
        <select id="doc-node-kind" class="mt-1 w-full rounded-md border border-input bg-background px-2 py-1.5 text-sm outline-none focus-visible:border-ring">
          <option value="article">文章</option>
          <option value="folder">目录（可嵌套子目录/文章）</option>
        </select>
      </label>
    </div>
    <label class="mt-2 block text-xs font-medium text-muted-foreground">
      所在目录
      <select id="doc-node-parent" class="mt-1 w-full rounded-md border border-input bg-background px-2 py-1.5 text-sm outline-none focus-visible:border-ring"></select>
    </label>
    <div id="doc-node-content-wrap" class="mt-2">
      <div class="flex items-center justify-between">
        <span class="text-xs font-medium text-muted-foreground">正文（Markdown / MDX）</span>
        <button id="doc-node-preview-btn" type="button" class="rounded-md border border-border px-3 py-1.5 text-xs text-muted-foreground transition-colors hover:border-primary/50 hover:text-primary">预览</button>
      </div>
      <div class="mt-1 grid gap-2 md:grid-cols-2">
        <textarea id="doc-node-content" spellcheck="false" placeholder="文章正文…" class="h-80 w-full resize-y rounded-md border border-input bg-background px-3 py-2 font-mono text-sm leading-relaxed outline-none focus-visible:border-ring"></textarea>
        <div id="doc-node-preview" class="prose h-80 overflow-y-auto rounded-md border border-border bg-background/50 px-3 py-2 text-sm"></div>
      </div>
    </div>
    <p id="doc-node-status" class="mt-2 hidden text-xs text-destructive" role="alert"></p>
    <div class="mt-3 flex items-center justify-end gap-2">
      <button id="doc-node-cancel" type="button" class="rounded-md px-2 py-1 text-xs text-muted-foreground hover:text-foreground">取消</button>
      <button id="doc-node-confirm" type="button" class="rounded-md bg-primary px-3 py-1 text-xs text-primary-foreground transition-opacity hover:opacity-90">保存</button>
    </div>
  </dialog>

  <!-- 文档编辑弹窗 -->
  <dialog id="doc-edit-bundle-dialog" class="m-auto w-80 rounded-lg border border-border bg-card p-4 text-foreground shadow-xl backdrop:bg-black/40">
    <h3 class="font-medium">编辑文档</h3>
    <label class="mt-3 block text-xs font-medium text-muted-foreground">
      文档名
      <input id="doc-bundle-edit-name" type="text" maxlength="80" class="mt-1 w-full rounded-md border border-input bg-background px-3 py-1.5 text-sm outline-none focus-visible:border-ring" />
    </label>
    <label class="mt-2 block text-xs font-medium text-muted-foreground">
      图标（可选）
      <input id="doc-bundle-edit-icon" type="text" maxlength="20" class="mt-1 w-full rounded-md border border-input bg-background px-3 py-1.5 text-sm outline-none focus-visible:border-ring" />
    </label>
    <label class="mt-2 block text-xs font-medium text-muted-foreground">
      简介（可选）
      <input id="doc-bundle-edit-summary" type="text" maxlength="200" class="mt-1 w-full rounded-md border border-input bg-background px-3 py-1.5 text-sm outline-none focus-visible:border-ring" />
    </label>
    <p id="doc-bundle-edit-status" class="mt-2 hidden text-xs text-destructive" role="alert"></p>
    <div class="mt-3 flex items-center justify-end gap-2">
      <button id="doc-bundle-edit-cancel" type="button" class="rounded-md px-2 py-1 text-xs text-muted-foreground hover:text-foreground">取消</button>
      <button id="doc-bundle-edit-confirm" type="button" class="rounded-md bg-primary px-3 py-1 text-xs text-primary-foreground transition-opacity hover:opacity-90">保存</button>
    </div>
  </dialog>
</BaseLayout>

<style is:global>
  /* ===== /doc/[id] 布局：左目录树两栏 grid + 右 TOC 悬浮面板 ===== */
  /* 左栏宽度（可折叠为 44px 只留按钮条）；右 TOC 为 fixed 悬浮面板，不占布局列 */
  #doc-3col { --toc-lw: 220px; }
  /* 左栏折叠态：只留按钮条 */
  #doc-3col[data-ltoc-collapsed='true'] { --toc-lw: 44px; }

  /* —— TOC 悬浮面板三态（状态属性挂在 #doc-toc-aside 上，由 setupTocRail 维护） ——
     ① data-collapsed='false' + data-auto='false'（≥1320px）：悬浮展开，贴视口右缘不遮正文
     ② data-collapsed='true'：收起为贴右浮钮（fab）
     ③ data-collapsed='false' + data-auto='true'（<1320px 手动点开）：浮层 + 遮罩 */
  #doc-toc-aside[data-collapsed='true'] #doc-toc-panel { display: none; }
  #doc-toc-aside[data-collapsed='true'] #doc-toc-fab { display: inline-flex; }
  #doc-toc-aside[data-collapsed='false'][data-auto='true'] ~ #doc-toc-overlay { display: block; }
  /* 浮层模式下面板抬升层级（高于遮罩 z-20） */
  #doc-toc-aside[data-auto='true'][data-collapsed='false'] #doc-toc-panel { z-index: 40; }

  /* 左栏折叠动画：inner 向左滑出（纯合成器动画），列宽由 data-* 瞬切（单次 reflow）。
     旧实现把 opacity 过渡挂在 #doc-3col 上导致正文整段淡出 + 巨型合成层卡顿，已废弃。 */
  @media (min-width: 1024px) {
    #doc-ltoc-aside { overflow: hidden; }
    #doc-ltoc-inner { width: 220px; }
    #doc-ltoc-inner { transition: transform 0.2s ease; }
    #doc-3col[data-ltoc-collapsed='true'] #doc-ltoc-inner { transform: translateX(-100%); }
    #doc-ltoc-toggle { position: absolute; top: 0; right: 0.5rem; z-index: 10; }
  }
  /* 左栏折叠态按钮图标切换（折叠图隐藏，展开图显示） */
  #doc-3col[data-ltoc-collapsed='true'] [data-ltoc-icon-collapse] { display: none; }
  #doc-3col[data-ltoc-collapsed='true'] [data-ltoc-icon-expand] { display: inline-block; }
  #doc-3col[data-ltoc-collapsed='false'] [data-ltoc-icon-collapse] { display: inline-block; }
  #doc-3col[data-ltoc-collapsed='false'] [data-ltoc-icon-expand] { display: none; }

  /* ===== 树形目录：层级递归折叠 ===== */
  .toc-row { display: flex; align-items: flex-start; gap: 0.125rem; }
  .toc-fold {
    flex-shrink: 0;
    width: 1rem;
    height: 1.4rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--color-muted-foreground);
    cursor: pointer;
    border-radius: 0.25rem;
    transition: color 0.15s;
  }
  .toc-fold:hover { color: var(--color-primary); }
  .toc-fold .toc-chevron { width: 0.7rem; height: 0.7rem; transition: transform 0.15s ease; }
  .toc-node.folded > .toc-row .toc-chevron { transform: rotate(-90deg); }
  .toc-node.folded > .toc-children { display: none; }
  .toc-fold-spacer { flex-shrink: 0; width: 1rem; height: 1.4rem; }
  .toc-children {
    margin-left: 1.05rem;
    margin-top: 0.375rem;
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }
  .toc-item {
    display: block;
    font-size: 0.95rem;
    line-height: 1.35;
    color: var(--color-muted-foreground);
    transition: color 0.2s;
    min-width: 0;
  }
  .toc-item:hover { color: var(--color-primary); }
  /* 编辑态反向高亮：编辑器滚动 → 当前小节目录项（由 DocInlineEditor 切 class） */
  #doc-toc-list .toc-item.toc-active {
    color: var(--color-primary);
    font-weight: 500;
  }
  .toc-l3 { font-size: 0.9rem; }
  .toc-l4 { font-size: 0.85rem; }

  /* ===== 目录内 KaTeX：缩小字号防撑行；display 公式收敛为块内展示 ===== */
  #doc-toc-list .katex { font-size: 0.85em; }
  #doc-toc-list .katex-display { margin: 0.2em 0; }
  #doc-toc-list .katex-display > .katex { display: inline-block; white-space: nowrap; }

  /* ===== 正文 KaTeX：解拥挤 =====
     vlist 防御（诊断实验）：.katex 内部行盒必须用 KaTeX 官方行高 1.2 ——
     覆盖成 1.6 会给每个绝对定位行盒叠加额外前导，分式/上下标嵌套时 bbox 相交
     数倍增（实测 lh1.6 → 1.2 使 mfrac 重叠显著下降）。段落级行距由
     p:has(.katex) 的 line-height: 2 独立兜底，两者互不影响。
     字体失败场景由 html.katex-font-fallback 的 MathML 兜底处理（global.css）。 */
  .prose .katex { font-size: 1.05em; line-height: 1.2; }
  /* 行内公式左右留白：0.05em → 0.18em，避免与相邻文字粘连 */
  .prose p .katex,
  .prose li .katex { padding: 0 0.18em; }
  /* 含公式的段落/列表项放宽行距：\frac / \int 等"高"公式不再顶到相邻行 */
  .prose p:has(.katex),
  .prose li:has(.katex) { line-height: 2; }
  /* 行间公式：上下留白更舒展，横向溢出时独立滚动而不是撑破栏宽 */
  .prose .katex-display {
    margin: 1.3em 0;
    overflow-x: auto;
    overflow-y: hidden;
    padding: 0.35em 0;
  }
  .prose .katex-display > .katex { display: inline-block; white-space: nowrap; }
  /* 窄屏下宽公式轻微降字号，换取横向空间（宁可小一点，也不要挤成滚动条） */
  @media (max-width: 767px) {
    .prose .katex-display > .katex { font-size: 0.94em; }
  }

  /* ===== 长文渲染优化：跳过首屏外区块的布局与绘制 =====
     实测：243KB 文章渲染出约 1.9 万个 DOM 标签，浏览器一次性 layout 是
     「切到大文章卡一下」的主因（服务端有 LRU 后仅 0.1ms，网络 gzip 后也很小）。
     content-visibility:auto 让视口外区块跳过 layout/paint，只算可见部分；
     contain-intrinsic-size 的 `auto` 前缀会记住真实高度，避免滚动条反复抖动。
     权衡：未渲染过的区块用估算高度，首次锚点/TOC 跳转可能有轻微偏移；
     打印时必须还原 visible，否则视口外内容不会进打印结果。 */
  main article.prose > * {
    content-visibility: auto;
    contain-intrinsic-size: auto 120px;
  }
  @media print {
    main article.prose > * { content-visibility: visible; }
  }
  /* 目录跳转/模式切换定位专用的「强制渲染」态：
     首次点击目录时视口外区块仍是估算高（120px），滚动途中逐渐真实化导致
     首次定位偏移、后续点击才准。跳转前暂时整篇强制布局（contain-intrinsic-size
     的 auto 前缀会记住真实高度，恢复后不再回跳），定位完即恢复。 */
  main article.prose.toc-nav-rendering > * {
    content-visibility: visible;
  }

  /* ===== 切换文章的加载反馈（见页内切换 handler 的性能说明） =====
     每篇文章首次服务端渲染 1~3s；页内切换无浏览器原生加载指示，
     必须给出即时反馈，否则用户会当成卡死并连点（连点让 node 单线程排队）。
     正文降透明 + 顶部不确定进度条；同时禁 pointer-events，避免加载中误操作旧内容。 */
  main article.prose.doc-article-loading {
    opacity: 0.4;
    pointer-events: none;
    transition: opacity 0.15s ease;
  }
  #doc-switch-progress {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 60;
    height: 3px;
    overflow: hidden;
    background: color-mix(in oklab, var(--primary) 15%, transparent);
  }
  #doc-switch-progress > span {
    display: block;
    width: 35%;
    height: 100%;
    background: var(--primary);
    animation: doc-switch-slide 1.1s ease-in-out infinite;
  }
  @keyframes doc-switch-slide {
    0% { transform: translateX(-110%); }
    100% { transform: translateX(330%); }
  }
  @media (prefers-reduced-motion: reduce) {
    #doc-switch-progress > span { animation-duration: 2.4s; }
  }

  /* ===== 就地编辑（Obsidian 式原位编辑） =====
     编辑器=ghost 变体：透明融入正文、无卡片无工具条；高度按正文高计算不跳变。
     host 承接原 <article> 的 mt-6，使编辑内容与阅读正文起点一致。 */
  .doc-ie-host { margin-top: 1.5rem; }
  .doc-ie-view {
    overflow: hidden;
    border-radius: var(--radius-md);
    /* 就地编辑态下编辑器处于可点选状态，滚动条细而低调 */
    scrollbar-width: thin;
  }
  .doc-ie-view .cm-editor { border-radius: var(--radius-md); }
  .doc-ie-view .cm-scroller { scrollbar-width: thin; }
  /* 正文原位替换时去除 CM 的焦点外框（阅读正文无框，编辑态亦应无框） */
  .doc-ie-view .cm-editor.cm-focused { outline: none; }
  /* ghost 编辑器首行/末尾对齐阅读正文间距 */
  .doc-ie-view .cm-content { padding-top: 0.375rem; }

  /* 标题旁入口按钮：编辑态 →「完成」高亮（primary 色） */
  #doc-inline-edit.doc-entry-active {
    border-color: var(--color-primary);
    color: var(--color-primary);
    background: color-mix(in srgb, var(--color-primary) 8%, transparent);
  }

  /* ===== 目录树拖拽反馈（对齐导航模块交互） ===== */
  /* 目录行落点：主色浅底 + 虚线描边（移入该目录末尾） */
  #doc-ltoc-body [data-doc-folder-target].doc-drag-over-folder {
    background: color-mix(in srgb, var(--color-primary) 12%, transparent);
    color: var(--color-primary);
    outline: 1px dashed color-mix(in srgb, var(--color-primary) 55%, transparent);
    outline-offset: -1px;
  }
  /* 文章行落点：上/下插入线（2px 主色，inset 不占布局） */
  #doc-ltoc-body [data-doc-node-id].doc-drag-line-top {
    box-shadow: inset 0 2px 0 var(--color-primary);
  }
  #doc-ltoc-body [data-doc-node-id].doc-drag-line-bottom {
    box-shadow: inset 0 -2px 0 var(--color-primary);
  }
  /* 被拖源行半透明 */
  #doc-ltoc-body .doc-dragging {
    opacity: 0.45;
  }

  /* ====== 块级公式行：源 line 文本透明 / 不占布局，仅保留 KaTeX widget ======
     根因：cm-wysiwyg 的 `Decoration.replace({ widget })` 在 CodeMirror 6 中不会
     删除源 line 节点（widget 仅替代渲染位置），导致 $$..$$ 行内 KaTeX 字符与
     源码字符并存甚至被压扁。CSS 层把源文本藏起来 —— 公式始终以 KaTeX 形式可见，
     透明文本仍可选中（selectionInside 行为完整保留：光标进公式行可改源码）*/
  .doc-ie-view .cm-line:has(.cm-wy-math-display) {
    color: transparent;
    font-size: 0;
    line-height: 0;
  }
  .doc-ie-view .cm-line:has(.cm-wy-math-display) .cm-wy-math-display {
    display: block;
    /* 左对齐（KaTeX .katex-display 默认居中，这里按需求改为与正文左缘对齐） */
    text-align: left;
    margin: 1em 0;
    color: var(--color-foreground);
    font-size: 1rem;
    line-height: 1.5;
  }
</style>

<script>
  /** 文档详情页：目录树文章切换 + 节点 CRUD（目录/文章 增删改移动）+ 预览 */
  import { confirmDanger } from '@/lib/confirm';
  import { renderTocTreeHtml } from '@/lib/toc-tree';
  import {
    buildDocTree,
    collectSubtreeIds,
    docFolderOptions,
    patchNodes,
    removeSubtree,
    renderDocTree,
    type DocTreeItem,
  } from '@/lib/doc-tree-render';
  import type { TocItem } from '@/lib/mdx-plugins';

  const DATA = document.getElementById('doc-detail-data');
  const IS_AUTHED = DATA?.dataset.authed === '1';
  /** View Transitions（SPA 切换）下页面数据会随 DOM 更换，禁止模块级缓存 —— 每次按需读取最新 bundle/nodes/folders */
  function readBundle(): { id: string; name: string; icon: string | null; summary: string | null } {
    const d = document.getElementById('doc-detail-data');
    return JSON.parse(d?.dataset.bundle ?? '{}') as { id: string; name: string; icon: string | null; summary: string | null };
  }
  /** 注入的节点元信息（updatedAt 用作 /render 的缓存版本号 v） */
  interface NodeMeta {
    id: string;
    parentId: string | null;
    kind: 'folder' | 'article';
    title: string;
    sort: number;
    /** ISO 串；同级排序依据（对齐服务端 ORDER BY sort, createdAt） */
    createdAt?: string;
    updatedAt?: string;
  }
  function readNodes(): NodeMeta[] {
    const d = document.getElementById('doc-detail-data');
    return JSON.parse(d?.dataset.nodes ?? '[]') as NodeMeta[];
  }
  function readFolders(): Array<{ id: string; title: string }> {
    const d = document.getElementById('doc-detail-data');
    return JSON.parse(d?.dataset.folders ?? '[]') as Array<{ id: string; title: string }>;
  }
  /** 内存节点表写回。就地增删改后必须回写，否则后续 readNodes 仍读到旧数据。 */
  function writeNodes(list: NodeMeta[]): void {
    const d = document.getElementById('doc-detail-data');
    if (d) d.dataset.nodes = JSON.stringify(list);
  }
  /** 「移动到」下拉与树共用同一份扁平表（顺序由 docFolderOptions 统一决定） */
  function writeFolders(list: NodeMeta[]): void {
    const d = document.getElementById('doc-detail-data');
    if (d) d.dataset.folders = JSON.stringify(docFolderOptions(list as DocTreeItem[]));
  }

  /* ================= 目录树就地重绘 =================
     原先目录树增删改成功后一律 window.location.reload()，会丢掉：
     手动折叠的目录（SSR 恒 `<details open>`，重载后全弹开）、左右栏滚动位置，
     以及**编辑器里尚未保存的正文**（本页挂了 DocInlineEditor，这是真实数据丢失）。
     现在改为：就地改内存表 → 重绘 [data-doc-tree-root]。

     ⚠️ 折叠态必须快照回放，且要快照「**被折叠**的」而非「展开的」：
        SSR 默认全开，快照展开集合会让**新建的目录**渲染成收起（反直觉）；
        快照折叠集合则天然满足「新目录默认展开、用户收起的保持收起」。 */
  function snapshotTreeCollapsed(): Set<string> {
    const closed = new Set<string>();
    document.querySelectorAll<HTMLDetailsElement>('[data-doc-tree-root] details[data-folder]').forEach((d) => {
      if (!d.open) closed.add(d.dataset.folder ?? '');
    });
    return closed;
  }
  /** 用当前内存节点表重绘目录树（SSR 与客户端同一渲染函数，标记必然一致） */
  function renderTree(): void {
    const root = document.querySelector<HTMLElement>('[data-doc-tree-root]');
    if (!root) return;
    const closed = snapshotTreeCollapsed();
    root.innerHTML = renderDocTree(buildDocTree(readNodes() as DocTreeItem[]), {
      authed: IS_AUTHED === true,
      bundleId: readBundle().id,
      activeId: currentActiveId(),
    });
    for (const d of root.querySelectorAll<HTMLDetailsElement>('details[data-folder]')) {
      if (closed.has(d.dataset.folder ?? '')) d.open = false;
    }
  }
  /** 删除 / 新增目录后，刷新「移动到」下拉的选项（否则会选到已删目录） */
  function refreshFolderOptions(): void {
    writeFolders(readNodes());
  }

  function el<T extends Element = HTMLElement>(id: string): T | null {
    return document.getElementById(id) as T | null;
  }
  function escHtml(s: string): string {
    return String(s).replace(/[&<>"']/g, (c) => {
      const map: Record<string, string> = { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' };
      return map[c] ?? c;
    });
  }

  /* ================= 左栏管理按钮：捕获阶段拦截导航 ================= */
  // 编辑/删除/移动/新增按钮嵌在文章行 <a data-article-switch> 链接内部（目录行按钮
  // 在 <summary> 内，点击默认还会翻转 details 开合）。Astro ClientRouter 在 document
  // 冒泡阶段监听链接点击并触发 SPA 转场，且先于本页冒泡阶段的弹窗逻辑执行 —— 点击
  // 按钮时弹窗刚 showModal 页面就开始转场，<dialog> 随旧 DOM 一起被替换（弹窗闪退，
  // confirmDanger 的 Promise 永不 resolve）。修复与 doc.astro 同款：在【捕获阶段】
  // （先于任何冒泡 handler，含 ClientRouter）对管理按钮立即 preventDefault()，使
  // ClientRouter 检查 defaultPrevented=true 时跳过导航、<summary> 不再翻转开合；
  // 弹窗打开/删除确认仍在冒泡阶段正常处理。
  document.addEventListener(
    'click',
    (e) => {
      const t = e.target as HTMLElement | null;
      if (t && t.closest('[data-node-edit], [data-node-del], [data-node-move], [data-node-add-article], [data-node-add-folder]')) {
        e.preventDefault();
      }
    },
    true,
  );

  /* ================= 左栏文章即时切换 ================= */
  // ⚠️ 必须挂捕获阶段（capture: true）：ClientRouter 的 click 委托（head 内脚本，先注册）
  // 会在冒泡阶段先于本 handler 启动 VT 转场并做 DOM 快照——抢在本 handler preventDefault
  // 之前，随后本文的 pushState + innerHTML 重写与转场竞态 → 每次页内切换抛
  // 「InvalidStateError: Transition was aborted ... Snapshot capture failed」（未捕获，实测）。
  // 捕获阶段先执行 preventDefault，ClientRouter 检查 defaultPrevented 即跳过，本 handler 独占生效。
  //
  // ⚠️ 性能前提（2026-09-16 实测）：每篇文章**首次**服务端渲染约 1~3s（43KB 文档 → 542KB HTML，
  // 冷渲染 2.3s；二次请求命中服务端 LRU 仅 13ms）。页内切换没有浏览器原生加载指示，
  // 若不做反馈，用户会把这 2~3s 的静止当成"卡死"并连点——连点又会让 node 单线程并发排队。
  // 因此本 handler 必须：① 立即给加载反馈；② AbortController 取消上一次未完成的请求；
  // ③ 客户端缓存渲染结果（回切瞬开，不再让服务端重复渲染）。
  /** 客户端渲染结果缓存（key = id + updatedAt；LRU 上限 12 篇，约几 MB 字符串） */
  const ARTICLE_HTML_CACHE = new Map<string, { html: string; toc: TocItem[]; title?: string }>();
  const ARTICLE_CACHE_MAX = 12;
  /** 当前切换请求控制器：连点时中止上一个，避免服务端并发排队（node 单线程） */
  let switchCtrl: AbortController | null = null;

  /** 把渲染结果落到页面（缓存命中与网络返回共用同一路径） */
  function applyArticleHtml(id: string, d: { html: string; toc?: TocItem[]; title?: string }): void {
    const h1 = document.querySelector('main h1');
    if (h1 && d.title) h1.textContent = d.title;
    const article = document.querySelector<HTMLElement>('main article.prose');
    if (article) article.innerHTML = d.html;
    // 正文重写后重建 / 清理黑幕开关（spoiler.ts 监听；幂等：新文章无 :spoiler 时自动移除旧按钮）
    document.dispatchEvent(new CustomEvent('spoiler:refresh'));
    // 重建树形目录（与 SSR 同一实现：层级折叠 + KaTeX 富文本）
    // ⚠️ 容器 `#doc-toc-list` 仅在 SSR 的 toc 非空时渲染（见模板 `toc.length > 0` 分支）：
    //   延迟渲染（SSR 不渲染正文故无 toc）或从无标题文章切到有标题文章时容器不存在，
    //   必须就地创建并清掉「无目录」占位，否则目录一直缺失（2026-09-16 实测缺陷）。
    const rail = document.getElementById('doc-toc-rail');
    if (rail) {
      let tocWrap = document.getElementById('doc-toc-list');
      if (!tocWrap) {
        rail.querySelectorAll('[data-toc-label]').forEach((el) => el.remove());
        tocWrap = document.createElement('div');
        tocWrap.id = 'doc-toc-list';
        tocWrap.className = 'flex flex-col gap-1.5';
        tocWrap.setAttribute('data-toc-label', '');
        rail.appendChild(tocWrap);
      }
      tocWrap.innerHTML =
        Array.isArray(d.toc) && d.toc.length > 0
          ? renderTocTreeHtml(d.toc)
          : '<p class="mt-2 text-xs text-muted-foreground">无目录</p>';
      // 重写后回放标题目录折叠态（否则手动折叠全被重置为展开）
      applyTocFoldState(tocWrap);
    }
    document.getElementById('doc-detail-data')?.setAttribute('data-active-node', id);
  }

  /** 加载反馈：正文降透明 + 顶部进度条（大文档首渲染期间页面不得静止无反馈） */
  function setArticleLoading(on: boolean): void {
    document.querySelector<HTMLElement>('main article.prose')?.classList.toggle('doc-article-loading', on);
    document.getElementById('doc-switch-progress')?.classList.toggle('hidden', !on);
  }

  /** 入历史 + 回顶部（缓存命中与网络返回共用） */
  function pushArticleUrl(id: string): void {
    // ⚠️ state 必须带 ClientRouter 的 {index, scrollX, scrollY} 结构（index 单调递增）：
    //    onPopState 遇 state===null 的条目会直接 return 不转场 → URL 变了内容不变。
    const u = new URL(window.location.href);
    u.searchParams.set('article', id);
    u.hash = '';
    const curIndex = typeof history.state?.index === 'number' ? history.state.index : 0;
    history.pushState({ index: curIndex + 1, scrollX: 0, scrollY: 0 }, '', u);
    window.scrollTo({ top: 0, behavior: 'smooth' });
  }

  document.addEventListener(
    'click',
    async (e) => {
    const t = e.target as HTMLElement;
    // 左栏管理按钮（编辑/删除/移动/新建）嵌在文章链接内：点击时不要顺带切换文章
    if (t.closest('[data-node-edit], [data-node-del], [data-node-move], [data-node-add-article], [data-node-add-folder]')) return;
    const link = t.closest<HTMLElement>('[data-article-switch]');
    if (!link) return;
    // 编辑中禁止切换文章：否则编辑器里的旧正文会被保存/渲染到新文章上（数据覆盖）
    if (document.getElementById('doc-3col')?.getAttribute('data-editing') === 'true') return;
    e.preventDefault();
    const id = link.dataset.articleSwitch;
    if (!id) return;
    setActiveArticle(id);
    if (id === currentActiveId()) {
      window.scrollTo({ top: 0, behavior: 'smooth' });
      return;
    }

    // 加载与应用（缓存命中瞬开；网络加载带反馈 + 取消）；失败兜底整页导航
    const ok = await loadArticleById(id, 'navigate');
    if (ok) pushArticleUrl(id);
  }, true);

  /**
   * 加载并应用某篇文章（点击切换与「大文档延迟渲染」共用同一路径）。
   * - 客户端缓存命中 → 立即应用（回切瞬开，不闪加载态）；
   * - 网络加载 → 立即加载反馈 + AbortController 取消上一次（服务端只服务最后一次）；
   * - 返回 true 表示已应用（调用方据此决定是否 pushState）；被取代/失败返回 false；
   * - onError='navigate'：整页导航兜底（SSR 按 ?article= 渲染）；
   *   onError='message'：就地显示错误（延迟渲染路径专用——大文档 SSR 同样延迟，导航会死循环）。
   */
  async function loadArticleById(id: string, onError: 'navigate' | 'message'): Promise<boolean> {
    // 带版本号 v（= updatedAt）：编辑后 key 变化，避免命中过期缓存
    const meta = readNodes().find((n) => n.id === id);
    const v = meta?.updatedAt ? `?v=${encodeURIComponent(meta.updatedAt)}` : '';
    const cacheKey = `${id}:${meta?.updatedAt ?? ''}`;

    const cached = ARTICLE_HTML_CACHE.get(cacheKey);
    if (cached) {
      applyArticleHtml(id, cached);
      return true;
    }

    switchCtrl?.abort();
    const ctrl = new AbortController();
    switchCtrl = ctrl;
    setArticleLoading(true);
    try {
      const res = await fetch(`/api/doc/nodes/${id}/render${v}`, { signal: ctrl.signal });
      const d = (await res.json().catch(() => ({}))) as { title?: string; html?: string; toc?: TocItem[]; error?: string };
      if (!res.ok || typeof d.html !== 'string') throw new Error(d.error ?? '加载失败');
      const html = d.html; // 收窄为 string：对象本身仍保留可选 html，故渲染处需显式传值
      if (ctrl.signal.aborted) return false; // 已被更新的一次点击取代：静默放弃
      // LRU 写缓存
      ARTICLE_HTML_CACHE.set(cacheKey, { html, toc: Array.isArray(d.toc) ? d.toc : [], title: d.title });
      while (ARTICLE_HTML_CACHE.size > ARTICLE_CACHE_MAX) {
        const oldest = ARTICLE_HTML_CACHE.keys().next().value;
        if (oldest === undefined) break;
        ARTICLE_HTML_CACHE.delete(oldest);
      }
      applyArticleHtml(id, { html, toc: d.toc, title: d.title });
      return true;
    } catch (err) {
      if ((err as Error)?.name === 'AbortError') return false; // 被新点击取代：静默
      if (onError === 'navigate') {
        window.location.href = `/doc/${readBundle().id}?article=${encodeURIComponent(id)}`;
      } else {
        const article = document.querySelector<HTMLElement>('main article.prose');
        if (article) {
          article.innerHTML = `<p class="text-sm text-destructive">长文档加载失败：${escHtml((err as Error)?.message || '未知错误')}。可刷新页面重试。</p>`;
        }
      }
      return false;
    } finally {
      // 仅当自己仍是当前请求时才收尾（被取代时由新请求接管加载态）
      if (switchCtrl === ctrl) {
        switchCtrl = null;
        setArticleLoading(false);
      }
    }
  }

  /** 大文档延迟渲染：SSR 只出骨架（秒开），正文由客户端按统一流程拉取。
   *  幂等：取走 data-defer-article 后再进入本函数不会重复触发。 */
  function loadDeferredArticle(): void {
    const art = document.querySelector<HTMLElement>('main article.prose[data-defer-article]');
    const id = art?.getAttribute('data-defer-article');
    if (!art || !id) return;
    art.removeAttribute('data-defer-article');
    document.getElementById('doc-detail-data')?.setAttribute('data-active-node', id);
    void loadArticleById(id, 'message');
  }
  loadDeferredArticle(); // 直达 / 刷新
  document.addEventListener('astro:page-load', loadDeferredArticle); // VT 转场后

  function setActiveArticle(id: string): void {
    document.querySelectorAll<HTMLElement>('[data-article-switch]').forEach((a) => {
      const active = a.dataset.articleSwitch === id;
      a.classList.toggle('bg-primary/10', active);
      a.classList.toggle('text-primary', active);
      a.classList.toggle('text-muted-foreground', !active);
    });
  }
  function currentActiveId(): string {
    return document.getElementById('doc-detail-data')?.getAttribute('data-active-node') ?? '';
  }
  document.addEventListener('astro:page-load', () => setActiveArticle(currentActiveId()));
  setActiveArticle(currentActiveId());

  /* ================= 旧版 hash 直达链接迁移 =================
     旧版把当前文章存在 URL hash（/doc/{bundle}#{nodeId}），但 fragment 不会随
     HTTP 请求发送，SSR 读不到 → 刷新/直达恒渲染第一篇。检测到 hash 指向本册
     文章时，一次性 location.replace 整页迁移为 /doc/{bundle}?article={nodeId}
     （SSR 直出正确文章；replace 不产生历史记录，前进后退不受影响）。
     正文 TOC 的 heading 锚点 hash 不是节点 id，不会命中迁移。 */
  function migrateLegacyHash(): void {
    const h = window.location.hash.slice(1);
    if (!h) return;
    try {
      if (!readNodes().some((n) => n.id === h)) return;
      const b = readBundle();
      if (b?.id) window.location.replace(`/doc/${b.id}?article=${encodeURIComponent(h)}`);
    } catch {
      /* 非详情页上下文：忽略 */
    }
  }
  migrateLegacyHash();
  document.addEventListener('astro:page-load', migrateLegacyHash);

  /* ================= 正文就地编辑（无跳转；滚动保持由岛内部完成） =================
     标题旁「编辑/完成」按钮：未编辑 → 打开就地编辑；编辑态再点 = 保存并退出。
     岛用 client:idle，首屏可能尚未水合：轮询等待最多 ~2s，避免点击无响应。 */
  document.addEventListener('click', (e) => {
    if (!(e.target as HTMLElement).closest('#doc-inline-edit')) return;
    const grid = document.getElementById('doc-3col');
    const editing = grid?.dataset.editing === 'true';
    let tries = 0;
    const tryBridge = (): void => {
      const bridge = (window as unknown as { __docInlineEditor?: { open: () => void; saveAndClose?: () => void } }).__docInlineEditor;
      if (!bridge) {
        if (tries++ < 20) window.setTimeout(tryBridge, 100);
        return;
      }
      if (editing && bridge.saveAndClose) bridge.saveAndClose();
      else bridge.open();
    };
    tryBridge();
  });

  /* ================= 树形目录：层级折叠/展开（事件委托，动态重建安全） ================= */
  // 点击折叠箭头 → 折叠/展开该节点全部子孙；点击目录链接仍正常锚点跳转
  document.addEventListener('click', (e) => {
    const fold = (e.target as HTMLElement).closest<HTMLElement>('.toc-fold');
    if (!fold) return;
    const node = fold.closest<HTMLElement>('.toc-node');
    if (!node) return;
    const folded = node.classList.toggle('folded');
    fold.setAttribute('aria-expanded', String(!folded));
    fold.setAttribute('aria-label', folded ? '展开子目录' : '折叠子目录');
    persistTocFold(tocNodeId(node), folded);
  });

  /* ================= 目录折叠状态持久化（localStorage） =================
     两类目录原本都会"重置为全展开"：
     ① 标题目录树（右栏悬浮面板）：页内切换文章时 innerHTML 整体重写 → 手动折叠全丢；
     ② 左栏册内树：details SSR 恒 open，VT 转场 / 刷新 / 直开 ?article= 时重置。
     方案：折叠态按 id 存 localStorage（只存「已折叠」集合——展开是常态），
     渲染后回放；无 JS 时保持 SSR 默认全展开（渐进增强不受影响）。
     标题目录以标题锚点 id（slug）为 key，全局一池——同名标题跨文章联动折叠；
     册树以 folder id 为 key、按 bundle 分池。 */
  const TOC_FOLDED_KEY = 'doc-toc-folded';
  const FOLDER_FOLD_MAX = 500;

  const folderFoldKey = (bundleId: string): string => `doc-folder-folded:${bundleId}`;

  function readFoldedSet(key: string): Set<string> {
    try {
      const raw = JSON.parse(localStorage.getItem(key) ?? '[]') as unknown;
      return new Set(Array.isArray(raw) ? raw.filter((x): x is string => typeof x === 'string') : []);
    } catch {
      return new Set();
    }
  }

  function writeFoldedSet(key: string, set: Set<string>): void {
    try {
      localStorage.setItem(key, JSON.stringify([...set].slice(0, FOLDER_FOLD_MAX)));
    } catch {
      /* 隐私模式等写失败：仅退化为不跨页保持，本页交互不受影响 */
    }
  }

  /** 标题目录树节点 id（= 标题锚点 id，由 rehype-slug 生成，跨页稳定） */
  function tocNodeId(node: HTMLElement): string {
    const href = node.querySelector('a[data-doc-anchor]')?.getAttribute('href') ?? '';
    return href.startsWith('#') ? href.slice(1) : '';
  }

  function persistTocFold(id: string, folded: boolean): void {
    if (!id) return;
    const set = readFoldedSet(TOC_FOLDED_KEY);
    if (folded) set.add(id);
    else set.delete(id);
    writeFoldedSet(TOC_FOLDED_KEY, set);
  }

  /** 回放标题目录折叠态（页内切换重写 / VT 转场后调用） */
  function applyTocFoldState(root: HTMLElement | null): void {
    if (!root) return;
    const folded = readFoldedSet(TOC_FOLDED_KEY);
    if (folded.size === 0) return;
    root.querySelectorAll<HTMLElement>('.toc-node').forEach((node) => {
      const id = tocNodeId(node);
      if (!id || !folded.has(id)) return;
      node.classList.add('folded');
      const fold = node.querySelector<HTMLElement>(':scope > .toc-row > .toc-fold');
      if (fold) {
        fold.setAttribute('aria-expanded', 'false');
        fold.setAttribute('aria-label', '展开子目录');
      }
    });
  }

  const currentBundleId = (): string => /^\/doc\/([^/?#]+)/.exec(location.pathname)?.[1] ?? '';

  /** 回放左栏册树折叠态（details SSR 恒 open；整页导航后按存储调整 open） */
  function applyFolderFoldState(): void {
    const bundleId = currentBundleId();
    if (!bundleId) return;
    const folded = readFoldedSet(folderFoldKey(bundleId));
    document.querySelectorAll<HTMLDetailsElement>('details.doc-folder[data-folder]').forEach((d) => {
      const id = d.getAttribute('data-folder') ?? '';
      if (id) d.open = !folded.has(id);
    });
  }

  // details 开合 → 持久化册树折叠态。⚠️ toggle 事件不冒泡，必须 capture 捕获；
  // 回放时的程序化 d.open 赋值也会触发 toggle，写入值与回放值一致（幂等，无循环）。
  document.addEventListener(
    'toggle',
    (e) => {
      const d = e.target as HTMLDetailsElement;
      if (!d || d.tagName !== 'DETAILS' || !d.classList.contains('doc-folder')) return;
      const id = d.getAttribute('data-folder');
      const bundleId = currentBundleId();
      if (!id || !bundleId) return;
      const key = folderFoldKey(bundleId);
      const set = readFoldedSet(key);
      if (d.open) set.delete(id);
      else set.add(id);
      writeFoldedSet(key, set);
    },
    true,
  );

  /** 全部回放入口：直达/刷新首次执行 + astro:page-load（VT 转场 / 前进后退） */
  function applyAllFoldState(): void {
    applyTocFoldState(document.getElementById('doc-toc-list'));
    applyFolderFoldState();
  }
  applyAllFoldState();
  document.addEventListener('astro:page-load', applyAllFoldState);

  /* ================= 本册目录树：文章拖拽排序 / 跨目录移动（登录） =================
     交互对齐导航模块（nav.astro）：HTML5 原生 DnD + document 级委托（ClientRouter
     转场后无需重绑）+ 落点高亮 + drop 后 reload。
     落点模型（仅登录渲染 draggable/data-*）：
     - 文章行 [data-doc-node-id]：上半=插到它前面 / 下半=插到它后面（同目录排序、
       跨目录移动皆由此统一表达：目标父目录 = 命中行的 parentId）
     - 目录行 [data-doc-folder-target]：移入该目录末尾
     - 树容器空白 [data-doc-tree-root]：移到册根级末尾
     数据更新：PATCH /api/doc/nodes/[id] { parentId, sort }；sort 取目标位置前后
     兄弟中点，区间不可分（相等/撞车）时对目标父目录孩子全量重编 0..n-1。
     编辑态（data-editing='true'）禁止拖拽：drop 后 reload 会丢编辑内容。 */
  const DOC_DRAG_INACTIVE = '[data-doc-node-id]'; // 可拖源选择器（文章行）
  let draggingDocNodeId: string | null = null;
  let docDropMark: HTMLElement | null = null; // 当前带插入线/高亮的落点元素

  function clearDocDropMark(): void {
    docDropMark?.classList.remove('doc-drag-over-folder', 'doc-drag-line-top', 'doc-drag-line-bottom');
    docDropMark = null;
  }

  /** 解析 dragover 命中的落点：返回 {el, kind, folderId?} 或 null */
  function resolveDocDropTarget(target: EventTarget | null): { el: HTMLElement; kind: 'article' | 'folder' | 'root' } | null {
    const el = target as HTMLElement | null;
    if (!el || !el.closest) return null;
    const art = el.closest<HTMLElement>('[data-doc-node-id]');
    if (art) return { el: art, kind: 'article' };
    const folder = el.closest<HTMLElement>('[data-doc-folder-target]');
    if (folder) return { el: folder, kind: 'folder' };
    const root = el.closest<HTMLElement>('[data-doc-tree-root]');
    if (root) return { el: root, kind: 'root' };
    return null;
  }

  /** 应用落点视觉：目录=高亮；文章=上半/下半插入线；root=无装饰 */
  function applyDocDropMark(t: { el: HTMLElement; kind: 'article' | 'folder' | 'root' }, above: boolean): void {
    if (docDropMark === t.el) {
      // 同一元素内上下半切换
      if (t.kind === 'article') {
        t.el.classList.toggle('doc-drag-line-top', above);
        t.el.classList.toggle('doc-drag-line-bottom', !above);
      }
      return;
    }
    clearDocDropMark();
    docDropMark = t.el;
    if (t.kind === 'folder') t.el.classList.add('doc-drag-over-folder');
    else if (t.kind === 'article') t.el.classList.add(above ? 'doc-drag-line-top' : 'doc-drag-line-bottom');
  }

  /**
   * 计算 drop 后的 parentId + sort 并发 PATCH。
   * 目标序 = 目标父目录孩子（含 folder）按当前 sort；同目录先移除被拖节点再插入。
   */
  async function commitDocNodeMove(nodeId: string, targetParentId: string | null, insertIdx: number): Promise<void> {
    const siblings = readNodes()
      .filter((n) => (n.parentId ?? null) === targetParentId && n.id !== nodeId)
      .sort((a, b) => a.sort - b.sort);
    const idx = Math.max(0, Math.min(insertIdx, siblings.length));
    // sort 取前后兄弟中点；不可分（差 <2 或相等）时全量重编 0..n-1
    const prev = siblings[idx - 1];
    const next = siblings[idx];
    let sort: number;
    let renumber: NodeMeta[] | null = null;
    if (!prev && !next) sort = 0;
    else if (!prev) sort = (next?.sort ?? 0) - 1;
    else if (!next) sort = prev.sort + 1;
    else if (next.sort - prev.sort >= 2) sort = Math.floor((prev.sort + next.sort) / 2);
    else {
      renumber = [...siblings];
      renumber.splice(idx, 0, { id: nodeId, parentId: targetParentId, kind: 'article', title: '', sort: 0 });
      renumber = renumber.map((n, i) => ({ ...n, sort: i }));
      sort = -1; // 由 renumber 分支赋值
    }

    const patch = async (id: string, body: Record<string, unknown>): Promise<boolean> => {
      const res = await fetch(`/api/doc/nodes/${id}`, {
        method: 'PATCH',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify(body),
      });
      return res.ok;
    };

    if (renumber) {
      // 全量重编：只发变化项；被拖节点带 parentId（跨目录场景）
      const changed = renumber.filter((n, i) => n.sort !== siblings[i]?.sort || n.id === nodeId);
      const results = await Promise.all(
        changed.map((n) =>
          patch(n.id, n.id === nodeId ? { parentId: targetParentId, sort: n.sort } : { sort: n.sort }),
        ),
      );
      if (results.some((ok) => !ok)) throw new Error('排序保存失败');
      // 服务端已落库 → 同步内存表（原实现此处整页 reload，现改为就地重绘）
      writeNodes(
        patchNodes(
          readNodes(),
          changed.map((n) => ({
            id: n.id,
            patch: n.id === nodeId ? { parentId: targetParentId, sort: n.sort } : { sort: n.sort },
          })),
        ),
      );
    } else {
      const node = readNodes().find((n) => n.id === nodeId);
      const sameParent = (node?.parentId ?? null) === targetParentId;
      const ok = await patch(nodeId, sameParent ? { sort } : { parentId: targetParentId, sort });
      if (!ok) throw new Error('移动失败');
      writeNodes(
        patchNodes(readNodes(), [
          { id: nodeId, patch: sameParent ? { sort } : { parentId: targetParentId, sort } },
        ]),
      );
    }
  }

  document.addEventListener('dragstart', (e) => {
    const row = (e.target as HTMLElement).closest<HTMLElement>(DOC_DRAG_INACTIVE);
    if (!row || IS_AUTHED !== true) return;
    // 编辑态禁止拖拽：drop 后 reload 会丢失编辑器内容
    if (document.getElementById('doc-3col')?.getAttribute('data-editing') === 'true') {
      e.preventDefault();
      return;
    }
    draggingDocNodeId = row.dataset.docNodeId ?? null;
    e.dataTransfer?.setData('text/plain', draggingDocNodeId ?? '');
    if (e.dataTransfer) e.dataTransfer.effectAllowed = 'move';
    row.classList.add('doc-dragging'); // 源行半透明
  });
  document.addEventListener('dragover', (e) => {
    if (!draggingDocNodeId) return;
    const t = resolveDocDropTarget(e.target);
    if (!t) return;
    e.preventDefault();
    if (e.dataTransfer) e.dataTransfer.dropEffect = 'move';
    if (t.kind === 'article') {
      const r = t.el.getBoundingClientRect();
      applyDocDropMark(t, e.clientY < r.top + r.height / 2);
    } else {
      applyDocDropMark(t, true);
    }
  });
  document.addEventListener('dragleave', (e) => {
    if (!draggingDocNodeId) return;
    const rt = e.relatedTarget as HTMLElement | null;
    if (docDropMark && rt && docDropMark.contains(rt)) return;
    clearDocDropMark();
  });
  document.addEventListener('drop', async (e) => {
    if (!draggingDocNodeId) return;
    e.preventDefault();
    const nodeId = draggingDocNodeId;
    draggingDocNodeId = null;
    const t = resolveDocDropTarget(e.target);
    clearDocDropMark();
    document.querySelector('.doc-dragging')?.classList.remove('doc-dragging');
    if (!t) return;
    try {
      if (t.kind === 'article') {
        // 目标父目录 = 命中行的 parentId；插入位置 = 该行在目标序中的 index（±after）
        const hitId = t.el.dataset.docNodeId ?? '';
        const hit = readNodes().find((n) => n.id === hitId);
        if (!hit || hit.id === nodeId) return;
        const targetParentId = hit.parentId ?? null;
        const siblings = readNodes().filter((n) => (n.parentId ?? null) === targetParentId).sort((a, b) => a.sort - b.sort);
        const idxInSib = siblings.findIndex((n) => n.id === hitId);
        const r = t.el.getBoundingClientRect();
        const after = e.clientY >= r.top + r.height / 2;
        const dragged = readNodes().find((n) => n.id === nodeId);
        const sameParent = (dragged?.parentId ?? null) === targetParentId;
        const draggedIdx = siblings.findIndex((n) => n.id === nodeId);
        let insertIdx = idxInSib + (after ? 1 : 0);
        if (sameParent && draggedIdx >= 0 && draggedIdx < insertIdx) insertIdx -= 1; // 移除自身后左移
        // 原位判定：移除自身后插回原索引（前后邻居均不变）。注意 p===d+1 不是原位
        // ——那会让 A 与后邻居交换（[A,B] 中 A→B下半 应得 [B,A]）
        if (sameParent && insertIdx === draggedIdx) return;
        await commitDocNodeMove(nodeId, targetParentId, insertIdx);
      } else if (t.kind === 'folder') {
        const folderId = t.el.dataset.docFolderTarget ?? '';
        if (!folderId) return;
        const dragged = readNodes().find((n) => n.id === nodeId);
        if ((dragged?.parentId ?? null) === folderId) return; // 已在该目录：末尾=原目录尾，视为无操作
        await commitDocNodeMove(nodeId, folderId, Number.MAX_SAFE_INTEGER);
      } else {
        const dragged = readNodes().find((n) => n.id === nodeId);
        if ((dragged?.parentId ?? null) === null) return; // 已是根级
        await commitDocNodeMove(nodeId, null, Number.MAX_SAFE_INTEGER);
      }
      // 就地重绘（原实现整页 reload）：保住折叠态、滚动位置与编辑器未保存内容
      renderTree();
      refreshFolderOptions();
    } catch {
      /* 失败保持原状（与导航一致：不做 toast，用户重试） */
    }
  });
  document.addEventListener('dragend', () => {
    draggingDocNodeId = null;
    clearDocDropMark();
    document.querySelector('.doc-dragging')?.classList.remove('doc-dragging');
  });

  /* ================= 左栏目录树：整栏可折叠/展开（transform 滑入滑出，纯合成器动画） =================
     状态：默认展开；收起后该栏仅留按钮，正文自动变宽。
     关键性能点：不动画 grid-template-columns（布局属性，每帧触发全文档重排卡顿），
     列宽由 data-* 属性一次性切换（单次 reflow）；目录内容用 transform 滑入滑出（合成器，零重排零重绘），
     正文永不参与动画（不再淡出消失、不再产生巨型合成层）。
     ⚠️ 绑定时机：Astro module script 只在站点首次加载执行一次——从其它页面转场进入本文时
     doc DOM 尚不存在，顶层直接 getElementById 必为 null（「首次进入折叠按钮不可点、刷新
     后恢复」根因）。必须封装为幂等 setup 挂 astro:page-load（转场后新 DOM 重绑）。 */
  function setupLtocRail(): void {
    const grd = el<HTMLDivElement>('doc-3col');
    const lTocToggle = el<HTMLButtonElement>('doc-ltoc-toggle');
    if (!grd || !lTocToggle || grd.dataset.ltocBound === '1') return;
    grd.dataset.ltocBound = '1';
    const attr = 'ltocCollapsed' as const;
    const key = 'doc-ltoc-collapsed';
    const apply = (collapsed: boolean): void => {
      grd.dataset[attr] = collapsed ? 'true' : 'false';
      lTocToggle.setAttribute('aria-expanded', String(!collapsed));
      lTocToggle.setAttribute('aria-label', collapsed ? '展开目录' : '收起目录');
      lTocToggle.title = collapsed ? '展开目录' : '收起目录';
    };
    let initial = false;
    try {
      initial = window.localStorage.getItem(key) === '1';
    } catch { /* 忽略隐私模式等异常 */ }
    apply(initial);
    lTocToggle.addEventListener('click', () => {
      const next = grd.dataset[attr] !== 'true';
      apply(next); // 列宽瞬切 + inner transform 过渡自动滑入/滑出
      try {
        window.localStorage.setItem(key, next ? '1' : '0');
      } catch { /* 忽略 */ }
    });
  }

  /* ================= 右栏文章内目录：悬浮面板三态 =================
     ① ≥1320px：悬浮展开（fixed 贴视口右缘，正文右缘与面板留白 ≥40px，互不遮盖）
     ② <1320px：自动收起为贴右浮钮（fab）；点开 → 浮层 + 遮罩，点遮罩收起
     ③ 用户手动收起（任意宽度）：同 ② 浮钮形态
     正文列与面板永不相交：面板不占布局列，正文可用宽度完整释放。
     ⚠️ 绑定时机：同 setupLtocRail——幂等 setup + astro:page-load（转场后重绑）。
     resize 监听全站只挂一次（模块级标志），处理器动态重查 DOM，转场后依然生效。 */
  const TOC_KEY = 'doc-toc-collapsed';
  /** 宽屏阈值：≥ 该宽度悬浮展开不遮正文（正文右缘 940px + 面板 340px + 40px 间隙） */
  const TOC_AUTO_THRESHOLD = 1320;

  function readStoredTocCollapsed(): boolean {
    try {
      return window.localStorage.getItem(TOC_KEY) === '1';
    } catch {
      return false;
    }
  }

  /** 应用折叠态（动态重查 DOM：任意一次 setup 代的闭包都能操作当页节点） */
  function applyTocState(collapsed: boolean, persist: boolean): void {
    const aside = el<HTMLElement>('doc-toc-aside');
    const toggle = el<HTMLButtonElement>('doc-toc-toggle');
    const fab = el<HTMLButtonElement>('doc-toc-fab');
    if (!aside) return;
    aside.dataset.collapsed = collapsed ? 'true' : 'false';
    if (toggle) {
      toggle.setAttribute('aria-expanded', String(!collapsed));
      toggle.title = collapsed ? '展开目录' : '收起目录';
    }
    fab?.setAttribute('aria-expanded', String(!collapsed));
    if (persist) {
      try {
        window.localStorage.setItem(TOC_KEY, collapsed ? '1' : '0');
      } catch { /* 忽略 */ }
    }
  }

  /** 视口跨阈值时重算 auto 态；窄窗强制收起（不覆盖用户宽屏偏好） */
  function applyTocAuto(): void {
    const aside = el<HTMLElement>('doc-toc-aside');
    if (!aside) return;
    const auto = window.innerWidth < TOC_AUTO_THRESHOLD;
    aside.dataset.auto = auto ? 'true' : 'false';
    applyTocState(auto ? true : readStoredTocCollapsed(), false);
  }

  function setupTocRail(): void {
    const tocAside = el<HTMLElement>('doc-toc-aside');
    const tocToggle = el<HTMLButtonElement>('doc-toc-toggle');
    const tocFab = el<HTMLButtonElement>('doc-toc-fab');
    const tocOverlay = el<HTMLElement>('doc-toc-overlay');
    if (!tocAside || !tocToggle || !tocFab || tocAside.dataset.tocBound === '1') return;
    tocAside.dataset.tocBound = '1';

    // 面板头部「收起」按钮：宽屏写入用户偏好，窄窗仅临时收起
    tocToggle.addEventListener('click', () => {
      applyTocState(true, tocAside.dataset.auto !== 'true');
    });
    // 浮钮「展开」：窄窗进入浮层模式，宽屏恢复悬浮展开
    tocFab.addEventListener('click', () => applyTocState(false, tocAside.dataset.auto !== 'true'));
    // 遮罩点击：收起浮层
    tocOverlay?.addEventListener('click', () => applyTocState(true, false));

    applyTocAuto();
  }

  // resize 防抖：处理器动态重查 DOM，模块级只挂一次（转场累积安全）
  let tocResizeTimer = 0;
  window.addEventListener('resize', () => {
    window.clearTimeout(tocResizeTimer);
    tocResizeTimer = window.setTimeout(applyTocAuto, 120);
  });

  /** 两侧折叠栏统一初始化：立即执行（直达/刷新）+ astro:page-load（转场进入重绑） */
  function setupDocRails(): void {
    setupLtocRail();
    setupTocRail();
  }
  setupDocRails();
  document.addEventListener('astro:page-load', setupDocRails);

  /* ================= 目录定位原语（阅读态跳转 + 编辑态退出回读位共用） =================
     content-visibility:auto 的估算高度问题：视口外区块高度是 contain-intrinsic-size
     的估算值（120px），锚点跳转按估算高度计算落点 → 首次定位偏移；沿途区块被
     滚动渲染后高度变真实 → 后续点击才准（用户实测报障）。
     stableScrollTo 在跳转前把整篇临时强制布局（.toc-nav-rendering，跳转后恢复，
     auto 前缀记住真实高度不回跳），再做多帧校正（图片陆续加载的漂移一并收敛）；
     用户一旦手动滚动（wheel/touch）立即停止校正，绝不和用户抢视口。 */
  function stableScrollTo(target: Element): void {
    const art = document.querySelector<HTMLElement>('main article.prose');
    art?.classList.add('toc-nav-rendering');
    // 强制同步 layout：估算高 → 真实高
    void (art ?? document.body).offsetHeight;
    target.scrollIntoView({ behavior: 'auto', block: 'start' });
    let cancelled = false;
    const cancel = (): void => {
      cancelled = true;
    };
    window.addEventListener('wheel', cancel, { once: true, passive: true });
    window.addEventListener('touchmove', cancel, { once: true, passive: true });
    const align = (): void => {
      if (!cancelled) target.scrollIntoView({ behavior: 'auto', block: 'start' });
    };
    requestAnimationFrame(() => {
      art?.classList.remove('toc-nav-rendering');
      align();
    });
    window.setTimeout(align, 350);
    window.setTimeout(align, 900);
  }

  /** 按「正文内比例」（0~1，视口顶在正文中的深度）定位阅读视口（编辑态退出回读位用） */
  function scrollToProgress(ratio: number): void {
    const art = document.querySelector<HTMLElement>('main article.prose');
    if (!art) return;
    art.classList.add('toc-nav-rendering');
    void art.offsetHeight;
    const rect = art.getBoundingClientRect();
    const clamped = Math.min(1, Math.max(0, ratio));
    window.scrollTo({
      top: Math.max(0, rect.top + window.scrollY + clamped * Math.max(0, rect.height)),
      behavior: 'auto',
    });
    requestAnimationFrame(() => art.classList.remove('toc-nav-rendering'));
  }
  window.__docScrollToProgress = scrollToProgress;

  /* ================= 目录点击 → 跳转（阅读态稳定定位 / 编辑态编辑器内跳转） =================
     捕获阶段 preventDefault（先于 ClientRouter 的 document 冒泡监听，项目既定约定）：
     - 编辑态：正文已被 CodeMirror 编辑器原位替换（渲染锚点 #slug 随正文隐藏），
       按序列对齐跳到源码第 nth 个该级标题；
     - 阅读态：此前走原生锚点（首次定位受估算高度影响不准），改走 stableScrollTo。 */
  const tocJumpList = document.getElementById('doc-toc-list');
  if (tocJumpList) {
    tocJumpList.addEventListener(
      'click',
      (e) => {
        const a = (e.target as HTMLElement | null)?.closest<HTMLAnchorElement>('a[data-doc-anchor]');
        if (!a) return;
        e.preventDefault();
        const href = a.getAttribute('href') ?? '';
        if (document.getElementById('doc-3col')?.getAttribute('data-editing') === 'true') {
          const level = Number(a.className.match(/toc-l(\d)/)?.[1] ?? 2);
          // 序列对齐主键：目录里同 level 的第 nth 项 ↔ 源码里第 nth 个该级标题（免 slug 匹配）
          const same = tocJumpList.querySelectorAll(`a.toc-l${level}`);
          const nth = Array.prototype.indexOf.call(same, a);
          if (nth >= 0) window.__docInlineEditor?.jumpToHeading?.(level, nth);
          return;
        }
        // 阅读态：稳定定位到锚点标题 + 更新地址栏 hash（pushState 不触发二次滚动）
        const slug = decodeURIComponent(href.replace(/^#/, ''));
        const target = slug ? document.getElementById(slug) : null;
        if (!target) return;
        stableScrollTo(target);
        try {
          window.history.pushState(null, '', href);
        } catch {
          /* 特殊环境（沙箱预览等）下忽略地址栏更新 */
        }
      },
      true,
    );
  }

  /* ================= 节点 CRUD（登录） ================= */
  if (IS_AUTHED) {
    /** 打开节点弹窗：mode=create|edit；parentId 为创建时的所在目录 */
    function openNodeDialog(opts: {
      mode: 'create' | 'edit';
      kind?: 'folder' | 'article';
      parentId?: string | null;
      nodeId?: string | null;
    }): void {
      const dlg = el<HTMLDialogElement>('doc-node-dialog');
      if (!dlg) return;
      const titleInput = el<HTMLInputElement>('doc-node-title');
      const kindSelect = el<HTMLSelectElement>('doc-node-kind');
      const parentSelect = el<HTMLSelectElement>('doc-node-parent');
      const contentArea = el<HTMLTextAreaElement>('doc-node-content');
      const previewBox = el('doc-node-preview');
      const status = el('doc-node-status');
      const contentWrap = el('doc-node-content-wrap');
      if (!titleInput || !kindSelect || !parentSelect) return;

      // 所在目录选项：根目录 + 所有目录
      parentSelect.innerHTML = '<option value="">册根级</option>' + readFolders().map((f) => `<option value="${f.id}">${escHtml(f.title)}</option>`).join('');

      status?.classList.add('hidden');
      if (previewBox) previewBox.innerHTML = '';
      if (opts.mode === 'edit' && opts.nodeId) {
        const meta = readNodes().find((n) => n.id === opts.nodeId);
        if (!meta) return;
        el<HTMLHeadingElement>('doc-node-dialog-title')!.textContent = meta.kind === 'folder' ? '编辑目录' : '编辑文章';
        titleInput.value = meta.title;
        kindSelect.value = meta.kind;
        kindSelect.disabled = true; // 类型不可改
        parentSelect.value = meta.parentId ?? '';
        // content 字段单独 fetch：首屏已不再注入 MDX 源码（B1），编辑时按需取单节点
        if (contentArea) contentArea.value = '';
        if (contentWrap) contentWrap.classList.toggle('hidden', meta.kind === 'folder');
        dlg.dataset.editing = meta.id;
      } else {
        el<HTMLHeadingElement>('doc-node-dialog-title')!.textContent = opts.kind === 'folder' ? '新建目录' : '新建文章';
        titleInput.value = '';
        kindSelect.value = opts.kind ?? 'article';
        kindSelect.disabled = false;
        parentSelect.value = opts.parentId ?? '';
        if (contentArea) contentArea.value = '';
        if (contentWrap) contentWrap.classList.toggle('hidden', (opts.kind ?? 'article') === 'folder');
        delete dlg.dataset.editing;
      }
      dlg.showModal();
      titleInput.focus();
      // 编辑文章时异步拉取 content 填充 textarea（弹窗立刻显示，content 字段 ~200ms 后到位）
      if (opts.mode === 'edit' && opts.nodeId && contentArea && contentWrap && !contentWrap.classList.contains('hidden')) {
        const nodeId = opts.nodeId;
        fetch(`/api/doc/nodes/${nodeId}`)
          .then((r) => (r.ok ? r.json() : null))
          .then((d) => {
            const c = d?.node?.content;
            if (typeof c === 'string') contentArea.value = c;
          })
          .catch(() => { /* 网络失败时 textarea 保持空，用户感知 */ });
      }
    }

    // 打开弹窗：根级新建 / 目录内新建 / 编辑 / 移动
    document.addEventListener('click', (e) => {
      const t = e.target as HTMLElement;
      if (t.closest('#doc-add-root-folder')) return void openNodeDialog({ mode: 'create', kind: 'folder', parentId: null });
      if (t.closest('#doc-add-root-article')) return void openNodeDialog({ mode: 'create', kind: 'article', parentId: null });
      const addArt = t.closest<HTMLElement>('[data-node-add-article]');
      if (addArt) return void openNodeDialog({ mode: 'create', kind: 'article', parentId: addArt.dataset.nodeAddArticle ?? null });
      const addFolder = t.closest<HTMLElement>('[data-node-add-folder]');
      if (addFolder) return void openNodeDialog({ mode: 'create', kind: 'folder', parentId: addFolder.dataset.nodeAddFolder ?? null });
      const edit = t.closest<HTMLElement>('[data-node-edit]');
      if (edit) return void openNodeDialog({ mode: 'edit', nodeId: edit.dataset.nodeEdit ?? null });
      const move = t.closest<HTMLElement>('[data-node-move]');
      if (move) return void openNodeDialog({ mode: 'edit', nodeId: move.dataset.nodeMove ?? null });
      if (t.closest('#doc-node-cancel')) el<HTMLDialogElement>('doc-node-dialog')?.close();
    });

    // 类型切换：目录无正文
    el<HTMLSelectElement>('doc-node-kind')?.addEventListener('change', () => {
      const wrap = el('doc-node-content-wrap');
      if (wrap) wrap.classList.toggle('hidden', el<HTMLSelectElement>('doc-node-kind')?.value === 'folder');
    });

    // 预览：防并发/重复触发（AbortController + 序号守卫），按钮禁用避免双击
    let previewSeq = 0;
    let previewCtrl: AbortController | null = null;
    document.addEventListener('click', async (e) => {
      if (!(e.target as HTMLElement).closest('#doc-node-preview-btn')) return;
      const source = el<HTMLTextAreaElement>('doc-node-content')?.value ?? '';
      const preview = el('doc-node-preview');
      const btn = el<HTMLButtonElement>('doc-node-preview-btn');
      if (!preview) return;
      // 取消上一次未完成请求
      previewCtrl?.abort();
      const ctrl = new AbortController();
      previewCtrl = ctrl;
      const seq = ++previewSeq;
      if (btn) btn.disabled = true;
      preview.innerHTML = '<p class="text-xs text-muted-foreground">渲染中…</p>';
      try {
        const res = await fetch('/api/doc/preview', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ source }),
          signal: ctrl.signal,
        });
        const d = (await res.json().catch(() => ({}))) as { html?: string; error?: string };
        if (seq !== previewSeq) return; // 已被新请求覆盖
        preview.innerHTML = d.html ?? `<p class="text-destructive">${d.error ?? '渲染失败'}</p>`;
      } catch (err) {
        if (ctrl.signal.aborted) return; // 主动取消
        preview.innerHTML = '<p class="text-destructive">渲染失败</p>';
      } finally {
        if (btn && seq === previewSeq) btn.disabled = false;
      }
    });

    // 保存（创建 / 编辑 / 移动）
    document.addEventListener('click', async (e) => {
      if (!(e.target as HTMLElement).closest('#doc-node-confirm')) return;
      const dlg = el<HTMLDialogElement>('doc-node-dialog');
      const title = (el<HTMLInputElement>('doc-node-title')?.value ?? '').trim();
      const kind = el<HTMLSelectElement>('doc-node-kind')?.value === 'folder' ? 'folder' : 'article';
      const parentId = el<HTMLSelectElement>('doc-node-parent')?.value ?? '';
      const content = el<HTMLTextAreaElement>('doc-node-content')?.value ?? '';
      const status = el('doc-node-status');
      const editingId = dlg?.dataset.editing ?? null;
      if (!title) {
        if (status) { status.textContent = '请填写标题'; status.classList.remove('hidden'); }
        return;
      }
      if (kind === 'article' && !content.trim()) {
        if (status) { status.textContent = '文章正文不能为空'; status.classList.remove('hidden'); }
        return;
      }
      try {
        let saved: NodeMeta | null = null;
        if (editingId) {
          const res = await fetch(`/api/doc/nodes/${editingId}`, {
            method: 'PATCH',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify({ title, content, parentId: parentId || null }),
          });
          if (!res.ok) throw new Error('保存失败');
          saved = ((await res.json().catch(() => ({}))) as { node?: NodeMeta }).node ?? null;
        } else {
          const res = await fetch('/api/doc/nodes', {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify({ bundleId: readBundle().id, parentId: parentId || null, kind, title, content }),
          });
          if (!res.ok) throw new Error('创建失败');
          saved = ((await res.json().catch(() => ({}))) as { node?: NodeMeta }).node ?? null;
        }
        if (saved) {
          const node = saved;
          const list = readNodes();
          writeNodes(
            list.some((n) => n.id === node.id)
              ? patchNodes(list, [
                  {
                    id: node.id,
                    patch: { title: node.title, parentId: node.parentId, sort: node.sort, updatedAt: node.updatedAt },
                  },
                ])
              : [...list, node],
          );
          if (node.kind === 'article') {
            // 正文/标题已变：清掉该文章的渲染缓存；若正是当前文章，标题同步到 H1
            for (const k of [...ARTICLE_HTML_CACHE.keys()]) if (k.startsWith(`${node.id}:`)) ARTICLE_HTML_CACHE.delete(k);
            if (node.id === currentActiveId()) {
              const h1 = document.querySelector('main h1');
              if (h1) h1.textContent = node.title;
            }
          }
        }
        renderTree();
        refreshFolderOptions();
        el<HTMLDialogElement>('doc-node-dialog')?.close();
        // 原先没有任何文章、且刚新建的是文章 → 补上首篇
        // （原 reload 后 SSR 会默认选中第一篇，就地更新必须显式补这一步）
        if (!editingId && saved?.kind === 'article' && !currentActiveId()) {
          await loadArticleById(saved.id, 'message');
        }
      } catch (err) {
        if (status) { status.textContent = err instanceof Error ? err.message : '操作失败'; status.classList.remove('hidden'); }
      }
    });

    // 删除
    document.addEventListener('click', async (e) => {
      const del = (e.target as HTMLElement).closest<HTMLElement>('[data-node-del]');
      if (!del) return;
      const name = del.dataset.nodeName ?? '';
      const delId = del.dataset.nodeDel ?? '';
      if (!delId) return;
      if (!(await confirmDanger(`确定删除「${name}」？其下所有子目录与文章将一并删除。`))) return;
      const res = await fetch(`/api/doc/nodes/${delId}`, { method: 'DELETE' });
      if (!res.ok) return;
      // 就地移除（含全部子孙 —— 与服务端级联删除一致），并清掉被删文章的渲染缓存
      const doomed = collectSubtreeIds(readNodes(), delId);
      writeNodes(removeSubtree(readNodes(), delId));
      for (const k of [...ARTICLE_HTML_CACHE.keys()]) {
        if (doomed.includes(k.slice(0, k.indexOf(':')))) ARTICLE_HTML_CACHE.delete(k);
      }
      renderTree();
      refreshFolderOptions();
      // 当前文章被删 → 切到剩余第一篇（原 reload 后 SSR 同样回退到第一篇）
      if (doomed.includes(currentActiveId())) {
        const next = readNodes().find((n) => n.kind === 'article');
        // 整册已空：没有可保留的上下文，整页导航到 SSR 的「暂无文章」形态
        if (next) await loadArticleById(next.id, 'message');
        else window.location.href = `/doc/${readBundle().id}`;
      }
    });

    // 文档编辑（沿用旧接口）
    document.addEventListener('click', (e) => {
      // 关键守卫：只有点击 ✎（#doc-edit-bundle）才打开，避免盖住节点弹窗
      if (!(e.target as HTMLElement).closest('#doc-edit-bundle')) return;
      const dlg = el<HTMLDialogElement>('doc-edit-bundle-dialog');
      if (!dlg) return;
      if (el<HTMLInputElement>('doc-bundle-edit-name')) el<HTMLInputElement>('doc-bundle-edit-name')!.value = readBundle().name;
      if (el<HTMLInputElement>('doc-bundle-edit-icon')) el<HTMLInputElement>('doc-bundle-edit-icon')!.value = readBundle().icon ?? '';
      if (el<HTMLInputElement>('doc-bundle-edit-summary')) el<HTMLInputElement>('doc-bundle-edit-summary')!.value = readBundle().summary ?? '';
      el('doc-bundle-edit-status')?.classList.add('hidden');
      dlg.showModal();
    });
    // 取消
    document.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('#doc-bundle-edit-cancel')) {
        el<HTMLDialogElement>('doc-edit-bundle-dialog')?.close();
      }
    });
    // 保存
    document.addEventListener('click', async (e) => {
      if (!(e.target as HTMLElement).closest('#doc-bundle-edit-confirm')) return;
      const name = (el<HTMLInputElement>('doc-bundle-edit-name')?.value ?? '').trim();
      const icon = el<HTMLInputElement>('doc-bundle-edit-icon')?.value ?? '';
      const summary = el<HTMLInputElement>('doc-bundle-edit-summary')?.value ?? '';
      const status = el('doc-bundle-edit-status');
      if (!name) {
        if (status) { status.textContent = '请填写文档名'; status.classList.remove('hidden'); }
        return;
      }
      try {
        const res = await fetch(`/api/doc/bundles`, {
          method: 'PATCH',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ id: readBundle().id, name, icon, summary }),
        });
        if (!res.ok) throw new Error('保存失败');
        // 就地更新（原实现整页 reload）：面包屑 + 标签页标题 + 注入的 bundle 数据
        const oldName = readBundle().name;
        const d = document.getElementById('doc-detail-data');
        if (d) d.dataset.bundle = JSON.stringify({ ...readBundle(), name, icon, summary });
        const crumb = document.getElementById('doc-bundle-name');
        if (crumb) crumb.textContent = name;
        // 只替换前缀，保留 BaseLayout 追加的站点后缀（不同页面后缀可能不同）
        if (document.title.startsWith(oldName)) {
          document.title = name + document.title.slice(oldName.length);
        }
        el<HTMLDialogElement>('doc-edit-bundle-dialog')?.close();
      } catch (err) {
        if (status) { status.textContent = err instanceof Error ? err.message : '保存失败'; status.classList.remove('hidden'); }
      }
    });
  }
</script>
