---
/* ===== Props ===== */
/* （动态页无 Props） */

/* ===== Imports ===== */
import BaseLayout from '@/layouts/BaseLayout.astro';
import Timeline from '@/components/Timeline.astro';
import MomentCard from '@/components/moments/MomentCard.astro';
import { listMoments, getMomentTimeline, toMomentView, type MomentView } from '@/lib/moments';
import { getProfile } from '@/lib/profile';
import { canManage } from '@/lib/admin-auth';
import { countLikesByTargets } from '@/lib/likes';

/* ===== Logic ===== */
const PAGE_SIZE = 20;
/** 管理员视角（站主或持有 moments 权限）：列表与时间线包含私密动态（普通访客仅见公开） */
const isAuthed = await canManage(Astro.cookies, 'moments');
const rawMoments = await listMoments(PAGE_SIZE, 0, { includePrivate: isAuthed });
/** 服务端渲染 Markdown → contentHtml（首屏与 load-more 同一管线） */
const moments: MomentView[] = await Promise.all(rawMoments.map((m) => toMomentView(m)));
const momentTimeline = await getMomentTimeline(isAuthed);
const profile = await getProfile();
const now = new Date();
const avatarSrc = profile.avatar || '';
const nickname = profile.nickname || '博主';
/** 各动态点赞数（批量查询一次，防按钮初始闪烁） */
const likeMap = await countLikesByTargets('moment', moments.map((m) => m.id));
---
<!-- ===== Template ===== -->
<BaseLayout title="动态" description="随手记录，分享生活 —— My Blog Moments">
  <section class="mx-auto w-full max-w-6xl px-4 py-10">
    <div class="grid gap-10 lg:grid-cols-[minmax(0,1fr)_190px]">
    <!-- 主面板：与背景相融（无盒），用像素分割线分区 -->
    <div class="p-4 sm:p-6">
      <!-- 头部 -->
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div>
          <p class="font-pixel text-[0.6rem] uppercase tracking-[0.2em] text-primary">MOMENTS</p>
          <h1 class="mt-1 font-display text-3xl font-semibold tracking-tight">动态</h1>
          <p class="mt-1 text-sm text-muted-foreground">随手记录，分享生活</p>
        </div>
        <div class="flex items-center gap-3">
          {avatarSrc ? (
            <img src={avatarSrc} alt={nickname} decoding="async" class="size-10 rounded-full border border-border object-cover" />
          ) : (
            <span class="inline-flex size-10 items-center justify-center rounded-full border border-border bg-muted font-display text-lg font-semibold text-primary">
              {nickname.slice(0, 1)}
            </span>
          )}
          <span class="text-sm font-medium">{nickname}</span>
        </div>
      </div>
      <div class="pixel-divider mt-5" />

      <!-- 发布框（管理员） -->
      {
        isAuthed && (
          <div class="mt-6">
            <textarea
              id="moment-content"
              rows="3"
              maxlength="2000"
              placeholder="记录点什么…（支持 Markdown / 文字 + 图片/GIF + 视频链接）"
              class="w-full resize-y rounded-md border border-input bg-background px-3 py-2 text-sm text-foreground outline-none transition-colors placeholder:text-muted-foreground focus-visible:border-ring"
            />
            <div id="moment-content-preview" class="prose mt-2 hidden max-h-64 overflow-y-auto rounded-md border border-border bg-background/50 px-3 py-2 text-sm"></div>
            <input
              id="moment-tags-input"
              type="text"
              maxlength="200"
              placeholder="标签（逗号分隔，最多 10 个，如：日常,学习,旅行）"
              class="mt-2 w-full rounded-md border border-input bg-background px-3 py-1.5 text-sm text-foreground outline-none transition-colors placeholder:text-muted-foreground focus-visible:border-ring"
            />
            <div id="moment-media-preview" class="mt-2 grid grid-cols-4 gap-2"></div>
            <div class="mt-3 flex flex-wrap items-center gap-2">
              <input id="moment-file" type="file" accept="image/*" multiple class="hidden" />
              <button id="moment-preview-toggle" type="button" class="hidden rounded-md border border-border px-3 py-1.5 text-xs text-muted-foreground transition-colors hover:border-primary/50 hover:text-primary">
                预览
              </button>
              <button id="moment-upload" type="button" class="rounded-md border border-border px-3 py-1.5 text-xs transition-colors hover:border-primary hover:text-primary">
                图片 / GIF
              </button>
              <input
                id="moment-video-url"
                type="url"
                placeholder="视频链接（B站/YouTube/直链 mp4）"
                class="min-w-0 flex-1 rounded-md border border-input bg-background px-3 py-1.5 text-xs text-foreground outline-none placeholder:text-muted-foreground focus-visible:border-ring"
              />
              <button id="moment-video-add" type="button" class="rounded-md border border-border px-3 py-1.5 text-xs transition-colors hover:border-primary hover:text-primary">
                添加视频
              </button>
              <label class="ml-auto flex items-center gap-1 text-xs text-muted-foreground">
                <span class="sr-only">可见性</span>
                <select
                  id="moment-visibility"
                  class="rounded-md border border-input bg-background px-2 py-1.5 text-xs text-foreground outline-none transition-colors focus-visible:border-ring"
                  aria-label="动态可见性"
                >
                  <option value="public">公开发布</option>
                  <option value="private">私密发布（仅自己可见）</option>
                </select>
              </label>
              <button
                id="moment-publish"
                type="button"
                class="rounded-md bg-primary px-4 py-1.5 text-sm text-primary-foreground transition-opacity hover:opacity-90"
              >
                发布
              </button>
            </div>
            <p id="moment-upload-status" class="mt-1 hidden text-xs text-primary" role="status"></p>
            <p id="moment-status" class="mt-2 text-xs text-destructive"></p>
          </div>
        )
      }

      <!-- 搜索 + 标签筛选 -->
      <div class="mt-6">
        <div class="flex items-center gap-2 border-b border-border pb-2">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-4 shrink-0 text-muted-foreground" aria-hidden="true">
            <circle cx="11" cy="11" r="7" />
            <path d="m21 21-4.35-4.35" />
          </svg>
          <input
            id="moment-search"
            type="search"
            placeholder="搜索动态内容 / 标签…"
            autocomplete="off"
            class="w-full bg-transparent text-sm outline-none placeholder:text-muted-foreground"
            aria-label="搜索动态"
          />
          <span id="moment-filter-state" class="shrink-0 text-xs text-muted-foreground"></span>
        </div>
        <div id="moment-tags" class="mt-2 flex flex-wrap gap-1.5"></div>
      </div>

      <!-- 动态流 -->
      <div id="moment-stream" class="mt-4 space-y-4" data-offset={moments.length} data-authed={isAuthed ? '1' : '0'}>
        {
          moments.length === 0 ? (
            <div class="py-10 text-center">
              <p class="font-display text-lg font-semibold">还没有动态</p>
              <p class="mt-2 text-sm text-muted-foreground">{isAuthed ? '在上面记录第一条吧。' : '博主还没有发布动态。'}</p>
            </div>
          ) : (
            moments.map((m) => (
              <MomentCard m={m} avatarSrc={avatarSrc} nickname={nickname} isAuthed={isAuthed} now={now} likeCount={likeMap[m.id] ?? 0} />
            ))
          )
        }
      </div>

      <!-- 加载更多 -->
      <div id="moment-sentinel" aria-hidden="true" class="h-px" />
      <div id="moment-more-wrap" class="mt-6 hidden text-center">
        <button id="moment-more" type="button" class="rounded-md border border-border px-6 py-2 text-sm text-muted-foreground transition-colors hover:border-primary hover:text-primary">
          更多
        </button>
      </div>
    </div>
    <!-- 右侧：动态时间线（按天定位） -->
    <aside class="hidden lg:block">
      <div class="sticky top-20">
        <p class="pixel-chip mb-2 text-muted-foreground">时间线 / TIMELINE</p>
        <Timeline items={momentTimeline.map((t) => ({ date: t.date, label: t.date, count: t.count }))} emptyText="暂无动态" />
      </div>
    </aside>
    </div>
  </section>

  <!-- 编辑动态弹窗 -->
  <dialog id="moment-edit-dialog" class="m-auto w-[min(92vw,40rem)] rounded-lg border border-border bg-card p-5 text-foreground shadow-xl backdrop:bg-black/40">
    <div class="flex items-center justify-between gap-2">
      <h3 class="font-medium">编辑动态</h3>
      <span class="text-xs text-muted-foreground">支持 Markdown（粗体、列表、链接、引用、代码…）</span>
    </div>
    <div class="mt-3 flex items-center justify-end gap-1">
      <button id="moment-edit-preview-btn" type="button" class="rounded-md border border-border px-3 py-1.5 text-xs text-muted-foreground transition-colors hover:border-primary/50 hover:text-primary">预览</button>
    </div>
    <div class="mt-2 grid gap-2 md:grid-cols-2">
      <textarea
        id="moment-edit-content"
        spellcheck="false"
        rows="3"
        maxlength="2000"
        placeholder="Markdown 正文…"
        class="h-48 w-full resize-y rounded-md border border-input bg-background px-3 py-2 font-mono text-sm leading-relaxed text-foreground outline-none placeholder:text-muted-foreground focus-visible:border-ring"
      ></textarea>
      <div id="moment-edit-preview" class="prose h-48 overflow-y-auto rounded-md border border-border bg-background/50 px-3 py-2 text-sm empty:border-dashed"></div>
    </div>
    <div class="mt-2 flex items-center justify-between gap-2 text-xs text-muted-foreground">
      <span>在正文输入框内 Ctrl+V 粘贴图片即可上传</span>
      <span id="moment-edit-upload-status" class="text-primary" role="status"></span>
    </div>
    <div id="moment-edit-media-preview" class="mt-2 grid grid-cols-4 gap-2"></div>
    <input id="moment-edit-tags" type="text" maxlength="200" placeholder="标签（逗号分隔）" class="mt-2 w-full rounded-md border border-input bg-background px-3 py-1.5 text-sm text-foreground outline-none placeholder:text-muted-foreground focus-visible:border-ring" />
    <div class="mt-2 flex items-center gap-2 text-xs text-muted-foreground">
      <label for="moment-edit-visibility">可见性</label>
      <select
        id="moment-edit-visibility"
        class="rounded-md border border-input bg-background px-2 py-1.5 text-xs text-foreground outline-none focus-visible:border-ring"
      >
        <option value="public">公开发布</option>
        <option value="private">私密发布（仅自己可见）</option>
      </select>
    </div>
    <p id="moment-edit-status" class="mt-2 hidden text-xs text-destructive" role="alert"></p>
    <div class="mt-3 flex justify-end gap-2">
      <button id="moment-edit-cancel" type="button" class="rounded-md px-3 py-1.5 text-sm text-muted-foreground hover:text-foreground">取消</button>
      <button id="moment-edit-save" type="button" class="rounded-md bg-primary px-4 py-1.5 text-sm text-primary-foreground hover:opacity-90">保存</button>
    </div>
  </dialog>
</BaseLayout>

<script>
  import { compressImageForUpload } from '../../lib/client-image-upload';
  import { confirmDanger } from '@/lib/confirm';
  import { on } from '@/lib/dom';
  /** 动态页交互：发布（图片/GIF 上传 + 视频链接）、加载更多、删除（管理员） */

  const PAGE_SIZE = 20;
  let offset = 0;
  let loading = false;
  let done = false;
  /** 当前筛选：关键词 / 标签 / 日期（以 URL 查询参数为唯一事实源，可分享、可还原） */
  const filter = { q: '', tag: '', date: '' };

  /** 从 URL 同步筛选状态（首次进入 / SPA 重入时以 URL 为准） */
  function syncFilterFromUrl(): void {
    const sp = new URLSearchParams(window.location.search);
    filter.q = (sp.get('q') ?? '').trim();
    filter.tag = (sp.get('tag') ?? '').trim();
    filter.date = (sp.get('date') ?? '').trim();
    const si = el<HTMLInputElement>('moment-search');
    if (si) si.value = filter.q;
  }

  /** 把当前筛选写回 URL（replaceState 不触发导航；保证筛选状态可分享、刷新后可还原） */
  function syncUrl(): void {
    const sp = new URLSearchParams();
    if (filter.tag) sp.set('tag', filter.tag);
    if (filter.date) sp.set('date', filter.date);
    if (filter.q) sp.set('q', filter.q);
    const qs = sp.toString();
    window.history.replaceState(null, '', qs ? `${window.location.pathname}?${qs}` : window.location.pathname);
  }

  function el<T extends HTMLElement>(id: string): T | null {
    return document.getElementById(id) as T | null;
  }

  function esc(value: string): string {
    return String(value).replace(/[&<>"']/g, (c) => {
      const map: Record<string, string> = { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' };
      return map[c] ?? c;
    });
  }

  /** 是否管理员（决定发布框/编辑框预览是否可用；SSR 仅在 isAuthed 时渲染这些框） */
  const IS_AUTHED = document.getElementById('moment-stream')?.dataset.authed === '1';

  /** Markdown → HTML 预览：请求服务端同一渲染管线，保证预览 == 实际卡片渲染 */
  async function renderPreview(source: string, previewEl: HTMLElement | null): Promise<void> {
    if (!previewEl) return;
    try {
      const res = await fetch('/api/moments/preview', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ source }),
      });
      const d = (await res.json().catch(() => ({}))) as { html?: string; error?: string };
      previewEl.innerHTML = d.html ?? `<p class="text-destructive">${esc(d.error ?? '渲染失败')}</p>`;
    } catch {
      previewEl.innerHTML = '<p class="text-destructive">渲染失败</p>';
    }
  }

  /** 简易防抖（预览输入实时刷新用） */
  function debounce(fn: () => void, wait = 400): () => void {
    let t = 0;
    return () => {
      window.clearTimeout(t);
      t = window.setTimeout(fn, wait);
    };
  }

  // ---------- 发布 ----------
  interface PendingMedia {
    type: 'image' | 'gif' | 'video';
    url: string;
  }
  const pendingMedia: PendingMedia[] = [];

  /** 媒体缩略图网格渲染（发布框 / 编辑弹窗共用；× 删除 operate 操作 list） */
  function renderMediaInto(box: HTMLElement | null, list: PendingMedia[]): void {
    if (!box) return;
    box.innerHTML = '';
    list.forEach((m) => {
      const d = document.createElement('div');
      d.className = 'relative aspect-square overflow-hidden rounded-md border border-border';
      if (m.type === 'video') {
        d.innerHTML = `<span class="absolute inset-0 flex items-center justify-center bg-muted text-[0.6rem] text-muted-foreground">视频</span>`;
      } else {
        d.innerHTML = `<img src="${esc(m.url)}" class="h-full w-full object-cover" alt="">`;
      }
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'absolute right-0.5 top-0.5 flex size-5 items-center justify-center rounded-full bg-black/60 text-xs text-white';
      btn.textContent = '×';
      btn.addEventListener('click', () => {
        const i = list.indexOf(m);
        if (i >= 0) list.splice(i, 1);
        renderMediaInto(box, list);
      });
      d.appendChild(btn);
      box.appendChild(d);
    });
  }

  function renderPending(): void {
    renderMediaInto(el('moment-media-preview'), pendingMedia);
  }

  /** 压缩图片（宽 ≤1600，JPEG）；GIF 保持原样 */
  async function prepareImage(file: File): Promise<{ base64: string; mime: string }> {
    return compressImageForUpload(file, { maxDimension: 1600 });
  }

  async function uploadFile(file: File): Promise<string> {
    const { base64, mime } = await prepareImage(file);
    const res = await fetch('/api/images', {
      method: 'POST',
      headers: { 'content-type': 'application/json' },
      body: JSON.stringify({ filename: file.name, mime, data: base64 }),
    });
    if (!res.ok) throw new Error('上传失败');
    const out = (await res.json()) as { url?: string; error?: string };
    if (!out.url) throw new Error(out.error ?? '上传失败');
    return out.url;
  }

  async function publish(): Promise<void> {
    const status = el('moment-status');
    const content = (el<HTMLTextAreaElement>('moment-content')?.value ?? '').trim();
    if (content === '' && pendingMedia.length === 0) {
      if (status) status.textContent = '写点什么，或添加媒体';
      return;
    }
    const btn = el<HTMLButtonElement>('moment-publish');
    // 粘贴图片上传中拦截发布
    const upStatus = el('moment-upload-status');
    if (upStatus && !upStatus.classList.contains('hidden')) {
      if (status) status.textContent = '图片还在上传中，请稍候再发布';
      return;
    }
    if (btn) {
      btn.disabled = true;
      btn.textContent = '发布中…';
    }
    try {
      const tagsRaw = (el<HTMLInputElement>('moment-tags-input')?.value ?? '').trim();
      const tags = tagsRaw.split(/[,，]/).map((t) => t.trim()).filter(Boolean);
      const visibility = el<HTMLSelectElement>('moment-visibility')?.value === 'private' ? 'private' : 'public';
      const res = await fetch('/api/moments', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ content, media: pendingMedia, tags, visibility }),
      });
      const data = (await res.json()) as { error?: string };
      if (!res.ok) throw new Error(data.error ?? '发布失败');
      window.location.reload();
    } catch (err) {
      if (status) status.textContent = err instanceof Error ? err.message : '发布失败';
      if (btn) {
        btn.disabled = false;
        btn.textContent = '发布';
      }
    }
  }

  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    if (target.closest('#moment-upload')) {
      (el<HTMLInputElement>('moment-file'))?.click();
      return;
    }
    if (target.closest('#moment-video-add')) {
      const input = el<HTMLInputElement>('moment-video-url');
      const url = (input?.value ?? '').trim();
      if (!/^https?:\/\/\S+$/.test(url)) {
        if (el('moment-status')) el('moment-status')!.textContent = '请输入合法的视频链接';
        return;
      }
      pendingMedia.push({ type: 'video', url });
      if (input) input.value = '';
      renderPending();
      return;
    }
    if (target.closest('#moment-publish')) {
      void publish();
    }
  });

  document.addEventListener('change', (e) => {
    const input = e.target as HTMLInputElement;
    if (input.id !== 'moment-file') return;
    const files = Array.from(input.files ?? []);
    input.value = '';
    void (async () => {
      for (const f of files) {
        try {
          const url = await uploadFile(f);
          pendingMedia.push({ type: f.type === 'image/gif' ? 'gif' : 'image', url });
        } catch (err) {
          if (el('moment-status')) el('moment-status')!.textContent = err instanceof Error ? err.message : '上传失败';
        }
        renderPending();
      }
    })();
  });

  // ---------- 发布框：Markdown 实时预览（管理员） ----------
  let publishPreviewOn = false;
  const pubToggle = el<HTMLButtonElement>('moment-preview-toggle');
  const pubBox = el('moment-content-preview');
  if (IS_AUTHED && pubToggle) pubToggle.classList.remove('hidden');
  const pubPreviewSoon = debounce(() => {
    if (!publishPreviewOn) return;
    void renderPreview(el<HTMLTextAreaElement>('moment-content')?.value ?? '', pubBox);
  });
  document.addEventListener('input', (e) => {
    const t = e.target as HTMLElement;
    if (t.id === 'moment-content') pubPreviewSoon();
  });
  document.addEventListener('click', (e) => {
    if (!(e.target as HTMLElement).closest('#moment-preview-toggle')) return;
    publishPreviewOn = !publishPreviewOn;
    if (pubToggle) pubToggle.textContent = publishPreviewOn ? '收起预览' : '预览';
    if (pubBox) pubBox.classList.toggle('hidden', !publishPreviewOn);
    if (publishPreviewOn) void renderPreview(el<HTMLTextAreaElement>('moment-content')?.value ?? '', pubBox);
  });

  // 初始 offset（服务端注入）；筛选状态以 URL 为准；SPA 切换后 DOM 换新，需在 page-load 重新同步
  function syncPagination(): void {
    offset = Number(el('moment-stream')?.dataset.offset ?? 0);
    done = offset < PAGE_SIZE;
  }
  document.addEventListener('astro:page-load', () => {
    // SPA 重入：以新页面 URL 为准恢复筛选/搜索状态，并按新 DOM 重渲染 chips 与分页
    syncFilterFromUrl();
    syncPagination();
    renderTagChips();
    renderFilterState();
  });
  syncFilterFromUrl();
  syncPagination();

  // ---------- 加载更多 / 删除 ----------
  /**
   * 拉取下一页完整卡片 HTML（/moments/cards partial）。
   *
   * 卡片一律由服务端 MomentCard.astro 渲染（与首屏同一模板），客户端不再手拼
   * cardHtml——旧实现缺头像/姓名/时间/编辑删除按钮/评论岛，且 Astro 岛无法通过
   * innerHTML 手工构造。partial 片段里的 <astro-island> 插入 DOM 后会正常水合。
   */
  async function loadMore(): Promise<void> {
    if (loading || done) return;
    loading = true;
    const btn = el<HTMLButtonElement>('moment-more');
    if (btn) btn.textContent = '加载中…';
    try {
      const params = new URLSearchParams({ limit: String(PAGE_SIZE), offset: String(offset) });
      if (filter.q) params.set('q', filter.q);
      if (filter.tag) params.set('tag', filter.tag);
      if (filter.date) params.set('date', filter.date);
      const res = await fetch(`/moments/cards?${params}`);
      if (!res.ok) throw new Error('bad status');
      const html = await res.text();
      const tpl = document.createElement('template');
      tpl.innerHTML = html;
      const cards = tpl.content.querySelectorAll('.moment-card').length;
      const stream = el('moment-stream');
      if (stream) stream.appendChild(tpl.content);
      offset += cards;
      done = cards < PAGE_SIZE;
      if (done) el('moment-more-wrap')?.classList.add('hidden');
      if (cards === 0 && stream && stream.children.length === 0) {
        // 筛选后无结果 → 客户端空态
        stream.innerHTML =
          '<div class="py-10 text-center"><p class="font-display text-lg font-semibold">没有符合条件的动态</p><p class="mt-2 text-sm text-muted-foreground">换个关键词或清除筛选试试。</p></div>';
      }
      renderTagChips();
    } catch {
      if (btn) btn.textContent = '加载失败，点击重试';
    } finally {
      loading = false;
      if (btn && btn.textContent === '加载中…') btn.textContent = '更多';
    }
  }

  // ---------- 搜索 / 标签 / 时间线筛选 ----------
  /** 从 DOM 收集所有标签并渲染筛选 chips */
  function renderTagChips(): void {
    const box = el('moment-tags');
    if (!box) return;
    const set = new Set<string>();
    document.querySelectorAll<HTMLElement>('[data-moment-tag]').forEach((b) => {
      const t = b.dataset.momentTag ?? '';
      if (t) set.add(t);
    });
    box.innerHTML = '';
    set.forEach((t) => {
      const chip = document.createElement('button');
      chip.type = 'button';
      chip.dataset.filterTag = t;
      chip.className =
        'rounded px-1.5 py-0.5 text-[0.65rem] transition-colors ' +
        (filter.tag === t
          ? 'bg-primary text-primary-foreground'
          : 'bg-muted text-muted-foreground hover:bg-accent hover:text-primary');
      chip.textContent = `# ${t}`;
      box.appendChild(chip);
    });
  }

  /** 重置列表并按当前筛选重新加载第一页（筛选状态已由调用方写入 URL） */
  async function reload(): Promise<void> {
    const stream = el('moment-stream');
    if (stream) stream.innerHTML = '';
    offset = 0;
    done = false;
    el('moment-more-wrap')?.classList.remove('hidden');
    renderFilterState();
    renderTagChips();
    await loadMore();
  }

  /** 顶部筛选状态文案（当前 tag/date/q） */
  function renderFilterState(): void {
    const s = el('moment-filter-state');
    if (!s) return;
    const parts: string[] = [];
    if (filter.tag) parts.push(`#${filter.tag}`);
    if (filter.date) parts.push(filter.date);
    if (filter.q) parts.push(`"${filter.q}"`);
    if (parts.length === 0) {
      s.textContent = '';
      return;
    }
    s.innerHTML = `${parts.map(esc).join(' · ')} <button type="button" data-filter-clear class="ml-1 text-primary hover:underline">✕ 清除</button>`;
  }

  // 搜索输入（防抖）
  let searchTimer = 0;
  document.addEventListener('input', (e) => {
    const input = e.target as HTMLInputElement;
    if (input.id !== 'moment-search') return;
    window.clearTimeout(searchTimer);
    searchTimer = window.setTimeout(() => {
      filter.q = input.value.trim();
      syncUrl();
      void reload();
    }, 250);
  });

  // 标签 / 时间线 / 清除筛选（document 委托）——每次变更同步 URL，清除即还原初始状态
  document.addEventListener('click', (e) => {
    const tagBtn = (e.target as HTMLElement).closest<HTMLElement>('[data-filter-tag]');
    if (tagBtn) {
      filter.tag = filter.tag === tagBtn.dataset.filterTag ? '' : (tagBtn.dataset.filterTag ?? '');
      syncUrl();
      void reload();
      return;
    }
    const momentTag = (e.target as HTMLElement).closest<HTMLElement>('[data-moment-tag]');
    if (momentTag) {
      filter.tag = filter.tag === momentTag.dataset.momentTag ? '' : (momentTag.dataset.momentTag ?? '');
      syncUrl();
      void reload();
      return;
    }
    const tl = (e.target as HTMLElement).closest<HTMLElement>('[data-timeline-date]');
    if (tl) {
      const date = tl.dataset.timelineDate ?? '';
      filter.date = filter.date === date ? '' : date;
      syncUrl();
      void reload();
      return;
    }
    const clear = (e.target as HTMLElement).closest<HTMLElement>('[data-filter-clear]');
    if (clear) {
      filter.q = '';
      filter.tag = '';
      filter.date = '';
      const input = el<HTMLInputElement>('moment-search');
      if (input) input.value = '';
      syncUrl();
      void reload();
    }
  });

  // 初始：渲染标签 chips 与筛选状态
  renderTagChips();
  renderFilterState();

  // 删除动态（document 委托）
  document.addEventListener('click', async (e) => {
    const del = (e.target as HTMLElement).closest<HTMLElement>('[data-moment-del]');
    if (!del) return;
    if (!(await confirmDanger('确定删除这条动态？'))) return;
    await fetch(`/api/moments/${del.dataset.momentDel}`, { method: 'DELETE' });
    del.closest<HTMLElement>('.moment-card')?.remove();
  });

  // 底部哨兵 → 显示「更多」
  const sentinel = el('moment-sentinel');
  if (sentinel) {
    const observer = new IntersectionObserver(
      (entries) => {
        if (entries.some((entry) => entry.isIntersecting) && !done) {
          el('moment-more-wrap')?.classList.remove('hidden');
        }
      },
      { rootMargin: '300px' },
    );
    observer.observe(sentinel);
  }
  on('moment-more', 'click', () => void loadMore());

  // ---------- 编辑动态（管理员）----------
  let editingMomentId = '';
  /** 编辑弹窗中的媒体（打开时从动态回显；粘贴上传/×删除维护；保存随 PATCH 提交） */
  const editMedia: PendingMedia[] = [];
  function renderEditMedia(): void {
    renderMediaInto(el('moment-edit-media-preview'), editMedia);
  }
  document.addEventListener('click', (e) => {
    const editBtn = (e.target as HTMLElement).closest<HTMLElement>('[data-moment-edit]');
    if (editBtn) {
      editingMomentId = editBtn.dataset.momentEdit ?? '';
      fetch(`/api/moments/${editingMomentId}`)
        .then((r) => r.json())
        .then((d: { moment?: { content: string; media?: PendingMedia[]; tags: string[]; visibility?: 'public' | 'private' } }) => {
          if (!d.moment) return;
          const c = el<HTMLTextAreaElement>('moment-edit-content');
          const tg = el<HTMLInputElement>('moment-edit-tags');
          const vis = el<HTMLSelectElement>('moment-edit-visibility');
          if (c) c.value = d.moment.content;
          if (tg) tg.value = (d.moment.tags ?? []).join(', ');
          if (vis) vis.value = d.moment.visibility === 'private' ? 'private' : 'public';
          // 媒体回显（已有图片/视频可在编辑中删除，或继续粘贴新增）
          editMedia.length = 0;
          (d.moment.media ?? []).forEach((m) => editMedia.push(m));
          renderEditMedia();
          const up = el('moment-edit-upload-status');
          if (up) up.textContent = '';
          // 重置预览状态
          editPreviewOn = false;
          const pv = el('moment-edit-preview');
          if (pv) pv.innerHTML = '';
          const pvBtn = el<HTMLButtonElement>('moment-edit-preview-btn');
          if (pvBtn) pvBtn.textContent = '预览';
          el('moment-edit-status')?.classList.add('hidden');
          el<HTMLDialogElement>('moment-edit-dialog')?.showModal();
        });
      return;
    }
    if ((e.target as HTMLElement).closest('#moment-edit-cancel')) {
      el<HTMLDialogElement>('moment-edit-dialog')?.close();
    }
  });

  /** 发布正文框：Ctrl+V 粘贴图片 → 自动上传 → 缩略图展示 */
  document.addEventListener('paste', (e) => {
    const t = e.target as HTMLElement;
    // 发布框与编辑框分别响应；非图片内容走默认文本粘贴（仅在图片命中时拦截）
    const isPublish = t.id === 'moment-content' || !!t.closest('#moment-content');
    if (!isPublish) return;
    const imgs = Array.from(e.clipboardData?.items ?? []).filter((it) => it.type.startsWith('image/'));
    if (imgs.length === 0) return;
    e.preventDefault();
    void (async () => {
      const up = el('moment-upload-status');
      const publishBtn = el<HTMLButtonElement>('moment-publish');
      if (publishBtn) publishBtn.disabled = true;
      let count = 0;
      try {
        for (const it of imgs) {
          const file = it.getAsFile();
          if (!file) continue;
          if (up) {
            up.classList.remove('hidden');
            up.textContent = `图片上传中… (${count + 1}/${imgs.length})`;
          }
          try {
            const url = await uploadFile(file);
            pendingMedia.push({ type: file.type === 'image/gif' ? 'gif' : 'image', url });
            count++;
          } catch (err) {
            if (up) up.textContent = err instanceof Error ? err.message : '图片上传失败，请重试';
          }
        }
        renderPending();
        if (up) {
          up.textContent = count > 0 ? `✓ 已添加 ${count} 张` : '上传失败';
          window.setTimeout(() => { up.classList.add('hidden'); up.textContent = ''; }, 2000);
        }
      } finally {
        if (publishBtn) publishBtn.disabled = false;
      }
    })();
  });

  /** 编辑正文框：Ctrl+V 粘贴图片 → 自动上传 → 缩略图展示 */
  document.addEventListener('paste', (e) => {
    const t = e.target as HTMLElement;
    if (t.id !== 'moment-edit-content') return;
    const imgs = Array.from(e.clipboardData?.items ?? []).filter((it) => it.type.startsWith('image/'));
    if (imgs.length === 0) return; // 非图片内容：走默认文本粘贴
    e.preventDefault();
    void (async () => {
      const up = el('moment-edit-upload-status');
      for (const it of imgs) {
        const file = it.getAsFile();
        if (!file) continue;
        if (up) up.textContent = '图片上传中…';
        try {
          const url = await uploadFile(file);
          editMedia.push({ type: file.type === 'image/gif' ? 'gif' : 'image', url });
          if (up) up.textContent = '';
        } catch (err) {
          if (up) up.textContent = err instanceof Error ? err.message : '图片上传失败，请重试';
        }
        renderEditMedia();
      }
    })();
  });

  on('moment-edit-save', 'click', async () => {
    const content = (el<HTMLTextAreaElement>('moment-edit-content')?.value ?? '').trim();
    const tagsRaw = (el<HTMLInputElement>('moment-edit-tags')?.value ?? '').trim();
    const tags = tagsRaw.split(/[,，]/).map((t) => t.trim()).filter(Boolean);
    const visibility = el<HTMLSelectElement>('moment-edit-visibility')?.value === 'private' ? 'private' : 'public';
    const status = el('moment-edit-status');
    const up = el('moment-edit-upload-status');
    if (up && up.textContent) {
      if (status) { status.textContent = '图片还在上传中，请稍候再保存'; status.classList.remove('hidden'); }
      return;
    }
    try {
      const res = await fetch(`/api/moments/${editingMomentId}`, {
        method: 'PATCH',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ content, media: editMedia, tags, visibility }),
      });
      if (!res.ok) throw new Error('保存失败');
      window.location.reload();
    } catch (err) {
      if (status) { status.textContent = err instanceof Error ? err.message : '保存失败'; status.classList.remove('hidden'); }
    }
  });

  // ---------- 编辑弹窗：Markdown 实时预览（管理员） ----------
  let editPreviewOn = false;
  const editPreviewSoon = debounce(() => {
    if (!editPreviewOn) return;
    void renderPreview(el<HTMLTextAreaElement>('moment-edit-content')?.value ?? '', el('moment-edit-preview'));
  });
  document.addEventListener('click', (e) => {
    if (!(e.target as HTMLElement).closest('#moment-edit-preview-btn')) return;
    editPreviewOn = !editPreviewOn;
    const pvBtn = el<HTMLButtonElement>('moment-edit-preview-btn');
    if (pvBtn) pvBtn.textContent = editPreviewOn ? '收起预览' : '预览';
    if (editPreviewOn) void renderPreview(el<HTMLTextAreaElement>('moment-edit-content')?.value ?? '', el('moment-edit-preview'));
  });
  document.addEventListener('input', (e) => {
    const t = e.target as HTMLElement;
    if (t.id === 'moment-edit-content') editPreviewSoon();
  });
</script>
