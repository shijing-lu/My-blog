---
/* ===== Props ===== */
/* （相册主页无 Props） */

/* ===== Imports ===== */
import BaseLayout from '@/layouts/BaseLayout.astro';
import { countPhotos, getTimeline, listPhotos } from '@/lib/photos';
import { verifyRequest } from '@/lib/auth';

/* ===== Logic ===== */
/** 每页照片数（与 /api/photos 默认一致） */
const PAGE_SIZE = 30;

const photos = await listPhotos(PAGE_SIZE, 0);
const total = await countPhotos();
const timeline = await getTimeline();
const isAuthed = verifyRequest(Astro.cookies);

/** 日期 → 本地时区 YYYY-MM-DD（与时间线聚合一致） */
function dateKey(date: Date): string {
  const y = date.getFullYear();
  const m = String(date.getMonth() + 1).padStart(2, '0');
  const d = String(date.getDate()).padStart(2, '0');
  return `${y}-${m}-${d}`;
}

/** 按日期分组（photos 已按 takenAt 倒序，组序与组内顺序均保持） */
interface PhotoGroup {
  date: string;
  photos: Array<(typeof photos)[number]>;
}
const groups: PhotoGroup[] = [];
const groupMap = new Map<string, PhotoGroup>();
photos.forEach((p) => {
  const key = dateKey(p.takenAt);
  let g = groupMap.get(key);
  if (!g) {
    g = { date: key, photos: [] };
    groupMap.set(key, g);
    groups.push(g);
  }
  g.photos.push(p);
});
---
<!-- ===== Template ===== -->
<BaseLayout title="影集" description="收集好看的、有意义的照片 —— My Blog Gallery">
  <section class="mx-auto w-full max-w-6xl px-4 py-10">
    <!-- 页头 -->
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <p class="font-pixel text-[0.6rem] uppercase tracking-[0.2em] text-primary">GALLERY</p>
        <h1 class="ghost-text mt-2 font-display text-3xl font-semibold tracking-tight sm:text-4xl">影集</h1>
        <p class="mt-2 text-sm text-muted-foreground">
          收集记录的好看与有意义的照片 —— 共 <span class="text-primary">{total}</span> 张。
        </p>
      </div>
      {
        isAuthed && (
          <a
            href="/gallery/upload"
            class="shrink-0 rounded-md bg-primary px-4 py-2 text-sm text-primary-foreground transition-opacity duration-200 hover:opacity-90"
          >
            + 上传照片
          </a>
        )
      }
    </div>
    <div class="pixel-divider mt-6" />

    <!-- 三栏：左侧留白 | 中间瀑布流 | 右侧时间线 -->
    <div class="mt-6 grid gap-6 lg:grid-cols-[190px_minmax(0,1fr)_170px]">
      <!-- 左侧：预留区 -->
      <aside class="hidden lg:block">
        <div class="sticky top-20 rounded-lg border bg-card p-4">
          <p class="pixel-chip mb-2 text-muted-foreground">SIDE</p>
          <p class="text-xs leading-relaxed text-muted-foreground">
            左侧区域预留 —— 未来可放随机照片 / 标签筛选 / 统计等。
          </p>
        </div>
      </aside>

      <!-- 中间：瀑布流 -->
      <div class="min-w-0">
        {
          photos.length === 0 ? (
            <div class="rounded-lg border bg-card p-10 text-center">
              <p class="font-display text-lg font-semibold">影集还是空的</p>
              <p class="mt-2 text-sm text-muted-foreground">
                {
                  isAuthed
                    ? '点击右上角「上传照片」开始收集第一张。'
                    : '管理员登录后可上传照片。'
                }
              </p>
            </div>
          ) : (
            <>
              <div id="gallery-groups" class="space-y-8" data-offset={photos.length} data-total={total}>
                {
                  groups.map((g) => (
                    <section class="gallery-group" data-date={g.date}>
                      <div class="gallery-date-divider">
                        <span class="gallery-date-label">{g.date}</span>
                        <span class="gallery-date-count">{g.photos.length} 张</span>
                      </div>
                      <div class="masonry mt-4 grid grid-cols-2 gap-0 sm:grid-cols-3">
                        {
                          g.photos.map((p) => (
                            <figure
                              class="photo-card group relative overflow-hidden bg-card"
                              data-date={dateKey(p.takenAt)}
                              data-photo-id={p.id}
                            >
                              <div
                                class="photo-wrap overflow-hidden"
                                style={p.width && p.height ? `aspect-ratio: ${p.width} / ${p.height}` : undefined}
                                data-lightbox
                                data-caption={p.title}
                              >
                                <img
                                  src={p.thumbUrl ?? p.url}
                                  alt={p.title}
                                  loading="lazy"
                                  decoding="async"
                                  class="block w-full cursor-zoom-in object-cover"
                                />
                              </div>
                              {
                                p.title && (
                                  <figcaption class="pointer-events-none absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/70 to-transparent px-3 pb-2 pt-8 text-xs text-white opacity-0 transition-opacity duration-200 group-hover:opacity-100">
                                    {p.title}
                                  </figcaption>
                                )
                              }
                            </figure>
                          ))
                        }
                      </div>
                    </section>
                  ))
                }
              </div>

              <!-- 加载更多：滚动到底显示按钮，点击加载 -->
              <div id="gallery-sentinel" aria-hidden="true" class="h-px" />
              <div id="gallery-more-wrap" class="mt-8 hidden text-center">
                <button
                  id="load-more"
                  type="button"
                  class="rounded-md border border-border px-6 py-2.5 text-sm text-muted-foreground transition-colors duration-200 hover:border-primary hover:text-primary"
                >
                  更多
                </button>
              </div>
            </>
          )
        }
      </div>

      <!-- 右侧：时间线（上最新下最旧） -->
      <aside class="hidden lg:block">
        <div class="sticky top-20 rounded-lg border bg-card p-4">
          <p class="pixel-chip mb-2 text-muted-foreground">时间线 / TIMELINE</p>
          {
            timeline.length === 0 ? (
              <p class="text-xs text-muted-foreground">暂无照片</p>
            ) : (
              <ul class="space-y-1.5">
                {
                  timeline.map((t) => (
                    <li>
                      <button
                        type="button"
                        data-timeline-date={t.date}
                        class="flex w-full items-center justify-between gap-2 rounded-md px-2 py-1 text-left text-xs text-muted-foreground transition-colors duration-200 hover:bg-accent hover:text-foreground"
                      >
                        <span class="font-pixel text-[0.65rem]">{t.date}</span>
                        <span class="shrink-0 rounded bg-muted px-1.5 text-[0.65rem]">{t.count}</span>
                      </button>
                    </li>
                  ))
                }
              </ul>
            )
          }
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>

<script>
  /** 相册交互：瀑布流列分配 / 加载更多 / 时间线定位（原生 JS，document 委托兼容 View Transitions） */
  const PAGE_SIZE = 30;
  /** 首屏已渲染照片数 / 总数（init 时从 #masonry 的 data-* 读取） */
  let offset = 0;
  let total = 0;
  let loading = false;
  let done = offset >= total;
  let observer: IntersectionObserver | null = null;

  function el<T extends HTMLElement>(id: string): T | null {
    return document.getElementById(id) as T | null;
  }

  function esc(value: string): string {
    return String(value).replace(/[&<>"']/g, (c) => {
      const map: Record<string, string> = { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' };
      return map[c] ?? c;
    });
  }

  /** 响应式列数：桌面一行三张，移动端两列 */
  function columnCount(): number {
    return window.innerWidth < 640 ? 2 : 3;
  }

  /** 构建照片卡片 HTML（与首屏渲染同构；无宽高时按图片自然比例，保持参差） */
  function cardHtml(p: {
    id: string;
    url: string;
    thumbUrl: string | null;
    title: string;
    width: number | null;
    height: number | null;
    takenAt: string;
  }): string {
    const date = p.takenAt.slice(0, 10);
    const ratioStyle = p.width && p.height ? `style="aspect-ratio: ${p.width} / ${p.height}"` : '';
    return `<figure class="photo-card group relative overflow-hidden bg-card" data-date="${esc(date)}" data-photo-id="${esc(p.id)}">
      <div class="photo-wrap overflow-hidden" ${ratioStyle} data-lightbox data-caption="${esc(p.title)}">
        <img src="${esc(p.thumbUrl ?? p.url)}" alt="${esc(p.title)}" loading="lazy" decoding="async" class="block w-full cursor-zoom-in object-cover" />
      </div>
      ${p.title ? `<figcaption class="pointer-events-none absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/70 to-transparent px-3 pb-2 pt-8 text-xs text-white opacity-0 transition-opacity duration-200 group-hover:opacity-100">${esc(p.title)}</figcaption>` : ''}
    </figure>`;
  }

  /** 确保 masonry 容器已建好瀑布流列（用 ready 标记，避免误判照片为列） */
  function ensureColumns(masonry: HTMLElement): void {
    if (masonry.dataset.ready === '1') return;
    const n = columnCount();
    for (let i = 0; i < n; i += 1) {
      const col = document.createElement('div');
      col.className = 'min-w-0 self-start';
      masonry.appendChild(col);
    }
    masonry.dataset.ready = '1';
  }

  /** 取 masonry 下真正的瀑布流列（过滤未分配的照片等非列子元素） */
  function columnsOf(masonry: HTMLElement): HTMLElement[] {
    return Array.from(masonry.children).filter(
      (el): el is HTMLElement => el instanceof HTMLElement && el.classList.contains('self-start'),
    );
  }

  /** 把 HTML 卡片追加到 masonry 的最短列 */
  function appendToShortestColumn(masonry: HTMLElement, html: string): void {
    ensureColumns(masonry);
    const columns = columnsOf(masonry);
    if (columns.length === 0) return;
    let min = 0;
    for (let i = 1; i < columns.length; i += 1) {
      if (columns[i]!.scrollHeight < columns[min]!.scrollHeight) min = i;
    }
    columns[min]!.insertAdjacentHTML('beforeend', html);
  }

  /** 把已有卡片节点移动到 masonry 的最短列 */
  function moveCardToShortestColumn(masonry: HTMLElement, card: HTMLElement): void {
    ensureColumns(masonry);
    const columns = columnsOf(masonry);
    if (columns.length === 0) return;
    let min = 0;
    for (let i = 1; i < columns.length; i += 1) {
      if (columns[i]!.scrollHeight < columns[min]!.scrollHeight) min = i;
    }
    columns[min]!.appendChild(card);
  }

  /** 按日期把照片插入对应分组（无则新建分组，更旧日期追加到末尾） */
  function insertPhoto(html: string, date: string): void {
    const container = el<HTMLElement>('gallery-groups');
    if (!container) return;
    let section = container.querySelector<HTMLElement>(`.gallery-group[data-date="${CSS.escape(date)}"]`);
    if (!section) {
      section = document.createElement('section');
      section.className = 'gallery-group';
      section.dataset.date = date;
      section.innerHTML = `<div class="gallery-date-divider"><span class="gallery-date-label">${esc(date)}</span><span class="gallery-date-count"></span></div><div class="masonry mt-4 grid grid-cols-2 gap-0 sm:grid-cols-3"></div>`;
      container.appendChild(section);
    }
    const masonry = section.querySelector<HTMLElement>('.masonry');
    if (!masonry) return;
    appendToShortestColumn(masonry, html);
    const count = section.querySelector('.gallery-date-count');
    if (count) count.textContent = `${masonry.querySelectorAll('.photo-card').length} 张`;
  }

  /** 刷新「更多」按钮状态 */
  function updateMore(): void {
    const wrap = el('gallery-more-wrap');
    if (!wrap) return;
    if (done) wrap.classList.add('hidden');
    else wrap.classList.remove('hidden');
  }

  /** 加载一页（返回是否有更多） */
  async function loadMore(): Promise<boolean> {
    if (loading || done) return !done;
    loading = true;
    const btn = el('load-more');
    if (btn) btn.textContent = '加载中…';
    try {
      const res = await fetch(`/api/photos?limit=${PAGE_SIZE}&offset=${offset}`);
      if (!res.ok) throw new Error('bad status');
      const data = (await res.json()) as {
        photos: Array<{
          id: string;
          url: string;
          thumbUrl: string | null;
          title: string;
          width: number | null;
          height: number | null;
          takenAt: string;
        }>;
        total: number;
      };
      data.photos.forEach((p) => insertPhoto(cardHtml(p), p.takenAt.slice(0, 10)));
      offset += data.photos.length;
      total = data.total;
      done = offset >= total;
      return !done;
    } catch {
      if (btn) btn.textContent = '加载失败，点击重试';
      return !done;
    } finally {
      loading = false;
      const btn2 = el('load-more');
      if (btn2 && btn2.textContent === '加载中…') btn2.textContent = '更多';
      updateMore();
    }
  }

  /** 时间线定位：已加载则滚动；未加载则逐页拉取直到找到或加载完 */
  async function locateDate(date: string): Promise<void> {
    let guard = 0;
    while (guard < 200) {
      const target = document.querySelector<HTMLElement>(`[data-date="${CSS.escape(date)}"]`);
      if (target) {
        target.scrollIntoView({ behavior: 'smooth', block: 'start' });
        return;
      }
      if (!(await loadMore())) return;
      guard += 1;
    }
  }

  /** 初始化瀑布流（每次页面加载 / View Transition 后调用） */
  function init(): void {
    const container = el<HTMLElement>('gallery-groups');
    if (!container) return; // 空相册：无分组容器
    // 状态重置（新页面 DOM，初始值来自 data-* 属性）
    offset = Number(container.dataset.offset ?? 0);
    total = Number(container.dataset.total ?? 0);
    loading = false;
    done = offset >= total;
    // 更多按钮初始隐藏：滚动到底部哨兵进入视口时才显示
    el('gallery-more-wrap')?.classList.add('hidden');
    // 首次：把服务端渲染的卡片分配到各组的列
    container.querySelectorAll<HTMLElement>('.masonry').forEach((masonry) => {
      if (masonry.dataset.ready === '1') return;
      const cards = Array.from(masonry.querySelectorAll<HTMLElement>('.photo-card'));
      if (cards.length === 0) return;
      ensureColumns(masonry); // 建列并标记 ready
      cards.forEach((c) => moveCardToShortestColumn(masonry, c));
    });
    // 重建底部哨兵观察器
    observer?.disconnect();
    const sentinel = el('gallery-sentinel');
    if (sentinel) {
      observer = new IntersectionObserver(
        (entries) => {
          if (entries.some((e) => e.isIntersecting) && !done) {
            el('gallery-more-wrap')?.classList.remove('hidden');
          }
        },
        { rootMargin: '300px' },
      );
      observer.observe(sentinel);
    }
  }

  // ---- document 级事件委托（只绑定一次） ----
  document.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLElement>('[data-timeline-date]');
    if (btn) {
      void locateDate(btn.dataset.timelineDate ?? '');
      return;
    }
    const more = (e.target as HTMLElement).closest<HTMLElement>('#load-more');
    if (more) void loadMore();
  });

  document.addEventListener('astro:page-load', init);
  init();
</script>
