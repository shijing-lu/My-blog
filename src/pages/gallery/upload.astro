---
/* ===== Props ===== */
/* （上传管理页无 Props，中间件保护） */

/* ===== Imports ===== */
import AdminLayout from '@/layouts/AdminLayout.astro';
import { listPhotosAlive } from '@/lib/photos';
import { photoStorageEnabled } from '@/lib/photo-storage';

/* ===== Logic ===== */
/** 管理列表最多展示数 */
const MANAGE_LIMIT = 200;
// 治本：过滤"DB 行存在但 R2 文件已删"的孤儿（详见 lib/photos.ts listPhotosAlive 注释）
const photos = await listPhotosAlive(MANAGE_LIMIT, 0);
const today = new Date();

/** 日期 → 本地时区 YYYY-MM-DD */
function dateKey(date: Date): string {
  const y = date.getFullYear();
  const m = String(date.getMonth() + 1).padStart(2, '0');
  const d = String(date.getDate()).padStart(2, '0');
  return `${y}-${m}-${d}`;
}
const todayStr = dateKey(today);
---
<!-- ===== Template ===== -->
<AdminLayout title="影集上传">
  <section class="mx-auto h-full w-full max-w-5xl space-y-6 overflow-y-auto px-4 py-8">
    <div>
      <p class="pixel-chip text-primary">GALLERY UPLOAD</p>
      <h1 class="mt-1 font-display text-2xl font-semibold">影集上传与管理</h1>
      <p class="mt-1 text-sm text-muted-foreground">
        一次上传多张照片 · 每批统一日期（默认今日）· 可选标题
      </p>
    </div>

    <!-- ===== 上传表单 ===== -->
    <div class="pt-2">
      <div class="flex flex-wrap items-end gap-4">
        <label class="block text-xs font-medium text-muted-foreground">
          展示日期（默认今日）
          <input
            id="upload-date"
            type="date"
            value={todayStr}
            class="mt-1 block rounded-md border border-input bg-background px-3 py-1.5 text-sm outline-none transition-colors focus-visible:border-ring"
          />
        </label>
        <label class="block min-w-40 flex-1 text-xs font-medium text-muted-foreground">
          整批标题（可选）
          <input
            id="upload-title"
            type="text"
            placeholder="本次照片的标题，可留空"
            maxlength="200"
            class="mt-1 block w-full rounded-md border border-input bg-background px-3 py-1.5 text-sm outline-none transition-colors focus-visible:border-ring"
          />
        </label>
      </div>

      <label class="mt-3 block text-xs font-medium text-muted-foreground">
        整批标签（可选，逗号分隔，最多 10 个，如：风景,旅行,2024）
        <input
          id="upload-tags"
          type="text"
          maxlength="200"
          placeholder="风景,旅行,2024"
          class="mt-1 block w-full rounded-md border border-input bg-background px-3 py-1.5 text-sm outline-none transition-colors focus-visible:border-ring"
        />
      </label>

      {
        photoStorageEnabled ? (
          <>
            <div
              id="drop-zone"
              class="mt-4 cursor-pointer rounded-lg border-2 border-dashed border-border p-8 text-center transition-colors duration-200 hover:border-primary"
            >
              <input id="file-input" type="file" multiple accept="image/*" class="hidden" />
              <p class="text-sm text-muted-foreground">
                点击选择 或 拖拽多张照片到这里
              </p>
              <p class="mt-1 text-xs text-muted-foreground">
                单张自动压缩（宽 ≤2048px，约 ≤3MB）并生成缩略图
              </p>
            </div>

            <!-- 待上传队列 -->
            <div id="upload-list" class="mt-4 space-y-2"></div>

            <div class="mt-4 flex items-center gap-3">
              <button
                id="upload-btn"
                type="button"
                disabled
                class="rounded-md bg-primary px-5 py-2 text-sm text-primary-foreground transition-opacity duration-200 hover:opacity-90 disabled:opacity-40"
              >
                开始上传
              </button>
              <span id="upload-status" class="text-xs text-muted-foreground">选择照片后开始上传</span>
            </div>
          </>
        ) : (
          <div class="mt-4 rounded-md border border-amber-500/40 bg-amber-500/10 px-4 py-3 text-xs text-amber-600 dark:text-amber-400">
            未配置 Cloudflare R2（<code class="font-mono">R2_ACCOUNT_ID / R2_ACCESS_KEY_ID / R2_SECRET_ACCESS_KEY / R2_BUCKET</code>），自动上传不可用 ——
            请使用下方「URL 导入」添加照片（PicGo / GitHub 图床工作流）。
          </div>
        )
      }
    </div>

    <!-- ===== URL 导入（PicGo / GitHub 图床） ===== -->
    <div class="pt-8">
      <p class="pixel-chip text-muted-foreground">URL 导入 / IMPORT</p>
      <p class="mt-1 text-xs text-muted-foreground">
        用 PicGo 等工具把照片传到 GitHub 后，粘贴图片直链即可入库（无需配置 Blob）。
      </p>
      <div class="mt-3 flex flex-wrap items-end gap-3">
        <label class="block min-w-64 flex-1 text-xs font-medium text-muted-foreground">
          图片 URL
          <input
            id="url-input"
            type="url"
            placeholder="https://cdn.jsdelivr.net/gh/user/repo@main/path.jpg"
            class="mt-1 block w-full rounded-md border border-input bg-background px-3 py-1.5 text-sm outline-none transition-colors focus-visible:border-ring"
          />
        </label>
        <label class="block text-xs font-medium text-muted-foreground">
          日期
          <input
            id="url-date"
            type="date"
            value={todayStr}
            class="mt-1 block rounded-md border border-input bg-background px-3 py-1.5 text-sm outline-none transition-colors focus-visible:border-ring"
          />
        </label>
        <label class="block w-44 text-xs font-medium text-muted-foreground">
          标题（可选）
          <input
            id="url-title"
            type="text"
            maxlength="200"
            placeholder="标题"
            class="mt-1 block w-full rounded-md border border-input bg-background px-3 py-1.5 text-sm outline-none transition-colors focus-visible:border-ring"
          />
        </label>
        <label class="block w-44 text-xs font-medium text-muted-foreground">
          标签（可选，逗号分隔）
          <input
            id="url-tags"
            type="text"
            maxlength="200"
            placeholder="风景,旅行"
            class="mt-1 block w-full rounded-md border border-input bg-background px-3 py-1.5 text-sm outline-none transition-colors focus-visible:border-ring"
          />
        </label>
        <button
          id="url-import-btn"
          type="button"
          class="rounded-md border border-border px-4 py-1.5 text-sm transition-colors duration-200 hover:border-primary hover:text-primary"
        >
          导入
        </button>
      </div>
      <p id="url-status" class="mt-2 text-xs text-muted-foreground"></p>
    </div>

    <!-- ===== 已有照片管理 ===== -->
    <div class="pt-8">
      <div class="flex items-center justify-between">
        <p class="pixel-chip text-muted-foreground">
          已有照片 / <span id="manage-photo-count" data-initial={photos.length}>{photos.length}</span>
        </p>
      </div>
      {
        photos.length === 0 ? (
          <p class="mt-4 text-sm text-muted-foreground">影集还是空的，上传第一张吧。</p>
        ) : (
          <>
            <!-- ===== 批量标签工具条 ===== -->
            <div
              id="batch-bar"
              data-manage-area
              class="mt-4 flex flex-wrap items-end gap-3 rounded-md border border-border/70 bg-card/40 px-3 py-3"
            >
              <label class="flex items-center gap-1.5 text-xs text-muted-foreground">
                <input
                  id="check-all"
                  type="checkbox"
                  class="size-3.5 accent-[var(--color-primary)]"
                  aria-label="全选/取消全选照片"
                />
                全选
              </label>
              <span id="checked-count" class="text-xs text-muted-foreground">已选 0 张</span>
              <label class="block text-xs font-medium text-muted-foreground">
                批量操作
                <select
                  id="batch-op"
                  class="mt-1 block rounded-md border border-input bg-background px-2 py-1.5 text-xs outline-none focus-visible:border-ring"
                >
                  <option value="set">覆盖为</option>
                  <option value="add">追加</option>
                  <option value="remove">移除</option>
                </select>
              </label>
              <label class="block min-w-48 flex-1 text-xs font-medium text-muted-foreground">
                标签（逗号分隔）
                <input
                  id="batch-tags"
                  type="text"
                  maxlength="200"
                  placeholder="风景,旅行,2024"
                  class="mt-1 block w-full rounded-md border border-input bg-background px-2 py-1.5 text-xs outline-none focus-visible:border-ring"
                />
              </label>
              <button
                id="batch-apply"
                type="button"
                disabled
                class="rounded-md bg-primary px-4 py-1.5 text-xs text-primary-foreground transition-opacity duration-200 hover:opacity-90 disabled:opacity-40"
              >
                应用
              </button>
              <span id="batch-status" class="text-xs text-muted-foreground"></span>
            </div>

            <div id="manage-grid" data-manage-area class="mt-4 grid grid-cols-2 gap-3 md:grid-cols-4 lg:grid-cols-5">
              {
                photos.map((p) => (
                  <div class="manage-card p-1" data-photo-id={p.id}>
                    <div class="relative">
                      <img
                        src={p.thumbUrl ?? p.url}
                        alt={p.title || '照片'}
                        class="aspect-video w-full rounded object-cover"
                        loading="lazy"
                        data-broken-photo={p.id}
                        onerror="var c=this.closest('.manage-card');if(!c||c.dataset.fallback)return;c.dataset.fallback='1';c.remove();var n=document.getElementById('manage-photo-count');if(n)n.textContent=String(document.querySelectorAll('.manage-card').length);var e=document.getElementById('manage-empty'),r=document.querySelectorAll('.manage-card').length;r===0?(document.querySelectorAll('[data-manage-area]').forEach(function(a){a.classList.add('hidden')}),e&&e.classList.remove('hidden')):e&&e.classList.add('hidden')"
                      />
                      <input
                        type="checkbox"
                        value={p.id}
                        data-photo-check
                        class="absolute left-1.5 top-1.5 size-4 cursor-pointer accent-[var(--color-primary)]"
                        aria-label="选择这张照片"
                      />
                    </div>
                    <input
                      type="date"
                      value={dateKey(p.takenAt)}
                      data-manage-date
                      class="mt-2 w-full rounded border border-input bg-background px-1.5 py-1 text-xs outline-none focus-visible:border-ring"
                      aria-label="照片日期"
                    />
                    <input
                      type="text"
                      value={p.title}
                      data-manage-title
                      maxlength="200"
                      placeholder="标题"
                      class="mt-1 w-full rounded border border-input bg-background px-1.5 py-1 text-xs outline-none focus-visible:border-ring"
                      aria-label="照片标题"
                    />
                    <input
                      type="text"
                      value={p.tags.join(',')}
                      data-manage-tags
                      maxlength="200"
                      placeholder="标签（逗号分隔）"
                      class="mt-1 w-full rounded border border-input bg-background px-1.5 py-1 text-xs outline-none focus-visible:border-ring"
                      aria-label="照片标签"
                    />
                    <div class="mt-2 flex gap-2">
                      <button
                        type="button"
                        data-save-photo={p.id}
                        class="flex-1 rounded border border-border px-2 py-1 text-xs transition-colors duration-200 hover:border-primary hover:text-primary"
                      >
                        保存
                      </button>
                      <button
                        type="button"
                        data-delete-photo={p.id}
                        class="flex-1 rounded border border-destructive/40 px-2 py-1 text-xs text-destructive transition-colors duration-200 hover:bg-destructive/10"
                      >
                        删除
                      </button>
                    </div>
                  </div>
                ))
              }
            </div>

            <!-- 客户端把最后一张也删掉时的空态（平时隐藏；配合 data-manage-area 切换） -->
            <p id="manage-empty" class="mt-4 hidden text-sm text-muted-foreground">
              影集还是空的，上传第一张吧。
            </p>
          </>
        )
      }
    </div>
  </section>
</AdminLayout>

<script>
  /** 影集上传与管理（原生 JS）：
   *  多文件队列 → canvas 压缩原图+缩略图 → 逐张 POST /api/photos；
   *  URL 导入（PicGo 工作流）；管理列表 保存(PATCH) / 删除(DELETE)。 */
  import { confirmDanger } from '@/lib/confirm';

  const todayStr = new Date().toLocaleDateString('sv-SE'); // YYYY-MM-DD
  const MAX_ORIGINAL_BYTES = 3 * 1024 * 1024;

  function el<T extends HTMLElement>(id: string): T | null {
    return document.getElementById(id) as T | null;
  }

  function esc(value: string): string {
    return String(value).replace(/[&<>"']/g, (c) => {
      const map: Record<string, string> = { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' };
      return map[c] ?? c;
    });
  }

  /** 「风景,旅行,2024」→ ['风景','旅行','2024']（中英文逗号均可，去重去空） */
  function parseTagInput(value: string): string[] {
    return [...new Set(value.split(/[,，]/).map((t) => t.trim()).filter(Boolean))];
  }

  // ---------- 图片压缩 ----------
  function loadImage(file: File): Promise<HTMLImageElement> {
    return new Promise((resolve, reject) => {
      const url = URL.createObjectURL(file);
      const img = new Image();
      img.onload = () => { URL.revokeObjectURL(url); resolve(img); };
      img.onerror = () => { URL.revokeObjectURL(url); reject(new Error('图片读取失败')); };
      img.src = url;
    });
  }

  /** canvas 缩放并输出 base64（JPEG）；结果超限时逐步降质量 */
  function canvasToBase64(img: HTMLImageElement, maxWidth: number, quality: number): string {
    const scale = Math.min(1, maxWidth / img.naturalWidth);
    const w = Math.max(1, Math.round(img.naturalWidth * scale));
    const h = Math.max(1, Math.round(img.naturalHeight * scale));
    const canvas = document.createElement('canvas');
    canvas.width = w;
    canvas.height = h;
    const ctx = canvas.getContext('2d');
    if (!ctx) throw new Error('Canvas 不可用');
    ctx.drawImage(img, 0, 0, w, h);
    let q = quality;
    let b64 = canvas.toDataURL('image/jpeg', q).split(',')[1] ?? '';
    // base64 解码后 ≈ 0.75 * 长度；目标 < MAX_ORIGINAL_BYTES（Vercel 4.5MB 上限余量）
    while (b64.length > (MAX_ORIGINAL_BYTES / 0.75) * 0.9 && q > 0.35) {
      q -= 0.1;
      b64 = canvas.toDataURL('image/jpeg', q).split(',')[1] ?? '';
    }
    return b64;
  }

  // ---------- 上传队列 ----------
  interface QueueItem {
    file: File;
    status: 'pending' | 'uploading' | 'done' | 'error';
    row: HTMLElement;
  }
  const queue: QueueItem[] = [];

  function renderQueue(): void {
    const list = el('upload-list');
    const btn = el<HTMLButtonElement>('upload-btn');
    if (!list || !btn) return;
    list.innerHTML = '';
    if (queue.length === 0) {
      btn.disabled = true;
      btn.textContent = '开始上传';
      return;
    }
    btn.disabled = false;
    btn.textContent = `开始上传（${queue.length} 张）`;
    queue.forEach((item) => {
      const row = document.createElement('div');
      row.className = 'flex items-center gap-3 border-b border-border px-3 py-2 text-xs';
      row.innerHTML = `
        <img src="" class="h-10 w-14 shrink-0 rounded object-cover" alt="">
        <span class="min-w-0 flex-1 truncate">${esc(item.file.name)}</span>
        <span class="shrink-0 text-muted-foreground">${(item.file.size / 1024).toFixed(0)} KB</span>
        <span data-upload-status class="shrink-0"></span>
      `;
      list.appendChild(row);
      item.row = row;
      const preview = row.querySelector('img');
      if (preview) {
        const url = URL.createObjectURL(item.file);
        preview.src = url;
        preview.onload = () => URL.revokeObjectURL(url);
      }
    });
  }

  function setItemStatus(item: QueueItem, status: QueueItem['status'], text?: string): void {
    item.status = status;
    const node = item.row.querySelector('[data-upload-status]');
    if (node) {
      if (status === 'done') {
        node.textContent = '✓ 已上传';
        node.classList.add('text-emerald-600');
      } else if (status === 'error') {
        node.textContent = text ?? '失败';
        node.classList.add('text-destructive');
      } else if (status === 'uploading') {
        node.textContent = '上传中…';
        node.classList.remove('text-destructive');
      }
    }
  }

  /** 上传单张：压缩 → POST /api/photos */
  async function uploadItem(item: QueueItem, date: string, title: string, tags?: string[]): Promise<void> {
    setItemStatus(item, 'uploading');
    try {
      const isSvg = item.file.type === 'image/svg+xml';
      let dataBase64: string;
      let thumbBase64 = '';
      let mime: string;
      let width: number | null = null;
      let height: number | null = null;
      if (isSvg) {
        const dataUrl = await new Promise<string>((resolve, reject) => {
          const reader = new FileReader();
          reader.onload = () => resolve(String(reader.result));
          reader.onerror = () => reject(new Error('读取失败'));
          reader.readAsDataURL(item.file);
        });
        dataBase64 = dataUrl.split(',')[1] ?? '';
        mime = 'image/svg+xml';
      } else {
        const img = await loadImage(item.file);
        mime = 'image/jpeg';
        width = img.naturalWidth;
        height = img.naturalHeight;
        dataBase64 = canvasToBase64(img, 2048, 0.85);
        thumbBase64 = canvasToBase64(img, 800, 0.8);
      }
      const res = await fetch('/api/photos', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({
          dataBase64,
          thumbBase64,
          mime,
          takenAt: `${date}T00:00:00`,
          title,
          width,
          height,
          tags: tags ?? [],
        }),
      });
      const data = (await res.json()) as { error?: string };
      if (!res.ok) throw new Error(data.error ?? '上传失败');
      setItemStatus(item, 'done');
    } catch (err) {
      setItemStatus(item, 'error', err instanceof Error ? err.message : '失败');
    }
  }

  /** 开始上传：逐张串行，成功后从队列移除 */
  async function startUpload(): Promise<void> {
    const date = (el<HTMLInputElement>('upload-date')?.value ?? todayStr).trim();
    const title = (el<HTMLInputElement>('upload-title')?.value ?? '').trim();
    const tags = parseTagInput(el<HTMLInputElement>('upload-tags')?.value ?? '');
    const status = el('upload-status');
    const btn = el<HTMLButtonElement>('upload-btn');
    if (!btn || queue.length === 0) return;
    btn.disabled = true;
    if (status) status.textContent = '上传中…';

    const items = queue.filter((q) => q.status !== 'done');
    let failed = 0;
    for (let i = 0; i < items.length; i += 1) {
      await uploadItem(items[i]!, date, title, tags);
      if (items[i]!.status === 'error') failed += 1;
      if (status) status.textContent = `第 ${i + 1} / ${items.length} 张`;
    }
    const doneCount = queue.filter((q) => q.status === 'done').length;
    // 移除已完成项
    for (let i = queue.length - 1; i >= 0; i -= 1) {
      if (queue[i]!.status === 'done') queue.splice(i, 1);
    }
    renderQueue();
    if (status) {
      status.textContent = failed > 0 ? `完成 ${doneCount} 张，失败 ${failed} 张（可重新选择重试）` : `完成 ${doneCount} 张`;
    }
    btn.disabled = queue.length === 0;
    btn.textContent = queue.length > 0 ? `重试剩余（${queue.length} 张）` : '开始上传';
  }

  // ---------- 事件（document 委托 + change，兼容 View Transitions 不涉及：AdminLayout 无 ClientRouter） ----------
  const dropZone = el('drop-zone');
  const fileInput = el<HTMLInputElement>('file-input');

  dropZone?.addEventListener('click', () => fileInput?.click());
  fileInput?.addEventListener('change', () => {
    const files = Array.from(fileInput.files ?? []);
    files.forEach((f) => queue.push({ file: f, status: 'pending', row: document.createElement('div') }));
    fileInput.value = '';
    renderQueue();
  });

  dropZone?.addEventListener('dragover', (e) => {
    e.preventDefault();
    dropZone.classList.add('border-primary');
  });
  dropZone?.addEventListener('dragleave', () => dropZone.classList.remove('border-primary'));
  dropZone?.addEventListener('drop', (e) => {
    e.preventDefault();
    dropZone.classList.remove('border-primary');
    const files = Array.from(e.dataTransfer?.files ?? []).filter((f) => f.type.startsWith('image/'));
    files.forEach((f) => queue.push({ file: f, status: 'pending', row: document.createElement('div') }));
    renderQueue();
  });

  el('upload-btn')?.addEventListener('click', () => void startUpload());

  // ---------- URL 导入 ----------
  /** 把 GitHub blob/raw 页面 URL 改写成 raw 直链；已是直链则原样返回 */
  function normalizeImageUrl(raw: string): string {
    const m = raw.match(/^https?:\/\/github\.com\/([^/]+)\/([^/]+)\/(?:blob|raw)\/(.+)$/);
    if (m) {
      const [, user, repo, path] = m;
      return `https://raw.githubusercontent.com/${user}/${repo}/${path}`;
    }
    const rawh = raw.match(/^https?:\/\/raw\.githubusercontent\.com\//);
    if (rawh) return raw; // 已是 raw 直链
    const jsd = raw.match(/^https?:\/\/cdn\.jsdelivr\.net\/gh\//);
    if (jsd) return raw; // 已是 jsDelivr 直链
    return raw;
  }

  el('url-import-btn')?.addEventListener('click', async () => {
    const urlInput = el<HTMLInputElement>('url-input');
    const status = el('url-status');
    if (!urlInput || !status) return;
    let raw = urlInput.value.trim();
    if (!raw) {
      status.textContent = '请输入图片 URL';
      return;
    }
    // 规范化 GitHub 直链
    const normalized = normalizeImageUrl(raw);
    if (raw !== normalized) {
      raw = normalized;
      urlInput.value = normalized;
      status.textContent = `已改写为直链：${normalized}`;
    } else if (!/^https?:\/\/\S+$/.test(raw)) {
      status.textContent = 'URL 需以 http(s):// 开头';
      return;
    }
    const date = (el<HTMLInputElement>('url-date')?.value ?? todayStr).trim();
    const title = (el<HTMLInputElement>('url-title')?.value ?? '').trim();
    // 预加载读取宽高；跨域/防盗链/格式错误时降级为 null（仍允许导入）
    let width: number | null = null;
    let height: number | null = null;
    const dims = await new Promise<{ w: number | null; h: number | null }>((resolve) => {
      const img = new Image();
      const timer = window.setTimeout(() => resolve({ w: null, h: null }), 4000);
      img.onload = () => {
        window.clearTimeout(timer);
        resolve({ w: img.naturalWidth || null, h: img.naturalHeight || null });
      };
      img.onerror = () => {
        window.clearTimeout(timer);
        resolve({ w: null, h: null });
      };
      img.src = raw;
    });
    width = dims.w;
    height = dims.h;
    status.textContent = width && height ? '导入中…' : '直链无法预加载宽高（跨域/防盗链），将按 4:3 占位导入…';
    try {
      const importTags = parseTagInput(el<HTMLInputElement>('url-tags')?.value ?? '');
      const res = await fetch('/api/photos', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({
          importUrl: raw,
          takenAt: `${date}T00:00:00`,
          title,
          width,
          height,
          tags: importTags,
        }),
      });
      const data = (await res.json()) as { error?: string };
      if (!res.ok) throw new Error(data.error ?? '导入失败');
      status.textContent = '✓ 导入成功';
      urlInput.value = '';
      el<HTMLInputElement>('url-title')!.value = '';
      // 标签保留（批量导入常沿用同一批标签），其余清空
      window.location.reload(); // 刷新管理列表
    } catch (err) {
      status.textContent = err instanceof Error ? err.message : '导入失败';
    }
  });

  // ---------- 管理列表：保存 / 删除 ----------
  document.addEventListener('click', async (e) => {
    const target = e.target as HTMLElement;
    const saveBtn = target.closest<HTMLButtonElement>('[data-save-photo]');
    if (saveBtn) {
      const card = saveBtn.closest<HTMLElement>('.manage-card');
      const id = saveBtn.dataset.savePhoto ?? '';
      if (!card || !id) return;
      const date = (card.querySelector<HTMLInputElement>('[data-manage-date]')?.value ?? '').trim();
      const title = (card.querySelector<HTMLInputElement>('[data-manage-title]')?.value ?? '').trim();
      const tags = parseTagInput(card.querySelector<HTMLInputElement>('[data-manage-tags]')?.value ?? '');
      if (!date) {
        window.alert('请选择日期');
        return;
      }
      saveBtn.disabled = true;
      saveBtn.textContent = '保存中…';
      try {
        const res = await fetch(`/api/photos/${id}`, {
          method: 'PATCH',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ title, takenAt: `${date}T00:00:00`, tags }),
        });
        const data = (await res.json()) as { error?: string };
        if (!res.ok) throw new Error(data.error ?? '保存失败');
        saveBtn.textContent = '✓';
        window.setTimeout(() => {
          saveBtn.textContent = '保存';
          saveBtn.disabled = false;
        }, 1200);
      } catch (err) {
        window.alert(err instanceof Error ? err.message : '保存失败');
        saveBtn.textContent = '保存';
        saveBtn.disabled = false;
      }
      return;
    }

    const delBtn = target.closest<HTMLButtonElement>('[data-delete-photo]');
    if (delBtn) {
      const id = delBtn.dataset.deletePhoto ?? '';
      if (!id) return;
      if (!(await confirmDanger('确定删除这张照片？此操作不可撤销。'))) return;
      // 乐观移除：DELETE 涉及 R2 删除 + 主备双库双写，耗时可达数秒，
      // 若等响应再移除，卡片会长时间占着网格位置（用户会以为删除没生效）。
      const card = delBtn.closest<HTMLElement>('.manage-card');
      removeManageCard(id, card); // 释放 DOM 插槽 + 同步计数/空态/批量勾选（见 helper）
      try {
        const res = await fetch(`/api/photos/${id}`, { method: 'DELETE' });
        if (!res.ok) {
          const data = (await res.json().catch(() => ({}))) as { error?: string };
          throw new Error(data.error ?? '删除失败');
        }
      } catch (err) {
        // 删除失败 → 数据仍在，刷新页面以服务端状态回滚 UI
        window.alert(err instanceof Error ? err.message : '删除失败');
        window.location.reload();
      }
    }
  });

  // ---------- 批量标签维护 ----------
  const batchBar = el('batch-bar');
  const checkAll = el<HTMLInputElement>('check-all');
  const checkedCount = el('checked-count');
  const batchApply = el<HTMLButtonElement>('batch-apply');
  const batchStatus = el('batch-status');

  /**
   * 从管理网格移除一张照片卡片，并同步派生状态，彻底释放其占用的位置/空间。
   *
   * 这是全页唯一的「删除后释放展示插槽」入口：
   * 1. 移除 `.manage-card` DOM 节点（CSS grid 自动回流，不留空洞）；
   * 2. 递减头部「已有照片 / N」实时计数；
   * 3. 若网格删空，隐藏批量工具条与网格、展示空态文案（避免陈旧框架继续占位）；
   * 4. 刷新批量勾选态（被删卡片的勾选随之消失）。
   * 无论单张删除、未来新增的批量删除/清空回收站，都应复用本函数，避免各自手写移除导致残留。
   *
   * @param id    照片 id（供日志/去重）
   * @param card  可选：已定位的 `.manage-card`；缺省时按 data-photo-id 查找
   * @returns 是否确实移除了一张卡片
   */
  function removeManageCard(id: string, card?: HTMLElement | null): boolean {
    const target = card && card.isConnected ? card : document.querySelector<HTMLElement>(`.manage-card[data-photo-id="${CSS.escape(id)}"]`);
    if (!target || !target.isConnected) return false;
    target.remove();

    // 删除后：实时计数与空态都以「当前仍在 DOM 的卡片数」为准，确保不留陈旧计数/占位
    const remaining = document.querySelectorAll<HTMLElement>('.manage-card').length;
    const countNode = el('manage-photo-count');
    if (countNode) {
      countNode.dataset.initial = String(remaining);
      countNode.textContent = String(remaining);
    }

    // 网格已删空 → 释放整片管理区（隐藏批量工具条/网格），展示空态文案
    const emptyNode = el('manage-empty');
    if (remaining === 0) {
      document.querySelectorAll<HTMLElement>('[data-manage-area]').forEach((area) => area.classList.add('hidden'));
      emptyNode?.classList.remove('hidden');
    } else {
      emptyNode?.classList.add('hidden');
    }

    syncBatchState();
    return true;
  }

  /** 孤儿兜底：图片加载失败时复用 removeManageCard 释放网格槽位与计数
   *
   * 背景：DB 中可能存在"行存在但 R2 文件已缺失"的孤儿记录（典型来源：迁库/迁存储
   *  期间只删了存储未删行，或手动从 R2 删了文件没回写 DB）。浏览器拿到 `<img>` 的
   *  src 后会按状态码/响应体判定加载失败——R2 对私有未公开或缺失对象常返回 200 + 空
   *  body，浏览器以 `naturalWidth === 0` 表达加载失败、触发 `error` 事件。
   *
   * 行为：每个 `[data-broken-photo]` 的 `<img>` 一旦触发 error，立刻调
   *  `removeManageCard(id, card)`，复用统一的释放入口（删 DOM + 同步计数 + 空态
   *  切换 + 刷新批量勾选）。listener 一次性 `{ once: true }` 避免重复触发。
   *
   * 注：此为治标——释放 UI 槽位让用户视觉上不再看到破图占位；治本是 DB 中物理删除
   * 孤儿行（需 R2 SDK 探测，另作管理 API；本次不在范围内）。
   */
  function setupBrokenPhotoFallback(): void {
    document.querySelectorAll<HTMLImageElement>('#manage-grid img[data-broken-photo]').forEach((img) => {
      // 浏览器缓存命中且已成功加载的图片直接跳过
      if (img.complete && img.naturalWidth > 0) return;
      // 已触发过 error 的 `<img>` 标记一下，避免与 onerror 重复移除
      if ((img as HTMLImageElement & { dataset?: { handled?: string } }).dataset?.handled) return;
      img.addEventListener('error', () => {
        const card = img.closest<HTMLElement>('.manage-card');
        if (!card) return;
        const id = card.dataset.photoId ?? img.dataset.brokenPhoto ?? '';
        removeManageCard(id, card);
      }, { once: true });
    });
  }

  /** 当前勾选的照片 id（DOM 每次实时查询，避免缓存失效；本页为 AdminLayout 无 SPA 切换） */
  function checkedIds(): string[] {
    return [...document.querySelectorAll<HTMLInputElement>('[data-photo-check]')]
      .filter((c) => c.checked)
      .map((c) => c.value)
      .filter(Boolean);
  }

  /** 同步「已选 N 张」与「应用」按钮可用性 */
  function syncBatchState(): void {
    const boxes = [...document.querySelectorAll<HTMLInputElement>('[data-photo-check]')];
    const n = boxes.filter((c) => c.checked).length;
    if (checkedCount) checkedCount.textContent = `已选 ${n} 张`;
    if (batchApply) batchApply.disabled = n === 0;
    if (checkAll) {
      checkAll.checked = boxes.length > 0 && n === boxes.length;
      checkAll.indeterminate = n > 0 && n < boxes.length;
    }
  }

  if (batchBar) {
    checkAll?.addEventListener('change', () => {
      const on = checkAll.checked;
      document.querySelectorAll<HTMLInputElement>('[data-photo-check]').forEach((c) => {
        c.checked = on;
      });
      syncBatchState();
    });

    // 勾选变化用 change 委托（change 会冒泡到 document）
    document.addEventListener('change', (e) => {
      const target = e.target as HTMLElement;
      if (target.matches?.('[data-photo-check]')) syncBatchState();
    });

    batchApply?.addEventListener('click', async () => {
      const ids = checkedIds();
      const op = (el<HTMLSelectElement>('batch-op')?.value ?? 'set') as 'set' | 'add' | 'remove';
      const tags = parseTagInput(el<HTMLInputElement>('batch-tags')?.value ?? '');
      if (ids.length === 0 || !batchApply) return;
      if (tags.length === 0) {
        // 仅「覆盖为 + 留空」是有意义的清空操作，其余必须填标签
        if (op !== 'set') {
          if (batchStatus) batchStatus.textContent = '请输入标签';
          return;
        }
        if (!(await confirmDanger('留空将清空所选照片的全部标签，确定继续？'))) return;
      }
      batchApply.disabled = true;
      const original = batchApply.textContent;
      batchApply.textContent = '处理中…';
      if (batchStatus) batchStatus.textContent = '';
      try {
        const res = await fetch('/api/photos/batch-tags', {
          method: 'PATCH',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ ids, op, tags }),
        });
        const data = (await res.json()) as { error?: string; updated?: number };
        if (!res.ok) throw new Error(data.error ?? '操作失败');
        window.location.reload(); // 刷新卡片上的标签显示
      } catch (err) {
        if (batchStatus) batchStatus.textContent = err instanceof Error ? err.message : '操作失败';
        batchApply.textContent = original ?? '应用';
        batchApply.disabled = false;
      }
    });

    syncBatchState();
  }

  // 孤儿兜底：DOM 就绪后给所有管理卡片图绑一次性 error 监听；DOMContentLoaded
  // 之后节点也可能由其它代码插入，但本页无运行时插入卡片，故无需 observer
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupBrokenPhotoFallback, { once: true });
  } else {
    setupBrokenPhotoFallback();
  }
</script>
