---
/**
 * DeerDots.astro —— 首页落地页以下的「小鹿点阵」装饰背景
 *
 * 鹿形来源：/deer-mask.png —— 直接从用户提供的参考图提取的亮度密度场
 * （threshold → blur），形状/姿态/消散尾迹与原图 1:1 一致，非手绘临摹。
 *
 * 分层（absolute inset-0、pointer-events:none、-z-10 垫底，置于 relative.isolate 全宽容器内）：
 * 1. 点阵 canvas：10px 细密网格采样遮罩密度，核心大点亮、边缘小点消散；无连线，纯点阵。
 *    鼠标交互「混沌涡流」：经过处粒子绕焦点混乱旋转四散（切向涡流 + 径向外推 + 随机扰动，
 *    每点旋转方向随机），移开后弹簧恢复整齐点阵。
 *    动感：整体慢摇曳（sin 双频）+ 亮度沿对角线流动波 + 鹿形内随机星闪 + 缓慢呼吸（±10%）。
 *    主题联动：明亮模式整个点阵隐藏；切到暗黑时点阵从暗到亮平滑渐显。
 *    亮度分层：默认鹿形亮度降一档，鼠标靠近鹿形区域时平滑升回满亮，离开后缓落。
 * 2. 颗粒：SVG feTurbulence 噪点覆层（mix-blend overlay），消除色带、增加胶片颗粒感。
 * 3. 顶部线性渐隐 mask：与落地页 Hero 底部自然衔接，装饰区无生硬边界（无框感）。
 *
 * 性能（对齐 DeepSeek 的做法）：DPR≤2、30fps 节流、空闲 3fps 心跳、
 * 离屏（IntersectionObserver）/切后台暂停、触屏不绑鼠标、prefers-reduced-motion 只画静帧。
 * 明暗色板跟随 html.dark（MutationObserver 监听切换）。
 */
---

<div class="deer-dots-wrap" aria-hidden="true">
  <canvas class="deer-canvas"></canvas>
  <div class="deer-grain"></div>
</div>

<style>
  .deer-dots-wrap {
    position: absolute;
    inset: 0;
    z-index: -10;
    overflow: hidden;
    pointer-events: none;
    -webkit-mask-image: linear-gradient(to bottom, transparent 0, #000 140px);
    mask-image: linear-gradient(to bottom, transparent 0, #000 140px);
  }
  .deer-canvas {
    position: absolute;
    inset: 0;
    height: 100%;
    width: 100%;
  }
  .deer-grain {
    position: absolute;
    inset: 0;
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='160' height='160'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='2' stitchTiles='stitch'/><feColorMatrix type='saturate' values='0'/></filter><rect width='100%25' height='100%25' filter='url(%23n)' opacity='0.6'/></svg>");
    background-size: 160px 160px;
    mix-blend-mode: overlay;
    opacity: 0.04;
  }
  :global(.dark) .deer-grain {
    opacity: 0.07;
  }
</style>

<script>
  /* ---------- 遮罩贴图（参考图提取的密度场，public/deer-mask.png，520×453） ---------- */
  const VB_W = 520;
  const VB_H = 453;
  const maskImg = new Image();
  const maskReady = new Promise<void>((resolve) => {
    maskImg.onload = () => resolve();
    maskImg.onerror = () => resolve();
    maskImg.src = '/deer-mask.png';
  });

  /* ---------- 色板（明暗跟随 html.dark；浅色主题用深点保证对比度） ---------- */
  interface Palette {
    dot: string;
  }
  const DARK: Palette = { dot: '190,214,250' };
  const LIGHT: Palette = { dot: '62,84,124' };

  const SPACING = 10;
  const FRAME_MS = 1000 / 30;
  const MOUSE_R = 130;
  /** 悬停增亮判定半径：鼠标进入鹿形点此范围内视为「靠近鹿区」 */
  const BOOST_R = 160;
  /* 每点 6 个 float：restX, restY, x, y, vx, vy */
  const STRIDE = 6;

  function initDeerCanvas(canvas: HTMLCanvasElement): void {
    if (canvas.dataset.deerReady) return;
    canvas.dataset.deerReady = '1';
    const ctx0 = canvas.getContext('2d');
    if (!ctx0) return;
    const ctx: CanvasRenderingContext2D = ctx0;

    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const finePointer = !window.matchMedia('(hover: none), (pointer: coarse)').matches;
    const dpr = Math.min(window.devicePixelRatio || 1, 2);
    const htmlEl = document.documentElement;

    let w = 0;
    let h = 0;
    let dots = new Float32Array(0);
    let baseA = new Float32Array(0);
    let phase = new Float32Array(0);
    let spark = new Float32Array(0);
    let sizeF = new Float32Array(0);
    let cols = 0;
    let rows = 0;
    let mouse = { x: -9999, y: -9999 };
    let raf = 0;
    let last = 0;
    let running = false;
    let inView = true;
    let resizeTimer = 0;
    /** 空闲心跳定时器句柄：必须可取消，否则 stop() 后仍会不断自我唤醒（P2-2） */
    let idleTimer = 0;
    /** 缓存的画布边界：pointermove 中调 getBoundingClientRect() 会强制同步布局（P2-2） */
    let rectLeft = 0;
    let rectTop = 0;
    /** 主题渐显系数 0..1：暗黑=1，明亮=0；切换时每帧向目标缓动（首帧直接取当前主题，避免加载闪变） */
    let themeMix = htmlEl.classList.contains('dark') ? 1 : 0;
    /** 悬停增亮系数 0..1：鼠标靠近鹿形区域 → 1，离开 → 0 */
    let hoverMix = 0;

    const palette = (): Palette => (htmlEl.classList.contains('dark') ? DARK : LIGHT);

    /** 重建网格 + 把遮罩贴图画进「网格分辨率」离屏画布采样密度（天然低耗） */
    function rebuild(): void {
      w = canvas.clientWidth;
      h = canvas.clientHeight;
      if (w < 2 || h < 2 || !maskImg.naturalWidth) return;
      canvas.width = Math.round(w * dpr);
      canvas.height = Math.round(h * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

      cols = Math.ceil(w / SPACING) + 1;
      rows = Math.ceil(h / SPACING) + 1;
      const off = document.createElement('canvas');
      off.width = cols;
      off.height = rows;
      const octx0 = off.getContext('2d');
      if (!octx0) return;
      const octx: CanvasRenderingContext2D = octx0;
      const s = Math.min((rows * 0.92) / VB_H, (cols * 0.66) / VB_W);
      octx.drawImage(
        maskImg,
        cols * 0.56 - (VB_W * s) / 2,
        rows * 0.54 - (VB_H * s) / 2,
        VB_W * s,
        VB_H * s,
      );
      const mask = octx.getImageData(0, 0, cols, rows).data;

      const n = cols * rows;
      dots = new Float32Array(n * STRIDE);
      baseA = new Float32Array(n);
      phase = new Float32Array(n);
      spark = new Float32Array(n);
      sizeF = new Float32Array(n);
      for (let j = 0; j < rows; j++) {
        for (let i = 0; i < cols; i++) {
          const k = j * cols + i;
          const x = i * SPACING;
          const y = j * SPACING;
          dots[k * STRIDE] = x;
          dots[k * STRIDE + 1] = y;
          dots[k * STRIDE + 2] = x;
          dots[k * STRIDE + 3] = y;
          const a = mask[k * 4] ?? 0; // 灰度遮罩 → 取红通道作密度
          baseA[k] = Math.min(1, 0.05 + 0.85 * Math.pow(a / 255, 1.05));
          phase[k] = (i * 7 + j * 13) * 0.55;
          // 每点随机尺寸系数：大点在核心、小点在边缘，颗粒感更接近手绘粒子画
          sizeF[k] = 0.75 + Math.random() * 0.7;
        }
      }
    }

    /** 物理 + 绘制一帧，返回最大速度（用于空闲降频） */
    function draw(t: number): number {
      const pal = palette();
      ctx.clearRect(0, 0, w, h);
      let maxVel = 0;
      const mx = mouse.x;
      const my = mouse.y;
      let nearDeer = false;
      /* P2-2：点数是 cols*rows（1080p 下约 2.1 万），下面两个循环各自跑满一遍。
         把循环上界、鼠标半径平方等提出循环外，避免每轮重复求值与属性查找。 */
      const n = cols * rows;
      const mouseR2 = MOUSE_R * MOUSE_R;
      const boostR2 = BOOST_R * BOOST_R;

      // 主题联动：暗黑渐显（target=1）、明亮隐藏（target=0），每帧向目标缓动
      const themeTarget = htmlEl.classList.contains('dark') ? 1 : 0;
      if (reduced) themeMix = themeTarget;
      else {
        themeMix += (themeTarget - themeMix) * 0.05;
        if (Math.abs(themeTarget - themeMix) < 0.003) themeMix = themeTarget;
      }
      if (themeMix <= 0.001) {
        ctx.clearRect(0, 0, w, h);
        return 0;
      }
      const breath = 0.9 + 0.1 * Math.sin(t * 0.00085); // 鹿形缓慢呼吸（周期约 7.4s，±10%）

      for (let k = 0; k < n; k++) {
        const b = k * STRIDE;
        const rx = dots[b] ?? 0;
        const ry = dots[b + 1] ?? 0;
        const x = dots[b + 2] ?? 0;
        const y = dots[b + 3] ?? 0;
        let vx = dots[b + 4] ?? 0;
        let vy = dots[b + 5] ?? 0;
        if (finePointer) {
          const dx = x - mx;
          const dy = y - my;
          const d2 = dx * dx + dy * dy;
          // 悬停增亮判定：鼠标落在鹿形点附近（BOOST_R 内）→ 本帧标记 nearDeer
          if (!nearDeer && (baseA[k] ?? 0) > 0.25 && d2 < boostR2) nearDeer = true;
          if (d2 < mouseR2 && d2 > 0.01) {
            const d = Math.sqrt(d2);
            const fall = 1 - d / MOUSE_R;
            // 「混沌涡流」：切向绕转（每点方向随机）+ 径向外推 + 随机扰动。
            // P2-2：每帧只取 1 次随机数驱动两轴（原为 2 次），随机性视觉等价、开销减半。
            const jitter = (Math.random() - 0.5) * fall * 6;
            const spin = (phase[k] ?? 0) % 2 < 1 ? 1 : -1;
            const swirl = fall * 4.6 * spin;
            vx += (-dy / d) * swirl + (dx / d) * fall * 1.6 + jitter;
            vy += (dx / d) * swirl + (dy / d) * fall * 1.6 + jitter;
          }
        }
        // 弹簧回位 + 阻尼（鼠标离开后逐渐恢复整齐点阵）
        vx = (vx + (rx - x) * 0.06) * 0.82;
        vy = (vy + (ry - y) * 0.06) * 0.82;
        const nx = x + vx;
        const ny = y + vy;
        dots[b + 2] = nx;
        dots[b + 3] = ny;
        dots[b + 4] = vx;
        dots[b + 5] = vy;
        const v = Math.abs(vx) + Math.abs(vy);
        if (v > maxVel) maxVel = v;
      }

      // 悬停增亮：靠近鹿形区域 → 平滑升满亮，离开 → 缓落回默认暗一档
      const hoverTarget = nearDeer ? 1 : 0;
      if (reduced) hoverMix = hoverTarget;
      else {
        hoverMix += (hoverTarget - hoverMix) * 0.06;
        if (Math.abs(hoverTarget - hoverMix) < 0.003) hoverMix = hoverTarget;
      }
      const dimF = 0.6 + 0.4 * hoverMix; // 默认亮度降一档（0.6），悬停回满（1.0）

      // 随机星闪：鹿形内的点偶尔被点亮，随时间衰减
      for (let s = 0; s < 3; s++) {
        if (Math.random() < 0.35) {
          const k = Math.floor(Math.random() * n);
          if ((baseA[k] ?? 0) > 0.3) spark[k] = 1;
        }
      }

      // 点：核心亮、边缘消散；整体慢摇曳 + 亮度沿对角线流动 + 星闪衰减
      const swayX = Math.sin(t * 0.0006) * 3.4;
      const swayY = Math.sin(t * 0.00042 + 1.3) * 2.4;
      const waveT = t * 0.0016;
      ctx.fillStyle = `rgb(${pal.dot})`;
      for (let k = 0; k < n; k++) {
        const b = k * STRIDE;
        const inDeer = (baseA[k] ?? 0) > 0.2;
        let x = dots[b + 2] ?? 0;
        let y = dots[b + 3] ?? 0;
        if (inDeer) {
          x += swayX;
          y += swayY;
        }
        const wave = 0.72 + 0.28 * Math.sin(waveT - (x + y) * 0.01 + (phase[k] ?? 0) * 0.4);
        spark[k] = (spark[k] ?? 0) * 0.9;
        const ba = baseA[k] ?? 0;
        const sp = spark[k] ?? 0;
        let alpha = Math.min(1, ba * wave + sp * 0.6 * ba);
        if (inDeer) alpha *= breath * dimF; // 呼吸 + 悬停增亮只作用于鹿形点
        alpha *= themeMix; // 主题联动：明亮模式整体隐去，暗黑渐显
        // 核心大点、边缘小点，叠加每点随机尺寸系数（参考图的有机颗粒感）
        const sz = (1.6 + 2.2 * Math.min(1, ba * 1.6)) * (sizeF[k] ?? 1);
        ctx.globalAlpha = alpha;
        ctx.fillRect(x - sz / 2, y - sz / 2, sz, sz);
      }
      ctx.globalAlpha = 1;
      return maxVel;
    }

    function frame(ts: number): void {
      raf = 0;
      if (!canvas.isConnected || !inView) {
        running = false;
        return;
      }
      if (ts - last < FRAME_MS) {
        raf = requestAnimationFrame(frame);
        return;
      }
      last = ts - ((ts - last) % FRAME_MS);
      const maxVel = draw(ts);
      // 明亮模式（themeMix 已归零）：完全停帧省电，主题切换时由 MutationObserver 唤醒
      if (themeMix <= 0.001) {
        running = false;
        return;
      }
      // 波光/星闪常驻 → 空闲时不完全停帧，降为低频心跳（约 3fps）
      // 主题渐显 / 悬停增亮过渡中 → 保持 30fps 全速，保证过渡平滑
      const transitioning = (themeMix > 0.001 && themeMix < 0.999) || (hoverMix > 0.001 && hoverMix < 0.999);
      if (maxVel < 0.05 && !transitioning) {
        running = false;
        // P2-2：心跳句柄必须存下来 —— 否则 stop()（离屏/切后台/主题归零）无法取消它，
        // 定时器会在页面上留下一条永不停止的 330ms 轮询链。
        idleTimer = window.setTimeout(() => {
          idleTimer = 0;
          if (canvas.isConnected && inView && !document.hidden && !running) {
            running = true;
            raf = requestAnimationFrame(frame);
          }
        }, 330);
        return;
      }
      raf = requestAnimationFrame(frame);
    }

    function wake(): void {
      if (reduced || running || !inView || document.hidden) return;
      running = true;
      raf = requestAnimationFrame(frame);
    }

    function stop(): void {
      if (raf) cancelAnimationFrame(raf);
      raf = 0;
      // P2-2：连同空闲心跳一起取消，否则 stop() 之后 330ms 又会被自己唤醒
      if (idleTimer) {
        window.clearTimeout(idleTimer);
        idleTimer = 0;
      }
      running = false;
    }

    function redrawStatic(): void {
      draw(performance.now());
    }

    /** 记录画布在视口中的位置：resize / 滚动会改变它，但 pointermove 里不能现算（强制重排） */
    function captureRect(): void {
      const rect = canvas.getBoundingClientRect();
      rectLeft = rect.left;
      rectTop = rect.top;
    }

    rebuild();
    redrawStatic();
    if (reduced) return;

    if (finePointer) {
      captureRect();
      window.addEventListener(
        'pointermove',
        (e) => {
          // P2-2：用缓存的 rect 做减法，避免每帧 getBoundingClientRect() 触发的强制同步布局
          mouse.x = e.clientX - rectLeft;
          mouse.y = e.clientY - rectTop;
          wake();
        },
        { passive: true },
      );
      // 视口变化会移动画布 → 失效缓存（滚动同理，用 passive 监听不阻塞滚动）
      window.addEventListener('scroll', captureRect, { passive: true });
      window.addEventListener('resize', captureRect, { passive: true });
    }
    window.addEventListener('resize', () => {
      window.clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(() => {
        captureRect();
        rebuild();
        redrawStatic();
        wake();
      }, 150);
    });
    new IntersectionObserver((entries) => {
      inView = entries[0]?.isIntersecting ?? true;
      if (inView) wake();
      else stop();
    }).observe(canvas);
    document.addEventListener('visibilitychange', () => {
      if (document.hidden) stop();
      else wake();
    });
    // 明暗主题切换 → 重绘一帧（色板即时生效）
    new MutationObserver(() => {
      redrawStatic();
      wake();
    }).observe(htmlEl, { attributes: true, attributeFilter: ['class'] });
    wake();
  }

  async function initAll(): Promise<void> {
    await maskReady;
    if (!maskImg.naturalWidth) return;
    document.querySelectorAll<HTMLCanvasElement>('canvas.deer-canvas').forEach(initDeerCanvas);
  }
  void initAll();
  document.addEventListener('astro:page-load', () => void initAll());
</script>
