---
/* ===== Props ===== */
interface Props {
  /** 是否管理员（控制编辑按钮） */
  isAuthed: boolean;
}

const { isAuthed } = Astro.props;

/* ===== Imports ===== */
import { getProfile } from '@/lib/profile';

/* ===== Logic ===== */
const profile = await getProfile();
const avatarSrc = profile.avatar || '';
const nickname = profile.nickname || '博主';
const profileJson = JSON.stringify(profile);
---
<!-- ===== Template ===== -->
<!-- 导航头像入口 -->
<button
  id="profile-btn"
  type="button"
  aria-label="个人中心"
  title="个人中心"
  class="ml-1 inline-flex size-8 items-center justify-center overflow-hidden rounded-full border border-border text-sm transition-colors duration-200 hover:border-primary"
>
  {avatarSrc ? (
    <img src={avatarSrc} alt={nickname} class="h-full w-full object-cover" />
  ) : (
    <span class="font-display font-semibold text-primary">{nickname.slice(0, 1)}</span>
  )}
</button>

<!-- 个人中心悬浮框（屏幕正中） -->
<dialog id="profile-dialog" class="profile-dialog" aria-labelledby="profile-title" data-json={profileJson}>
  <div class="settings-header">
    <div>
      <p class="pixel-chip text-primary">PROFILE</p>
      <h2 id="profile-title" class="mt-1 font-display text-xl font-semibold">个人中心</h2>
    </div>
    <button id="profile-close" type="button" aria-label="关闭" class="settings-close">×</button>
  </div>
  <div class="pixel-divider" />

  <!-- 查看模式 -->
  <div id="profile-view" class="pt-4 text-center">
    {avatarSrc ? (
      <img src={avatarSrc} alt={nickname} class="mx-auto size-24 rounded-full border-2 border-primary object-cover" />
    ) : (
      <span class="mx-auto inline-flex size-24 items-center justify-center rounded-full border-2 border-primary bg-muted font-display text-4xl font-semibold text-primary">
        {nickname.slice(0, 1)}
      </span>
    )}
    <h3 class="mt-3 font-display text-xl font-semibold">{nickname}</h3>
    {profile.motto && <p class="mt-1 text-sm italic text-muted-foreground">「{profile.motto}」</p>}
    {profile.bio && <p class="mt-3 text-sm leading-relaxed text-muted-foreground">{profile.bio}</p>}
    {profile.location && (
      <p class="mt-3 inline-flex items-center gap-1 text-xs text-muted-foreground">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-3.5" aria-hidden="true">
          <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z" />
          <circle cx="12" cy="10" r="3" />
        </svg>
        {profile.location}
      </p>
    )}
    {
      isAuthed && (
        <button id="profile-edit-btn" type="button" class="mt-5 rounded-md border border-border px-4 py-1.5 text-sm transition-colors hover:border-primary hover:text-primary">
          编辑资料
        </button>
      )
    }
  </div>

  <!-- 编辑模式（管理员） -->
  {
    isAuthed && (
      <div id="profile-edit" class="hidden pt-4">
        <div class="flex items-center gap-3">
          {avatarSrc ? (
            <img id="profile-avatar-preview" src={avatarSrc} alt="" class="size-16 rounded-full border border-border object-cover" />
          ) : (
            <span class="inline-flex size-16 items-center justify-center rounded-full border border-border bg-muted font-display text-xl text-primary">
              {nickname.slice(0, 1)}
            </span>
          )}
          <div class="min-w-0 flex-1">
            <input
              id="profile-avatar"
              type="text"
              placeholder="头像 URL"
              class="w-full rounded-md border border-input bg-background px-2 py-1 text-xs outline-none focus-visible:border-ring"
            />
            <div class="mt-1.5 flex items-center gap-2">
              <input id="profile-avatar-file" type="file" accept="image/*" class="hidden" />
              <button id="profile-avatar-upload" type="button" class="rounded border border-border px-2 py-0.5 text-xs transition-colors hover:border-primary hover:text-primary">
                上传头像
              </button>
              <span id="profile-avatar-status" class="text-xs text-muted-foreground"></span>
            </div>
          </div>
        </div>
        <div class="mt-4 space-y-2">
          <input id="profile-nickname" type="text" maxlength="30" placeholder="昵称" class="w-full rounded-md border border-input bg-background px-2 py-1.5 text-sm outline-none focus-visible:border-ring" />
          <input id="profile-motto" type="text" maxlength="100" placeholder="座右铭" class="w-full rounded-md border border-input bg-background px-2 py-1.5 text-sm outline-none focus-visible:border-ring" />
          <textarea id="profile-bio" rows="2" maxlength="500" placeholder="简介" class="w-full resize-y rounded-md border border-input bg-background px-2 py-1.5 text-sm outline-none focus-visible:border-ring" />
          <input id="profile-location" type="text" maxlength="100" placeholder="位置" class="w-full rounded-md border border-input bg-background px-2 py-1.5 text-sm outline-none focus-visible:border-ring" />
        </div>
        <div class="mt-4 flex justify-end gap-2">
          <button id="profile-cancel" type="button" class="rounded-md border border-border px-4 py-1.5 text-sm transition-colors hover:bg-accent">取消</button>
          <button id="profile-save" type="button" class="rounded-md bg-primary px-4 py-1.5 text-sm text-primary-foreground transition-opacity hover:opacity-90">保存</button>
        </div>
        <p id="profile-status" class="mt-2 text-xs text-destructive"></p>
      </div>
    )
  }
</dialog>

<script>
  /** 个人中心悬浮框：打开/关闭/查看↔编辑/头像上传/保存（document 委托，兼容 View Transitions） */

  function dialogEl(): HTMLDialogElement | null {
    return document.getElementById('profile-dialog') as HTMLDialogElement | null;
  }

  function openDialog(): void {
    // 实时读取服务端注入的配置（兼容 View Transitions 后元素替换）
    const dlg = dialogEl();
    let data: Record<string, string | undefined> = {};
    try {
      data = dlg?.dataset.json ? (JSON.parse(dlg.dataset.json) as Record<string, string | undefined>) : {};
    } catch {
      /* 忽略 */
    }
    const nickname = data.nickname ?? '';
    const avatar = data.avatar ?? '';
    const motto = data.motto ?? '';
    const bio = data.bio ?? '';
    const location = data.location ?? '';
    const av = document.getElementById('profile-avatar') as HTMLInputElement | null;
    const nm = document.getElementById('profile-nickname') as HTMLInputElement | null;
    const mt = document.getElementById('profile-motto') as HTMLInputElement | null;
    const bi = document.getElementById('profile-bio') as HTMLTextAreaElement | null;
    const lo = document.getElementById('profile-location') as HTMLInputElement | null;
    if (av) av.value = avatar;
    if (nm) nm.value = nickname;
    if (mt) mt.value = motto;
    if (bi) bi.value = bio;
    if (lo) lo.value = location;
    // 重置到查看模式
    document.getElementById('profile-edit')?.classList.add('hidden');
    document.getElementById('profile-view')?.classList.remove('hidden');
    const status = document.getElementById('profile-status');
    if (status) status.classList.add('hidden');
    dlg?.showModal();
  }

  function closeDialog(): void {
    dialogEl()?.close();
  }

  function switchToEdit(): void {
    document.getElementById('profile-view')?.classList.add('hidden');
    document.getElementById('profile-edit')?.classList.remove('hidden');
  }

  async function saveProfile(): Promise<void> {
    const status = document.getElementById('profile-status');
    try {
      const body = {
        nickname: (document.getElementById('profile-nickname') as HTMLInputElement | null)?.value ?? '',
        avatar: (document.getElementById('profile-avatar') as HTMLInputElement | null)?.value ?? '',
        motto: (document.getElementById('profile-motto') as HTMLInputElement | null)?.value ?? '',
        bio: (document.getElementById('profile-bio') as HTMLTextAreaElement | null)?.value ?? '',
        location: (document.getElementById('profile-location') as HTMLInputElement | null)?.value ?? '',
      };
      const res = await fetch('/api/profile', {
        method: 'PUT',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify(body),
      });
      if (!res.ok) throw new Error('保存失败');
      window.location.reload(); // 刷新导航头像/首页名片/动态
    } catch {
      if (status) {
        status.textContent = '保存失败，请重试';
        status.classList.remove('hidden');
      }
    }
  }

  /** 压缩并上传头像 → 填入头像 URL 框 */
  async function uploadAvatar(file: File): Promise<void> {
    const status = document.getElementById('profile-avatar-status');
    if (status) status.textContent = '上传中…';
    try {
      const dataUrl = await new Promise<string>((resolve, reject) => {
        const reader = new FileReader();
        reader.onload = () => resolve(String(reader.result));
        reader.onerror = () => reject(new Error('读取失败'));
        reader.readAsDataURL(file);
      });
      const img = await new Promise<HTMLImageElement>((resolve, reject) => {
        const image = new Image();
        image.onload = () => resolve(image);
        image.onerror = () => reject(new Error('图片读取失败'));
        image.src = dataUrl;
      });
      const size = Math.min(512, Math.max(img.naturalWidth, img.naturalHeight));
      const scale = size / Math.max(img.naturalWidth, img.naturalHeight);
      const w = Math.max(1, Math.round(img.naturalWidth * scale));
      const h = Math.max(1, Math.round(img.naturalHeight * scale));
      const canvas = document.createElement('canvas');
      canvas.width = w;
      canvas.height = h;
      const ctx = canvas.getContext('2d');
      if (!ctx) throw new Error('Canvas 不可用');
      ctx.drawImage(img, 0, 0, w, h);
      const base64 = canvas.toDataURL('image/jpeg', 0.85).split(',')[1] ?? '';
      const res = await fetch('/api/images', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ filename: file.name, mime: 'image/jpeg', data: base64 }),
      });
      if (!res.ok) throw new Error('上传失败');
      const out = (await res.json()) as { url?: string; error?: string };
      if (!out.url) throw new Error(out.error ?? '上传失败');
      const av = document.getElementById('profile-avatar') as HTMLInputElement | null;
      if (av) av.value = out.url;
      if (status) status.textContent = '✓ 已上传，保存后生效';
    } catch (err) {
      if (status) status.textContent = err instanceof Error ? err.message : '上传失败';
    }
  }

  // document 级委托
  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    if (target.closest('#profile-btn') || target.closest('#profile-card')) {
      openDialog();
      return;
    }
    if (target.closest('#profile-close')) {
      closeDialog();
      return;
    }
    if (target.closest('#profile-edit-btn')) {
      switchToEdit();
      return;
    }
    if (target.closest('#profile-cancel')) {
      document.getElementById('profile-edit')?.classList.add('hidden');
      document.getElementById('profile-view')?.classList.remove('hidden');
      return;
    }
    if (target.closest('#profile-save')) {
      void saveProfile();
      return;
    }
    if (target.closest('#profile-avatar-upload')) {
      (document.getElementById('profile-avatar-file') as HTMLInputElement | null)?.click();
      return;
    }
    const dlg = dialogEl();
    if (dlg && target === dlg && dlg.open) {
      closeDialog();
    }
  });

  document.addEventListener('change', (e) => {
    const input = e.target as HTMLInputElement;
    if (input.id === 'profile-avatar-file') {
      const file = input.files?.[0];
      if (file) void uploadAvatar(file);
      input.value = '';
    }
  });
</script>
