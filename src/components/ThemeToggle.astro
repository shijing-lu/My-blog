---
/*
 * ThemeToggle.astro —— 快速亮/暗切换（与主题系统共享状态）
 * Props: 无
 * Imports: 客户端主题状态
 */
---
<!-- ===== Template ===== -->
<button
  id="theme-toggle"
  type="button"
  aria-label="切换亮暗主题"
  data-mode-icon="light"
  class="inline-flex size-9 items-center justify-center rounded-md text-muted-foreground transition-colors duration-200 hover:bg-accent hover:text-accent-foreground"
>
  <!-- 暗色时显示太阳（切回亮色） -->
  <svg class="hidden size-5 dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <circle cx="12" cy="12" r="4" />
    <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41" />
  </svg>
  <!-- 亮色时显示月亮（切回暗色） -->
  <svg class="block size-5 dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z" />
  </svg>
</button>

<script>
  import { readState, writeState, isDark } from '@/lib/theme';

  /** 依据当前状态同步 <html> 的 dark 类（图标切换由 CSS dark: 变体处理） */
  const apply = (): void => {
    document.documentElement.classList.toggle('dark', isDark(readState()));
  };

  // document 级事件委托：点击任意 #theme-toggle 生效，
  // View Transitions 后元素被替换也无需重新绑定
  document.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest('#theme-toggle');
    if (!btn) return;
    const state = readState();
    // 快速切换：亮/暗互切；当前为 system 时按随即偏好落定
    const nextMode = isDark(state) ? 'light' : 'dark';
    writeState({ ...state, mode: nextMode });
  });

  // 初始加载与每次 View Transition 后同步一次（head 内联脚本可能在导航时重置状态）
  document.addEventListener('astro:page-load', apply);
  apply();
</script>
