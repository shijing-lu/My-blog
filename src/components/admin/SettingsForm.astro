<script>
  import { confirmDialog, confirmDanger } from '@/lib/confirm';
  import { scopeMdCss } from '@/lib/md-css-scope';

  /** 幂等初始化：以 #settings-form-root[data-inited] 防重复绑定；
   * - /admin/settings（无 ClientRouter）模块加载即执行；
   * - 前台弹窗页（ClientRouter）astro:page-load 随 DOM 重建重初始化。 */
  function initSettingsForm(): void {
    const formRoot = document.getElementById('settings-form-root');
    if (!formRoot || formRoot.dataset.inited === '1') return;
    formRoot.dataset.inited = '1';

    /* ---------- Markdown 样式自定义（上传/编辑/恢复默认，预览实时生效） ---------- */
    const mdSection = document.getElementById('md-css');
    if (mdSection) {
      const mdText = document.getElementById('mdcss-text') as HTMLTextAreaElement | null;
      const mdFile = document.getElementById('mdcss-file') as HTMLInputElement | null;
      const mdFileName = document.getElementById('mdcss-file-name');
      const mdState = document.getElementById('mdcss-state');
      const mdErr = document.getElementById('mdcss-err');
      const mdHint = document.getElementById('mdcss-saved-hint');
      const mdSaveBtn = document.getElementById('mdcss-save');
      const mdResetBtn = document.getElementById('mdcss-reset');
      /** 预览样式标签：SSR 已注入则复用，否则动态创建 */
      let previewStyle = document.getElementById('mdcss-preview-style') as HTMLStyleElement | null;

      const setMdErr = (msg: string): void => {
        if (!mdErr) return;
        mdErr.textContent = msg;
        mdErr.classList.toggle('hidden', !msg);
      };
      const flashMdHint = (msg: string): void => {
        if (!mdHint) return;
        mdHint.textContent = msg;
        window.setTimeout(() => {
          mdHint.textContent = '';
        }, 2000);
      };
      const renderMdState = (css: string, updatedAtMs: number | null): void => {
        if (!mdState) return;
        mdState.textContent =
          css.trim() !== ''
            ? `已自定义（${Math.max(1, Math.ceil(css.length / 1024))}KB${updatedAtMs != null ? `，更新于 ${new Date(updatedAtMs).toLocaleString('zh-CN')}` : ''}）`
            : '当前使用站点默认样式';
      };
      /** 编辑实时预览：作用域化后写入（或创建）预览 <style> */
      const applyPreview = (css: string): void => {
        if (!previewStyle) {
          previewStyle = document.createElement('style');
          previewStyle.id = 'mdcss-preview-style';
          document.head.appendChild(previewStyle);
        }
        previewStyle.textContent = scopeMdCss(css);
      };

      applyPreview(mdText?.value ?? '');

      /* 选择 CSS 文件（重新上传 = 再次选择覆盖文本框） */
      document.getElementById('mdcss-choose')?.addEventListener('click', () => mdFile?.click());
      mdFile?.addEventListener('change', () => {
        const file = mdFile.files?.[0];
        if (!file) return;
        if (file.size > 256 * 1024) {
          setMdErr('CSS 文件过大（上限 256KB）');
          mdFile.value = '';
          return;
        }
        const reader = new FileReader();
        reader.onload = () => {
          const text = String(reader.result);
          if (mdText) mdText.value = text;
          if (mdFileName) mdFileName.textContent = file.name;
          applyPreview(text);
          setMdErr('');
        };
        reader.onerror = () => setMdErr('文件读取失败');
        reader.readAsText(file);
      });

      /* 文本编辑 → 预览实时生效 */
      mdText?.addEventListener('input', () => {
        applyPreview(mdText.value);
        if (mdFileName) mdFileName.textContent = '已手动编辑（保存后生效）';
      });

      /* 保存并应用（全站生效：SSR 注入，游客侧缓存最多延迟 ~60s） */
      mdSaveBtn?.addEventListener('click', async () => {
        const css = mdText?.value ?? '';
        if (css.length > 64 * 1024) {
          setMdErr('CSS 过长（上限 64KB）');
          return;
        }
        mdSaveBtn.setAttribute('disabled', '');
        try {
          const res = await fetch('/api/md-css', {
            method: 'PUT',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify({ css }),
          });
          const d = (await res.json().catch(() => ({}))) as { error?: string; updatedAt?: number | null };
          if (!res.ok) throw new Error(d.error ?? '保存失败');
          setMdErr('');
          renderMdState(css, d.updatedAt ?? Date.now());
          if (css.trim() === '') flashMdHint('已清空自定义样式');
          else flashMdHint('已保存并应用');
        } catch (err) {
          setMdErr(err instanceof Error ? err.message : '保存失败，请重试');
        } finally {
          mdSaveBtn.removeAttribute('disabled');
        }
      });

      /* 恢复默认样式（清除 DB 记录） */
      mdResetBtn?.addEventListener('click', async () => {
        if (!(await confirmDanger('恢复默认 Markdown 样式？将删除当前自定义 CSS。'))) return;
        mdResetBtn.setAttribute('disabled', '');
        try {
          const res = await fetch('/api/md-css', { method: 'DELETE' });
          const d = (await res.json().catch(() => ({}))) as { error?: string };
          if (!res.ok) throw new Error(d.error ?? '恢复失败');
          if (mdText) mdText.value = '';
          if (mdFileName) mdFileName.textContent = '未选择（可直接在下方编辑）';
          applyPreview('');
          renderMdState('', null);
          setMdErr('');
          flashMdHint('已恢复默认样式');
        } catch (err) {
          setMdErr(err instanceof Error ? err.message : '恢复失败，请重试');
        } finally {
          mdResetBtn.removeAttribute('disabled');
        }
      });

      /* ---------- 样式库（命名保存 / 下拉选择一键应用 / 更新 / 删除） ---------- */
      const libSelect = document.getElementById('mdcss-lib-select') as HTMLSelectElement | null;
      const libName = document.getElementById('mdcss-lib-name') as HTMLInputElement | null;
      const libSaveBtn = document.getElementById('mdcss-lib-save');
      const libUpdateBtn = document.getElementById('mdcss-lib-update');
      const libDeleteBtn = document.getElementById('mdcss-lib-delete');
      const libCount = document.getElementById('mdcss-lib-count');

      /** 有无选中项 → 更新/删除按钮可用性 */
      const syncLibButtons = (): void => {
        const hasSel = !!libSelect?.value;
        libUpdateBtn?.toggleAttribute('disabled', !hasSel);
        libDeleteBtn?.toggleAttribute('disabled', !hasSel);
      };

      /** 操作后重拉列表重建 options（selectId 传入时恢复选中到该条） */
      const refreshLib = async (selectId?: string): Promise<void> => {
        if (!libSelect) return;
        try {
          const res = await fetch('/api/md-css/library');
          if (!res.ok) return;
          const d = (await res.json()) as { items?: { id: string; name: string; cssLength: number }[] };
          const items = d.items ?? [];
          libSelect.innerHTML = '';
          const ph = document.createElement('option');
          ph.value = '';
          ph.textContent = items.length ? `选择已保存样式…（共 ${items.length} 个）` : '样式库为空';
          libSelect.appendChild(ph);
          for (const it of items) {
            const o = document.createElement('option');
            o.value = it.id;
            o.textContent = `${it.name}（${Math.max(1, Math.ceil(it.cssLength / 1024))}KB）`;
            libSelect.appendChild(o);
          }
          if (selectId && items.some((it) => it.id === selectId)) libSelect.value = selectId;
          if (libCount) libCount.textContent = `共 ${items.length} 个`;
        } catch {
          /* 静默：下次操作再刷新 */
        }
        syncLibButtons();
      };

      /* 下拉选中 → 取单条填入编辑框 + 实时预览（一键应用） */
      libSelect?.addEventListener('change', async () => {
        const sel = libSelect;
        if (!sel) return;
        syncLibButtons();
        const id = sel.value;
        if (!id) return;
        try {
          const res = await fetch(`/api/md-css/library?id=${encodeURIComponent(id)}`);
          const d = (await res.json().catch(() => ({}))) as { item?: { name: string; css: string }; error?: string };
          if (!res.ok || !d.item) throw new Error(d.error ?? '样式读取失败');
          if (mdText) mdText.value = d.item.css;
          if (mdFileName) mdFileName.textContent = `来自样式库：${d.item.name}`;
          applyPreview(d.item.css);
          if (libName) libName.value = d.item.name;
          setMdErr('');
        } catch (err) {
          setMdErr(err instanceof Error ? err.message : '样式读取失败，请重试');
        }
      });

      /* 将当前编辑框内容存为命名样式 */
      libSaveBtn?.addEventListener('click', async () => {
        const btn = libSaveBtn;
        if (!btn) return;
        const name = (libName?.value ?? '').trim();
        const css = mdText?.value ?? '';
        if (name === '') {
          setMdErr('请先填写样式名称');
          return;
        }
        if (css.trim() === '') {
          setMdErr('编辑框内容为空，无可保存');
          return;
        }
        if (css.length > 64 * 1024) {
          setMdErr('CSS 过长（上限 64KB）');
          return;
        }
        btn.setAttribute('disabled', '');
        try {
          const res = await fetch('/api/md-css/library', {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify({ name, css }),
          });
          const d = (await res.json().catch(() => ({}))) as { item?: { id: string; name: string }; error?: string };
          if (!res.ok || !d.item) throw new Error(d.error ?? '保存失败');
          await refreshLib(d.item.id);
          setMdErr('');
          flashMdHint(`已保存样式「${d.item.name}」`);
        } catch (err) {
          setMdErr(err instanceof Error ? err.message : '保存失败，请重试');
        } finally {
          btn.removeAttribute('disabled');
