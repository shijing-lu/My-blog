      /* ---------- 诗词轮播 ---------- */

      interface QuoteConfig {
        text: string;
        pauseMs?: number;
      }
      interface HeroSettings {
        quotes: QuoteConfig[];
        charIntervalMs: number;
        defaultPauseMs: number;
      }

      function esc(value: string): string {
        return String(value).replace(/[&<>"']/g, (c) => {
          const map: Record<string, string> = { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' };
          return map[c] ?? c;
        });
      }

      /** 读取服务端注入的初始配置 */
      function readInitial(): HeroSettings {
        const el = document.getElementById('hero-quotes');
        const raw = el?.dataset.settings;
        if (raw) {
          try {
            return JSON.parse(raw) as HeroSettings;
          } catch {
            /* 兜底 */
          }
        }
        return { quotes: [], charIntervalMs: 420, defaultPauseMs: 4200 };
      }

      const initial = readInitial();
      const list = document.getElementById('s-quotes') as HTMLDivElement | null;
      const charMs = document.getElementById('s-char-ms') as HTMLInputElement | null;
      const pauseMs = document.getElementById('s-pause-ms') as HTMLInputElement | null;

      /** 创建一行诗词编辑行 */
      function createRow(q?: { text: string; pauseMs?: number }): HTMLDivElement {
        const row = document.createElement('div');
        row.className = 'qs-row flex items-center gap-1.5';
        row.innerHTML = `
          <input type="text" class="qs-text min-w-0 flex-1 rounded-md border border-input bg-background px-2 py-1 text-sm outline-none focus-visible:border-ring" placeholder="诗词内容" value="${esc(q?.text ?? '')}">
          <input type="number" class="qs-pause w-20 rounded-md border border-input bg-background px-2 py-1 text-xs outline-none focus-visible:border-ring" min="0" step="100" placeholder="停留ms" value="${q?.pauseMs ?? ''}">
          <button type="button" class="qs-del shrink-0 rounded-md px-2 py-1 text-sm text-destructive hover:bg-destructive/10" title="删除" aria-label="删除该条">×</button>`;
        return row;
      }

      function renderRows(quotes: QuoteConfig[]): void {
        if (!list) return;
        list.innerHTML = '';
        quotes.forEach((q) => list.appendChild(createRow(q)));
      }

      function collectQuotes(): QuoteConfig[] {
        if (!list) return [];
        const out: QuoteConfig[] = [];
        list.querySelectorAll<HTMLElement>('.qs-row').forEach((row) => {
          const text = row.querySelector<HTMLInputElement>('.qs-text')?.value.trim() ?? '';
          if (!text) return;
          const pauseRaw = row.querySelector<HTMLInputElement>('.qs-pause')?.value ?? '';
          out.push({ text, pauseMs: pauseRaw === '' ? undefined : Number(pauseRaw) });
        });
        return out;
      }

      function setStatus(message: string, kind: 'error' | 'saved'): void {
        const status = document.getElementById('s-status');
        const hint = document.getElementById('s-saved-hint');
        if (!status || !hint) return;
        if (kind === 'error') {
          status.textContent = message;
          status.classList.remove('hidden');
          hint.textContent = '';
        } else {
          status.classList.add('hidden');
          hint.textContent = message;
          window.setTimeout(() => { hint.textContent = ''; }, 2000);
        }
      }

      async function save(): Promise<void> {
        const quotes = collectQuotes();
        if (quotes.length === 0) {
          setStatus('至少保留一条诗词', 'error');
          return;
        }
        try {
          const body: HeroSettings = {
            quotes,
            charIntervalMs: Number(charMs?.value) || 420,
            defaultPauseMs: Number(pauseMs?.value) || 4200,
          };
          const res = await fetch('/api/quote-settings', {
            method: 'PUT',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify(body),
          });
          if (!res.ok) throw new Error('保存失败');
          setStatus('已保存并应用', 'saved');
        } catch {
          setStatus('保存失败，请重试', 'error');
        }
      }

      // 回显初始配置
      if (charMs) charMs.value = String(initial.charIntervalMs);
      if (pauseMs) pauseMs.value = String(initial.defaultPauseMs);
      renderRows(initial.quotes);

      // 事件绑定（admin 页全页加载，无需 View Transitions 兼容）
      document.getElementById('s-add')?.addEventListener('click', () => list?.appendChild(createRow()));
      document.getElementById('s-save')?.addEventListener('click', () => void save());
      formRoot.addEventListener('click', (e) => {
        const del = (e.target as HTMLElement).closest<HTMLElement>('.qs-del');
        if (del) del.closest<HTMLElement>('.qs-row')?.remove();
      });

      // ---------- 站点背景表单（统一 / 按页面） ----------
      interface PageBackground {
        imageUrl: string;
        opacity: number;
        blur: number;
      }
      interface SiteBackground {
        mode: 'unified' | 'pages';
        enabled: boolean;
        imageUrl: string;
        opacity: number;
        blur: number;
        pages: Record<string, PageBackground>;
        stardust: boolean;
      }

      const PAGE_KEY_LABELS: Record<string, string> = {
        home: '首页', doc: '文档', nav: '导航', gallery: '影集',
        calendar: '日历', moments: '动态', blog: '文章详情', login: '登录页', other: '其他页面',
      };

      const bgSection = document.getElementById('appearance'); // data-bg 挂在 #appearance 上（外观分区）
      let bgInitial: SiteBackground = { mode: 'unified', enabled: false, imageUrl: '', opacity: 50, blur: 0, pages: {}, stardust: true };
      try {
        if (bgSection?.dataset.bg) bgInitial = JSON.parse(bgSection.dataset.bg) as SiteBackground;
      } catch {
        /* dataset.bg 损坏时用默认 */
      }
      let bgMode: 'unified' | 'pages' = bgInitial.mode === 'pages' ? 'pages' : 'unified';
      const pageRows: Record<string, PageBackground> = {};

      const bgEnabled = document.getElementById('bg-enabled') as HTMLInputElement | null;
      const bgStardust = document.getElementById('bg-stardust') as HTMLInputElement | null;
      const bgImage = document.getElementById('bg-image') as HTMLInputElement | null;
      const bgOpacity = document.getElementById('bg-opacity') as HTMLInputElement | null;
      const bgBlur = document.getElementById('bg-blur') as HTMLInputElement | null;
      const bgOpacityVal = document.getElementById('bg-opacity-val');
      const bgBlurVal = document.getElementById('bg-blur-val');
      const bgModeUnifiedBtn = document.getElementById('bg-mode-unified');
      const bgModePagesBtn = document.getElementById('bg-mode-pages');
      const bgPagesPanel = document.getElementById('bg-pages-panel');
      const bgPagesList = document.getElementById('bg-pages-list') as HTMLDivElement | null;

      function updateBgSliders(): void {
        if (bgOpacity && bgOpacityVal) bgOpacityVal.textContent = `${bgOpacity.value}%`;
        if (bgBlur && bgBlurVal) bgBlurVal.textContent = `${bgBlur.value}px`;
      }

      /** 模式渲染：切换面板与按钮高亮 */
      function renderBgMode(): void {
        const unified = bgMode === 'unified';
        (document.getElementById('bg-unified-panel') as HTMLElement | null)?.classList.toggle('hidden', !unified);
        if (bgPagesPanel) bgPagesPanel.classList.toggle('hidden', unified);
        bgModeUnifiedBtn?.classList.toggle('bg-primary/10', unified);
        bgModeUnifiedBtn?.classList.toggle('text-primary', unified);
        bgModePagesBtn?.classList.toggle('bg-primary/10', !unified);
        bgModePagesBtn?.classList.toggle('text-primary', !unified);
      }

      /** 构建每页配置行（含回填） */
      function renderPageRows(): void {
        if (!bgPagesList) return;
        bgPagesList.innerHTML = '';
        Object.entries(PAGE_KEY_LABELS).forEach(([key, label]) => {
          const row = document.createElement('div');
          row.className = 'rounded-md border border-border/70 px-3 py-2';
          row.innerHTML = `
            <div class="flex items-center justify-between">
              <span class="text-xs font-medium">${label}</span>
              <button type="button" data-page-clear="${key}" class="text-xs text-muted-foreground hover:text-destructive">清除</button>
            </div>
            <div class="mt-2 flex flex-wrap items-center gap-2">
              <input type="file" accept="image/*" class="hidden" data-page-file="${key}" />
              <button type="button" data-page-upload="${key}" class="rounded-md border border-border px-2.5 py-1 text-xs transition-colors hover:border-primary hover:text-primary">上传图片</button>
              <input type="url" data-page-url="${key}" placeholder="背景图 URL" class="min-w-0 flex-1 rounded-md border border-input bg-background px-2 py-1 text-xs outline-none focus-visible:border-ring" />
            </div>
            <div class="mt-2 flex flex-wrap items-center gap-4">
              <label class="flex items-center gap-2 text-xs text-muted-foreground">透明度
                <input type="range" min="0" max="100" step="5" data-page-opacity="${key}" class="flex-1 accent-[var(--color-primary)]" />
                <span data-page-opacity-val="${key}" class="font-pixel text-primary"></span>
              </label>
              <label class="flex items-center gap-2 text-xs text-muted-foreground">模糊
                <input type="range" min="0" max="24" step="1" data-page-blur="${key}" class="flex-1 accent-[var(--color-primary)]" />
                <span data-page-blur-val="${key}" class="font-pixel text-primary"></span>
              </label>
            </div>`;
          bgPagesList.appendChild(row);
        });
        // 回填已有配置
        Object.entries(bgInitial.pages ?? {}).forEach(([key, pb]) => {
          if (pb && pb.imageUrl) pageRows[key] = { imageUrl: pb.imageUrl, opacity: pb.opacity ?? 50, blur: pb.blur ?? 0 };
        });
        Object.keys(PAGE_KEY_LABELS).forEach((key) => {
          const pb = pageRows[key];
          const url = bgPagesList.querySelector<HTMLInputElement>(`[data-page-url="${key}"]`);
          const op = bgPagesList.querySelector<HTMLInputElement>(`[data-page-opacity="${key}"]`);
          const bl = bgPagesList.querySelector<HTMLInputElement>(`[data-page-blur="${key}"]`);
          const opv = bgPagesList.querySelector<HTMLElement>(`[data-page-opacity-val="${key}"]`);
          const blv = bgPagesList.querySelector<HTMLElement>(`[data-page-blur-val="${key}"]`);
          if (url) url.value = pb?.imageUrl ?? '';
          if (op) op.value = String(pb?.opacity ?? 50);
          if (bl) bl.value = String(pb?.blur ?? 0);
          if (opv) opv.textContent = `${op?.value ?? 50}%`;
          if (blv) blv.textContent = `${bl?.value ?? 0}px`;
        });
      }

      if (bgEnabled) bgEnabled.checked = bgInitial.enabled;
      if (bgStardust) bgStardust.checked = bgInitial.stardust !== false;
      if (bgImage) bgImage.value = bgInitial.imageUrl;
      if (bgOpacity) bgOpacity.value = String(bgInitial.opacity);
      if (bgBlur) bgBlur.value = String(bgInitial.blur);
      updateBgSliders();
      bgOpacity?.addEventListener('input', updateBgSliders);
      bgBlur?.addEventListener('input', updateBgSliders);
      renderPageRows();
      renderBgMode();

      // 模式切换
      bgModeUnifiedBtn?.addEventListener('click', () => { bgMode = 'unified'; renderBgMode(); });
      bgModePagesBtn?.addEventListener('click', () => { bgMode = 'pages'; renderBgMode(); });

      // 每页行：URL/透明度/模糊 变更同步到 pageRows
      bgPagesList?.addEventListener('input', (e) => {
        const t = e.target as HTMLInputElement;
        const key = t.dataset.pageUrl ?? t.dataset.pageOpacity ?? t.dataset.pageBlur ?? '';
        if (!key || !(key in PAGE_KEY_LABELS)) return;
        const row = pageRows[key] ?? { imageUrl: '', opacity: 50, blur: 0 };
        if (t.dataset.pageUrl !== undefined) row.imageUrl = t.value.trim();
        if (t.dataset.pageOpacity !== undefined) {
          row.opacity = Number(t.value) || 50;
          const v = bgPagesList.querySelector<HTMLElement>(`[data-page-opacity-val="${key}"]`);
          if (v) v.textContent = `${t.value}%`;
        }
        if (t.dataset.pageBlur !== undefined) {
          row.blur = Number(t.value) || 0;
          const v = bgPagesList.querySelector<HTMLElement>(`[data-page-blur-val="${key}"]`);
          if (v) v.textContent = `${t.value}px`;
        }
        pageRows[key] = row;
      });

      // 每页行：上传 / 清除
      formRoot.addEventListener('click', (e) => {
        const target = e.target as HTMLElement;
        const upload = target.closest<HTMLElement>('[data-page-upload]');
        if (upload) {
          const key = upload.dataset.pageUpload ?? '';
          bgPagesList?.querySelector<HTMLInputElement>(`[data-page-file="${key}"]`)?.click();
          return;
        }
        const clear = target.closest<HTMLElement>('[data-page-clear]');
        if (clear) {
          const key = clear.dataset.pageClear ?? '';
          delete pageRows[key];
          const url = bgPagesList?.querySelector<HTMLInputElement>(`[data-page-url="${key}"]`);
          if (url) url.value = '';
        }
      });
      bgPagesList?.addEventListener('change', async (e) => {
        const input = e.target as HTMLInputElement;
        const key = input.dataset.pageFile ?? '';
        const file = input.files?.[0];
        if (!key || !file) return;
        try {
          const base64 = await compressImage(file);
          const res = await fetch('/api/images', {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify({ filename: file.name, mime: 'image/jpeg', data: base64 }),
          });
          const out = (await res.json().catch(() => ({}))) as { url?: string; error?: string };
          if (!res.ok || !out.url) throw new Error(out.error ?? '上传失败');
          const urlInput = bgPagesList.querySelector<HTMLInputElement>(`[data-page-url="${key}"]`);
          if (urlInput) urlInput.value = out.url;
          const row = pageRows[key] ?? { imageUrl: '', opacity: 50, blur: 0 };
          row.imageUrl = out.url;
          pageRows[key] = row;
        } catch (err) {
          window.alert(err instanceof Error ? err.message : '上传失败');
        } finally {
          input.value = '';
        }
      });

      /** 压缩本地图片为 JPEG base64（宽 ≤1920） */
      async function compressImage(file: File): Promise<string> {
        const dataUrl = await new Promise<string>((resolve, reject) => {
          const reader = new FileReader();
          reader.onload = () => resolve(String(reader.result));
          reader.onerror = () => reject(new Error('读取失败'));
          reader.readAsDataURL(file);
        });
        const img = await new Promise<HTMLImageElement>((resolve, reject) => {
          const image = new Image();
          image.onload = () => resolve(image);
          image.onerror = () => reject(new Error('图片读取失败'));
          image.src = dataUrl;
        });
        const scale = Math.min(1, 1920 / img.naturalWidth);
        const w = Math.max(1, Math.round(img.naturalWidth * scale));
        const h = Math.max(1, Math.round(img.naturalHeight * scale));
        const canvas = document.createElement('canvas');
        canvas.width = w;
        canvas.height = h;
        const ctx = canvas.getContext('2d');
        if (!ctx) throw new Error('Canvas 不可用');
        ctx.drawImage(img, 0, 0, w, h);
        let q = 0.85;
        let b64 = canvas.toDataURL('image/jpeg', q).split(',')[1] ?? '';
        while (b64.length > 3.5 * 1024 * 1024 && q > 0.4) {
          q -= 0.1;
          b64 = canvas.toDataURL('image/jpeg', q).split(',')[1] ?? '';
        }
        return b64;
      }

      // 上传本地背景图 → /api/images → 填入 URL 框
      document.getElementById('bg-upload')?.addEventListener('click', () => {
        (document.getElementById('bg-file') as HTMLInputElement | null)?.click();
      });
      document.getElementById('bg-file')?.addEventListener('change', async (e) => {
        const input = e.target as HTMLInputElement;
        const file = input.files?.[0];
        if (!file) return;
        const status = document.getElementById('bg-upload-status');
        if (status) status.textContent = '上传中…';
        try {
          const base64 = await compressImage(file);
          const res = await fetch('/api/images', {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify({ filename: file.name, mime: 'image/jpeg', data: base64 }),
          });
          if (!res.ok) throw new Error('上传失败');
          const out = (await res.json()) as { url?: string; error?: string };
          if (!out.url) throw new Error(out.error ?? '上传失败');
          if (bgImage) bgImage.value = out.url;
          if (bgEnabled) bgEnabled.checked = true;
          if (status) status.textContent = '✓ 已上传，点击「保存并应用」生效';
        } catch (err) {
          if (status) status.textContent = err instanceof Error ? err.message : '上传失败';
        } finally {
          input.value = '';
        }
      });

      document.getElementById('bg-save')?.addEventListener('click', async () => {
        const status = document.getElementById('bg-status');
        const hint = document.getElementById('bg-saved-hint');
        try {
          const body: Record<string, unknown> = { mode: bgMode, stardust: bgStardust?.checked ?? true };
          if (bgMode === 'pages') {
            // 仅提交有 URL 的页面
            const pages: Record<string, PageBackground> = {};
            Object.entries(pageRows).forEach(([key, pb]) => {
              if (pb.imageUrl.trim()) pages[key] = { imageUrl: pb.imageUrl.trim(), opacity: pb.opacity, blur: pb.blur };
            });
            body.pages = pages;
          } else {
            const imageUrl = (bgImage?.value ?? '').trim();
            if (bgEnabled?.checked && !imageUrl) {
              if (status) { status.textContent = '开启背景需要填写图片 URL'; status.classList.remove('hidden'); }
              return;
            }
            // Number(...) || 50 会把 0 误判为缺省 → 用 Number.isFinite 判断，允许 opacity=0 / blur=0
            const rawOpacity = Number(bgOpacity?.value);
            const rawBlur = Number(bgBlur?.value);
            body.enabled = bgEnabled?.checked ?? false;
            body.imageUrl = imageUrl;
            body.opacity = Number.isFinite(rawOpacity) ? rawOpacity : 50;
            body.blur = Number.isFinite(rawBlur) ? rawBlur : 0;
          }
          const res = await fetch('/api/background', {
            method: 'PUT',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify(body),
          });
          if (!res.ok) throw new Error('保存失败');
          if (status) status.classList.add('hidden');
          if (hint) {
            hint.textContent = '已保存并应用';
            window.setTimeout(() => { hint.textContent = ''; }, 2000);
          }
        } catch {
          if (status) { status.textContent = '保存失败，请重试'; status.classList.remove('hidden'); }
        }
      });

        /* ---------- 落地页头图（多图轮播 + 副标题） ---------- */
      interface Landing {
        images: string[];
        intervalSec: number;
        animation: 'slide' | 'break';
        subtitle: string;
      }
      const landingEl = document.getElementById('landing');
      let landingInitial: Landing = { images: [], intervalSec: 6, animation: 'slide', subtitle: '' };
      try {
        if (landingEl?.dataset.landing) landingInitial = JSON.parse(landingEl.dataset.landing) as Landing;
      } catch {
        /* dataset 损坏时用默认 */
      }

      let landingImages: string[] = Array.isArray(landingInitial.images) ? landingInitial.images.slice() : [];
      let landingInterval = Number(landingInitial.intervalSec) || 6;
      let landingAnimation: 'slide' | 'break' = landingInitial.animation === 'break' ? 'break' : 'slide';
      let landingSubtitle = landingInitial.subtitle || '';

      const landingList = document.getElementById('landing-images') as HTMLDivElement | null;
      const landingEmpty = document.getElementById('landing-empty') as HTMLParagraphElement | null;
      const landingStatus = document.getElementById('landing-status') as HTMLSpanElement | null;
      const landingErr = document.getElementById('landing-err') as HTMLParagraphElement | null;
      const landingHint = document.getElementById('landing-saved-hint') as HTMLSpanElement | null;
      const landingIntervalEl = document.getElementById('landing-interval') as HTMLInputElement | null;
      const landingAnimEl = document.getElementById('landing-animation') as HTMLSelectElement | null;
      const landingSubtitleEl = document.getElementById('landing-subtitle') as HTMLInputElement | null;

      function setLandingErr(msg: string): void {
        if (!landingErr) return;
        landingErr.textContent = msg;
        landingErr.classList.toggle('hidden', !msg);
      }

      /** 渲染多图列表（缩略图 + 上移/下移/删除） */
      function renderLanding(): void {
        if (!landingList || !landingEmpty) return;
        landingList.innerHTML = '';
        landingEmpty.classList.toggle('hidden', landingImages.length > 0);
        landingImages.forEach((url, i) => {
          const row = document.createElement('div');
          row.className = 'flex items-center gap-2 rounded-md border border-border/70 px-2 py-1.5';
          row.innerHTML = `
            <img src="${esc(url)}" alt="" class="h-10 w-16 shrink-0 rounded object-cover">
            <span class="min-w-0 flex-1 truncate text-xs text-muted-foreground">${esc(url)}</span>
            <div class="flex shrink-0 gap-1">
              <button type="button" data-landing-move="${i}" data-dir="-1" class="rounded border border-border px-1.5 py-0.5 text-xs disabled:opacity-30" ${i === 0 ? 'disabled' : ''}>↑</button>
              <button type="button" data-landing-move="${i}" data-dir="1" class="rounded border border-border px-1.5 py-0.5 text-xs disabled:opacity-30" ${i === landingImages.length - 1 ? 'disabled' : ''}>↓</button>
              <button type="button" data-landing-del="${i}" class="rounded border border-destructive/40 px-1.5 py-0.5 text-xs text-destructive">×</button>
            </div>`;
          landingList.appendChild(row);
        });
        if (landingIntervalEl) landingIntervalEl.value = String(landingInterval);
        if (landingAnimEl) landingAnimEl.value = landingAnimation;
        if (landingSubtitleEl) landingSubtitleEl.value = landingSubtitle;
      }
      renderLanding();

      landingIntervalEl?.addEventListener('input', () => {
        landingInterval = Number(landingIntervalEl.value) || 6;
      });
      landingAnimEl?.addEventListener('change', () => {
        landingAnimation = landingAnimEl.value === 'break' ? 'break' : 'slide';
      });
      landingSubtitleEl?.addEventListener('input', () => {
        landingSubtitle = landingSubtitleEl.value;
      });

      // 选择本地图片（可多选）→ 压缩 → /api/images 上传 → 追加到列表
      document.getElementById('landing-choose')?.addEventListener('click', () => {
        (document.getElementById('landing-file') as HTMLInputElement | null)?.click();
      });
      document.getElementById('landing-file')?.addEventListener('change', async (e) => {
        const input = e.target as HTMLInputElement;
        const files = Array.from(input.files ?? []);
        if (files.length === 0) return;
        if (landingStatus) landingStatus.textContent = '上传中…';
        setLandingErr('');
        try {
          for (const file of files) {
            const base64 = await compressImage(file);
            const res = await fetch('/api/images', {
              method: 'POST',
              headers: { 'content-type': 'application/json' },
              body: JSON.stringify({ filename: file.name, mime: 'image/jpeg', data: base64 }),
            });
            const out = (await res.json().catch(() => ({}))) as { url?: string; error?: string };
            if (!res.ok || !out.url) throw new Error(out.error ?? '上传失败');
            landingImages.push(out.url);
          }
          renderLanding();
          if (landingStatus) landingStatus.textContent = `✓ 已添加 ${files.length} 张，点击「保存并应用」生效`;
        } catch (err) {
          if (landingStatus) landingStatus.textContent = '可多选，自动压缩（宽 ≤1920px）';
          setLandingErr(err instanceof Error ? err.message : '上传失败');
        } finally {
          input.value = '';
        }
      });

      // 列表操作（删除 / 上移下移，document 委托）
      formRoot.addEventListener('click', (e) => {
        const del = (e.target as HTMLElement).closest<HTMLElement>('[data-landing-del]');
        if (del) {
          const i = Number(del.dataset.landingDel);
          if (Number.isInteger(i) && i >= 0 && i < landingImages.length) {
            landingImages.splice(i, 1);
            renderLanding();
          }
          return;
        }
        const mv = (e.target as HTMLElement).closest<HTMLElement>('[data-landing-move]');
        if (mv) {
          const i = Number(mv.dataset.landingMove);
          const dir = Number(mv.dataset.dir);
          const j = i + dir;
          if (Number.isInteger(i) && j >= 0 && j < landingImages.length) {
            const [x] = landingImages.splice(i, 1);
            landingImages.splice(j, 0, x!);
            renderLanding();
          }
        }
      });

      // 保存（多图 + 间隔 + 动画 + 副标题）
      document.getElementById('landing-save')?.addEventListener('click', async () => {
        setLandingErr('');
        try {
          const res = await fetch('/api/landing', {
            method: 'PUT',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify({
              images: landingImages,
              intervalSec: landingInterval,
              animation: landingAnimation,
              subtitle: landingSubtitle,
            }),
          });
          const d = (await res.json().catch(() => ({}))) as { error?: string };
          if (!res.ok) throw new Error(d.error ?? '保存失败');
          if (landingHint) {
            landingHint.textContent = '已保存并应用';
            window.setTimeout(() => { landingHint.textContent = ''; }, 2000);
          }
        } catch (err) {
          setLandingErr(err instanceof Error ? err.message : '保存失败');
        }
      });

      // 恢复文章封面（清空图片；保留间隔/动画/副标题）
      document.getElementById('landing-clear')?.addEventListener('click', async () => {
        if (!(await confirmDialog('恢复为文章封面？将清除所有自定义头图。'))) return;
        setLandingErr('');
        try {
          const res = await fetch('/api/landing', {
            method: 'PUT',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify({
              images: [],
              intervalSec: landingInterval,
              animation: landingAnimation,
              subtitle: landingSubtitle,
            }),
          });
          if (!res.ok) throw new Error('清空失败');
          landingImages = [];
          renderLanding();
          if (landingHint) {
            landingHint.textContent = '已恢复为文章封面';
            window.setTimeout(() => { landingHint.textContent = ''; }, 2000);
          }
        } catch (err) {
          setLandingErr(err instanceof Error ? err.message : '清空失败');
        }
      });

    /* ---------- 全局字体设置 ---------- */
      const appearanceEl = document.getElementById('appearance');
      const fontArticle = document.getElementById('font-article') as HTMLSelectElement | null;
      const fontUi = document.getElementById('font-ui') as HTMLSelectElement | null;
      const fontScale = document.getElementById('font-scale') as HTMLSelectElement | null;

      /** 初始化两个字体下拉与字号缩放为当前设置 */
      function initFontSelects(): void {
        const raw = appearanceEl?.dataset.fonts;
        if (!raw) return;
        try {
          const s = JSON.parse(raw) as { article: { type: string; value: string }; ui: { type: string; value: string }; scale?: number };
          if (fontArticle) fontArticle.value = `${s.article.type}:${s.article.value}`;
          if (fontUi) fontUi.value = `${s.ui.type}:${s.ui.value}`;
          if (fontScale) fontScale.value = String(s.scale ?? 100);
        } catch {
          /* 保持默认 */
        }
      }
      initFontSelects();

      /** 字体模式：手动设置（全站优先）或跟随主题 */
      const fontModeText = document.getElementById('font-mode-text');
      const fontFollowTheme = document.getElementById('font-follow-theme');
      const fontModeStatus = document.getElementById('font-mode-status');
      const hasManualFonts = appearanceEl?.dataset.hasManualFonts === 'true';
      function renderFontMode(): void {
        if (!fontModeText || !fontFollowTheme) return;
        if (hasManualFonts) {
          fontModeText.textContent = '当前：手动字体（全站优先于主题，切换主题仍生效）';
          fontFollowTheme.classList.remove('hidden');
        } else {
          fontModeText.textContent = '当前：跟随主题字体（切换主题即更换字体）';
          fontFollowTheme.classList.add('hidden');
        }
      }
      renderFontMode();
      function setFontModeStatus(msg: string, isError: boolean): void {
        if (!fontModeStatus) return;
        fontModeStatus.textContent = msg;
        fontModeStatus.classList.toggle('hidden', !isError);
      }
      fontFollowTheme?.addEventListener('click', async () => {
        if (!(await confirmDialog('恢复跟随主题字体？将清除当前手动字体设置，全站改用当前主题自带字体。'))) return;
        try {
          const res = await fetch('/api/fonts-settings', { method: 'DELETE' });
          if (!res.ok) throw new Error('清除失败');
          window.location.reload();
        } catch {
          setFontModeStatus('清除失败，请重试', true);
        }
      });

      /** 渲染已导入字体列表 */
      const fontList = document.getElementById('font-list') as HTMLUListElement | null;
      function renderFontList(): void {
        const raw = appearanceEl?.dataset.customFonts;
        if (!fontList) return;
        const fonts = raw
          ? (JSON.parse(raw) as { id: string; familyName: string; size: number }[])
          : [];
        fontList.innerHTML = '';
        if (fonts.length === 0) {
          fontList.innerHTML = '<li>暂无自定义字体（上传后此处显示，可在下拉中选择）</li>';
          return;
        }
        fonts.forEach((f) => {
          const li = document.createElement('li');
          li.className = 'flex items-center gap-2';
          const kb = Math.round(f.size / 1024);
          li.innerHTML = `<span>${esc(f.familyName)}（${kb}KB）</span>`;
          const del = document.createElement('button');
          del.type = 'button';
          del.textContent = '删除';
          del.className = 'ml-auto rounded px-1.5 py-0.5 text-destructive hover:bg-destructive/10';
          del.addEventListener('click', async () => {
            if (!(await confirmDanger(`删除字体 ${f.familyName}？`))) return;
            const res = await fetch(`/api/fonts/${f.id}`, { method: 'DELETE' });
            if (res.ok) window.location.reload();
          });
          li.appendChild(del);
          fontList.appendChild(li);
        });
      }
      renderFontList();

      /** 选择文件 */
      const fontFile = document.getElementById('font-file') as HTMLInputElement | null;
      const fontFileName = document.getElementById('font-file-name') as HTMLSpanElement | null;
      document.getElementById('font-choose')?.addEventListener('click', () => fontFile?.click());
      fontFile?.addEventListener('change', () => {
        if (fontFileName && fontFile?.files?.[0]) fontFileName.textContent = fontFile.files[0].name;
      });

      /** 上传字体（≤3MB base64 存站内；>3MB 走 Vercel Blob 直传） */
      const fontStatus = document.getElementById('font-status') as HTMLParagraphElement | null;
      const MAX_BLOB_BYTES = 30 * 1024 * 1024;
      function setFontStatus(msg: string, kind: 'error' | 'info' = 'error'): void {
        if (!fontStatus) return;
        fontStatus.textContent = msg;
        fontStatus.classList.remove('hidden');
        fontStatus.classList.toggle('text-destructive', kind === 'error');
      }
      function mimeFromName(name: string): string {
        const ext = name.split('.').pop()?.toLowerCase() ?? '';
        if (ext === 'ttf') return 'font/ttf';
        if (ext === 'otf') return 'font/otf';
        if (ext === 'woff') return 'font/woff';
        return 'font/woff2';
      }
      document.getElementById('font-upload')?.addEventListener('click', async () => {
        const file = fontFile?.files?.[0];
        const nameInput = document.getElementById('font-name') as HTMLInputElement | null;
        const name = nameInput?.value.trim() ?? '';
        if (!file) {
          setFontStatus('请先选择字体文件');
          return;
        }
        if (!name) {
          setFontStatus('请填写字体名称');
          return;
        }
        if (file.size > MAX_BLOB_BYTES) {
          setFontStatus('字体文件不能超过 30MB（Vercel Blob 直传上限）');
          return;
        }
        const mime = file.type || mimeFromName(file.name);

        // ≤3MB：base64 经函数上传（无需 Blob）
        if (file.size <= 3 * 1024 * 1024) {
          const dataUrl = await new Promise<string>((resolve, reject) => {
            const reader = new FileReader();
            reader.onload = () => resolve(String(reader.result));
            reader.onerror = () => reject(new Error('读取失败'));
            reader.readAsDataURL(file);
          });
          const base64 = dataUrl.slice(dataUrl.indexOf(',') + 1);
          const res = await fetch('/api/fonts', {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify({ familyName: name, mime, data: base64 }),
          });
          const d = (await res.json().catch(() => ({}))) as { error?: string };
          if (!res.ok) {
            setFontStatus(d.error ?? '上传失败');
            return;
          }
          window.location.reload();
          return;
        }

        // >3MB：Vercel Blob 客户端直传（文件不经过函数请求体，绕过 4.5MB 限制）
        try {
          setFontStatus('获取上传凭证…', 'info');
          const res = await fetch('/api/fonts/upload-url', {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify({ mime, filename: file.name }),
          });
          const d = (await res.json().catch(() => ({}))) as { error?: string; pathname?: string; token?: string; contentType?: string };
          if (!res.ok || !d.token || !d.pathname) {
            setFontStatus(d.error ?? '获取上传凭证失败');
            return;
          }
          const { put } = await import('@vercel/blob/client');
          setFontStatus('上传中 0%…', 'info');
          const blob = await put(d.pathname, file, {
            access: 'public',
            token: d.token,
            contentType: d.contentType,
            multipart: true,
            onUploadProgress: (p) => setFontStatus(`上传中 ${Math.round(p.percentage)}%…`, 'info'),
          });
          const rec = await fetch('/api/fonts/record', {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify({ familyName: name, url: blob.url, mime: d.contentType, size: file.size }),
          });
          const rd = (await rec.json().catch(() => ({}))) as { error?: string };
          if (!rec.ok) {
            setFontStatus(rd.error ?? '记录失败');
            return;
          }
          window.location.reload();
        } catch (err) {
          setFontStatus(err instanceof Error ? err.message : '上传失败');
        }
      });

      /** 保存字体设置 */
      document.getElementById('font-save')?.addEventListener('click', async () => {
        const hint = document.getElementById('font-saved-hint');
        if (!fontArticle || !fontUi) return;
        const pick = (sel: HTMLSelectElement): { type: string; value: string } => {
          const [type, ...rest] = sel.value.split(':');
          return { type: type === 'builtin' || type === 'custom' ? type : 'system', value: rest.join(':') };
        };
        try {
          const res = await fetch('/api/fonts-settings', {
            method: 'PUT',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify({ article: pick(fontArticle), ui: pick(fontUi), scale: Number(fontScale?.value ?? 100) }),
          });
          if (!res.ok) throw new Error('保存失败');
          if (hint) {
            hint.textContent = '已保存并应用';
            window.setTimeout(() => {
              hint.textContent = '';
            }, 2000);
          }
        } catch {
          if (hint) hint.textContent = '保存失败，请重试';
        }
      });

  }

  initSettingsForm();
  document.addEventListener('astro:page-load', initSettingsForm);
</script>
