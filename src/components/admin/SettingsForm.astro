      /** 即时更新页面上所有站名展示（导航栏品牌 + 文档标题后缀） */
      function applySiteName(name: string): void {
        document.querySelectorAll<HTMLElement>('[data-site-name]').forEach((el) => {
          el.textContent = name;
        });
        if (document.title.includes(currentSiteName) && currentSiteName) {
