---
/*
 * SettingsForm.astro —— 站点设置表单（分区分页：6 个独立页面 + 弹窗复用）
 * 由 admin/settings.astro 抽离：六个分区（站点名称/诗词轮播/落地页/外观/GitHub 图床/Markdown 样式）+ 全部交互脚本。
 * - Props.section 为 'site-name' | 'hero-quotes' | 'landing' | 'appearance' | 'image-bed' | 'md-css'：
 *   - 省略 → 渲染全部（用于弹窗和兼容旧 /admin/settings）
 *   - 指定 → 仅渲染该分区（用于独立子页面 /admin/settings/<section>）
 * - 脚本以 #settings-form-root[data-inited] 幂等防重复绑定；astro:page-load 时随 DOM 重建自动重初始化。
 */
interface Props {
  section?: 'site-name' | 'hero-quotes' | 'landing' | 'appearance' | 'image-bed' | 'md-css' | 'ai';
}
const { section } = Astro.props;
import { getHeroQuoteSettings, serializeSettings } from '@/lib/quote-settings';
import { getSiteBackground } from '@/lib/background';
import { getLandingHero } from '@/lib/landing';
import { getSiteFonts, hasManualFontSettings, listFontsMeta } from '@/lib/fonts';
import { getSiteName } from '@/lib/site-name';
import { getImageBedConfig, serializeImageBedConfig } from '@/lib/image-bed';
import { getCustomMdCss, scopeMdCss } from '@/lib/md-css';
import { getMdCssLibrary } from '@/lib/md-css-library';
import { getAiConfig, serializeAiConfig } from '@/lib/ai-config';

/* ===== Logic ===== */
/** 读取各类设置：诗词轮播 + 外观（字体 + 背景） */
const heroSettings = serializeSettings(await getHeroQuoteSettings());
const heroJson = JSON.stringify(heroSettings);
const bg = await getSiteBackground();
const landing = await getLandingHero();
const fontSettings = await getSiteFonts();
const customFonts = await listFontsMeta();
/** 是否手动设置过字体（false = 跟随主题字体） */
const hasManualFonts = await hasManualFontSettings();
/** 当前站点名称（导航栏品牌文字，默认「白衣卿相」） */
const siteName = await getSiteName();
/** 各分区是否渲染（未指定 section → 全部；指定 → 仅该分区） */
const showSiteName = !section || section === 'site-name';
const showHeroQuotes = !section || section === 'hero-quotes';
const showLanding = !section || section === 'landing';
const showAppearance = !section || section === 'appearance';
const showImageBed = !section || section === 'image-bed';
const showMdCss = !section || section === 'md-css';
const showAi = !section || section === 'ai';

/** GitHub 图床配置（token 掩码：SSR 注入 hasToken，明文永不出库） */
const imageBed = serializeImageBedConfig(await getImageBedConfig());

/** AI 助手配置（apiKey 掩码：SSR 注入 hasApiKey，明文永不出库） */
const aiConfig = serializeAiConfig(await getAiConfig());

/** 自定义 Markdown 样式（CSS 原文进 textarea；作用域化后注入预览实时生效） */
const mdCss = await getCustomMdCss();
const mdCssHasCustom = mdCss.css.trim() !== '';
const mdCssScopedPreview = mdCssHasCustom ? scopeMdCss(mdCss.css) : '';
const mdCssUpdatedAtText =
  mdCss.updatedAt != null ? new Date(mdCss.updatedAt).toLocaleString('zh-CN') : '';
/** 样式库（命名样式列表，下拉快速选择） */
const mdCssLib = await getMdCssLibrary();
---

<!-- ===== Template ===== -->
<div id="settings-form-root">
    <!-- 站点名称分区 -->
    {showSiteName && (<>
    <section id="site-name" data-settings-section="site-name" class="border-t border-border pt-6" data-name={siteName}>
      <div class="flex items-center justify-between">
        <div>
          <p class="pixel-chip text-primary">SITE NAME</p>
          <h2 class="mt-1 font-medium">站点名称</h2>
        </div>
      </div>
      <p class="mt-1 text-xs text-muted-foreground">
        导航栏显示的站点名称（默认「白衣卿相」）。保存后全站生效并持久保存，刷新页面后仍保持。
      </p>

      <label class="mt-4 block text-xs font-medium text-muted-foreground">
        名称（1-30 个字符，不能为空）
        <input
          id="site-name-input"
          type="text"
          maxlength="30"
          placeholder="白衣卿相"
          class="mt-1 block w-full rounded-md border border-input bg-background px-3 py-1.5 text-sm outline-none transition-colors focus-visible:border-ring"
        />
      </label>

      <p id="site-name-err" class="mt-3 hidden text-xs text-destructive" role="alert"></p>

      <div class="mt-5 flex items-center justify-end gap-3">
        <span id="site-name-hint" class="text-xs text-emerald-600"></span>
        <button
          id="site-name-save"
          type="button"
          class="rounded-md bg-primary px-5 py-2 text-sm text-primary-foreground transition-opacity hover:opacity-90"
        >
          保存并应用
        </button>
      </div>
    </section>
    </>)}

    <!-- 诗词轮播分区 -->
    {showHeroQuotes && (<>
    <section id="hero-quotes" data-settings-section="hero-quotes" class="border-t border-border pt-6" data-settings={heroJson}>
      <div class="flex items-center justify-between">
        <div>
          <p class="pixel-chip text-primary">HERO QUOTES</p>
          <h2 class="mt-1 font-medium">首页诗词轮播</h2>
        </div>
        <a href="/" class="text-xs text-muted-foreground hover:text-primary">查看效果 →</a>
      </div>
      <p class="mt-1 text-xs text-muted-foreground">
        首页 Hero 大字的古诗/名言：逐字闪烁出现，全部显示后停留，再倒序逐字还原并轮播到下一条。
      </p>

      <div class="mt-5 grid grid-cols-2 gap-3">
        <label class="block text-xs font-medium text-muted-foreground">
          逐字间隔（毫秒）
          <input
            id="s-char-ms"
            type="number"
            min="60"
            max="3000"
            step="10"
            class="mt-1 block w-full rounded-md border border-input bg-background px-3 py-1.5 text-sm outline-none transition-colors focus-visible:border-ring"
          />
        </label>
        <label class="block text-xs font-medium text-muted-foreground">
          默认停留（毫秒）
          <input
            id="s-pause-ms"
            type="number"
            min="0"
            max="120000"
            step="100"
            class="mt-1 block w-full rounded-md border border-input bg-background px-3 py-1.5 text-sm outline-none transition-colors focus-visible:border-ring"
          />
        </label>
      </div>

      <p class="settings-label mt-5">诗词列表 / QUOTES</p>
      <p class="text-xs text-muted-foreground">每行一条；「停留(ms)」留空则用上方默认停留。</p>
      <div id="s-quotes" class="mt-2 space-y-1.5"></div>
      <button id="s-add" type="button" class="settings-mini-btn mt-2">+ 添加诗词</button>

      <p id="s-status" class="mt-3 hidden text-xs text-destructive" role="alert"></p>

      <div class="mt-5 flex items-center justify-end gap-3">
        <span id="s-saved-hint" class="text-xs text-emerald-600"></span>
        <button
          id="s-save"
          type="button"
          class="rounded-md bg-primary px-5 py-2 text-sm text-primary-foreground transition-opacity hover:opacity-90"
        >
          保存并应用
        </button>
      </div>
    </section>
    </>)}

    <!-- 落地页分区（Hero 头图） -->
    {showLanding && (<>
    <section id="landing" data-settings-section="landing" class="border-t border-border pt-6" data-landing={JSON.stringify(landing)}>
      <div class="flex items-center justify-between">
        <div>
          <p class="pixel-chip text-primary">LANDING HERO</p>
          <h2 class="mt-1 font-medium">落地页头图</h2>
        </div>
        <a href="/" target="_blank" class="text-xs text-muted-foreground hover:text-primary">查看首页 →</a>
      </div>
      <p class="mt-1 text-xs text-muted-foreground">
        首页 Hero 全屏背景图。可上传多张本地图片组成轮播（单张则静态展示）；未自定义时默认取「最新文章的封面」。
      </p>

      <!-- 头图列表（多图） -->
      <div id="landing-images" class="mt-4 space-y-2"></div>
      <p id="landing-empty" class="px-3 py-8 text-center text-xs text-muted-foreground">
        当前使用文章封面（未自定义图片）
      </p>

      <div class="mt-4 flex flex-wrap items-center gap-2">
        <input id="landing-file" type="file" accept="image/*" multiple class="hidden" />
        <button
          id="landing-choose"
          type="button"
          class="rounded-md border border-border px-3 py-1.5 text-sm transition-colors duration-200 hover:border-primary hover:text-primary"
        >
          添加本地图片
        </button>
        <button
          id="landing-clear"
          type="button"
          class="rounded-md border border-border px-3 py-1.5 text-sm transition-colors duration-200 hover:border-primary hover:text-primary"
        >
          恢复文章封面
        </button>
        <span id="landing-status" class="text-xs text-muted-foreground">可多选，自动压缩（宽 ≤1920px）</span>
      </div>

      <div class="mt-4 grid gap-3 sm:grid-cols-3">
        <label class="block text-xs font-medium text-muted-foreground">
          轮换间隔（秒，2-60）
          <input
            id="landing-interval"
            type="number"
            min="2"
            max="60"
            step="1"
            class="mt-1 block w-full rounded-md border border-input bg-background px-3 py-1.5 text-sm outline-none transition-colors focus-visible:border-ring"
          />
        </label>
        <label class="block text-xs font-medium text-muted-foreground">
          轮换动画
          <select
            id="landing-animation"
            class="mt-1 block w-full rounded-md border border-input bg-background px-2 py-1.5 text-sm outline-none transition-colors focus-visible:border-ring"
          >
            <option value="slide">右→左滑入（slide）</option>
            <option value="break">破碎浮现（break）</option>
          </select>
        </label>
        <label class="block text-xs font-medium text-muted-foreground">
          副标题（留空用默认）
          <input
            id="landing-subtitle"
            type="text"
            maxlength="200"
            placeholder="全面自由地发展吧，同志！…"
            class="mt-1 block w-full rounded-md border border-input bg-background px-3 py-1.5 text-sm outline-none transition-colors focus-visible:border-ring"
          />
        </label>
      </div>

      <p id="landing-err" class="mt-3 hidden text-xs text-destructive" role="alert"></p>

      <div class="mt-5 flex items-center justify-end gap-3">
        <span id="landing-saved-hint" class="text-xs text-emerald-600"></span>
        <button
          id="landing-save"
          type="button"
          class="rounded-md bg-primary px-5 py-2 text-sm text-primary-foreground transition-opacity hover:opacity-90"
        >
          保存并应用
        </button>
      </div>
    </section>
    </>)}

    <!-- 外观分区（字体 + 背景） -->
    {showAppearance && (<>
    <section
      id="appearance"
      data-settings-section="appearance"
      class="border-t border-border pt-6"
      data-bg={JSON.stringify(bg)}
      data-fonts={JSON.stringify(fontSettings)}
      data-custom-fonts={JSON.stringify(customFonts)}
      data-has-manual-fonts={String(hasManualFonts)}
    >
      <!-- 全局字体 -->
      <p class="pixel-chip text-primary">FONTS</p>
      <h2 class="mt-1 font-medium">全局字体</h2>
      <p class="mt-1 text-xs text-muted-foreground">
        两种字体：<strong>文章字体</strong>用于文章正文；<strong>其他字体</strong>用于其余所有内容（标题、导航、按钮、评论、动态、UI 等，含像素装饰）。
        手动设置后全站优先于主题；<strong>恢复跟随主题</strong>后回到主题自带界面字体（默认主题为像素风格，切换主题即换字体）。
      </p>

      <!-- 手动/跟随主题状态 + 操作 -->
      <div class="mt-3 flex flex-wrap items-center gap-2 rounded-md border border-border bg-muted/40 px-3 py-2">
        <span id="font-mode-text" class="text-xs text-muted-foreground"></span>
        <button
          id="font-follow-theme"
          type="button"
          class="hidden rounded-md border border-border px-2.5 py-1 text-xs transition-colors duration-200 hover:border-primary hover:text-primary"
        >
          恢复跟随主题字体
        </button>
        <p id="font-mode-status" class="hidden w-full text-xs text-destructive" role="alert"></p>
      </div>

      <div class="mt-4 grid gap-4 sm:grid-cols-2">
        <label class="block text-xs font-medium text-muted-foreground">
          文章字体（正文）
          <select
            id="font-article"
            class="mt-1 block w-full rounded-md border border-input bg-background px-2 py-1.5 text-sm outline-none transition-colors focus-visible:border-ring"
          >
            <option value="system:sans">系统无衬线（默认）</option>
            <option value="system:serif">系统衬线（宋体）</option>
            <option value="system:mono">系统等宽</option>
            <option value="builtin:lora">Lora（文艺衬线）</option>
            <option value="builtin:silkscreen">Silkscreen（像素）</option>
            <option value="builtin:noto-serif-sc">思源宋体 Noto Serif SC</option>
            <option value="builtin:zcool-kuaile">站酷快乐体 ZCOOL KuaiLe</option>
            {
              customFonts.map((f) => <option value={`custom:${f.id}`}>{f.familyName}（自定义）</option>)
            }
          </select>
        </label>
        <label class="block text-xs font-medium text-muted-foreground">
          其他字体（标题/UI/评论/动态等所有非正文）
          <select
            id="font-ui"
            class="mt-1 block w-full rounded-md border border-input bg-background px-2 py-1.5 text-sm outline-none transition-colors focus-visible:border-ring"
          >
            <option value="system:sans">系统无衬线（默认）</option>
            <option value="system:serif">系统衬线（宋体）</option>
            <option value="system:mono">系统等宽</option>
            <option value="builtin:lora">Lora（文艺衬线）</option>
            <option value="builtin:silkscreen">Silkscreen（像素）</option>
            <option value="builtin:noto-serif-sc">思源宋体 Noto Serif SC</option>
            <option value="builtin:zcool-kuaile">站酷快乐体 ZCOOL KuaiLe</option>
            {
              customFonts.map((f) => <option value={`custom:${f.id}`}>{f.familyName}（自定义）</option>)
            }
          </select>
        </label>
      </div>

      <!-- 字号缩放 -->
      <label class="mt-4 block text-xs font-medium text-muted-foreground">
        字号缩放（部分字体字面偏小，可整体放大；全站 rem 等比生效）
        <select
          id="font-scale"
          class="mt-1 block w-48 rounded-md border border-input bg-background px-2 py-1.5 text-sm outline-none transition-colors focus-visible:border-ring"
        >
          <option value="80">80%（更小）</option>
          <option value="90">90%</option>
          <option value="100">100%（默认）</option>
          <option value="110">110%</option>
          <option value="120">120%</option>
          <option value="130">130%</option>
          <option value="140">140%</option>
          <option value="150">150%</option>
        </select>
      </label>

      <!-- 导入自定义字体 -->
      <div class="mt-4 rounded-md border border-dashed border-border p-3">
        <p class="text-xs font-medium text-muted-foreground">导入自定义字体</p>
        <p class="mt-0.5 text-xs text-muted-foreground/70">≤3MB 存站内；更大文件（最高 30MB，如全量中文字体）自动走 Vercel Blob 直传，不经过服务器限制。</p>
        <div class="mt-2 flex flex-wrap items-center gap-2">
          <input id="font-file" type="file" accept=".woff2,.ttf,.otf,font/*" class="hidden" />
          <button
            id="font-choose"
            type="button"
            class="rounded-md border border-border px-3 py-1.5 text-sm transition-colors duration-200 hover:border-primary hover:text-primary"
          >
            选择字体文件
          </button>
          <span id="font-file-name" class="text-xs text-muted-foreground">未选择</span>
          <input
            id="font-name"
            type="text"
            maxlength="100"
            placeholder="字体名称（如 MyFont）"
            class="min-w-0 flex-1 rounded-md border border-input bg-background px-2 py-1.5 text-sm outline-none transition-colors focus-visible:border-ring"
          />
          <button
            id="font-upload"
            type="button"
            class="rounded-md bg-primary px-4 py-1.5 text-sm text-primary-foreground transition-opacity hover:opacity-90"
          >
            上传
          </button>
        </div>
        <p id="font-status" class="mt-2 hidden text-xs text-destructive" role="alert"></p>
        <ul id="font-list" class="mt-2 space-y-1 text-xs text-muted-foreground"></ul>
      </div>

      <div class="mt-4 flex items-center justify-end gap-3">
        <span id="font-saved-hint" class="text-xs text-emerald-600"></span>
        <button
          id="font-save"
          type="button"
          class="rounded-md bg-primary px-5 py-2 text-sm text-primary-foreground transition-opacity hover:opacity-90"
        >
          保存并应用
        </button>
      </div>

      <!-- 站点背景（统一 / 按页面） -->
      <div id="settings-background" class="mt-6 scroll-mt-4 border-t border-border pt-5">
        <p class="pixel-chip text-primary">BACKGROUND</p>
        <h2 class="mt-1 font-medium">站点背景</h2>
        <p class="mt-1 text-xs text-muted-foreground">
          可统一给全站铺一张背景图，也可为每个页面单独设置；未设置的页面保持默认纯色。
        </p>

        <!-- 模式切换 -->
        <div class="mt-4 flex gap-2" role="radiogroup" aria-label="背景模式">
          <button id="bg-mode-unified" type="button" class="bg-mode-btn rounded-md border border-border px-3 py-1.5 text-xs transition-colors hover:border-primary/50">统一背景</button>
          <button id="bg-mode-pages" type="button" class="bg-mode-btn rounded-md border border-border px-3 py-1.5 text-xs transition-colors hover:border-primary/50">按页面设置</button>
        </div>

        <!-- 星光闪烁开关（两种模式都生效） -->
        <label class="mt-4 flex items-center gap-2 text-sm">
          <input id="bg-stardust" type="checkbox" class="size-4 accent-[var(--color-primary)]" />
          星光闪烁粒子（暗色模式背景装饰）
        </label>

        <!-- 统一模式面板 -->
        <div id="bg-unified-panel" class="mt-4">
          <div class="flex items-center gap-3">
            <label class="flex items-center gap-2 text-sm">
              <input id="bg-enabled" type="checkbox" class="size-4 accent-[var(--color-primary)]" />
              开启背景层
            </label>
          </div>
          <label class="mt-4 block text-xs font-medium text-muted-foreground">
            背景图 URL（http(s) 或站内路径，建议大尺寸图片）
            <input
              id="bg-image"
              type="url"
              placeholder="https://example.com/background.jpg"
              class="mt-1 block w-full rounded-md border border-input bg-background px-3 py-1.5 text-sm outline-none transition-colors focus-visible:border-ring"
            />
          </label>
          <div class="mt-3 flex flex-wrap items-center gap-3">
            <input id="bg-file" type="file" accept="image/*" class="hidden" />
            <button
              id="bg-upload"
              type="button"
              class="rounded-md border border-border px-3 py-1.5 text-sm transition-colors duration-200 hover:border-primary hover:text-primary"
            >
              上传本地背景图
            </button>
            <span id="bg-upload-status" class="text-xs text-muted-foreground">自动压缩（宽 ≤1920px）并填入上方 URL 框</span>
          </div>
          <div class="mt-4 grid grid-cols-2 gap-6">
            <label class="block text-xs font-medium text-muted-foreground">
              透明度（0-100%）
              <input id="bg-opacity" type="range" min="0" max="100" step="5" class="mt-2 w-full accent-[var(--color-primary)]" />
              <span id="bg-opacity-val" class="font-pixel text-primary"></span>
            </label>
            <label class="block text-xs font-medium text-muted-foreground">
              模糊度（0-24px）
              <input id="bg-blur" type="range" min="0" max="24" step="1" class="mt-2 w-full accent-[var(--color-primary)]" />
              <span id="bg-blur-val" class="font-pixel text-primary"></span>
            </label>
          </div>
        </div>

        <!-- 按页面模式面板 -->
        <div id="bg-pages-panel" class="mt-4 hidden">
          <p class="text-xs text-muted-foreground">逐页设置；URL 留空 = 该页不设背景（默认纯色）。</p>
          <div id="bg-pages-list" class="mt-3 space-y-3"></div>
        </div>

        <p id="bg-status" class="mt-3 hidden text-xs text-destructive" role="alert"></p>

        <div class="mt-5 flex items-center justify-end gap-3">
          <span id="bg-saved-hint" class="text-xs text-emerald-600"></span>
          <a href="/" target="_blank" class="text-xs text-muted-foreground hover:text-primary">预览首页 →</a>
          <button
            id="bg-save"
            type="button"
            class="rounded-md bg-primary px-5 py-2 text-sm text-primary-foreground transition-opacity hover:opacity-90"
          >
            保存并应用
          </button>
        </div>
      </div>
    </section>
    </>)}

    <!-- GitHub 图床分区 -->
    {showImageBed && (<>
    <section id="image-bed" data-settings-section="image-bed" class="border-t border-border pt-6" data-image-bed={JSON.stringify(imageBed)}>
      <div class="flex items-center justify-between">
        <div>
          <p class="pixel-chip text-primary">GITHUB IMAGE BED</p>
          <h2 class="mt-1 font-medium">GitHub 图床</h2>
        </div>
      </div>
      <p class="mt-1 text-xs text-muted-foreground">
        开启后，文章/动态中粘贴的图片自动上传到 GitHub 仓库，通过本站 /img/ 反代展示（国内可直连）；
