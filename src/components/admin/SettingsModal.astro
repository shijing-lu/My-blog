---
/*
 * SettingsModal.astro —— 站点设置悬浮弹窗（Obsidian 设置风格）
 * 左右分栏居中 <dialog>：左侧搜索框 + 垂直标签导航，右侧设置内容区。
 * - 切换完全在弹窗内：点击导航仅显隐对应分区面板（SettingsForm 全渲染 + data-settings-section），
 *   不跳转页面、不关闭/缩小弹窗。
 * - 打开方式：任意 [data-open-settings] 元素（document 委托）；值可为分区 key（如 hero-quotes 笔按钮），
 *   打开后直接激活该分区。
 * - 关闭：ESC（原生）/ 点击遮罩 / 右上角 ×。
 * - 仅在管理端渲染（BaseLayout 按 settings 权限条件渲染），游客不输出任何标记。
 * - 独立子页面 /admin/settings/<section> 仍保留为直链入口（SettingsLayout）。
 */
import SettingsForm from '@/components/admin/SettingsForm.astro';
import NeoIcon from '@/components/NeoIcon.astro';
import '@/styles/settings-workspace.css';
import { serverEnv } from '@/lib/env';
import { getSettingsSections } from '@/lib/settings-sections';

/* 左侧导航：分区 key + 标签 + 搜索关键词；anchor 用于分区内的子定位（如站点背景） */
const navItems = getSettingsSections(serverEnv('DESKTOP_MODE') === '1');
---

<!-- ===== Template ===== -->
<dialog
  id="settings-modal"
  class="neo-settings-modal"
  aria-labelledby="settings-modal-title"
>
  <div class="settings-dialog-header">
    <h2 id="settings-modal-title" class="settings-dialog-title"><NeoIcon name="settings" size={21} />站点设置 <small>SETTINGS</small></h2>
    <button id="settings-modal-close" data-m3-role="icon-button" type="button" aria-label="关闭设置" title="关闭 (Esc)" class="absolute right-3 top-3 z-10 inline-flex size-8 items-center justify-center rounded-md text-muted-foreground transition-colors hover:bg-accent hover:text-foreground">
      <NeoIcon name="close" size={20} />
    </button>
  </div>
  <!-- 左侧：搜索 + 垂直标签导航（Obsidian 风格） -->
  <div class="neo-settings-modal-sidebar">
    <div class="p-3 pb-2">
      <input
        id="settings-modal-search"
        type="text"
        placeholder="搜索设置..."
        aria-label="搜索设置"
        class="w-full rounded-md border border-input bg-background px-2.5 py-1.5 text-sm outline-none transition-colors focus-visible:border-ring"
      />
    </div>
    <nav id="settings-modal-nav" class="min-h-0 flex-1 overflow-y-auto px-2 pb-3" aria-label="设置导航">
      <p class="px-2.5 pb-1 pt-2 text-xs font-medium text-muted-foreground">选项</p>
      {navItems.map((it) => (
        <button
          type="button"
          data-section={it.id}
          data-keywords={it.keywords}
          data-m3-role="navigation-item"
          class="settings-nav-item block w-full rounded-md px-2.5 py-1.5 text-left text-sm transition-colors hover:bg-accent"
        >
          {it.label}
        </button>
      ))}
    </nav>
    <p id="settings-modal-empty" class="hidden px-4 py-3 text-sm text-muted-foreground" role="status">没有匹配的设置，请更换关键词。</p>
  </div>

  <!-- 右侧：设置内容（全部分区渲染，导航切换显隐） -->
  <div class="neo-settings-modal-body">
    <div id="settings-modal-content">
      <SettingsForm />
    </div>
  </div>
</dialog>

<style>
  /* 遮罩（原生 dialog::backdrop 不受主题变量影响，这里显式给色） */
  #settings-modal::backdrop {
    background: rgb(0 0 0 / 50%);
  }
  /* 垂直标签页激活态（Obsidian 风格：accent 底 + 主色文字） */
  #settings-modal-nav .settings-nav-item.active {
    background: var(--color-accent);
    color: var(--color-primary);
    font-weight: 500;
  }
</style>

<script>
  /**
   * 弹窗交互：
   * - 打开：document 委托监听 [data-open-settings] → showModal → 激活指定分区（默认 site-name）；
   * - 关闭：× 按钮 / 点击遮罩 / ESC（原生 dialog）；
   * - 导航：左侧 <button data-section> → 纯弹窗内切换（显隐右侧面板 + 高亮），不跳页、不关弹窗；
   * - 分区内锚点（站点背景）：激活 appearance 后滚动到 #settings-background；
   * - 搜索：左侧 nav 关键字过滤（只过滤导航项，不影响右侧内容）。
   * 表单自身交互由 SettingsForm 的 initSettingsForm 负责。
   */

  function getDialog(): HTMLDialogElement | null {
    return document.getElementById('settings-modal') as HTMLDialogElement | null;
  }
  let settingsTrigger: HTMLElement | null = null;
  document.addEventListener('close', event => {
    if (event.target === getDialog() && settingsTrigger?.isConnected) settingsTrigger.focus({ preventScroll: true });
  }, true);

  /* ---------- 垂直标签页切换（弹窗内） ---------- */
  function activateSection(key: string, anchor?: string): void {
    const dialog = getDialog();
    if (!dialog) return;
    if (!dialog.querySelector(`[data-settings-section="${CSS.escape(key)}"]`)) key = 'site-name';
    dialog.dataset.activeSection = key;
    dialog.scrollLeft = 0;
    // 1) 导航高亮
    dialog.querySelectorAll<HTMLElement>('#settings-modal-nav .settings-nav-item').forEach((btn) => {
      const active = btn.dataset.section === key;
      btn.classList.toggle('active', active);
      if (active) btn.setAttribute('aria-current', 'page');
      else btn.removeAttribute('aria-current');
    });
    // 2) 面板显隐（仅弹窗内容器内，独立子页面的同 id 分区不受影响）
    const content = dialog.querySelector<HTMLElement>('#settings-modal-content');
    if (content) {
      content.querySelectorAll<HTMLElement>('[data-settings-section]').forEach((sec) => {
        sec.classList.toggle('hidden', sec.dataset.settingsSection !== key);
      });
      // 3) 分区内锚点定位（如「站点背景」→ appearance 内 #settings-background）
      const scrollBox = content;
      scrollBox.scrollTop = 0;
      scrollBox.scrollLeft = 0;
      if (anchor) {
        // 双 rAF 等布局稳定后，手动按容器坐标滚动（scrollIntoView 在 dialog 内会滚错容器）
        requestAnimationFrame(() => {
          requestAnimationFrame(() => {
            const el = content.querySelector<HTMLElement>(`#${CSS.escape(anchor)}`);
            if (!el) return;
            const details = el.closest<HTMLDetailsElement>('details[data-classic-settings]');
            if (details) { details.open = true; details.dataset.materialOpen = 'true'; }
            scrollBox.scrollTop += el.getBoundingClientRect().top - scrollBox.getBoundingClientRect().top - 8;
          });
        });
      }
    }
  }

  /* ---------- 打开（document 委托；按 trigger 指定分区激活） ---------- */
  document.addEventListener('click', (e) => {
    const trigger = (e.target as HTMLElement).closest<HTMLElement>('[data-open-settings]');
    if (!trigger) return;
    e.preventDefault();
    const dialog = getDialog();
    if (!dialog || dialog.open) return;
    settingsTrigger = trigger;
    const search = dialog.querySelector<HTMLInputElement>('#settings-modal-search');
    if (search) search.value = '';
    dialog.querySelectorAll('.settings-nav-item').forEach(item => item.classList.remove('hidden'));
    dialog.querySelector('#settings-modal-empty')?.classList.add('hidden');
    dialog.showModal();
    const target = trigger.dataset.openSettings?.trim();
    if (target === 'settings-background') activateSection('appearance', 'settings-background');
    else activateSection(target && target !== '' ? target : 'site-name');
  });

  /* ---------- 关闭：× 按钮 + 点击遮罩 ---------- */
  document.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('#settings-modal-close')) getDialog()?.close();
  });
  document.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).id === 'settings-modal') getDialog()?.close();
  });

  /* ---------- 左侧导航：弹窗内切换分区（不跳页、不关弹窗） ---------- */
  document.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLElement>('#settings-modal-nav .settings-nav-item');
    if (!btn) return;
    const key = btn.dataset.section ?? 'site-name';
    const anchor = btn.dataset.anchor || undefined;
    activateSection(key, anchor);
  });

  /* ---------- 搜索过滤（关键字匹配 label 与 data-keywords；仅过滤导航项） ---------- */
  document.addEventListener('input', (e) => {
    const input = e.target as HTMLInputElement;
    if (input.id !== 'settings-modal-search') return;
    const q = input.value.trim().toLowerCase();
    let matches = 0;
    document.querySelectorAll<HTMLElement>('#settings-modal-nav .settings-nav-item').forEach((a) => {
      const hit =
        !q ||
        (a.textContent ?? '').toLowerCase().includes(q) ||
        (a.dataset.keywords ?? '').toLowerCase().includes(q);
      a.classList.toggle('hidden', !hit);
      if (hit) matches++;
    });
    document.getElementById('settings-modal-empty')?.classList.toggle('hidden', matches > 0);
  });
</script>
