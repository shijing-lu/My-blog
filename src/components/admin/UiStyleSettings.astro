<div class="neo-style-note"><h2>明暗模式</h2><p>全站使用统一的新粗野主义外观。选择当前设备的显示模式，会自动记住你的偏好。</p><div class="neo-settings-modes" role="group" aria-label="设置明暗模式">{[{ mode: 'light', label: '亮色' }, { mode: 'dark', label: '暗色' }, { mode: 'system', label: '跟随系统' }].map(item => <button type="button" data-settings-mode={item.mode} aria-pressed="false">{item.label}</button>)}</div></div>
<script>
  import { readState, writeState } from '@/lib/theme';
  function syncSettingsMode(): void {
    document.querySelectorAll<HTMLElement>('[data-settings-mode]').forEach(button => button.setAttribute('aria-pressed', String(button.dataset.settingsMode === readState().mode)));
  }
  document.addEventListener('click', event => {
    const button = (event.target as Element).closest<HTMLElement>('[data-settings-mode]');
    const mode = button?.dataset.settingsMode;
    if (mode === 'light' || mode === 'dark' || mode === 'system') writeState({ ...readState(), mode });
  });
  window.addEventListener('byqx:theme-change', syncSettingsMode);
  document.addEventListener('astro:page-load', syncSettingsMode);
  syncSettingsMode();
</script>
