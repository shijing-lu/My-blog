---
import '@/styles/article-detail.css';

interface Props {
  domain: 'docs' | 'home';
  authed: boolean;
  treeLabel: string;
  treeHtml: string;
  title?: string;
  articleHtml?: string;
  tocHtml: string;
  tocState?: 'ready' | 'loading' | 'empty';
  deferArticleId?: string;
  emptyText: string;
}

const { domain, authed, treeLabel, treeHtml, title, articleHtml = '', tocHtml, tocState = 'ready', deferArticleId, emptyText } = Astro.props;
---

<section data-authed={authed ? '1' : '0'} data-article-domain={domain}>
  <div class="mx-auto w-full max-w-[1320px] px-4 pt-6 text-sm text-muted-foreground">
    <slot name="breadcrumb" />
  </div>

  <div class="mx-auto w-full max-w-[1320px] px-4 py-6">
    <div id="doc-3col" data-ltoc-collapsed="false" data-toc-collapsed="false" data-toc-auto="false" class="grid gap-6 lg:grid-cols-[var(--toc-lw,220px)_minmax(0,1fr)]">
      <aside id="doc-ltoc-aside" class="lg:sticky lg:top-20 lg:self-start">
        <div id="doc-ltoc-inner" class="lg:border-r lg:border-border lg:pr-4">
          <div class="flex items-center justify-between gap-2 pl-1 pr-10">
            <p data-ltoc-label class="font-pixel text-[0.7rem] uppercase tracking-[0.15em] text-muted-foreground">{treeLabel}</p>
            {authed && (
              <span data-ltoc-label class="flex items-center gap-1">
                <button id="doc-add-root-folder" type="button" title="新建目录" aria-label="新建目录" class="rounded-full border border-dashed border-border px-2 py-0.5 text-[0.65rem] text-muted-foreground transition-colors hover:border-primary/50 hover:text-primary">＋目录</button>
                <button id="doc-add-root-article" type="button" title="新建文章" aria-label="新建文章" class="rounded-full border border-dashed border-border px-2 py-0.5 text-[0.65rem] text-muted-foreground transition-colors hover:border-primary/50 hover:text-primary">＋文章</button>
                <span id="doc-create-status" role="status" class="sr-only" />
              </span>
            )}
          </div>
          <div id="doc-ltoc-body" class="mt-3 lg:max-h-[calc(100vh-6rem)] lg:overflow-y-auto">
            <nav class="space-y-0.5 text-base" aria-label={treeLabel}>
              <div class="space-y-0.5" data-doc-tree-root set:html={treeHtml} />
            </nav>
          </div>
        </div>
        <button id="doc-ltoc-toggle" type="button" title="收起 / 展开目录" aria-label="收起或展开目录" aria-controls="doc-ltoc-body" aria-expanded="true" class="hidden h-7 w-7 shrink-0 items-center justify-center rounded-md border border-border bg-background/80 text-muted-foreground backdrop-blur transition-colors hover:border-primary/50 hover:text-primary lg:inline-flex">
          <svg data-ltoc-icon-collapse class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="15 18 9 12 15 6" /></svg>
          <svg data-ltoc-icon-expand class="hidden h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6" /></svg>
        </button>
      </aside>

      <main class="min-w-0">
        {title !== undefined ? (
          <>
            <header>
              <div class="flex items-start gap-3">
                <h1 class="font-display text-3xl font-semibold tracking-tight">{title}</h1>
                <slot name="title-actions" />
              </div>
              <div class="pixel-divider mt-4" />
            </header>
            <article class="prose mt-6 max-w-none break-words" data-heading-folding data-defer-article={deferArticleId} set:html={articleHtml} />
            <slot name="editor" />
          </>
        ) : <p class="mt-10 text-center text-sm text-muted-foreground">{emptyText}</p>}
      </main>
    </div>

    <aside id="doc-toc-aside" data-collapsed="true" aria-label="当前文章目录">
      <div id="doc-toc-panel" tabindex="-1" class="fixed right-0 z-30 flex flex-col border-l border-y border-border bg-card/95 shadow-lg backdrop-blur">
        <div class="flex shrink-0 items-center justify-between gap-2 border-b border-border/60 px-4 py-2.5">
          <p data-toc-label class="font-pixel text-[0.7rem] uppercase tracking-[0.15em] text-muted-foreground">目录 / TOC</p>
          <button id="doc-toc-toggle" type="button" title="收起目录" aria-label="收起目录" aria-controls="doc-toc-panel" aria-expanded="false" class="inline-flex h-11 w-11 shrink-0 items-center justify-center rounded-md border border-border bg-background/80 text-muted-foreground backdrop-blur transition-colors hover:border-primary/50 hover:text-primary">
            <svg data-toc-icon-collapse class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="15 18 9 12 15 6" /></svg>
            <svg data-toc-icon-expand class="hidden h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6" /></svg>
          </button>
        </div>
        <div id="doc-toc-rail" class="min-h-0 flex-1 overflow-y-auto overscroll-contain px-4 py-3 [scrollbar-width:thin]">
          <div id="doc-toc-list" data-toc-label class="flex flex-col gap-1.5" set:html={tocState === 'ready' && tocHtml ? tocHtml : `<p class="mt-2 text-xs text-muted-foreground">${tocState === 'loading' ? '正在加载目录…' : '无目录'}</p>`} />
        </div>
      </div>
      <button id="doc-toc-fab" type="button" title="展开当前文章目录" aria-label="展开当前文章目录" aria-controls="doc-toc-panel" aria-expanded="false" class="fixed right-3 z-30 hidden h-11 w-11 items-center justify-center rounded-full border border-border bg-card/95 text-muted-foreground shadow-lg backdrop-blur transition-colors hover:border-primary/50 hover:text-primary">
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6h12M9 12h12M9 18h12M3 6h.01M3 12h.01M3 18h.01" /></svg>
      </button>
    </aside>
    <div id="doc-toc-overlay" class="fixed inset-x-0 bottom-0 z-20 hidden bg-black/30 backdrop-blur-[1px]" aria-hidden="true" />
  </div>
</section>
