---
import '@/styles/article-detail.css';
import '@/styles/article-workspace.css';
import ArticleDirectory from './ArticleDirectory.astro';
import ArticleSearch from './ArticleSearch.astro';

interface Props {
  domain: 'docs' | 'home';
  authed: boolean;
  treeLabel: string;
  treeHtml: string;
  title?: string;
  articleHtml?: string;
  tocHtml: string;
  tocState?: 'ready' | 'loading' | 'empty';
  deferArticleId?: string;
  emptyText: string;
}

const { domain, authed, treeLabel, treeHtml, title, articleHtml = '', tocHtml, tocState = 'ready', deferArticleId, emptyText } = Astro.props;
---

<section class="article-workspace" data-authed={authed ? '1' : '0'} data-article-domain={domain}>
  <div class="article-breadcrumb text-sm text-muted-foreground">
    <slot name="breadcrumb" />
  </div>

  <div class="article-detail-layout mx-auto w-full max-w-[1320px] px-4 py-6">
    <div id="doc-3col" data-ltoc-collapsed="false" data-toc-collapsed="false" data-toc-auto="false" class="grid gap-6 lg:grid-cols-[var(--toc-lw,220px)_minmax(0,1fr)]">
      <aside id="doc-ltoc-aside" class="lg:sticky lg:top-20 lg:self-start">
        <div id="doc-ltoc-inner" class="lg:border-r lg:border-border lg:pr-4">
          <div class="flex items-center justify-between gap-2 pl-1 pr-10">
            <p data-ltoc-label class="font-pixel text-[0.7rem] uppercase tracking-[0.15em] text-muted-foreground">{treeLabel}</p>
            {authed && (
              <span data-ltoc-label class="flex items-center gap-1">
                <button id="doc-add-root-folder" type="button" title="新建目录" aria-label="新建目录" class="rounded-full border border-dashed border-border px-2 py-0.5 text-[0.65rem] text-muted-foreground transition-colors hover:border-primary/50 hover:text-primary">＋目录</button>
                <button id="doc-add-root-article" type="button" title="新建文章" aria-label="新建文章" class="rounded-full border border-dashed border-border px-2 py-0.5 text-[0.65rem] text-muted-foreground transition-colors hover:border-primary/50 hover:text-primary">＋文章</button>
                <span id="doc-create-status" role="status" class="sr-only" />
              </span>
            )}
          </div>
          {authed && <p data-ltoc-label class="mt-2 px-1 text-[0.65rem] text-muted-foreground">拖入 MD 文件到{domain === 'docs' ? '目录' : '分类'}即可导入</p>}
          <div id="doc-ltoc-body" class="mt-3 lg:max-h-[calc(100vh-6rem)] lg:overflow-y-auto">
            <nav class="space-y-0.5 text-base" aria-label={treeLabel}>
              <div class="space-y-0.5" data-doc-tree-root set:html={treeHtml} />
            </nav>
          </div>
        </div>
        <button id="doc-ltoc-toggle" type="button" title="收起 / 展开目录" aria-label="收起或展开目录" aria-controls="doc-ltoc-body" aria-expanded="true" class="hidden h-7 w-7 shrink-0 items-center justify-center rounded-md border border-border bg-background/80 text-muted-foreground backdrop-blur transition-colors hover:border-primary/50 hover:text-primary lg:inline-flex">
          <svg data-ltoc-icon-collapse class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="15 18 9 12 15 6" /></svg>
          <svg data-ltoc-icon-expand class="hidden h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6" /></svg>
        </button>
      </aside>

      <main class="article-paper min-w-0">
        {title !== undefined ? (
          <>
            <header>
              <div class="flex items-start gap-3">
                <h1 class="font-display text-3xl font-semibold tracking-tight">{title}</h1>
                <slot name="title-actions" />
                <span id="article-save-status" class="article-save-status" role="status" aria-live="polite" hidden />
                <img class="article-title-cat" src="/images/neobrutalism/cat-peek.webp" alt="" aria-hidden="true" width="72" height="44" />
              </div>
              <div class="pixel-divider mt-4" />
            </header>
            <ArticleSearch />
            <article class="prose mt-6 max-w-none break-words" data-heading-folding data-defer-article={deferArticleId} set:html={articleHtml} />
            <slot name="editor" />
          </>
        ) : <div class="article-empty"><img src="/images/neobrutalism/cat-peek.webp" alt="" aria-hidden="true" width="120" height="72" /><p>{emptyText}</p></div>}
      </main>
      <ArticleDirectory tocHtml={tocHtml} tocState={tocState} />
    </div>


  </div>
</section>
