<dialog id="home-folder-dialog" class="m-auto w-[min(92vw,25rem)] rounded-lg border border-border bg-card p-5 text-foreground shadow-xl backdrop:bg-black/40">
  <h2 id="home-folder-dialog-title" class="font-display text-lg font-semibold">目录</h2>
  <label class="mt-4 block text-sm">目录名称<input id="home-folder-name" maxlength="30" class="mt-1 w-full rounded-md border border-input bg-background px-3 py-2" /></label>
  <p id="home-folder-error" role="alert" class="mt-2 hidden text-sm text-destructive"></p>
  <div class="mt-5 flex justify-end gap-2"><button id="home-folder-cancel" type="button" class="rounded-md border border-border px-3 py-1.5 text-sm">取消</button><button id="home-folder-save" type="button" class="rounded-md bg-primary px-3 py-1.5 text-sm text-primary-foreground">保存</button></div>
</dialog>
