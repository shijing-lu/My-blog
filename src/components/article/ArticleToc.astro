---
/* ===== Props ===== */
interface Props {
  /** 目录项（h2/h3/h4） */
  toc: import('@/lib/mdx-plugins').TocItem[];
}

const { toc } = Astro.props;
/** 层级缩进（h3/h4 逐级加深） */
const indent = (level: number): string => (level === 3 ? ' pl-7' : level === 4 ? ' pl-10' : '');
---
<!-- ===== Template ===== -->
{
  toc.length > 0 && (
    <nav class="border-b border-border pb-4" aria-label="目录">
      <p class="pixel-chip mb-2 text-muted-foreground">目录 / TOC</p>
      <div class="border-l border-border pl-2">
        {
          toc.map((item) => (
            <a
              class={'toc-link' + indent(item.level)}
              href={`#${item.id}`}
            >
              {item.text}
            </a>
          ))
        }
      </div>
    </nav>
  )
}
