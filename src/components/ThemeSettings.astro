---
const modes = [{ value: 'light', label: '亮色' }, { value: 'dark', label: '暗色' }, { value: 'system', label: '跟随系统' }];
---
<button id="theme-settings-btn" type="button" aria-label="外观设置" title="外观设置" class="neo-appearance-button">外观</button>
<dialog id="theme-settings-dialog" class="theme-settings neo-appearance-dialog" aria-labelledby="theme-settings-title">
  <div class="settings-header"><h2 id="theme-settings-title">外观设置</h2><button id="settings-close" type="button" aria-label="关闭" class="settings-close">×</button></div>
  <p class="neo-mode-description">选择明暗模式，自动记住当前设备的偏好。</p>
  <div class="settings-modes" role="group" aria-label="明暗模式">
    {modes.map(mode => <button type="button" class="mode-btn" data-mode-btn={mode.value} aria-pressed="false">{mode.label}</button>)}
  </div>
</dialog>
<script>
  import { readState, writeState } from '@/lib/theme';
  const dialog = () => document.getElementById('theme-settings-dialog') as HTMLDialogElement | null;
  const sync = () => document.querySelectorAll<HTMLElement>('[data-mode-btn]').forEach(button => button.setAttribute('aria-pressed', String(button.dataset.modeBtn === readState().mode)));
  document.addEventListener('click', event => {
    const target = event.target instanceof Element ? event.target : null;
    if (target?.closest('#theme-settings-btn')) { sync(); dialog()?.showModal(); }
    if (target?.closest('#settings-close') || target === dialog()) dialog()?.close();
    const button = target?.closest<HTMLElement>('[data-mode-btn]');
    if (button) { const mode = button.dataset.modeBtn; if (mode === 'light' || mode === 'dark' || mode === 'system') { writeState({ ...readState(), mode }); sync(); } }
  });
  window.addEventListener('byqx:theme-change', sync);
  document.addEventListener('astro:page-load', sync);
  sync();
</script>
