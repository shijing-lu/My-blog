---
import type { UiStyle } from '@/lib/ui-style';
interface Props { defaultStyle?: UiStyle }
---
<meta name="site-ui-style" content="neobrutalism" />
<script is:inline>
  (() => {
    const root = document.documentElement;
    let mode = 'system';
    try {
      const value = JSON.parse(localStorage.getItem('my-blog-theme') || '{}');
      if (value?.mode === 'light' || value?.mode === 'dark') mode = value.mode;
    } catch { /* Storage is optional. */ }
    root.dataset.uiStyle = root.dataset.siteUiStyle = 'neobrutalism';
    root.removeAttribute('data-theme');
    root.dataset.mode = mode;
    root.classList.toggle('dark', mode === 'dark' || (mode === 'system' && matchMedia('(prefers-color-scheme: dark)').matches));
    window.__uiStyleObserver?.disconnect();
    window.__applyUiStyleHead = () => {};
  })();
</script>
