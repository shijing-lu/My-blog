---
/*
 * RightToolbar.astro —— 右侧竖向图标工具栏（d-d 式）
 * Props: 无
 * Imports: 鉴权（新建入口仅管理员可见）
 * Logic: 首页 → 新建文章（房子图标下方，仅登录）→ 站点设置 →「编辑当前文章」
 *        （仅登录且处于文档详情页 /doc/[id] 时显示；点击进入/退出就地编辑）→ 回到顶部
 */
import { verifyRequest } from '@/lib/auth';

/* ===== Logic ===== */
const isAuthed = verifyRequest(Astro.cookies);
/** 文档详情页（/doc/<bundleId>）才显示「编辑当前文章」；/doc 列表页等不显示 */
const isDocDetail = /^\/doc\/[^/]+\/?$/.test(Astro.url.pathname);
---
<!-- ===== Template ===== -->
<aside class="side-toolbar" aria-label="快捷工具栏">
  <!-- 返回首页 -->
  <a href="/" aria-label="返回首页" title="首页">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-5" aria-hidden="true">
      <path d="M3 10.5 12 3l9 7.5" />
      <path d="M5 9.5V21h14V9.5" />
    </svg>
  </a>
  <!-- 新建文章（管理员，房子图标下方） -->
  {
    isAuthed && (
      <a href="/edit/new" aria-label="新建文章" title="新建文章">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-5" aria-hidden="true">
          <path d="M12 5v14M5 12h14" />
        </svg>
      </a>
    )
  }
  <!-- 站点设置（管理员，新建文章下方） -->
  {
    isAuthed && (
      <a href="/admin/settings" aria-label="站点设置" title="站点设置">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-5" aria-hidden="true">
          <path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z" />
          <circle cx="12" cy="12" r="3" />
        </svg>
      </a>
    )
  }
  <!-- 编辑当前文章（管理员 + 文档详情页：就地编辑入口，点击桥接打开/完成） -->
  {
    isAuthed && isDocDetail && (
      <button id="rt-doc-inline-edit" type="button" aria-label="编辑当前文章" title="编辑当前文章">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-5" aria-hidden="true">
          <path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z" />
          <path d="m15 5 4 4" />
        </svg>
      </button>
    )
  }
  <!-- 回到顶部 -->
  <button id="to-top" type="button" aria-label="回到顶部" title="回到顶部">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-5" aria-hidden="true">
      <path d="M12 19V5" />
      <path d="m5 12 7-7 7 7" />
    </svg>
  </button>
</aside>

<script>
  /** 回到顶部（平滑滚动）；document 委托，View Transitions 后无需重绑 */
  document.addEventListener('click', (e) => {
    if (!(e.target as HTMLElement).closest('#to-top')) return;
    window.scrollTo({ top: 0, behavior: 'smooth' });
  });

  /**
   * 「编辑当前文章」（仅文档详情页渲染该按钮）：
   * - 未编辑 → 打开就地编辑；
   * - 已在编辑态 → 保存并退出。
   * 岛用 client:idle，首屏可能尚未水合：轮询等待最多 ~2s，避免点击无响应。
   */
  document.addEventListener('click', (e) => {
    if (!(e.target as HTMLElement).closest('#rt-doc-inline-edit')) return;
    const grid = document.getElementById('doc-3col');
    const editing = grid?.dataset.editing === 'true';
    let tries = 0;
    const tryBridge = (): void => {
      const bridge = (window as unknown as { __docInlineEditor?: { open: () => void; saveAndClose?: () => void } }).__docInlineEditor;
      if (!bridge) {
        if (tries++ < 20) window.setTimeout(tryBridge, 100);
        return;
      }
      if (editing && bridge.saveAndClose) bridge.saveAndClose();
      else bridge.open();
    };
    tryBridge();
  });
</script>
