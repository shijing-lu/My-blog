---
/* ===== Props ===== */
interface Props {
  /** 文章总数（初始计数显示） */
  total: number;
  canEdit?: boolean;
  /**
   * 自定义分类（写作台维护，服务端注入；表未迁移时为空数组）。
   * 分类按钮行 = 「全部」+ 各分类；替代旧的内置类型按钮（tech/note/photo 已从 UI 退役，
   * 仅作为内部元数据保留在 articles.type）。
   */
  categories?: Array<{ id: string; name: string }>;
}

const { total, categories = [], canEdit = false } = Astro.props;

/* ===== Imports ===== */
import NeoIcon from './NeoIcon.astro';
---

<div id="search-box" data-can-edit={String(canEdit)}>
  <div class="neo-search-bar"><label class="neo-search-field"><NeoIcon name="search" size={19} /><input id="search-input" type="search" placeholder="搜索标题 / 正文 / 标签（全站）…" autocomplete="off" data-total={total} aria-label="搜索文章" /></label>
    <div class="neo-search-categories" role="group" aria-label="分类筛选"><button type="button" class="search-type-btn active" data-cat-filter="all" aria-pressed="true">全部</button>{categories.map(category => <button type="button" class="search-type-btn" data-cat-filter={category.id} aria-pressed="false">{category.name}</button>)}</div>
  </div><p id="search-count" class="neo-search-status" role="status" aria-live="polite">{total} 篇</p>
</div>
<template id="search-file-icon"><NeoIcon name="file" size={15} /></template><template id="search-lock-icon"><NeoIcon name="lock" size={15} /></template><template id="search-more-icon"><NeoIcon name="more" size={20} /></template>
<div id="search-results" class="post-list hidden"></div><p id="search-empty" class="neo-empty hidden">未找到匹配的文章，换个关键词或分类试试。</p>
<script>
  import { feedback } from '@/lib/motion';
  /** 全站服务端搜索：输入防抖 200ms → GET /api/search → 渲染结果卡片
   *  - 关键词为空且分类为「全部」时回到服务端分页列表；
   *  - 分类筛选 = 自定义分类（写作台维护，服务端注入 data-cat-filter），替代旧内置类型按钮；
   *  - 事件用 document 委托 + 每次解析元素，规避 View Transitions 后绑定失效。 */

  let controller: AbortController | null = null;
  let debounceTimer: number | null = null;
  let activeCat = 'all';
  let requestId = 0;

  function el<T extends HTMLElement>(id: string): T | null {
    return document.getElementById(id) as T | null;
  }

  function esc(value: string): string {
    return String(value).replace(/[&<>"']/g, (c) => {
      const map: Record<string, string> = { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' };
      return map[c] ?? c;
    });
  }

  function formatShort(iso: string): string {
    const d = new Date(iso);
    const p = (n: number): string => String(n).padStart(2, '0');
    return `${d.getFullYear()}-${p(d.getMonth() + 1)}-${p(d.getDate())} ${p(d.getHours())}:${p(d.getMinutes())}`;
  }

  function countText(n: number): string {
    return n >= 1000 ? `${(n / 1000).toFixed(1)}k` : String(n);
  }


  function rowHtml(a: { id:string; title:string; slug:string; summary:string; snippet:string; cover:string|null; tags:string[]; updatedAt:string; charCount:number; encrypted?:boolean }):string {
    const tags = a.tags.slice(0,4).map(tag => '<a href="/tags/' + encodeURIComponent(tag) + '" class="post-tag">' + esc(tag) + '</a>').join('');
    const icon = (id:string) => document.getElementById(id)?.innerHTML ?? '';
    // Covers are supplied by the API; never fetch article bodies to find an image.
    const cover = a.cover && /^(https?:\/\/|\/(?!\/))/.test(a.cover) ? a.cover : '/images/neobrutalism/article-fallback.webp';
    const edit = el('search-box')?.dataset.canEdit === 'true' ? '<a class="post-row-edit" href="/edit/' + encodeURIComponent(a.id) + '" aria-label="编辑《' + esc(a.title) + '》">' + icon('search-more-icon') + '</a>' : '';
    return '<article class="post-row"><a class="neo-post-link" href="/blog/' + encodeURIComponent(a.slug) + '" aria-label="阅读《' + esc(a.title || '未命名') + '》"></a>' +
      '<img class="neo-post-cover" data-article-cover src="' + esc(cover) + '" alt="" width="164" height="84" loading="lazy" />' +
      '<div class="post-row-main"><h3>' + esc(a.title || '未命名') + (a.encrypted ? '<span class="neo-encrypted" aria-label="加密文章">' + icon('search-lock-icon') + '</span>' : '') + '</h3><div class="neo-post-tags">' + tags + '</div><p class="neo-post-summary">' + esc(a.snippet || a.summary) + '</p></div>' +
      '<div class="post-row-meta"><time datetime="' + esc(a.updatedAt) + '">' + formatShort(a.updatedAt) + '</time><span class="neo-word-count">' + icon('search-file-icon') + (a.encrypted ? '已加密' : countText(a.charCount) + ' 字') + '</span></div>' + edit + '</article>';
  }

  /** 回到静态（服务端分页）列表 */
  function showStatic(total: number): void {
    el('search-box')?.removeAttribute('data-searching');
    requestId += 1;
    controller?.abort();
    el('search-results')?.classList.add('hidden');
    el('search-empty')?.classList.add('hidden');
    el('post-grid')?.classList.remove('hidden');
    el('post-pagination')?.classList.remove('hidden');
    const count = el('search-count');
    if (count) count.textContent = `${total} 篇`;
  }

  /** 触发一次搜索（q 为空且分类=全部时回静态列表） */
  function runSearch(): void {
    const input = el<HTMLInputElement>('search-input');
    const q = (input?.value ?? '').trim();
    document.dispatchEvent(new CustomEvent('byqx:home-clear-tag'));
    if (!q && activeCat === 'all') {
      showStatic(Number(input?.dataset.total ?? 0));
      return;
    }
    controller?.abort();
    controller = new AbortController();
    el('search-box')?.setAttribute('data-searching', 'true');
    const currentRequest = ++requestId;
    el('search-results')?.classList.remove('hidden');
    el('post-grid')?.classList.add('hidden');
    el('post-pagination')?.classList.add('hidden');
    el('search-empty')?.classList.add('hidden');
    const count = el('search-count');
    if (count) count.textContent = '搜索中…';
    const resultsBefore = el('search-results');
    if (resultsBefore) { resultsBefore.innerHTML = ''; resultsBefore.setAttribute('aria-busy','true'); }
    fetch(`/api/search?q=${encodeURIComponent(q)}&category=${encodeURIComponent(activeCat)}`, { signal: controller.signal })
      .then((r) => (r.ok ? r.json() : Promise.reject(new Error('bad status'))))
      .then((data: { articles: Array<Parameters<typeof rowHtml>[0]>; total: number }) => {
        if (currentRequest !== requestId) return;
        const results = el('search-results');
        results?.removeAttribute('aria-busy');
        if (results) { results.innerHTML = data.articles.map(rowHtml).join(''); void feedback(results); }
        if (count) count.textContent = data.total > 50 ? `命中 ${data.total} 篇 · 最多展示前 50 篇` : `命中 ${data.total} 篇`;
        el('search-empty')?.classList.toggle('hidden', data.total > 0);
      })
      .catch((err: unknown) => {
        if (currentRequest !== requestId) return;
        el('search-results')?.removeAttribute('aria-busy');
        if (err instanceof DOMException && err.name === 'AbortError') return;
        if (count) count.textContent = '搜索失败';
      });
  }

  function scheduleSearch(): void {
    if (debounceTimer) window.clearTimeout(debounceTimer);
    debounceTimer = window.setTimeout(runSearch, 200);
  }

  // ---- document 级委托（只绑定一次，View Transitions 后依然有效） ----
  document.addEventListener('input', (e) => {
    const target = e.target as HTMLElement;
    if (target.id === 'search-input') scheduleSearch();
  });

  document.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLElement>('[data-cat-filter]');
    if (!btn) return;
    activeCat = btn.dataset.catFilter ?? 'all';
    document.querySelectorAll<HTMLElement>('[data-cat-filter]').forEach((b) => {
      b.classList.toggle('active', b === btn);
      b.setAttribute('aria-pressed', String(b === btn));
    });
    runSearch();
  });

  // ---- 初始/每次 View Transition 后恢复状态 ----
  function init(): void {
    const input = el<HTMLInputElement>('search-input');
    if (!input) return;
    const total = Number(input.dataset.total ?? 0);
    input.value = '';
    document.querySelectorAll<HTMLElement>('[data-cat-filter]').forEach((b) => {
      b.classList.toggle('active', b.dataset.catFilter === 'all');
      b.setAttribute('aria-pressed', String(b.dataset.catFilter === 'all'));
    });
    activeCat = 'all';
    showStatic(total);
  }
  document.addEventListener('astro:page-load', init);
  document.addEventListener('byqx:home-reset-search', () => { if (debounceTimer) window.clearTimeout(debounceTimer); debounceTimer = null; init(); });
  document.addEventListener('astro:before-swap', () => { controller?.abort(); requestId += 1; if (debounceTimer) window.clearTimeout(debounceTimer); });
  init();
</script>
