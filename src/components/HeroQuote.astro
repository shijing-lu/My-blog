---
import { getHeroQuoteSettings, serializeSettings } from '@/lib/quote-settings';
import { canManage } from '@/lib/admin-auth';
import { heroQuoteLines } from '@/lib/hero-quote-lines';
import NeoIcon from './NeoIcon.astro';
const settings = await getHeroQuoteSettings();
const isAuthed = await canManage(Astro.cookies, 'settings');
const firstQuote = settings.quotes[0]?.text ?? '';
const lines = heroQuoteLines(firstQuote);
---
<div class="neo-quote-wrap">
  <h1 id="hero-quote" class:list={['neo-quote', { 'neo-quote-long': firstQuote.length > 60 }]} data-settings={JSON.stringify(serializeSettings(settings))}>
    {lines.map((line, index) => <span class:list={['neo-quote-line', { 'neo-quote-accent': index >= Math.ceil(lines.length / 2) }]}>{line}</span>)}
  </h1>
  {isAuthed && <button type="button" data-open-settings="hero-quotes" class="neo-quote-edit" aria-label="管理诗词" title="管理诗词"><NeoIcon name="pencil" size={16} /></button>}
</div>
<script>
  import { heroQuoteLines } from '@/lib/hero-quote-lines';
  type Settings = { quotes: { text: string; pauseMs?: number }[]; defaultPauseMs: number };
  let timer = 0;
  let current = 0;
  const stop = () => { window.clearTimeout(timer); timer = 0; document.getElementById('hero-quote')?.classList.remove('is-changing'); };
  function start(): void {
    stop();
    const heading = document.getElementById('hero-quote');
    if (!heading || document.hidden || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    let settings: Settings;
    try { settings = JSON.parse(heading.dataset.settings ?? '{}') as Settings; } catch { return; }
    if (!Array.isArray(settings.quotes) || settings.quotes.length < 2) return;
    const next = () => {
      timer = window.setTimeout(() => {
        heading.classList.add('is-changing');
        timer = window.setTimeout(() => {
          current = (current + 1) % settings.quotes.length;
          const text = settings.quotes[current]?.text ?? '';
          const lines = heroQuoteLines(text);
          heading.replaceChildren(...lines.map((line, index) => { const span = document.createElement('span'); span.className = 'neo-quote-line' + (index >= Math.ceil(lines.length / 2) ? ' neo-quote-accent' : ''); span.textContent = line; return span; }));
          heading.classList.toggle('neo-quote-long', text.length > 60);
          heading.classList.remove('is-changing');
          next();
        }, 180);
      }, Math.max(0, settings.quotes[current]?.pauseMs ?? settings.defaultPauseMs ?? 8000));
    };
    next();
  }
  document.addEventListener('astro:before-swap', stop);
  document.addEventListener('astro:page-load', () => { current = 0; start(); });
  window.addEventListener('byqx:quotes-saved', event => {
    const heading = document.getElementById('hero-quote');
    if (!heading) return;
    const settings = (event as CustomEvent<Settings>).detail;
    heading.dataset.settings = JSON.stringify(settings);
    const text = settings.quotes[0]?.text ?? '';
    const lines = heroQuoteLines(text);
    heading.replaceChildren(...lines.map((line, index) => { const span = document.createElement('span'); span.className = 'neo-quote-line' + (index >= Math.ceil(lines.length / 2) ? ' neo-quote-accent' : ''); span.textContent = line; return span; }));
    heading.classList.toggle('neo-quote-long', text.length > 60);
    current = 0; start();
  });
  document.addEventListener('visibilitychange', () => document.hidden ? stop() : start());
  matchMedia('(prefers-reduced-motion: reduce)').addEventListener('change', start);
  start();
</script>
