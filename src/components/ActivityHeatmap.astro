---
/* ===== Props ===== */
/* （无） */

/* ===== Imports ===== */
import { buildHeatmap } from '@/lib/heatmap';
import { listArticles } from '@/lib/articles';
import NeoIcon from './NeoIcon.astro';

/* ===== Logic ===== */
/** 文章数据（含 createdAt/updatedAt/content） */
const articles = await listArticles();
/** 热力图数据（最近 12 个月） */
const data = buildHeatmap(articles, new Date(), 12);

/** 数量 → 颜色档位 0-4 */
function level(count: number): number {
  if (count === 0) return 0;
  if (count === 1) return 1;
  if (count <= 3) return 2;
  if (count <= 5) return 3;
  return 4;
}

/** 每列顶部月份标签：若该列某天是某月 1 号，则在该列标出月份缩写 */
const monthLabels: string[] = data.weeks.map((week) => {
  const first = week.find((d) => d.date.endsWith('-01'));
  if (!first) return '';
  const m = new Date(`${first.date}T12:00:00`);
  return m.toLocaleString('en-US', { month: 'short' }).toUpperCase();
});

/* ---- 折线图（月度聚合） ---- */
const CHART_W = 260;
const CHART_H = 120;
const PAD = 10;
const maxTotal = Math.max(1, ...data.monthly.map((m) => m.total));
const points = data.monthly.map((m, i) => {
  const denom = Math.max(1, data.monthly.length - 1);
  const x = PAD + (i * (CHART_W - PAD * 2)) / denom;
  const y = CHART_H - PAD - (m.total / maxTotal) * (CHART_H - PAD * 2);
  return { x: Number(x.toFixed(1)), y: Number(y.toFixed(1)), total: m.total };
});
const linePath = points.map((p, i) => `${i === 0 ? 'M' : 'L'}${p.x},${p.y}`).join(' ');
const areaPath =
  points.length > 1
    ? `M${points[0]!.x},${points[0]!.y} ` +
      points.slice(1).map((p) => `L${p.x},${p.y}`).join(' ') +
      ` L${points[points.length - 1]!.x},${CHART_H - PAD} L${points[0]!.x},${CHART_H - PAD} Z`
    : '';
const monthShort = (month: string): string => {
  const [y, m] = month.split('-');
  return new Date(Number(y), Number(m) - 1, 1).toLocaleString('en-US', { month: 'short' }).toUpperCase();
};
const peakIdx = data.monthly.reduce((best, m, i) => (m.total > data.monthly[best]!.total ? i : best), 0);
const peakTotal = data.monthly[peakIdx]?.total ?? 0;
---

<section class="activity-heatmap neo-stats neo-panel" aria-labelledby="stats-heading">
  <header class="neo-stats-heading"><span class="neo-heading-icon"><NeoIcon name="chart" size={23} /></span><h2 id="stats-heading">站点数据</h2><p>记录点滴，见证成长 ✨</p><small>EVERY BIT COUNTS.</small></header>
  <div class="neo-metrics">
    {[{value:data.stats.posts,label:'文章数',en:'POSTS',icon:'file'}, {value:data.stats.days,label:'创作天数',en:'DAYS',icon:'calendar'}, {value:data.stats.words,label:'总字数',en:'WORDS',icon:'file'}].map(metric => <div class="neo-metric"><span class="neo-metric-icon"><NeoIcon name={metric.icon as 'file' | 'calendar'} size={29} /></span><div><strong>{metric.value.toLocaleString()}</strong><small>{metric.en}</small><p>{metric.label}</p></div></div>)}
    <aside class="neo-encouragement"><img src="/images/neobrutalism/cat-peek.webp" alt="" width="140" height="85" loading="lazy" /><p>持续创作<br />让热爱发光!</p></aside>
  </div>
  <div class="neo-charts">
    <div class="neo-chart"><h3>创作日历 <span aria-hidden="true">›</span></h3>
      <div class="activity-heatmap-scroll" role="region" aria-label="最近十二个月的每日写作活动，可横向滚动" tabindex="0">
        <div class="activity-heatmap-cells"><div>{data.weeks.map(week => <div>{week.map(day => <div class={'heat-cell heat-' + level(day.count)} title={day.date + '：' + day.count + ' 篇文章有发布或更新'} />)}</div>)}</div></div>
        <div class="activity-heatmap-months">{monthLabels.map(label => <span>{label}</span>)}</div>
      </div>
      <div class="neo-heat-legend"><span>很少</span><span class="heat-cell heat-0" /><span class="heat-cell heat-1" /><span class="heat-cell heat-2" /><span class="heat-cell heat-3" /><span class="heat-cell heat-4" /><span>多</span></div>
    </div>
    <div class="neo-chart neo-month-chart"><h3>月度写作活动 <small>/ MONTHLY</small></h3><div class="neo-peak">PEAK MONTH<strong>{peakTotal > 0 ? monthShort(data.monthly[peakIdx]!.month) + ' · ' + peakTotal : '—'}</strong></div>
      <svg viewBox={'0 0 ' + CHART_W + ' ' + CHART_H} preserveAspectRatio="none" role="img" aria-label={'最近十二个月发布或更新活动，峰值 ' + peakTotal}>
        {[0,.5,1].map(ratio => <line x1={PAD} x2={CHART_W-PAD} y1={CHART_H-PAD-ratio*(CHART_H-PAD*2)} y2={CHART_H-PAD-ratio*(CHART_H-PAD*2)} stroke="var(--neo-line)" stroke-dasharray="2 3" />)}
        {[0,.5,1].map(ratio => <text x="0" y={CHART_H-PAD-ratio*(CHART_H-PAD*2)+2}>{Math.round(maxTotal*ratio)}</text>)}
        <path d={areaPath} fill="currentColor" opacity="0.13" /><path d={linePath} fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" stroke-linecap="round" />
        {points.map((point,index) => <circle cx={point.x} cy={point.y} r="2.7" fill="currentColor"><title>{data.monthly[index]!.month + '：' + point.total + ' 次发布或更新活动'}</title></circle>)}
      </svg><div class="neo-month-labels">{data.monthly.map(month => <span>{monthShort(month.month)}</span>)}</div><p class="neo-chart-caption">每日按有发布或更新的文章计数，最近 12 个月。</p>
    </div>
  </div>
</section>
