---
/**
 * Comments.astro —— 评论系统（Twikoo 现成框架）
 *
 * - 文章/动态复用：通过 targetType + targetId 区分独立评论线程（Twikoo path）；
 * - 后端地址由 PUBLIC_TWIKOO_ENV_ID 提供，未配置时静默隐藏（与旧 Giscus 一致）；
 * - collapsible 模式（动态卡片）：点击"评论"按钮才展开并懒加载评论；
 * - 主题跟随博客 .dark class 自动切换。
 */
interface Props {
  /** 目标类型：article | moment */
  targetType: 'article' | 'moment';
  /** 目标 id（文章 id / 动态 id） */
  targetId: string;
  /** 折叠模式（动态卡片用）：点击"评论"才展开加载 */
  collapsible?: boolean;
  /** 折叠按钮初始评论数（可选占位） */
  initialCount?: number;
}

const { targetType, targetId, collapsible = false, initialCount = 0 } = Astro.props;
const threadPath = `/${targetType === 'article' ? 'article' : 'moment'}/${targetId}`;
---
<!-- 静态引入 Twikoo CSS（nocss 版不注入样式，避免 Astro ClientRouter 导航后动态注入的 CSS 被移除而样式崩） -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/twikoo@1.7.19/dist/twikoo.css" />

{
  collapsible ? (
    <div class="mt-3">
      <button
        type="button"
        data-comment-toggle
        data-thread-path={threadPath}
        class="inline-flex items-center gap-1.5 rounded-md border border-border px-3 py-1.5 text-sm text-muted-foreground transition-colors duration-150 hover:border-primary hover:text-primary"
      >
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-4" aria-hidden="true">
          <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" />
        </svg>
        评论
        {initialCount > 0 && <span class="tabular-nums">({initialCount})</span>}
      </button>
      <div class="comment-body mt-3 hidden" data-twikoo data-thread-path={threadPath}></div>
    </div>
  ) : (
    <section class="mt-12 border-t border-border pt-8" aria-label="评论">
      <p class="pixel-chip text-primary">COMMENTS</p>
      <div class="mt-4" data-twikoo data-thread-path={threadPath}></div>
    </section>
  )
}

<script>
  // 幂等守卫：View Transition 重执行本脚本时只绑定一次
  if (!(window as unknown as { __twikooBound?: boolean }).__twikooBound) {
    (window as unknown as { __twikooBound?: boolean }).__twikooBound = true;

    void (() => {
      const envId = (import.meta.env.PUBLIC_TWIKOO_ENV_ID as string | undefined) ?? '';

      /** 当前主题（跟随博客 .dark class，init 时读取） */
      function currentTheme(): 'dark' | 'light' {
        return document.documentElement.classList.contains('dark') ? 'dark' : 'light';
      }

      /** Twikoo 全局对象类型（CDN 加载的 nocss 版） */
      type TwikooGlobal = {
        init: (o: {
          el: HTMLElement;
          envId: string;
          path?: string;
          lang?: string;
          theme?: string;
          pageSize?: number;
        }) => Promise<void>;
      };
      function getTwikoo(): TwikooGlobal | null {
        return (window as unknown as { twikoo?: TwikooGlobal }).twikoo ?? null;
      }

      /** 动态加载 twikoo.nocss.js（无 CSS 版，样式由静态 <link> 提供） */
      let loading: Promise<void> | null = null;
      function loadTwikoo(): Promise<void> {
        if (getTwikoo()) return Promise.resolve();
        if (!loading) {
          loading = new Promise((resolve, reject) => {
            const s = document.createElement('script');
            s.src = 'https://cdn.jsdelivr.net/npm/twikoo@1.7.19/dist/twikoo.nocss.js';
            s.onload = () => setTimeout(resolve, 100);
            s.onerror = () => reject(new Error('twikoo load failed'));
            document.head.appendChild(s);
          });
        }
        return loading;
      }

      /** 初始化单个评论容器（懒加载幂等；env 未配置时静默） */
      async function initContainer(el: HTMLElement): Promise<void> {
        if (!envId || el.dataset.twikooLoaded === '1') return;
        el.dataset.twikooLoaded = '1';
        try {
          await loadTwikoo();
          await getTwikoo()?.init({
            el,
            envId,
            path: el.dataset.threadPath ?? '/',
            lang: 'zh-CN',
            theme: currentTheme(),
            // 每页条数（优先由 Twikoo 后端 serverConfig 控制；此处作为前端兜底）
            pageSize: 6,
          });
        } catch {
          /* 忽略 */
        }
      }

      // 折叠容器：点击"评论"展开并懒加载（不依赖 env，未配置时也能展开/收起）
      document.addEventListener('click', (e) => {
        const btn = (e.target as HTMLElement).closest<HTMLElement>('[data-comment-toggle]');
        if (!btn) return;
        const body = btn.parentElement?.querySelector<HTMLElement>('[data-twikoo]');
        if (!body) return;
        body.classList.toggle('hidden');
        if (!body.classList.contains('hidden')) void initContainer(body);
      });

      // 仅初始化"非折叠"容器（文章评论区）；折叠容器（动态）等点击展开时才 init，
      // 避免同一页面多个 Twikoo 实例同时加载导致评论串/状态干扰
      document.querySelectorAll<HTMLElement>('[data-twikoo]').forEach((el) => {
        const isCollapsed = !!el.parentElement?.querySelector('[data-comment-toggle]');
        if (!isCollapsed) void initContainer(el);
      });
    })();
  }
</script>
