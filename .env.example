# ============================================================
# My-Blog 环境变量示例 —— 复制为 .env 后填写
# （.env 已被 .gitignore 忽略，切勿提交真实密钥）
# ============================================================

# ---------- 数据库 ----------
# 开发：本地 SQLite（默认，不配置本项亦可，代码会自动回落）
# 生产（Vercel）：Neon / Supabase 等 PostgreSQL 连接串，以 postgres:// 或 postgresql:// 开头
DATABASE_URL=file:./data/blog.db
# DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# ---------- 后台鉴权（口令通道） ----------
# 登录后台的密码（必填；生产环境务必修改）
ADMIN_PASSWORD=change-me-please
# 会话 Cookie 签名密钥（建议 32 字节以上随机串；缺省时由 ADMIN_PASSWORD 派生）
AUTH_SECRET=

# ---------- 后台鉴权（GitHub OAuth 通道，可选） ----------
# 在 https://github.com/settings/developers 创建 OAuth App：
#   Homepage URL  -> https://你的域名
#   Callback URL  -> https://你的域名/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# 允许登录后台的 GitHub 用户名（不区分大小写），例如 ADMIN_GITHUB_LOGIN=octocat
ADMIN_GITHUB_LOGIN=

# ---------- 评论系统（Twikoo，自托管） ----------
# 前置：部署 Twikoo 后端到 Vercel（官方模板 + MongoDB Atlas 免费档），拿到后端地址：
#   https://vercel.com/new/clone?repository-url=https://github.com/twikoojs/twikoo-vercel
# PUBLIC_TWIKOO_ENV_ID 填 Twikoo 后端地址，如 https://twikoo-xxx.vercel.app
# 未配置时评论区自动隐藏，不影响其余功能。
PUBLIC_TWIKOO_ENV_ID=

# ---------- 站点 ----------
# 用于 RSS 与 SEO canonical 的完整站点地址（生产必填）
PUBLIC_SITE_URL=http://localhost:4321
